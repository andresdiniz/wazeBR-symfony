+            var pwOk = strongEnough.test(password.value);
+            password.classList.toggle('is-invalid', password.value.length > 0 && !pwOk);
+            password.classList.toggle('is-valid', pwOk);
+            passwordHint.classList.toggle('is-invalid', password.value.length > 0 && !pwOk);
