                            <pre><code>const axios = require('axios');

const config = {
    headers: {
        'Authorization': 'Bearer YOUR_API_KEY',
        'Content-Type': 'application/json'
    }
};

axios.get('https://api.wazebr.com/api/traffic', config)
    .then(response =&gt; {
        response.data.data.alerts.forEach(alert =&gt; {
            console.log(`Alerta: ${alert.type}`);
        });
    });</code></pre>
