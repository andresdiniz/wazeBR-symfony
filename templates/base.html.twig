<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}wazeBR{% endblock %}</title>
    
    {# Meta tags #}
    <meta name="description" content="{% block meta_description %}wazeBR - Monitoramento de Tr\u00e2nsito e Mobilidade{% endblock %}">
    <meta name="keywords" content="{% block meta_keywords %}tr\u00e2nsito, mobilidade, monitoramento, waze{% endblock %}">
    
    {# Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    {# Icons #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    {# Global Stylesheet (loaded on every page) #}
    <link rel="stylesheet" href="{{ asset('assets/css/global.css') }}">
    
    {# Page-specific Stylesheets #}
    {% block stylesheets %}{% endblock %}
    
    {# Favicon #}
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
</head>
<body class="{% block body_class %}{% endblock %}">
    {# Header #}
    {% include 'partials/header.html.twig' %}
    
    {# Main Content #}
    <main class="main-content">
        {% block body %}{% endblock %}
    </main>
    
    {# Footer #}
    {% include 'partials/footer.html.twig' %}
    
    {# Global JavaScript (loaded on every page) #}
    <script src="{{ asset('assets/js/global.js') }}"></script>
    
    {# Page-specific JavaScript #}
    {% block javascripts %}{% endblock %}
</body>
</html>
