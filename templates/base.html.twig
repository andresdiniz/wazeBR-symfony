<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}wazeBR{% endblock %}</title>
    <link rel="icon" href="{{ asset('favicon.ico') }}">
    {{ encore_entry_link_tags('app') }}
    <link rel="stylesheet" href="{{ asset('styles/base.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/layout.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <div class="layout-public">
        <header class="header">
            <div class="header-left">
                <a href="{{ path('app_dashboard') }}" style="font-weight: 700; font-size: 1.25rem; color: var(--color-primary);">wazeBR</a>
            </div>
            <div class="header-right">
                {% if app.user %}
                    <div class="header-user">
                        <div class="header-user-avatar">{{ app.user.email|first|upper }}</div>
                        <span class="header-user-name">{{ app.user.email }}</span>
                    </div>
                    <a href="{{ path('app_logout') }}" class="btn btn-secondary">Sair</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-primary">Entrar</a>
                {% endif %}
            </div>
        </header>
        <main class="content-area">
            {% block body %}{% endblock %}
        </main>
        <footer class="footer">
            <div class="footer-left">
                <span>&copy; {{ date('Y') }} wazeBR - Monitoramento de trfego e hidrologia</span>
            </div>
            <div class="footer-right">
                <div class="footer-links">
                    <a href="#" class="footer-link">Suporte</a>
                    <a href="#" class="footer-link">Termos</a>
                    <a href="#" class="footer-link">Privacidade</a>
                </div>
            </div>
        </footer>
    </div>
    {{ encore_entry_script_tags('app') }}
    <script src="{{ asset('js/main.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>