<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}WazeBR{% endblock %}</title>
    <style>
        :root {
            --app-bg: #f6f8fb;
            --surface: #ffffff;
            --surface-hover: #f1f5f9;
            --border: #e2e8f0;
            --text: #172033;
            --muted: #64748b;
            --brand: #0f766e;
            --brand-dark: #115e59;
            --brand-soft: #ccfbf1;
            --sidebar-width: 264px;
            --header-height: 64px;
        }
        * { box-sizing: border-box; }
        html, body { min-height: 100%; }
        body {
            margin: 0;
            background: var(--app-bg);
            color: var(--text);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            line-height: 1.5;
        }
        a { color: inherit; text-decoration: none; }
        button { font: inherit; }
        .app-shell { min-height: 100vh; }
        .sidebar {
            position: fixed;
            inset: 0 auto 0 0;
            z-index: 100;
            display: flex;
            flex-direction: column;
            width: var(--sidebar-width);
            background: var(--surface);
            border-right: 1px solid var(--border);
            transition: transform .25s ease;
        }
        .brand {
            display: flex;
            align-items: center;
            gap: .75rem;
            min-height: var(--header-height);
            padding: 0 1.25rem;
            border-bottom: 1px solid var(--border);
            font-size: 1.15rem;
            font-weight: 800;
        }
        .brand-mark {
            display: grid;
            width: 2rem;
            height: 2rem;
            place-items: center;
            border-radius: .55rem;
            background: var(--brand);
            color: #fff;
            font-size: .72rem;
            letter-spacing: .04em;
        }
        .navigation { flex: 1; overflow-y: auto; padding: 1rem .75rem; }
        .nav-group { margin: 0 0 1.25rem; }
        .nav-heading {
            display: block;
            margin: 0 0 .4rem;
            padding: 0 .75rem;
            color: var(--muted);
            font-size: .7rem;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
        }
        .nav-link {
            display: flex;
            align-items: center;
            gap: .75rem;
            min-height: 2.65rem;
            margin: .15rem 0;
            padding: .55rem .75rem;
            border-radius: .5rem;
            color: #334155;
            font-size: .9rem;
            font-weight: 600;
        }
        .nav-link:hover { background: var(--surface-hover); color: var(--brand-dark); }
        .nav-link.is-active { background: var(--brand-soft); color: var(--brand-dark); }
        .nav-icon { width: 1.25rem; text-align: center; }
        .user-panel {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: 1rem 1.25rem;
            border-top: 1px solid var(--border);
        }
        .avatar {
            display: grid;
            width: 2.35rem;
            height: 2.35rem;
            flex: 0 0 auto;
            place-items: center;
            border-radius: 50%;
            background: var(--brand);
            color: #fff;
            font-size: .85rem;
            font-weight: 800;
        }
        .user-details { min-width: 0; }
        .user-email { overflow: hidden; margin: 0; font-size: .8rem; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
        .user-role { margin: .1rem 0 0; color: var(--muted); font-size: .73rem; }
        .page { display: flex; min-height: 100vh; flex-direction: column; margin-left: var(--sidebar-width); }
        .topbar {
            position: sticky;
            top: 0;
            z-index: 50;
            display: flex;
            min-height: var(--header-height);
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: .75rem 1.5rem;
            background: rgba(255,255,255,.96);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(8px);
        }
        .topbar-left, .topbar-actions { display: flex; align-items: center; gap: .75rem; }
        .page-heading { min-width: 0; }
        .page-heading h1 { margin: 0; font-size: 1.15rem; line-height: 1.2; }
        .page-heading p { overflow: hidden; margin: .15rem 0 0; color: var(--muted); font-size: .8rem; text-overflow: ellipsis; white-space: nowrap; }
        .menu-button, .logout-button {
            display: inline-flex;
            min-height: 2.35rem;
            align-items: center;
            justify-content: center;
            gap: .4rem;
            padding: .45rem .7rem;
            border: 1px solid var(--border);
            border-radius: .45rem;
            background: var(--surface);
            color: #334155;
            cursor: pointer;
        }
        .menu-button:hover, .logout-button:hover { background: var(--surface-hover); }
        .menu-button { display: none; }
        .content { width: 100%; max-width: 1600px; flex: 1; margin: 0 auto; padding: 1.5rem; }
        .footer { padding: 1rem 1.5rem; color: var(--muted); font-size: .78rem; text-align: center; }
        .flash { margin: 0 0 1rem; padding: .85rem 1rem; border: 1px solid; border-radius: .5rem; font-size: .9rem; }
        .flash-success { background: #ecfdf5; border-color: #a7f3d0; color: #065f46; }
        .flash-error { background: #fef2f2; border-color: #fecaca; color: #991b1b; }
        .flash-warning { background: #fffbeb; border-color: #fde68a; color: #92400e; }
        .overlay { display: none; }
        @media (max-width: 900px) {
            .sidebar { transform: translateX(-100%); box-shadow: 0 18px 45px rgba(15, 23, 42, .2); }
            .sidebar.is-open { transform: translateX(0); }
            .overlay { position: fixed; inset: 0; z-index: 90; background: rgba(15, 23, 42, .45); }
            .overlay.is-visible { display: block; }
            .page { margin-left: 0; }
            .menu-button { display: inline-flex; }
            .topbar { padding: .75rem 1rem; }
            .content { padding: 1rem; }
            .logout-label { display: none; }
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
{% set current_route = app.request.attributes.get('_route')|default('') %}
{% set user_email = app.user ? app.user.userIdentifier : 'Usu�rio' %}
{% set is_admin = is_granted('ROLE_ADMIN') %}

<div class="app-shell">
    <div class="overlay" id="sidebar-overlay"></div>
    <aside class="sidebar" id="sidebar" aria-label="Navega��o principal">
        <a class="brand" href="{{ path('dashboard_index') }}">
            <span class="brand-mark">WB</span>
            <span>WazeBR</span>
        </a>
        <nav class="navigation">
            <section class="nav-group">
                <span class="nav-heading">Principal</span>
                <a class="nav-link {{ current_route in ['dashboard_index', 'app_dashboard'] ? 'is-active' : '' }}" href="{{ path('dashboard_index') }}"><span class="nav-icon">▦</span><span>Dashboard</span></a>
                <a class="nav-link {{ current_route starts with 'jam_' or current_route starts with 'traffic_jam_' ? 'is-active' : '' }}" href="{{ path('jam_index') }}"><span class="nav-icon">▤</span><span>Congestionamentos</span></a>
                <a class="nav-link {{ current_route starts with 'alert_' ? 'is-active' : '' }}" href="{{ path('alert_index') }}"><span class="nav-icon">!</span><span>Alertas</span></a>
            </section>
            <section class="nav-group">
                <span class="nav-heading">Conta</span>
                <a class="nav-link {{ current_route starts with 'account_settings' ? 'is-active' : '' }}" href="{{ path('account_settings') }}"><span class="nav-icon">◉</span><span>Configura��es</span></a>
                <a class="nav-link {{ current_route starts with 'account_link' ? 'is-active' : '' }}" href="{{ path('account_link_index') }}"><span class="nav-icon">↗</span><span>Meus links</span></a>
                <a class="nav-link {{ current_route starts with 'account_logs' ? 'is-active' : '' }}" href="{{ path('account_logs') }}"><span class="nav-icon">≡</span><span>Logs</span></a>
            </section>
            {% if is_admin %}
            <section class="nav-group">
                <span class="nav-heading">Administra��o</span>
                <a class="nav-link {{ current_route == 'admin_dashboard' ? 'is-active' : '' }}" href="{{ path('admin_dashboard') }}"><span class="nav-icon">◆</span><span>Dashboard admin</span></a>
                <a class="nav-link {{ current_route starts with 'admin_partner' ? 'is-active' : '' }}" href="{{ path('admin_partner_index') }}"><span class="nav-icon">▣</span><span>Parceiros</span></a>
                <a class="nav-link {{ current_route starts with 'admin_city' ? 'is-active' : '' }}" href="{{ path('admin_city_index') }}"><span class="nav-icon">⌂</span><span>Cidades</span></a>
                <a class="nav-link {{ current_route starts with 'admin_routes' ? 'is-active' : '' }}" href="{{ path('admin_routes_index') }}"><span class="nav-icon">↝</span><span>Rotas</span></a>
                <a class="nav-link {{ current_route starts with 'admin_link' ? 'is-active' : '' }}" href="{{ path('admin_link_index') }}"><span class="nav-icon">↗</span><span>Links</span></a>
                <a class="nav-link {{ current_route starts with 'admin_station' ? 'is-active' : '' }}" href="{{ path('admin_station_index') }}"><span class="nav-icon">◌</span><span>Esta��es</span></a>
                <a class="nav-link {{ current_route starts with 'admin_settings' ? 'is-active' : '' }}" href="{{ path('admin_settings_index') }}"><span class="nav-icon">⚙</span><span>Configura��es</span></a>
            </section>
            {% endif %}
        </nav>
        <div class="user-panel">
            <span class="avatar">{{ user_email|first|upper }}</span>
            <div class="user-details">
                <p class="user-email">{{ user_email }}</p>
                <p class="user-role">{{ is_admin ? 'Administrador' : 'Usu�rio autenticado' }}</p>
            </div>
        </div>
    </aside>
    <div class="page">
        <header class="topbar">
            <div class="topbar-left">
                <button class="menu-button" id="sidebar-toggle" type="button" aria-label="Abrir menu" aria-controls="sidebar" aria-expanded="false">☰</button>
                <div class="page-heading">
                    <h1>{% block header_title %}Dashboard{% endblock %}</h1>
                    <p>{% block header_subtitle %}Plataforma WazeBR{% endblock %}</p>
                </div>
            </div>
            <div class="topbar-actions">
                <span class="avatar" title="{{ user_email }}">{{ user_email|first|upper }}</span>
                <a class="logout-button" href="{{ path('app_logout') }}"><span aria-hidden="true">↪</span><span class="logout-label">Sair</span></a>
            </div>
        </header>
        <main class="content">
            {% for message in app.flashes('success') %}<div class="flash flash-success">{{ message }}</div>{% endfor %}
            {% for message in app.flashes('error') %}<div class="flash flash-error">{{ message }}</div>{% endfor %}
            {% for message in app.flashes('warning') %}<div class="flash flash-warning">{{ message }}</div>{% endfor %}
            {% block body %}{% endblock %}
        </main>
        <footer class="footer">&copy; {{ 'now'|date('Y') }} WazeBR. Todos os direitos reservados.</footer>
    </div>
</div>
<script>
(function(){var s=document.getElementById('sidebar'),o=document.getElementById('sidebar-overlay'),t=document.getElementById('sidebar-toggle');if(!s||!o||!t)return;function c(){s.classList.remove('is-open');o.classList.remove('is-visible');t.setAttribute('aria-expanded','false');}function d(){s.classList.add('is-open');o.classList.add('is-visible');t.setAttribute('aria-expanded','true');}t.addEventListener('click',function(){s.classList.contains('is-open')?c():d();});o.addEventListener('click',c);window.addEventListener('keydown',function(e){if(e.key==='Escape')c();});})();
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
