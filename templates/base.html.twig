<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}WazeBR{% endblock %}</title>

    {# CSS externos (CDN) — sempre carregados #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    {# CSS globais da aplicação (AssetMapper) #}
    <link rel="stylesheet" href="{{ asset('css/global.css') }}">
    <link rel="stylesheet" href="{{ asset('css/base-layout.css') }}">

    {# CSS do partial header — carregado aqui pois o partial está no base #}
    <link rel="stylesheet" href="{{ asset('css/header.css') }}">

    {# CSS específicos de cada página #}
    {% block stylesheets %}{% endblock %}
</head>
<body>

    {# Header via controller para dados dinâmicos (ex: notification_count) #}
    {{ render(controller('App\\Controller\\HeaderController::index')) }}

    {% include 'partials/sidebar.html.twig' %}

    {% block body %}{% endblock %}

    {% include 'partials/footer.html.twig' %}

    {# JS externos (CDN) #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    {# JS globais da aplicação (AssetMapper) #}
    <script src="{{ asset('js/global.js') }}" defer></script>
    <script src="{{ asset('js/base-layout.js') }}" defer></script>

    {# JS do partial header — carregado aqui pois o partial está no base #}
    <script src="{{ asset('js/header.js') }}" defer></script>

    {# JS específicos de cada página #}
    {% block javascripts %}{% endblock %}
</body>
</html>
