<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{% block title %}wazeBR{% endblock %} - Monitoramento de Trâ££ego</title>
    
    <!-- Favicon -->
    <link rel="icon" href="{{ asset('favicon.ico') }}" type="image/x-icon">
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Leaflet CSS (Maps) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    
    <!-- App CSS -->
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    
    {% block stylesheets %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}" data-page="{% block page_name %}{% endblock %}">
    {% block sidebar %}
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <a href="{{ path('dashboard_index') }}" class="sidebar-brand">
                <div class="sidebar-brand-icon">
                    <i class="bi bi-speedometer2"></i>
                </div>
                <span>wazeBR</span>
            </a>
            <button class="sidebar-toggle" id="sidebarToggle" title="Recolher menu">
                <i class="bi bi-chevron-left"></i>
            </button>
        </div>
        
        <nav class="sidebar-nav">
            {% block sidebar_nav %}
            <!-- Dashboard -->
            <div class="sidebar-section">
                <div class="sidebar-section-title">Principal</div>
                <ul class="sidebar-menu">
                    <li class="sidebar-menu-item {% if app.request.attributes.get('_route') == 'dashboard_index' %}active{% endif %}">
                        <a href="{{ path('dashboard_index') }}" class="sidebar-menu-link">
                            <span class="sidebar-menu-icon"><i class="bi bi-speedometer2"></i></span>
                            <span class="sidebar-menu-label">Dashboard</span>
                        </a>
                    </li>
                </ul>
            </div>
            
            <!-- Monitoramento -->
            <div class="sidebar-section">
                <div class="sidebar-section-title">Monitoramento</div>
                <ul class="sidebar-menu">
                    <li class="sidebar-menu-item {% if 'alert' in app.request.attributes.get('_route') %}active{% endif %}">
                        <a href="{{ path('alert_index') }}" class="sidebar-menu-link">
                            <span class="sidebar-menu-icon"><i class="bi bi-exclamation-triangle"></i></span>
                            <span class="sidebar-menu-label">Alertas</span>
                            {% if unread_notifications|default(0) > 0 %}
                            <span class="sidebar-menu-badge">{{ unread_notifications }}</span>
                            {% endif %}
                        </a>
                    </li>
                    <li class="sidebar-menu-item {% if 'jam' in app.request.attributes.get('_route') or 'traffic' in app.request.attributes.get('_route') %}active{% endif %}">
                        <a href="{{ path('jam_index') }}" class="sidebar-menu-link">
                            <span class="sidebar-menu-icon"><i class="bi bi-sign-merge-right"></i></span>
                            <span class="sidebar-menu-label">Congestionamentos</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item {% if 'hydro' in app.request.attributes.get('_route') %}active{% endif %}">
                        <a href="{{ path('hydro_live') }}" class="sidebar-menu-link">
                            <span class="sidebar-menu-icon"><i class="bi bi-droplet"></i></span>
                            <span class="sidebar-menu-label">Hidrologia</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item {% if 'cemaden' in app.request.attributes.get('_route') %}active{% endif %}">
                        <a href="{{ path('app_cemaden_index') }}" class="sidebar-menu-link">
                            <span class="sidebar-menu-icon"><i class="bi bi-cloud-rain"></i></span>
                            <span class="sidebar-menu-label">CEMADEN</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item {% if 'cifs' in app.request.attributes.get('_route') %}active{% endif %}">
                        <a href="{{ path('cifs_index') }}" class="sidebar-menu-link">
                            <span class="sidebar-menu-icon"><i class="bi bi-calendar-event"></i></span>
                            <span class="sidebar-menu-label">Eventos CIFs</span>
                        </a>
                    </li>
                </ul>
            </div>
            
            <!-- Admin -->
            {% if is_granted('ROLE_ADMIN') %}
            <div class="sidebar-section">
                <div class="sidebar-section-title">Administraçª£o</div>
                <ul class="sidebar-menu">
                    <li class="sidebar-menu-item {% if 'admin_dashboard' in app.request.attributes.get('_route') %}active{% endif %}">
                        <a href="{{ path('admin_dashboard') }}" class="sidebar-menu-link">
                            <span class="sidebar-menu-icon"><i class="bi bi-gear"></i></span>
                            <span class="sidebar-menu-label">Admin</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item has-submenu">
                        <div class="sidebar-menu-item">
                            <span class="sidebar-menu-icon"><i class="bi bi-people"></i></span>
                            <span class="sidebar-menu-label">Cadastros</span>
                            <span class="sidebar-menu-icon ms-auto"><i class="bi bi-chevron-right"></i></span>
                        </div>
                        <ul class="sidebar-menu-submenu">
                            <li><a href="{{ path('admin_partner_index') }}" class="sidebar-menu-link">Parceiros</a></li>
                            <li><a href="{{ path('admin_city_index') }}" class="sidebar-menu-link">Cidades</a></li>
                            <li><a href="{{ path('admin_link_index') }}" class="sidebar-menu-link">Links</a></li>
                            <li><a href="{{ path('admin_station_index') }}" class="sidebar-menu-link">Estaçµµ</a></li>
                        </ul>
                    </li>
                    <li class="sidebar-menu-item {% if 'admin_routes' in app.request.attributes.get('_route') %}active{% endif %}">
                        <a href="{{ path('admin_routes_index') }}" class="sidebar-menu-link">
                            <span class="sidebar-menu-icon"><i class="bi bi-map"></i></span>
                            <span class="sidebar-menu-label">Rotas</span>
                        </a>
                    </li>
                </ul>
            </div>
            {% endif %}
            {% endblock %}
        </nav>
        
        <div class="sidebar-footer">
            <div class="sidebar-user" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="sidebar-user-avatar">
                    {{ app.user.firstName|default(app.user.email|split('@')|first)|first|upper }}
                </div>
                <div class="sidebar-user-info">
                    <div class="sidebar-user-name">{{ app.user.firstName|default(app.user.email|split('@')|first) }}</div>
                    <div class="sidebar-user-role">{{ app.user.roles|first|replace({'ROLE_': ''})|title }}</div>
                </div>
            </div>
            <ul class="dropdown-menu dropdown-menu-dark">
                <li><a class="dropdown-item" href="{{ path('account_settings') }}"><i class="bi bi-person me-2"></i>Perfil</a></li>
                <li><a class="dropdown-item" href="{{ path('account_settings') }}"><i class="bi bi-gear me-2"></i>Configuraçµµ</a></li>
                <li><a class="dropdown-item" href="{{ path('account_logs') }}"><i class="bi bi-journal me-2"></i>Logs</a></li>
                {% if is_granted('ROLE_ADMIN') %}
                <li><a class="dropdown-item" href="{{ path('account_user_index') }}"><i class="bi bi-people me-2"></i>Usuá¡£os</a></li>
                {% endif %}
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Sair</a></li>
            </ul>
        </div>
    </aside>
    {% endblock %}
    
    <div class="main-content">
        {% block header %}
        <header class="main-header header">
            <div class="header-left">
                <button class="header-toggle d-md-none" id="mobileMenuToggle">
                    <i class="bi bi-list"></i>
                </button>
                
                <div class="header-search">
                    <i class="bi bi-search header-search-icon"></i>
                    <input type="text" class="header-search-input" placeholder="Buscar..." id="headerSearch">
                </div>
            </div>
            
            <div class="header-right">
                <!-- Notifications -->
                <div class="header-action dropdown" id="notificationsDropdown">
                    <button class="header-action" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-bell"></i>
                        {% if unread_notifications|default(0) > 0 %}
                        <span class="header-action-badge">{{ unread_notifications }}</span>
                        {% endif %}
                    </button>
                    <div class="dropdown-menu dropdown-menu-end header-dropdown" style="min-width: 350px;">
                        <div class="header-dropdown-header">
                            <h6 class="header-dropdown-title mb-0">Notificaçµµ</h6>
                        </div>
                        <div class="header-dropdown-body">
                            {% for notification in notifications|default([])|slice(0, 5) %}
                            <div class="header-dropdown-item">
                                <div class="header-dropdown-item-icon {{ notification.type|default('info') }}">
                                    <i class="bi bi-{{ notification.icon|default('bell') }}"></i>
                                </div>
                                <div class="header-dropdown-item-content">
                                    <div class="header-dropdown-item-title">{{ notification.title }}</div>
                                    <div class="header-dropdown-item-text">{{ notification.message|truncate(50) }}</div>
                                </div>
                                <div class="header-dropdown-item-time">{{ notification.createdAt|date('H:i') }}</div>
                            </div>
                            {% else %}
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-bell-slash" style="font-size: 2rem;"></i>
                                <p class="mt-2 mb-0">Nenhuma notificaçª£o</p>
                            </div>
                            {% endfor %}
                        </div>
                        <div class="header-dropdown-footer">
                            <a href="{{ path('notification_index') }}">Ver todas</a>
                        </div>
                    </div>
                </div>
                
                <!-- User Menu -->
                <div class="header-divider d-none d-md-block"></div>
                
                <div class="header-profile dropdown">
                    <div class="d-flex align-items-center" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="header-profile-avatar">
                            {{ app.user.firstName|default(app.user.email|split('@')|first)|first|upper }}
                        </div>
                        <span class="header-profile-name d-none d-md-block ms-2">{{ app.user.firstName|default(app.user.email|split('@')|first) }}</span>
                        <i class="bi bi-chevron-down header-profile-arrow d-none d-md-block ms-1"></i>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end header-profile-dropdown">
                        <li><a class="dropdown-item" href="{{ path('account_settings') }}"><i class="bi bi-person me-2"></i>Meu Perfil</a></li>
                        <li><a class="dropdown-item" href="{{ path('account_settings') }}"><i class="bi bi-gear me-2"></i>Configuraçµµ</a></li>
                        <li><a class="dropdown-item" href="{{ path('account_logs') }}"><i class="bi bi-journal me-2"></i>Logs</a></li>
                        {% if is_granted('ROLE_ADMIN') %}
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('account_user_index') }}"><i class="bi bi-people me-2"></i>Usuá¡£os</a></li>
                        {% endif %}
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Sair</a></li>
                    </ul>
                </div>
            </div>
        </header>
        {% endblock %}
        
        <main class="main-body">
            {% block flash_messages %}
            {% for type, messages in app.flashes %}
            {% for message in messages %}
            <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            {% endfor %}
            {% endfor %}
            {% endblock %}
            
            {% block content %}{% endblock %}
        </main>
        
        {% block footer %}
        <footer class="main-footer">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col-md-6 text-center text-md-start">
                        <p class="text-muted mb-0">
                            &copy; {{ "now"|date("Y") }} wazeBR. Todos os direitos reservados.
                        </p>
                    </div>
                    <div class="col-md-6 text-center text-md-end">
                        <p class="text-muted mb-0">
                            v{{ app.environment == 'dev' ? '1.0.0-dev' : '1.0.0' }}
                        </p>
                    </div>
                </div>
            </div>
        </footer>
        {% endblock %}
    </div>
    
    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Leaflet JS (Maps) -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    
    <!-- App JS -->
    <script type="module" src="{{ asset('js/app.js') }}"></script>
    
    {% block javascripts %}{% endblock %}
</body>
</html>
