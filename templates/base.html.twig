<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('wazebr-theme');
                var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-bs-theme', theme);
            } catch (e) {
                document.documentElement.setAttribute('data-bs-theme', 'light');
            }
        })();
    </script>
    <title>{% block title %}WazeBR{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root, [data-bs-theme="light"] { --sidebar-width:264px; --header-height:60px; --primary-color:#2563eb; --page-bg:#f4f6f9; --surface:#fff; --surface-2:#f8fafc; --text-primary:#111827; --text-secondary:#4b5563; --text-muted:#9ca3af; --border-color:#e5e7eb; --card-shadow:0 2px 8px rgba(15,23,42,.08); --sidebar-bg:#fff; --sidebar-border:#e5e7eb; --sidebar-text:#4b5563; --sidebar-text-active:#111827; --sidebar-hover-bg:#f1f5f9; --sidebar-active-bg:#eef2ff; --sidebar-section-label:#9ca3af; --sidebar-backdrop:rgba(15,23,42,.35); }
        [data-bs-theme="dark"] { --sidebar-width:264px; --header-height:60px; --primary-color:#3b82f6; --page-bg:#0b0e14; --surface:#12161e; --surface-2:#171c25; --text-primary:#f3f4f6; --text-secondary:#9aa4b2; --text-muted:#6b7280; --border-color:#232a35; --card-shadow:0 2px 10px rgba(0,0,0,.4); --sidebar-bg:#0d1119; --sidebar-border:#202733; --sidebar-text:#9aa4b2; --sidebar-text-active:#f3f4f6; --sidebar-hover-bg:#1a212c; --sidebar-active-bg:#16233d; --sidebar-section-label:#5b6472; --sidebar-backdrop:rgba(0,0,0,.55); }
        body { background-color:var(--page-bg); color:var(--text-primary); font-family:'Segoe UI',system-ui,sans-serif; transition:background-color .15s ease,color .15s ease; }
        .sidebar { position:fixed; top:0; left:0; height:100vh; width:var(--sidebar-width); background:var(--sidebar-bg); border-right:1px solid var(--sidebar-border); z-index:1040; transition:transform .25s ease,background-color .15s ease; display:flex; flex-direction:column; }
        .sidebar-brand { padding:18px 20px; font-size:1.3rem; font-weight:700; color:var(--sidebar-text-active); border-bottom:1px solid var(--sidebar-border); flex-shrink:0; }.sidebar-brand i { color:var(--primary-color); }.sidebar-scroll { flex:1 1 auto; overflow-y:auto; padding:10px 0; }.sidebar-section-label { padding:14px 20px 6px; font-size:.68rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--sidebar-section-label); }.sidebar-menu a { display:flex; align-items:center; gap:12px; padding:10px 20px; margin:1px 8px; border-radius:8px; color:var(--sidebar-text); text-decoration:none; font-size:.9rem; transition:background-color .12s ease,color .12s ease; }.sidebar-menu a:hover { background:var(--sidebar-hover-bg); color:var(--sidebar-text-active); }.sidebar-menu a.active { background:var(--sidebar-active-bg); color:var(--primary-color); font-weight:600; }.sidebar-menu a i { width:20px; text-align:center; font-size:1.05rem; flex-shrink:0; }.sidebar-menu a .badge-count { margin-left:auto; }.sidebar-divider { border-top:1px solid var(--sidebar-border); margin:10px 16px; }
        .sidebar-ad { flex-shrink:0; padding:10px 16px 4px; }.sidebar-ad-label { font-size:.62rem; font-weight:700; letter-spacing:.07em; text-transform:uppercase; color:var(--sidebar-section-label); margin-bottom:6px; }.sidebar-ad-slot { min-height:100px; border:1px dashed var(--sidebar-border); border-radius:8px; overflow:hidden; }.sidebar-footer { flex-shrink:0; padding:12px 16px 16px; border-top:1px solid var(--sidebar-border); }.theme-switch { display:flex; align-items:center; gap:6px; background:var(--sidebar-hover-bg); border-radius:999px; padding:3px; }.theme-switch button { flex:1; border:none; background:transparent; color:var(--sidebar-text); font-size:.78rem; padding:6px 0; border-radius:999px; display:flex; align-items:center; justify-content:center; gap:5px; transition:all .15s ease; }.theme-switch button.active { background:var(--surface); color:var(--sidebar-text-active); box-shadow:0 1px 3px rgba(0,0,0,.15); }
        .sidebar-backdrop { display:none; position:fixed; inset:0; background:var(--sidebar-backdrop); z-index:1035; }.sidebar-backdrop.show { display:block; }.main-content { margin-left:var(--sidebar-width); min-height:100vh; }.header { height:var(--header-height); background:var(--surface); border-bottom:1px solid var(--border-color); display:flex; align-items:center; justify-content:space-between; padding:0 24px; position:sticky; top:0; z-index:100; }.header-left,.header-right { display:flex; align-items:center; gap:16px; }.header-right { gap:12px; }.header-title { font-size:1.3rem; font-weight:600; color:var(--text-primary); }.header .btn-link { color:var(--text-secondary); }.user-menu { display:flex; align-items:center; gap:8px; padding:8px 12px; border-radius:999px; background:var(--sidebar-active-bg); cursor:pointer; color:var(--text-primary); }.user-avatar { width:32px; height:32px; border-radius:50%; background:var(--primary-color); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:600; }.content { padding:24px; }.card { border:1px solid var(--border-color); border-radius:12px; box-shadow:var(--card-shadow); margin-bottom:24px; background:var(--surface); }.card-header { background:var(--surface); border-bottom:1px solid var(--border-color); padding:16px 20px; font-weight:600; font-size:.95rem; color:var(--text-primary); }.card-body { padding:20px; }
        .kpi-card { border-radius:12px; padding:20px; margin-bottom:24px; color:#fff; box-shadow:var(--card-shadow); }.kpi-card.primary { background:linear-gradient(135deg,#2563eb 0%,#1d4ed8 100%); }.kpi-card.success { background:linear-gradient(135deg,#16a34a 0%,#15803d 100%); }.kpi-card.warning { background:linear-gradient(135deg,#f59e0b 0%,#d97706 100%); }.kpi-card.danger { background:linear-gradient(135deg,#ef4444 0%,#b91c1c 100%); }.kpi-value { font-size:2rem; font-weight:700; margin:8px 0; }.kpi-label { font-size:.85rem; text-transform:uppercase; letter-spacing:.06em; opacity:.9; }
        .alerts-submenu { display:none; margin:2px 8px 6px 48px; padding:4px; border-left:1px solid var(--sidebar-border); }.alerts-submenu.is-open { display:block; }.alerts-submenu a { margin:1px 0; padding:8px 12px; font-size:.82rem; }.alerts-submenu a.active { background:var(--sidebar-active-bg); color:var(--primary-color); }.alerts-group > .alerts-toggle { justify-content:flex-start; }.alerts-toggle .submenu-chevron { margin-left:auto; font-size:.72rem; transition:transform .18s ease; }.alerts-toggle[aria-expanded="true"] .submenu-chevron { transform:rotate(180deg); }
        @media (max-width:768px) { .sidebar { transform:translateX(-100%); }.sidebar.show { transform:translateX(0); }.main-content { margin-left:0; } }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
{% set r = app.current_route %}
{% set roles = app.user ? app.user.roles : [] %}
{% set isAccountAdmin = 'ROLE_ACCOUNT_ADMIN' in roles or 'ROLE_SUPER_ADMIN' in roles %}
{% set isSuperAdmin = 'ROLE_SUPER_ADMIN' in roles %}
<div class="sidebar-backdrop" id="sidebarBackdrop"></div>
<nav class="sidebar" id="sidebar">
    <div class="sidebar-brand"><i class="bi bi-bar-chart-fill"></i> WazeBR</div>
    <div class="sidebar-scroll"><div class="sidebar-menu">
        <div class="sidebar-section-label">Operação</div>
        <a href="{{ path('dashboard_index') }}" class="{{ r == 'dashboard_index' ? 'active' }}"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
        <div class="alerts-group">
            <a href="{{ path('alert_index') }}" class="alerts-toggle {{ r starts with 'alert_' ? 'active' }}" aria-expanded="{{ r starts with 'alert_' ? 'true' : 'false' }}" aria-controls="alertsSubmenu">
                <i class="bi bi-exclamation-triangle"></i><span>Alertas</span><i class="bi bi-chevron-down submenu-chevron"></i>
            </a>
            <div class="alerts-submenu {{ r starts with 'alert_' ? 'is-open' : '' }}" id="alertsSubmenu">
                <a href="{{ path('alert_index') }}" class="{{ r == 'alert_index' ? 'active' }}"><i class="bi bi-clock-history"></i><span>Histórico</span></a>
                <a href="{{ path('alert_live') }}" class="{{ r == 'alert_live' or r == 'alert_api_live' ? 'active' }}"><i class="bi bi-broadcast-pin"></i><span>Ao vivo</span></a>
                <a href="{{ path('alert_export') }}" class=""><i class="bi bi-filetype-csv"></i><span>Exportar CSV</span></a>
            </div>
        </div>
        <a href="{{ path('jam_index') }}" class="{{ r starts with 'jam_' ? 'active' }}"><i class="bi bi-cone-striped"></i><span>Congestionamentos</span></a>
        <a href="{{ path('route_admin_index') }}" class="{{ r starts with 'route_admin_' ? 'active' }}"><i class="bi bi-signpost-split"></i><span>Rotas</span></a>
        <a href="{{ path('cifs_index') }}" class="{{ r starts with 'cifs_' ? 'active' }}"><i class="bi bi-calendar-event"></i><span>CIFS</span></a>
        <a href="{{ path('cemaden_index') }}" class="{{ r starts with 'cemaden_' ? 'active' }}"><i class="bi bi-droplet"></i><span>Cemaden</span></a>
        <a href="{{ path('hydro_live') }}" class="{{ r starts with 'hydro_' ? 'active' }}"><i class="bi bi-water"></i><span>Hidrológico</span></a>
        <a href="{{ path('operator_live') }}" class="{{ r starts with 'operator_' ? 'active' }}"><i class="bi bi-broadcast"></i><span>Operador ao vivo</span></a>
        <a href="{{ path('notification_index') }}" class="{{ r starts with 'notification_' ? 'active' }}"><i class="bi bi-bell"></i><span>Notificações</span></a>
        <div class="sidebar-divider"></div><div class="sidebar-section-label">Conta</div>
        <a href="{{ path('auth_profile') }}" class="{{ r == 'auth_profile' ? 'active' }}"><i class="bi bi-person"></i><span>Perfil</span></a>
        {% if isAccountAdmin %}<a href="{{ path('account_settings') }}" class="{{ r starts with 'account_settings' ? 'active' }}"><i class="bi bi-gear"></i><span>Configurações</span></a><a href="{{ path('account_user_index') }}" class="{{ r starts with 'account_user_' ? 'active' }}"><i class="bi bi-people"></i><span>Usuários</span></a><a href="{{ path('account_link_index') }}" class="{{ r starts with 'account_link_' ? 'active' }}"><i class="bi bi-link-45deg"></i><span>Links vinculados</span></a><a href="{{ path('account_logs') }}" class="{{ r starts with 'account_logs' ? 'active' }}"><i class="bi bi-clock-history"></i><span>Logs</span></a>{% endif %}
        {% if isSuperAdmin %}<div class="sidebar-divider"></div><div class="sidebar-section-label">Administração</div><a href="{{ path('admin_partner_index') }}" class="{{ r starts with 'admin_partner_' ? 'active' }}"><i class="bi bi-building"></i><span>Partners</span></a>{% endif %}
    </div></div>
    <div class="sidebar-ad"><div class="sidebar-ad-label">Publicidade</div><div class="sidebar-ad-slot"><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-XXXXXXXXXXXXXXXX" data-ad-slot="XXXXXXXXXX" data-ad-format="auto" data-full-width-responsive="true"></ins></div></div>
    <div class="sidebar-footer"><div class="theme-switch" id="themeSwitch"><button type="button" data-theme="light"><i class="bi bi-sun"></i> Claro</button><button type="button" data-theme="dark"><i class="bi bi-moon-stars"></i> Escuro</button></div></div>
</nav>
<div class="main-content"><header class="header"><div class="header-left"><button class="btn btn-link d-md-none" id="sidebarToggle"><i class="bi bi-list" style="font-size:1.5rem;"></i></button><h1 class="header-title mb-0">{% block header_title %}Dashboard{% endblock %}</h1></div><div class="header-right"><div class="dropdown"><button class="btn btn-link" data-bs-toggle="dropdown"><i class="bi bi-bell" style="font-size:1.2rem;"></i></button><ul class="dropdown-menu dropdown-menu-end"><li><h6 class="dropdown-header">Notificações</h6></li><li><a class="dropdown-item" href="{{ path('notification_index') }}">Ver todas</a></li></ul></div><div class="dropdown"><div class="user-menu" data-bs-toggle="dropdown"><div class="user-avatar">{{ app.user.email|first|upper }}</div><span class="d-none d-md-inline">{{ app.user.email }}</span><i class="bi bi-chevron-down ms-2"></i></div><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" href="{{ path('auth_profile') }}"><i class="bi bi-person me-2"></i>Perfil</a></li>{% if isAccountAdmin %}<li><a class="dropdown-item" href="{{ path('account_settings') }}"><i class="bi bi-gear me-2"></i>Configurações</a></li>{% endif %}<li><hr class="dropdown-divider"></li><li><a class="dropdown-item" href="{{ path('auth_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Sair</a></li></ul></div></div></header><div class="content">{% block body %}{% endblock %}</div></div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script><script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script>
<script>
 document.getElementById('sidebarToggle')?.addEventListener('click',function(){document.getElementById('sidebar').classList.toggle('show');document.getElementById('sidebarBackdrop').classList.toggle('show');});document.getElementById('sidebarBackdrop')?.addEventListener('click',function(){document.getElementById('sidebar').classList.remove('show');this.classList.remove('show');});
 (function(){var switchEl=document.getElementById('themeSwitch');if(!switchEl)return;function applyActiveButton(theme){switchEl.querySelectorAll('button').forEach(function(btn){btn.classList.toggle('active',btn.dataset.theme===theme);});}applyActiveButton(document.documentElement.getAttribute('data-bs-theme')||'light');switchEl.addEventListener('click',function(e){var btn=e.target.closest('button[data-theme]');if(!btn)return;var theme=btn.dataset.theme;document.documentElement.setAttribute('data-bs-theme',theme);try{localStorage.setItem('wazebr-theme',theme);}catch(e){}applyActiveButton(theme);});})();
 (function(){var alertToggle=document.querySelector('.alerts-toggle');var submenu=document.getElementById('alertsSubmenu');if(!alertToggle||!submenu)return;alertToggle.addEventListener('click',function(e){if(window.matchMedia('(max-width:768px)').matches){e.preventDefault();}var open=alertToggle.getAttribute('aria-expanded')==='true';alertToggle.setAttribute('aria-expanded',String(!open));submenu.classList.toggle('is-open',!open);});})();
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
