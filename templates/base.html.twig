<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}wazeBR{% endblock %}</title>
    <link rel="icon" href="{{ asset('favicon.ico') }}">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/layout.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/navbar.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
{% if app.user %}
    <div class="app-shell">
        <div class="sidebar-overlay" data-sidebar-overlay></div>


        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <a href="{{ path('dashboard_index') }}" class="sidebar-brand">
                    <span class="sidebar-brand-mark" aria-hidden="true">⌁</span>
                    <span class="sidebar-brand-text">wazeBR</span>
                </a>
                <button type="button" class="sidebar-toggle" data-sidebar-toggle aria-label="Recolher menu">
                    <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"/>
                    </svg>
                </button>
            </div>


            {% if app.user.partner is defined and app.user.partner %}
                <div class="sidebar-partner">
                    Parceiro
                    <strong>{{ app.user.partner.name }}</strong>
                </div>
            {% endif %}


            <nav class="sidebar-nav">
                {{ include('partials/_navbar_menu.html.twig') }}
            </nav>


            {% if app.user %}
                <div class="sidebar-user" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="sidebar-user-avatar">
                        {{ app.user.firstName|default(app.user.email|split('@')|first)|first|upper }}
                    </div>
                    <div class="sidebar-user-info">
                        <div class="sidebar-user-name">
                            {{ app.user.firstName|default(app.user.email|split('@')|first) }}
                        </div>
                        <div class="sidebar-user-role">
                            {{ app.user.roles|first|replace({'ROLE_': ''})|title }}
                        </div>
                    </div>
                </div>
            {% else %}
                {# Opcional: mostrar algo quando não estiver logado, ou nada #}
            {% endif %}
        </aside>


        <div class="main-content">
            <header class="topbar">
                <div class="topbar-left">
                    <button type="button" class="mobile-sidebar-toggle" data-sidebar-mobile-toggle aria-label="Abrir menu">
                        <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"/>
                        </svg>
                    </button>
                    <h1 class="header-title">{% block header_title %}{% endblock %}</h1>
                </div>
                {% if app.user %}
                    <div class="sidebar-user" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="sidebar-user-avatar">
                            {{ app.user.firstName|default(app.user.email|split('@')|first)|first|upper }}
                        </div>
                        <div class="sidebar-user-info">
                            <div class="sidebar-user-name">
                                {{ app.user.firstName|default(app.user.email|split('@')|first) }}
                            </div>
                            <div class="sidebar-user-role">
                                {{ app.user.roles|first|replace({'ROLE_': ''})|title }}
                            </div>
                        </div>
                    </div>
                {% else %}
                    {# Opcional: mostrar algo quando não estiver logado, ou nada #}
                {% endif %}
            </header>


            {% if app.flashes|length > 0 %}
                <div class="flash-stack">
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="flash flash-{{ label }}" role="status">
                                <span>{{ message }}</span>
                                <button type="button" class="flash-close" data-flash-close aria-label="Fechar">&times;</button>
                            </div>
                        {% endfor %}
                    {% endfor %}
                </div>
            {% endif %}


            <main class="content-area">
                {% block body %}{% endblock %}
            </main>


            <footer class="footer">
                <span>&copy; {{ "now"|date('Y') }} wazeBR - Monitoramento de tráfego e hidrologia</span>
                <div class="footer-links">
                    <a href="#" class="footer-link">Suporte</a>
                    <a href="#" class="footer-link">Termos</a>
                    <a href="#" class="footer-link">Privacidade</a>
                </div>
            </footer>
        </div>
    </div>
{% else %}
    {# Visitante sem sessão: layout simples, sem sidebar #}
    <div class="layout-public">
        <header class="topbar">
            <a href="{{ path('app_home') }}" class="sidebar-brand" style="color: var(--text-primary);">
                <span class="sidebar-brand-mark" aria-hidden="true">⌁</span>
                <span class="sidebar-brand-text">wazeBR</span>
            </a>
            <a href="{{ path('app_login') }}" class="btn btn-primary">Entrar</a>
        </header>


        {% if app.flashes|length > 0 %}
            <div class="flash-stack">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="flash flash-{{ label }}" role="status">
                            <span>{{ message }}</span>
                            <button type="button" class="flash-close" data-flash-close aria-label="Fechar">&times;</button>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}


        <main class="content-area">
            {{ block('body') }}
        </main>


        <footer class="footer">
            <span>&copy; {{ "now"|date('Y') }} wazeBR - Monitoramento de tráfego e hidrologia</span>
        </footer>
    </div>
{% endif %}


<script src="{{ asset('js/main.js') }}"></script>
<script src="{{ asset('js/navbar.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
