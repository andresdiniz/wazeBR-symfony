{% extends 'base.html.twig' %}
{% block title %}Histórico — {{ latest.name ?? wazeRouteId }}{% endblock %}

{% set jsFromName = (latest.fromName ?? 'Início')|json_encode %}
{% set jsToName   = (latest.toName   ?? 'Fim')|json_encode %}
{% set jsJamLevel = latest.jamLevel ?? 0 %}
{% set jsLine     = latest.line is not null ? latest.line|json_encode : 'null' %}
{% set jsHistory  = history|map(r => {
  t:    r.snapshot.collectedAt|date('c'),
  time: r.time,
  hist: r.historicTime,
  jam:  r.jamLevel,
  delay: r.delaySeconds
})|json_encode %}
{% set jsByJam    = byJamLevel|json_encode %}
{% set jsHourly   = hourlyProfile|json_encode %}
{% set jsJamColors= jamColors|json_encode %}

{% block stylesheets %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" crossorigin=""/>
<link rel="stylesheet" href="{{ asset('styles/history.css') }}?v={{ 'now'|date('U') }}">
<style>
  .page-header .page-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .page-header .page-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .custom-tooltip .leaflet-tooltip-content {
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 4px 12px;
    box-shadow: var(--shadow-sm);
  }
  .leaflet-tooltip-top::before {
    border-top-color: var(--color-border);
  }
  .kpi-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); }
  .kpi-sazonal {
    grid-column: span 2;
    background: var(--color-surface-offset) !important;
    border: 2px solid var(--color-primary) !important;
  }
  @media (max-width: 768px) {
    .kpi-sazonal { grid-column: span 1; }
  }
</style>
{% endblock %}

{% block body %}
<div id="js-data"
  data-history="{{ jsHistory|e('html_attr') }}"
  data-line="{{ jsLine|e('html_attr') }}"
  data-jam-level="{{ jsJamLevel }}"
  data-from="{{ jsFromName|e('html_attr') }}"
  data-to="{{ jsToName|e('html_attr') }}"
  data-by-jam="{{ jsByJam|e('html_attr') }}"
  data-hourly="{{ jsHourly|e('html_attr') }}"
  data-jam-colors="{{ jsJamColors|e('html_attr') }}"
  style="display:none"
></div>

<div class="history-page">
  {# Header #}
  <div class="history-header">
    <div class="history-header-left">
      <a href="{{ path('route_admin_index') }}" class="back-btn" title="Voltar">
        <i class="bi bi-arrow-left"></i>
      </a>
      <div>
        <h1>{{ latest.name ?? 'Rota' }}</h1>
        <div class="subtitle">
          {{ latest.fromName ?? '' }}{% if latest.fromName and latest.toName %} → {% endif %}{{ latest.toName ?? '' }}
          &mdash;
          {% if dateFrom and dateTo %}{{ dateFrom|date('d/m/Y') }} a {{ dateTo|date('d/m/Y') }}{% else %}todo o período{% endif %}
          &mdash;
          {{ totalInRange|number_format(0, ',', '.') }} registro(s)
        </div>
      </div>
    </div>
    <div class="history-header-right">
      <a href="{{ path('route_admin_history_export', {wazeRouteId: wazeRouteId}) }}?{{ app.request.query.all|merge({limit: null})|url_encode }}"
         class="btn btn-primary btn-sm" target="_blank" rel="noopener">
        <i class="bi bi-download me-1"></i>Exportar CSV
      </a>
    </div>
  </div>

  {# Períodos #}
  <div class="period-row">
    <a href="?{{ app.request.query.all|merge({period: 'last8h', dateFrom: null, dateTo: null})|url_encode }}"
       class="btn {{ period == 'last8h' ? 'btn-primary' : 'btn-outline-secondary' }}">Últimas 8h</a>
    {% for key, p in periods %}
      <a href="?{{ app.request.query.all|merge({period: key, dateFrom: null, dateTo: null})|url_encode }}"
         class="btn {{ period == key ? 'btn-primary' : 'btn-outline-secondary' }}">{{ p.label }}</a>
    {% endfor %}
    <a href="?{{ app.request.query.all|merge({period: 'all', dateFrom: null, dateTo: null})|url_encode }}"
       class="btn {{ period == 'all' ? 'btn-primary' : 'btn-outline-secondary' }}">Tudo</a>
  </div>

  {# Filtros #}
  <div class="filter-card">
    <form method="get" class="form-row">
      <div class="form-group">
        <label class="form-label">De</label>
        <input type="date" name="dateFrom" class="form-control" value="{{ dateFrom }}">
      </div>
      <div class="form-group">
        <label class="form-label">Até</label>
        <input type="date" name="dateTo" class="form-control" value="{{ dateTo }}">
      </div>
      <div class="form-group">
        <label class="form-label">Congestionamento mínimo</label>
        <select name="minJam" class="form-select">
          <option value="">Qualquer</option>
          <option value="1" {{ minJam == 1 ? 'selected' : '' }}>Lento ou pior</option>
          <option value="2" {{ minJam == 2 ? 'selected' : '' }}>Moderado ou pior</option>
          <option value="3" {{ minJam == 3 ? 'selected' : '' }}>Pesado ou pior</option>
          <option value="4" {{ minJam == 4 ? 'selected' : '' }}>Muito pesado ou pior</option>
          <option value="5" {{ minJam == 5 ? 'selected' : '' }}>Parado</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Registros</label>
        <select name="limit" class="form-select">
          {% for opt in [15, 30, 50, 100, 200] %}
            <option value="{{ opt }}" {{ limit == opt ? 'selected' : '' }}>{{ opt }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="filter-actions">
        <button type="submit" class="btn btn-primary btn-sm">Filtrar</button>
        <a href="{{ path('route_admin_history', {wazeRouteId: wazeRouteId}) }}" class="btn btn-outline-secondary btn-sm">Limpar</a>
      </div>
      <div class="form-hint">
        Datas consideram o fuso de Brasília. O mapa de calor e a distribuição usam <strong>todo o período filtrado</strong>;
        o limite afeta apenas a tabela e o gráfico de evolução.
      </div>
    </form>
  </div>

  {# ─── KPIs sazonais ─── #}
  <div class="kpi-grid">
    <div class="kpi-card kpi-sazonal">
      <div class="kpi-label" style="font-size: var(--text-sm);">
        📊 Média dos últimos 7 dias para o horário <strong>{{ '%02d:00'|format(kpis.sazonal.hour) }}</strong>
        <span style="font-weight: normal; font-size: var(--text-xs); color: var(--color-text-muted);">({{ kpis.sazonal.sampleCount }} registros)</span>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: var(--space-4); justify-content: center; margin-top: var(--space-2);">
        <div>
          <span style="font-size: var(--text-xs); color: var(--color-text-muted);">Tempo atual</span>
          <div style="font-size: var(--text-xl); font-weight: 700;">{{ kpis.sazonal.currentTime ?? '—' }} min</div>
        </div>
        <div>
          <span style="font-size: var(--text-xs); color: var(--color-text-muted);">Média 7d (mesmo horário)</span>
          <div style="font-size: var(--text-xl); font-weight: 700;">{{ kpis.sazonal.avgTime ?? '—' }} min</div>
        </div>
        <div>
          <span style="font-size: var(--text-xs); color: var(--color-text-muted);">Diferença</span>
          <div style="font-size: var(--text-xl); font-weight: 700; {% if kpis.sazonal.delayVsAvg > 0 %}color: var(--color-error);{% elseif kpis.sazonal.delayVsAvg < 0 %}color: var(--color-success);{% else %}color: var(--color-text-muted);{% endif %}">
            {% if kpis.sazonal.delayVsAvg is not null %}
              {{ kpis.sazonal.delayVsAvg > 0 ? '+' : '' }}{{ kpis.sazonal.delayVsAvg }} min
            {% else %}—{% endif %}
          </div>
        </div>
        <div>
          <span style="font-size: var(--text-xs); color: var(--color-text-muted);">🏔️ Horário de pico</span>
          <div style="font-size: var(--text-base); font-weight: 600;">{{ kpis.sazonal.peakHour ?? '—' }}</div>
          <span style="font-size: var(--text-xs); color: var(--color-text-muted);">média {{ kpis.sazonal.peakAvg ?? '—' }} min</span>
        </div>
        <div>
          <span style="font-size: var(--text-xs); color: var(--color-text-muted);">🌿 Melhor horário</span>
          <div style="font-size: var(--text-base); font-weight: 600;">{{ kpis.sazonal.bestHour ?? '—' }}</div>
          <span style="font-size: var(--text-xs); color: var(--color-text-muted);">média {{ kpis.sazonal.bestAvg ?? '—' }} min</span>
        </div>
      </div>
    </div>
  </div>

  {# ─── KPIs gerais ─── #}
  <div class="kpi-grid">
    <div class="kpi-card">
      <div class="kpi-icon" style="background:oklch(from var(--color-primary) l c h/.1);color:var(--color-primary)">📊</div>
      <div class="kpi-label">Registros</div>
      <div class="kpi-value">{{ kpis.total|number_format(0, ',', '.') }}</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon" style="background:oklch(from var(--color-success) l c h/.1);color:var(--color-success)">⏱️</div>
      <div class="kpi-label">Tempo médio</div>
      <div class="kpi-value">{{ kpis.avgTime ?? '—' }} min</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon" style="background:oklch(from var(--color-orange) l c h/.1);color:var(--color-orange)">📈</div>
      <div class="kpi-label">Máximo</div>
      <div class="kpi-value">{{ kpis.maxTime ?? '—' }} min</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon" style="background:oklch(from var(--color-teal) l c h/.1);color:var(--color-teal)">📉</div>
      <div class="kpi-label">Mínimo</div>
      <div class="kpi-value">{{ kpis.minTime ?? '—' }} min</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon" style="background:oklch(from var(--color-error) l c h/.1);color:var(--color-error)">🐢</div>
      <div class="kpi-label">Atraso médio</div>
      <div class="kpi-value">{{ kpis.avgDelay ?? '—' }} min</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon" style="background:oklch(from var(--color-error) l c h/.1);color:var(--color-error)">🐌</div>
      <div class="kpi-label">Maior atraso</div>
      <div class="kpi-value">{{ kpis.maxDelay ?? '—' }} min</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon" style="background:oklch(from var(--color-success) l c h/.1);color:var(--color-success)">✅</div>
      <div class="kpi-label">No tempo (%)</div>
      <div class="kpi-value">{{ kpis.pctOnTime ?? '—' }}%</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon" style="background:oklch(from var(--color-gold) l c h/.1);color:var(--color-gold)">📌</div>
      <div class="kpi-label">Jam atual</div>
      <div class="kpi-value"><span class="badge jam-{{ latest.jamLevel ?? 0 }}">{{ latest.jamLevelLabel }}</span></div>
    </div>
  </div>

  {% if totalInRange == 0 %}
    <div class="card">
      <div class="empty-state-inline">
        <i class="bi bi-inbox"></i>
        <h3>Nenhum registro no período</h3>
        <p>Ajuste os filtros acima para visualizar os dados.</p>
      </div>
    </div>
  {% else %}

  <div class="viz-grid">
    <div class="card">
      <div class="card-header"><span class="card-title"><i class="bi bi-graph-up-arrow"></i> Evolução temporal</span></div>
      <div class="card-body"><div class="chart-wrap lg"><canvas id="chart-history"></canvas></div></div>
    </div>
    <div class="card">
      <div class="card-header"><span class="card-title"><i class="bi bi-geo-alt"></i> Trajeto da rota</span></div>
      <div class="card-body"><div id="history-map"></div></div>
    </div>
  </div>

  <div class="grid-2">
    <div class="card">
      <div class="card-header"><span class="card-title"><i class="bi bi-pie-chart"></i> Distribuição de congestionamento</span></div>
      <div class="card-body"><div class="chart-wrap sm"><canvas id="chart-byjam"></canvas></div></div>
    </div>
    <div class="card">
      <div class="card-header"><span class="card-title"><i class="bi bi-clock-history"></i> Perfil típico do dia (2h)</span></div>
      <div class="card-body"><div class="chart-wrap sm"><canvas id="chart-hourly"></canvas></div></div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <span class="card-title"><i class="bi bi-calendar-heat"></i> Mapa de calor — dia da semana × horário</span>
      <span class="form-hint">Cor = congestionamento médio · número = atraso médio (min)</span>
    </div>
    <div class="card-body heatmap-scroll">
      <div class="heatmap-grid">
        <div class="heatmap-cell heatmap-corner"></div>
        {% for bucket in range(0, 22, 2) %}
          <div class="heatmap-cell heatmap-col-label">{{ '%02d'|format(bucket) }}h</div>
        {% endfor %}

        {% for wd in range(1, 7) %}
          <div class="heatmap-cell heatmap-row-label">{{ weekdayLabels[wd] }}</div>
          {% for bucket in range(0, 22, 2) %}
            {% set cell = heatmap[wd][bucket] %}
            <div class="heatmap-cell heatmap-data {{ cell is null ? 'is-empty' : '' }}"
              {% if cell %}
                style="background:{{ cell.color }}"
                title="{{ weekdayLabelsFull[wd] ?? '' }} {{ '%02d'|format(bucket) }}–{{ '%02d'|format(bucket + 2) }}h · {{ cell.total }} registros · tempo médio {{ cell.avgTimeMin }} min · atraso médio {{ cell.avgDelayMin }} min"
              {% else %}
                title="Sem registros nesta faixa"
              {% endif %}>
              {% if cell %}{{ cell.avgDelayMin > 0 ? '+' : '' }}{{ cell.avgDelayMin }}{% endif %}
            </div>
          {% endfor %}
        {% endfor %}
      </div>
      <div class="heatmap-legend">
        <span>Fluindo</span>
        {% for c in jamColors %}<span class="heatmap-legend-swatch" style="background:{{ c }}"></span>{% endfor %}
        <span>Parado</span>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><span class="card-title"><i class="bi bi-table"></i> Registros</span></div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Coletado em</th>
            <th>Jam</th>
            <th style="text-align:right">Atual (min)</th>
            <th style="text-align:right">Atraso</th>
          </tr>
        </thead>
        <tbody>
        {% for r in history %}
          {% set delay = r.delaySeconds %}
          <tr>
            <td style="font-variant-numeric:tabular-nums;font-size:var(--text-xs)">
              <time data-utc="{{ r.snapshot.collectedAt|date('c') }}" data-fmt="datetime">{{ r.snapshot.collectedAt|date('d/m/Y H:i') }}</time>
            </td>
            <td><span class="badge jam-{{ r.jamLevel ?? 0 }}">{{ r.jamLevelLabel }}</span></td>
            <td style="text-align:right;font-variant-numeric:tabular-nums">
              {% if r.time is not null %}{{ (r.time/60)|round(1) }}{% else %}—{% endif %}
            </td>
            <td style="text-align:right;font-variant-numeric:tabular-nums" class="{% if delay is not null %}{% if delay > 0 %}delay-pos{% elseif delay < 0 %}delay-neg{% else %}delay-zero{% endif %}{% endif %}">
              {% if delay is null %}—
              {% elseif delay == 0 %}0s
              {% elseif delay > 0 %}+{{ delay < 60 ? delay ~ 's' : (delay/60)|round(1) ~ ' min' }}
              {% else %}{{ delay < -60 ? (delay/60)|round(1) ~ ' min' : delay ~ 's' }}{% endif %}
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js" crossorigin=""></script>
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script src="{{ asset('js/history.js') }}?v={{ 'now'|date('U') }}"></script>
{% endblock %}
