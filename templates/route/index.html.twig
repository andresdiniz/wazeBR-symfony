{% extends 'base.html.twig' %}

{% block title %}Rotas TVT{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin=""/>
<style>
  /* ── Tema completo (mesmo de antes) ── */
  :root, [data-bs-theme="light"] {
    --color-primary: var(--primary-color, #01696f);
    --color-border: var(--border-color, #e2e8f0);
    --color-text: var(--text-primary, #0a0a0a);
    --color-text-muted: var(--text-secondary, #64748b);
    --color-text-faint: var(--text-muted, #94a3b8);
    --color-surface: var(--surface, #ffffff);
    --color-surface-offset: #f1f5f9;
    --color-success: #16a34a;
    --color-gold: #ca8a04;
    --color-orange: #ea580c;
    --color-error: #dc2626;
    --space-1:4px; --space-2:8px; --space-3:12px; --space-4:16px; --space-5:20px; --space-6:24px; --space-8:32px;
    --radius-md:8px; --radius-lg:12px; --radius-full:9999px;
    --shadow-sm:0 1px 3px rgba(0,0,0,0.06);
    --shadow-md:0 4px 12px rgba(0,0,0,0.08);
    --shadow-lg:0 8px 24px rgba(15,23,42,.12);
    --font-body:'Segoe UI', system-ui, sans-serif;
    --font-display:'Segoe UI', system-ui, sans-serif;
    --text-xs:.72rem; --text-sm:.82rem; --text-base:.95rem; --text-lg:1.1rem; --text-xl:1.3rem; --text-2xl:1.6rem;
    --transition:0.2s ease;
  }
  [data-bs-theme="dark"] {
    --color-primary: var(--primary-color, #2d9b9f);
    --color-border: var(--border-color, #2d3748);
    --color-text: var(--text-primary, #f1f5f9);
    --color-text-muted: var(--text-secondary, #94a3b8);
    --color-text-faint: var(--text-muted, #64748b);
    --color-surface: var(--surface, #1a202c);
    --color-surface-offset: #171c25;
    --color-success: #22c55e;
    --color-gold: #eab308;
    --color-orange: #f97316;
    --color-error: #ef4444;
    --shadow-sm:0 1px 3px rgba(0,0,0,0.3);
    --shadow-md:0 4px 12px rgba(0,0,0,0.4);
    --shadow-lg:0 10px 28px rgba(0,0,0,.5);
  }

  .jam-0{background:oklch(from var(--color-success) l c h/.12);color:var(--color-success)}
  .jam-1{background:oklch(from var(--color-gold) l c h/.12);color:var(--color-gold)}
  .jam-2{background:oklch(from var(--color-orange) l c h/.15);color:var(--color-orange)}
  .jam-3{background:oklch(from var(--color-error) l c h/.12);color:var(--color-error)}
  .jam-4{background:oklch(from var(--color-error) l c h/.2);color:var(--color-error)}
  .jam-5{background:var(--color-error);color:#fff}
  .level-bar{display:flex;height:8px;border-radius:var(--radius-full);overflow:hidden;gap:2px;margin-top:var(--space-3)}
  .level-seg{height:100%;border-radius:2px;transition:width .6s ease}
  .ls-0{background:var(--color-success)}
  .ls-1{background:var(--color-gold)}
  .ls-2{background:var(--color-orange)}
  .ls-3,.ls-4,.ls-5{background:var(--color-error)}
  #tvt-map{height:480px;border-radius:var(--radius-lg);z-index:1;border:1px solid var(--color-border);background:var(--color-surface-offset)}
  .chip-group{display:flex;flex-wrap:wrap;gap:var(--space-2)}
  .chip{display:inline-flex;align-items:center;gap:4px;padding:6px 16px;border-radius:var(--radius-full);font-size:var(--text-xs);font-weight:600;border:1px solid var(--color-border);color:var(--color-text-muted);background:var(--color-surface);transition:all var(--transition);cursor:pointer;text-decoration:none}
  .chip:hover{background:var(--color-surface-offset);color:var(--color-text);transform:translateY(-1px);box-shadow:var(--shadow-sm)}
  .chip.active{background:var(--color-primary);color:#fff;border-color:var(--color-primary);box-shadow:0 2px 8px rgba(var(--color-primary-rgb,0,0,0),0.25)}
  .delay-pos{color:var(--color-error);font-weight:600}
  .delay-neg{color:var(--color-success);font-weight:600}
  .delay-zero{color:var(--color-text-faint)}
  tr.row-selected td{background:oklch(from var(--color-primary) l c h/.08)}
  tr.route-row{cursor:pointer;transition:background 0.15s ease}
  tr.route-row:hover td{background:var(--color-surface-offset)}
  .action-btn{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:var(--radius-md);border:1px solid var(--color-border);background:transparent;color:var(--color-text-muted);transition:all var(--transition);text-decoration:none}
  .action-btn:hover{background:var(--color-primary);color:#fff;border-color:var(--color-primary);transform:scale(1.05)}
  .action-btn .lucide{width:14px;height:14px}
  .action-btn.history:hover{background:#a12c7b;border-color:#a12c7b}
  .kpi-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:var(--space-4);margin-bottom:var(--space-6)}
  .kpi-card{background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:var(--space-4);text-align:center;box-shadow:var(--shadow-sm);transition:all var(--transition)}
  .kpi-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-md)}
  .kpi-icon{display:inline-flex;padding:var(--space-2);border-radius:var(--radius-full);margin-bottom:var(--space-2)}
  .kpi-icon .lucide{width:22px;height:22px}
  .kpi-label{font-size:var(--text-xs);color:var(--color-text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.03em}
  .kpi-value{font-family:var(--font-display);font-size:var(--text-xl);font-weight:700;margin-top:var(--space-1)}
  .card{background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden}
  .card-header{display:flex;align-items:center;justify-content:space-between;padding:var(--space-3) var(--space-5);border-bottom:1px solid var(--color-border);background:var(--color-surface-offset);flex-wrap:wrap;gap:var(--space-2)}
  .card-title{font-weight:600;font-size:var(--text-base);display:flex;align-items:center;gap:var(--space-2)}
  .page-header{display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:var(--space-4);margin-bottom:var(--space-5)}
  .page-title{font-family:var(--font-display);font-size:var(--text-2xl);font-weight:700;letter-spacing:-0.02em;margin:0}
  .page-subtitle{font-size:var(--text-sm);color:var(--color-text-muted);margin-top:2px}
  .btn{display:inline-flex;align-items:center;gap:6px;padding:0.45rem 1rem;border-radius:var(--radius-md);font-size:var(--text-sm);font-weight:600;border:1px solid transparent;transition:all var(--transition);cursor:pointer;text-decoration:none}
  .btn-sm{font-size:var(--text-xs);padding:0.25rem 0.75rem}
  .btn-primary{background:var(--color-primary);color:#fff;border-color:var(--color-primary)}
  .btn-primary:hover{opacity:0.85;transform:translateY(-1px);box-shadow:0 2px 8px rgba(var(--color-primary-rgb,0,0,0),0.2)}
  .btn-ghost{background:transparent;border:1px solid var(--color-border);color:var(--color-text-muted)}
  .btn-ghost:hover{background:var(--color-surface-offset);color:var(--color-text);border-color:var(--color-text-muted)}
  .badge{display:inline-block;padding:0.2rem 0.7rem;border-radius:var(--radius-full);font-weight:600;font-size:var(--text-xs)}
  .badge-gray{background:var(--color-text-faint);color:#fff}
  .badge-green{background:var(--color-success);color:#fff}
  .badge-yellow{background:var(--color-gold);color:#fff}
  .badge-orange{background:var(--color-orange);color:#fff}
  .badge-red{background:var(--color-error);color:#fff}
  .empty{padding:var(--space-8);text-align:center;color:var(--color-text-muted)}
  .empty .lucide{color:var(--color-text-faint);margin-bottom:var(--space-3)}
  .empty h3{margin:0 0 var(--space-2);font-size:var(--text-lg);font-weight:600}
  .table-wrap{overflow-x:auto}
  table{width:100%;border-collapse:collapse;font-size:var(--text-sm)}
  th{background:var(--color-surface-offset);padding:var(--space-3) var(--space-4);text-align:left;font-weight:600;color:var(--color-text-muted);border-bottom:2px solid var(--color-border);white-space:nowrap}
  td{padding:var(--space-3) var(--space-4);border-bottom:1px solid var(--color-border);vertical-align:middle}
  .text-right{text-align:right}
  @media(max-width:768px){.page-header{flex-direction:column;align-items:stretch}.page-header .btn{width:100%;justify-content:center}.kpi-grid{grid-template-columns:1fr 1fr}#tvt-map{height:320px}.card-header{flex-direction:column;align-items:stretch}}
  @media(max-width:480px){.kpi-grid{grid-template-columns:1fr}.chip-group .chip{flex:1;justify-content:center}}
</style>
{% endblock %}

{% block body %}
<div class="page-header">
  <div>
    <div class="page-title">🗺️ Rotas TVT</div>
    <div class="page-subtitle">
      Snapshot mais recente
      {% if lastSnapshot %}
        &mdash; coletado <time data-utc="{{ lastSnapshot.collectedAt|date('c') }}" data-fmt="relative">{{ lastSnapshot.collectedAt|date('d/m/Y H:i') }}</time>
      {% else %}
        &mdash; nenhum snapshot encontrado
      {% endif %}
    </div>
  </div>
  <div style="display:flex;gap:var(--space-2);flex-wrap:wrap">
    <a href="{{ path('route_admin_index') }}" class="btn btn-ghost btn-sm" id="btn-refresh">
      <i data-lucide="refresh-cw" style="width:14px;height:14px" id="refresh-icon"></i> Atualizar
    </a>
  </div>
</div>

{# ── KPIs ── #}
<div class="kpi-grid">
  <div class="kpi-card">
    <div class="kpi-icon" style="background:oklch(from var(--color-primary) l c h/.1);color:var(--color-primary)">
      <i data-lucide="route"></i>
    </div>
    <div class="kpi-label">Total de Rotas</div>
    <div class="kpi-value" id="kpi-total">{{ kpi.total }}</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-icon" style="background:oklch(from var(--color-error) l c h/.1);color:var(--color-error)">
      <i data-lucide="traffic-cone"></i>
    </div>
    <div class="kpi-label">Congestionadas (≥3)</div>
    <div class="kpi-value" id="kpi-congested">{{ kpi.congested }}</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-icon" style="background:oklch(from var(--color-success) l c h/.1);color:var(--color-success)">
      <i data-lucide="check-circle"></i>
    </div>
    <div class="kpi-label">Livres (nível 0)</div>
    <div class="kpi-value" id="kpi-free">{{ kpi.levels[0] ?? 0 }}</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-icon" style="background:oklch(from var(--color-gold) l c h/.1);color:var(--color-gold)">
      <i data-lucide="clock"></i>
    </div>
    <div class="kpi-label">Atraso Médio</div>
    <div class="kpi-value" id="kpi-avg-delay">
      {% if kpi.avgDelaySec == 0 %}&mdash;
      {% elseif kpi.avgDelaySec < 60 %}{{ kpi.avgDelaySec }}s
      {% else %}{{ (kpi.avgDelaySec / 60)|round(1) }} min
      {% endif %}
    </div>
  </div>
  <div class="kpi-card" style="grid-column:span 2">
    <div class="kpi-label">Distribuição por Nível de Jam</div>
    <div style="display:flex;flex-wrap:wrap;gap:var(--space-3);margin-top:var(--space-2);font-size:var(--text-xs);justify-content:center">
      {% set labels = {0:'Livre',1:'Lento',2:'Moderado',3:'Pesado',4:'Muito pesado',5:'Parado'} %}
      {% for lv, cnt in kpi.levels %}
        <span class="badge jam-{{ lv }}">{{ labels[lv] }}: {{ cnt }}</span>
      {% endfor %}
    </div>
    {% if kpi.total > 0 %}
    <div class="level-bar">
      {% for lv, cnt in kpi.levels %}
        {% if cnt > 0 %}
          <div class="level-seg ls-{{ lv }}" style="width:{{ (cnt / kpi.total * 100)|round(1) }}%" title="Nível {{ lv }}: {{ cnt }} ({{ (cnt / kpi.total * 100)|round(1) }}%)"></div>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </div>
</div>

{# ── Mapa ── #}
<div class="card" style="margin-bottom:var(--space-6)">
  <div class="card-header">
    <span class="card-title"><i data-lucide="map" style="width:16px;height:16px"></i> Mapa de Rotas</span>
    <span style="font-size:var(--text-xs);color:var(--color-text-muted)">Clique numa rota no mapa ou na tabela para destacar</span>
  </div>
  <div style="padding:var(--space-4)">
    <div id="tvt-map"></div>
  </div>
</div>

{# ── Filtros ── #}
<div style="margin-bottom:var(--space-4);display:flex;align-items:center;gap:var(--space-4);flex-wrap:wrap">
  <div class="chip-group" id="filter-chips">
    <a href="{{ path('route_admin_index') }}" class="chip {{ jamFilter is null or jamFilter == '' ? 'active' }}" data-jam="">Todos</a>
    <a href="{{ path('route_admin_index', {jam: 0}) }}" class="chip {{ jamFilter == '0' ? 'active' }}" data-jam="0">🟢 Livre</a>
    <a href="{{ path('route_admin_index', {jam: 1}) }}" class="chip {{ jamFilter == '1' ? 'active' }}" data-jam="1">🟡 Lento</a>
    <a href="{{ path('route_admin_index', {jam: 2}) }}" class="chip {{ jamFilter == '2' ? 'active' }}" data-jam="2">🟠 Moderado</a>
    <a href="{{ path('route_admin_index', {jam: 3}) }}" class="chip {{ jamFilter == '3' ? 'active' }}" data-jam="3">🔴 Pesado</a>
    <a href="{{ path('route_admin_index', {jam: 4}) }}" class="chip {{ jamFilter == '4' ? 'active' }}" data-jam="4">🔴 Muito Pesado</a>
    <a href="{{ path('route_admin_index', {jam: 5}) }}" class="chip {{ jamFilter == '5' ? 'active' }}" data-jam="5">⛔ Parado</a>
  </div>
  <span style="font-size:var(--text-xs);color:var(--color-text-muted)">{{ routes|length }} rota(s) encontrada(s)</span>
</div>

{# ── Tabela ── #}
{% if routes is empty %}
  <div class="card">
    <div class="empty">
      <i data-lucide="route" style="width:40px;height:40px;display:block;margin:0 auto var(--space-3)"></i>
      <h3>Nenhuma rota encontrada</h3>
      <p>Aguarde a próxima coleta do feed TVT ou remova os filtros.</p>
    </div>
  </div>
{% else %}
<div class="card">
  <div class="card-header">
    <span class="card-title"><i data-lucide="list" style="width:16px;height:16px"></i> Rotas do Snapshot</span>
    <span style="font-size:var(--text-xs);color:var(--color-text-muted)">Clique na linha para centralizar no mapa</span>
  </div>
  <div class="table-wrap">
    <table id="routes-table">
      <thead>
        <tr>
          <th>Nome</th>
          <th>Origem → Destino</th>
          <th>Jam</th>
          <th class="text-right">Ext. (m)</th>
          <th class="text-right">Atual</th>
          <th class="text-right">Histórico</th>
          <th class="text-right">Atraso</th>
          <th>Tipo</th>
          <th>ID Waze</th>
          <th style="width:70px" class="text-center">Ações</th>
        </tr>
      </thead>
      <tbody>
      {% for r in routes %}
        {% set delay = r.delaySeconds %}
        <tr class="route-row" data-waze-id="{{ r.wazeRouteId }}" data-route-id="{{ r.id }}">
          <td style="font-weight:500;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="{{ r.name }}">{{ r.name ?? '&mdash;' }}</td>
          <td style="font-size:var(--text-xs);color:var(--color-text-muted);max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="{{ r.fromName }} → {{ r.toName }}">
            {{ r.fromName ?? '&mdash;' }} → {{ r.toName ?? '&mdash;' }}
          </td>
          <td><span class="badge jam-{{ r.jamLevel ?? 0 }}">{{ r.jamLevelLabel }}</span></td>
          <td class="text-right">{{ r.length ?? '&mdash;' }}</td>
          <td class="text-right">
            {% if r.time is not null %}
              {% if r.time < 60 %}{{ r.time }}s{% else %}{{ (r.time / 60)|round(1) }} min{% endif %}
            {% else %}&mdash;{% endif %}
          </td>
          <td class="text-right" style="color:var(--color-text-muted)">
            {% if r.historicTime is not null %}
              {% if r.historicTime < 60 %}{{ r.historicTime }}s{% else %}{{ (r.historicTime / 60)|round(1) }} min{% endif %}
            {% else %}&mdash;{% endif %}
          </td>
          <td class="text-right {% if delay is not null %}{% if delay > 0 %}delay-pos{% elseif delay < 0 %}delay-neg{% else %}delay-zero{% endif %}{% endif %}">
            {% if delay is null %}&mdash;
            {% elseif delay == 0 %}0s
            {% elseif delay > 0 %}+{{ delay < 60 ? delay ~ 's' : (delay/60)|round(1) ~ ' min' }}
            {% else %}{{ delay < -60 ? (delay/60)|round(1) ~ ' min' : delay ~ 's' }}{% endif %}
          </td>
          <td><span class="badge badge-gray" style="font-size:10px">{{ r.type ?? '&mdash;' }}</span></td>
          <td style="font-family:var(--font-mono);font-size:var(--text-xs);color:var(--color-text-faint)">
            {{ r.wazeRouteId ? r.wazeRouteId|slice(0,12) ~ '…' : '&mdash;' }}
          </td>
          <td class="text-center" style="white-space:nowrap">
            <a href="{{ path('route_admin_history', {wazeRouteId: r.wazeRouteId}) }}" class="action-btn history" title="Ver histórico">
              <i data-lucide="chart-line" style="width:14px;height:14px"></i>
            </a>
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endif %}
{% endblock %}

{% block javascripts %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script>
(function () {
  'use strict';

  function initLucide() {
    if (typeof lucide !== 'undefined' && typeof lucide.createIcons === 'function') {
      try {
        lucide.createIcons();
        console.log('[Index] Ícones Lucide inicializados.');
      } catch (e) {
        console.warn('[Index] Erro ao inicializar Lucide:', e);
      }
    } else {
      console.warn('[Index] Lucide não encontrado. Tentando novamente em 500ms...');
      setTimeout(initLucide, 500);
    }
  }

  const ROUTES = [
  {% for r in routes %}
    {% if r.line|length > 1 %}
    {
      id: {{ r.id }},
      wazeId: {{ r.wazeRouteId|json_encode|raw }},
      name: {{ r.name|json_encode|raw }},
      jam: {{ r.jamLevel ?? 0 }},
      label: {{ r.jamLevelLabel|json_encode|raw }},
      delay: {{ r.delaySeconds ?? 'null' }},
      line: {{ r.line|json_encode|raw }}
    }{{ not loop.last ? ',' }}
    {% endif %}
  {% endfor %}
  ];

  const JAM_COLOR  = ['#437a22','#d19900','#da7101','#a12c7b','#a12c7b','#7b0000'];
  const JAM_WEIGHT = [3, 3, 4, 5, 5, 6];

  const mapEl = document.getElementById('tvt-map');
  if (mapEl) {
    const map = L.map('tvt-map', { zoomControl: true });
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      crossOrigin: true
    }).addTo(map);

    const polylines = {};
    const bounds = [];

    ROUTES.forEach(function (r) {
      if (!r.line || r.line.length < 2) return;
      const latlngs = r.line.map(function (p) { return [p.y, p.x]; });
      const color   = JAM_COLOR[r.jam]  || '#888';
      const weight  = JAM_WEIGHT[r.jam] || 3;

      const poly = L.polyline(latlngs, { color: color, weight: weight, opacity: 0.85 })
        .addTo(map)
        .bindPopup(function () {
          const delayStr = r.delay === null ? '—'
            : r.delay === 0 ? '0 s'
            : r.delay > 0 ? '+' + (r.delay < 60 ? r.delay + ' s' : (r.delay/60).toFixed(1) + ' min')
            : (r.delay < -60 ? (r.delay/60).toFixed(1) : r.delay) + ' min';
          return '<strong>' + (r.name || '—') + '</strong><br>'
            + '<span style="font-size:11px;color:#666">Jam: ' + r.label + ' | Atraso: ' + delayStr + '</span>';
        });

      if (r.wazeId) polylines[r.wazeId] = poly;
      latlngs.forEach(function (ll) { bounds.push(ll); });
    });

    if (bounds.length) map.fitBounds(bounds, { padding: [20, 20] });
    else map.setView([-19.92, -43.94], 12);

    document.querySelectorAll('.route-row').forEach(function (tr) {
      tr.addEventListener('click', function () {
        const wid = tr.getAttribute('data-waze-id');
        document.querySelectorAll('.route-row').forEach(function (r) { r.classList.remove('row-selected'); });
        tr.classList.add('row-selected');
        if (wid && polylines[wid]) {
          map.fitBounds(polylines[wid].getBounds(), { padding: [40, 40], maxZoom: 16 });
          polylines[wid].openPopup();
        }
      });
    });

    Object.entries(polylines).forEach(function ([wid, poly]) {
      poly.on('click', function () {
        document.querySelectorAll('.route-row').forEach(function (r) { r.classList.remove('row-selected'); });
        const tr = document.querySelector('.route-row[data-waze-id="' + wid + '"]');
        if (tr) {
          tr.classList.add('row-selected');
          tr.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });

    window.__map = map;
    window.__polylines = polylines;
    console.log('[Index] Mapa inicializado com ' + Object.keys(polylines).length + ' rotas.');
  } else {
    console.warn('[Index] Elemento #tvt-map não encontrado.');
  }

  const refreshBtn = document.getElementById('btn-refresh');
  const refreshIcon = document.getElementById('refresh-icon');
  if (refreshBtn && refreshIcon) {
    refreshBtn.addEventListener('click', function (e) {
      e.preventDefault();
      refreshIcon.classList.add('spinning');
      refreshBtn.disabled = true;
      refreshBtn.textContent = ' Carregando...';
      refreshBtn.prepend(refreshIcon);
      setTimeout(function () {
        window.location.href = refreshBtn.getAttribute('href');
      }, 300);
    });
  }

  document.querySelectorAll('.kpi-card, .card').forEach(function (el, i) {
    el.style.opacity = '0';
    el.style.transform = 'translateY(12px)';
    setTimeout(function () {
      el.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
    }, 50 + i * 50);
  });

  if (document.readyState === 'complete') {
    initLucide();
  } else {
    document.addEventListener('readystatechange', function () {
      if (document.readyState === 'complete') initLucide();
    });
  }
  setTimeout(initLucide, 1000);
  console.log('[Index] Página inicializada.');
})();
</script>
<style>
  @keyframes spin { to { transform: rotate(360deg); } }
  .spinning { animation: spin 0.6s linear infinite; display: inline-block; }
</style>
{% endblock %}
