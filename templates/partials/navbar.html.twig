{# Navigation Component with Role-based Menu #}
<nav class="site-nav" id="site-nav">
    <ul class="nav-list">
        {# Public Menu Items (for all users) #}
        <li class="nav-item">
            <a href="{{ path('app_home') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_home' %}active{% endif %}">
                <i class="fas fa-home"></i>
                <span>Home</span>
            </a>
        </li>
        
        {% if app.user %}
            {# Menu Items for Logged-in Users #}
            <li class="nav-item">
                <a href="{{ path('app_dashboard') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}">
                    <i class="fas fa-tachometer-alt"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            
            {# Role-based Menu Items #}
            
            {# Account Admin Menu #}
            {% if 'ROLE_ACCOUNT_ADMIN' in app.user.roles %}
                <li class="nav-item has-submenu">
                    <a href="#" class="nav-link" onclick="toggleSubmenu(event)">
                        <i class="fas fa-users-cog"></i>
                        <span>Administra\u00e7\u00e3o</span>
                        <i class="fas fa-chevron-down submenu-arrow"></i>
                    </a>
                    <ul class="submenu">
                        <li><a href="{{ path('app_account_admin_dashboard') }}"><i class="fas fa-chart-line"></i> Dashboard</a></li>
                        <li><a href="#"><i class="fas fa-users"></i> Usu\u00e1rios</a></li>
                        <li><a href="#"><i class="fas fa-file-alt"></i> Relat\u00f3rios</a></li>
                        <li><a href="#"><i class="fas fa-cog"></i> Configura\u00e7\u00f5es</a></li>
                    </ul>
                </li>
            {% endif %}
            
            {# Admin Partner Menu #}
            {% if 'ROLE_ADMIN_PARTNER' in app.user.roles %}
                <li class="nav-item has-submenu">
                    <a href="#" class="nav-link" onclick="toggleSubmenu(event)">
                        <i class="fas fa-handshake"></i>
                        <span>Parcerias</span>
                        <i class="fas fa-chevron-down submenu-arrow"></i>
                    </a>
                    <ul class="submenu">
                        <li><a href="{{ path('app_partner_dashboard') }}"><i class="fas fa-chart-pie"></i> Dashboard</a></li>
                        <li><a href="#"><i class="fas fa-building"></i> Empresas</a></li>
                        <li><a href="#"><i class="fas fa-file-invoice-dollar"></i> Faturamento</a></li>
                        <li><a href="#"><i class="fas fa-file-contract"></i> Contratos</a></li>
                    </ul>
                </li>
            {% endif %}
            
            {# Field Agent Menu #}
            {% if 'ROLE_FIELD_AGENT' in app.user.roles %}
                <li class="nav-item has-submenu">
                    <a href="#" class="nav-link" onclick="toggleSubmenu(event)">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Campo</span>
                        <i class="fas fa-chevron-down submenu-arrow"></i>
                    </a>
                    <ul class="submenu">
                        <li><a href="{{ path('app_field_agent_dashboard') }}"><i class="fas fa-clipboard-list"></i> Tarefas</a></li>
                        <li><a href="#"><i class="fas fa-route"></i> Rotas</a></li>
                        <li><a href="#"><i class="fas fa-camera"></i> Registrar</a></li>
                        <li><a href="#"><i class="fas fa-exclamation-triangle"></i> Alertas</a></li>
                    </ul>
                </li>
            {% endif %}
            
            {# Regular User Menu #}
            {% if 'ROLE_USER' in app.user.roles %}
                <li class="nav-item has-submenu">
                    <a href="#" class="nav-link" onclick="toggleSubmenu(event)">
                        <i class="fas fa-route"></i>
                        <span>Minhas Rotas</span>
                        <i class="fas fa-chevron-down submenu-arrow"></i>
                    </a>
                    <ul class="submenu">
                        <li><a href="{{ path('app_user_dashboard') }}"><i class="fas fa-home"></i> Dashboard</a></li>
                        <li><a href="#"><i class="fas fa-map"></i> Mapa</a></li>
                        <li><a href="#"><i class="fas fa-bell"></i> Alertas</a></li>
                        <li><a href="#"><i class="fas fa-cog"></i> Configura\u00e7\u00f5es</a></li>
                    </ul>
                </li>
            {% endif %}
            
            {# Common Menu for All Logged-in Users #}
            <li class="nav-item">
                <a href="#" class="nav-link">
                    <i class="fas fa-bell"></i>
                    <span>Alertas</span>
                    <span class="notification-badge">3</span>
                </a>
            </li>
        {% else %}
            {# Public Menu Items #}
            <li class="nav-item">
                <a href="#features" class="nav-link">
                    <i class="fas fa-star"></i>
                    <span>Funcionalidades</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="#pricing" class="nav-link">
                    <i class="fas fa-dollar-sign"></i>
                    <span>Planos</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="#contact" class="nav-link">
                    <i class="fas fa-envelope"></i>
                    <span>Contato</span>
                </a>
            </li>
        {% endif %}
    </ul>
    
    {# Mobile Menu Toggle #}
    <button class="mobile-nav-toggle" id="mobile-nav-toggle" onclick="toggleMobileNav()">
        <i class="fas fa-bars"></i>
    </button>
</nav>

{# Mobile Navigation #}
<div class="mobile-nav" id="mobile-nav">
    <div class="mobile-nav-header">
        <span>Menu</span>
        <button onclick="toggleMobileNav()">
            <i class="fas fa-times"></i>
        </button>
    </div>
    <ul class="mobile-nav-list">
        {# Duplicate nav items for mobile #}
        <li><a href="{{ path('app_home') }}"><i class="fas fa-home"></i> Home</a></li>
        {% if app.user %}
            <li><a href="{{ path('app_dashboard') }}"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
            
            {% if 'ROLE_ACCOUNT_ADMIN' in app.user.roles %}
                <li><a href="{{ path('app_account_admin_dashboard') }}"><i class="fas fa-chart-line"></i> Admin Dashboard</a></li>
            {% endif %}
            
            {% if 'ROLE_ADMIN_PARTNER' in app.user.roles %}
                <li><a href="{{ path('app_partner_dashboard') }}"><i class="fas fa-handshake"></i> Partner Dashboard</a></li>
            {% endif %}
            
            {% if 'ROLE_FIELD_AGENT' in app.user.roles %}
                <li><a href="{{ path('app_field_agent_dashboard') }}"><i class="fas fa-map-marker-alt"></i> Agent Dashboard</a></li>
            {% endif %}
            
            {% if 'ROLE_USER' in app.user.roles %}
                <li><a href="{{ path('app_user_dashboard') }}"><i class="fas fa-user"></i> Meu Dashboard</a></li>
            {% endif %}
            
            <li><a href="#"><i class="fas fa-bell"></i> Alertas</a></li>
        {% else %}
            <li><a href="#features"><i class="fas fa-star"></i> Funcionalidades</a></li>
            <li><a href="#pricing"><i class="fas fa-dollar-sign"></i> Planos</a></li>
            <li><a href="#contact"><i class="fas fa-envelope"></i> Contato</a></li>
        {% endif %}
    </ul>
</div>
