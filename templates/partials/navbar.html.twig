{# ========================================
   wazeBR - Premium Navigation Component
   Role-based menu with submenus
   ======================================== #}

<nav class="site-nav" id="site-nav" aria-label="Navega\u00e7\u00e3o principal">
    <ul class="nav-list">
        {# Home - Always visible #}
        <li class="nav-item">
            <a 
                href="{{ path('app_home') }}" 
                class="nav-link {% if app.request.attributes.get('_route') == 'app_home' %}active{% endif %}"
                aria-current="{% if app.request.attributes.get('_route') == 'app_home' %}page{% endif %}"
            >
                <i class="fas fa-home"></i>
                <span>Home</span>
            </a>
        </li>

        {% if app.user %}
            {# Dashboard - For logged-in users #}
            <li class="nav-item">
                <a 
                    href="{{ path('app_dashboard') }}" 
                    class="nav-link {% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}"
                >
                    <i class="fas fa-tachometer-alt"></i>
                    <span>Dashboard</span>
                </a>
            </li>

            {# ========================================
               Account Admin Menu
               ======================================== #}
            {% if 'ROLE_ACCOUNT_ADMIN' in app.user.roles %}
                <li class="nav-item has-submenu">
                    <a 
                        href="#" 
                        class="nav-link"
                        aria-haspopup="true"
                        aria-expanded="false"
                    >
                        <i class="fas fa-users-cog"></i>
                        <span>Administra\u00e7\u00e3o</span>
                        <i class="fas fa-chevron-down submenu-arrow"></i>
                    </a>
                    <ul class="submenu" role="menu">
                        <li role="none">
                            <a href="{{ path('app_account_admin_dashboard') }}" role="menuitem">
                                <i class="fas fa-chart-line"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li role="none">
                            <a href="#" role="menuitem">
                                <i class="fas fa-users"></i>
                                <span>Usu\u00e1rios</span>
                            </a>
                        </li>
                        <li role="none">
                            <a href="#" role="menuitem">
                                <i class="fas fa-file-alt"></i>
                                <span>Relat\u00f3rios</span>
                            </a>
                        </li>
                        <li role="none">
                            <a href="#" role="menuitem">
                                <i class="fas fa-cog"></i>
                                <span>Configura\u00e7\u00f5es</span>
                            </a>
                        </li>
                        <li role="separator" class="submenu-divider"></li>
                        <li role="none">
                            <a href="#" role="menuitem">
                                <i class="fas fa-shield-alt"></i>
                                <span>Seguran\u00e7a</span>
                            </a>
                        </li>
                    </ul>
                </li>
            {% endif %}

            {# ========================================
               Admin Partner Menu
               ======================================== #}
            {% if 'ROLE_ADMIN_PARTNER' in app.user.roles %}
                <li class="nav-item has-submenu">
                    <a 
                        href="#" 
                        class="nav-link"
                        aria-haspopup="true"
                        aria-expanded="false"
                    >
                        <i class="fas fa-handshake"></i>
                        <span>Parcerias</span>
                        <i class="fas fa-chevron-down submenu-arrow"></i>
                    </a>
                    <ul class="submenu" role="menu">
                        <li role="none">
                            <a href="{{ path('app_partner_dashboard') }}" role="menuitem">
                                <i class="fas fa-chart-pie"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li role="none">
                            <a href="#" role="menuitem">
                                <i class="fas fa-building"></i>
                                <span>Empresas</span>
                            </a>
                        </li>
                        <li role="none">
                            <a href="#" role="menuitem">
                                <i class="fas fa-file-invoice-dollar"></i>
                                <span>Faturamento</span>
                            </a>
                        </li>
                        <li role="none">
                            <a href="#" role="menuitem">
                                <i class="fas fa-file-contract"></i>
                                <span>Contratos</span>
                            </a>
                        </li>
                        <li role="separator" class="submenu-divider"></li>
                        <li role="none">
                            <a href="#" role="menuitem">
                                <i class="fas fa-chart-bar"></i>
                                <span>Analytics</span>
                            </a>
                        </li>
                    </ul>
                </li>
            {% endif %}

            {# ========================================
               Field Agent Menu
               ======================================== #}
            {% if 'ROLE_FIELD_AGENT' in app.user.roles %}
                <li class="nav-item has-submenu">
                    <a 
                        href="#" 
                        class="nav-link"
                        aria-haspopup="true"
                        aria-expanded="false"
                    >
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Campo</span>
                        <i class="fas fa-chevron-down submenu-arrow"></i>
                    </a>
                    <ul class="submenu" role="menu">
                        <li role="none">
                            <a href="{{ path('app_field_agent_dashboard') }}" role="menuitem">
                                <i class="fas fa-clipboard-list"></i>
                                <span>Tarefas</span>
                            </a>
                        </li>
                        <li role="none">
                            <a href="#" role="menuitem">
                                <i class="fas fa-route"></i>
                                <span>Rotas</span>
                            </a>
                        </li>
                        <li role="none">
                            <a href="#" role="menuitem">
                                <i class="fas fa-camera"></i>
                                <span>Registrar</span>
                            </a>
                        </li>
                        <li role="none">
                            <a href="#" role="menuitem">
                                <i class="fas fa-exclamation-triangle"></i>
                                <span>Alertas</span>
                            </a>
                        </li>
                        <li role="separator" class="submenu-divider"></li>
                        <li role="none">
                            <a href="#" role="menuitem">
                                <i class="fas fa-history"></i>
                                <span>Hist\u00f3rico</span>
                            </a>
                        </li>
                    </ul>
                </li>
            {% endif %}

            {# ========================================
               Regular User Menu
               ======================================== #}
            {% if 'ROLE_USER' in app.user.roles %}
                <li class="nav-item has-submenu">
                    <a 
                        href="#" 
                        class="nav-link"
                        aria-haspopup="true"
                        aria-expanded="false"
                    >
                        <i class="fas fa-route"></i>
                        <span>Minhas Rotas</span>
                        <i class="fas fa-chevron-down submenu-arrow"></i>
                    </a>
                    <ul class="submenu" role="menu">
                        <li role="none">
                            <a href="{{ path('app_user_dashboard') }}" role="menuitem">
                                <i class="fas fa-home"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li role="none">
                            <a href="#" role="menuitem">
                                <i class="fas fa-map"></i>
                                <span>Mapa</span>
                            </a>
                        </li>
                        <li role="none">
                            <a href="#" role="menuitem">
                                <i class="fas fa-bell"></i>
                                <span>Alertas</span>
                            </a>
                        </li>
                        <li role="none">
                            <a href="#" role="menuitem">
                                <i class="fas fa-cog"></i>
                                <span>Configura\u00e7\u00f5es</span>
                            </a>
                        </li>
                    </ul>
                </li>
            {% endif %}

            {# Alerts - For all logged-in users #}
            <li class="nav-item">
                <a href="#" class="nav-link">
                    <i class="fas fa-bell"></i>
                    <span>Alertas</span>
                    <span class="notification-badge">3</span>
                </a>
            </li>
        {% else %}
            {# ========================================
               Public Menu (Not logged in)
               ======================================== #}
            <li class="nav-item">
                <a href="#features" class="nav-link">
                    <i class="fas fa-star"></i>
                    <span>Funcionalidades</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="#pricing" class="nav-link">
                    <i class="fas fa-dollar-sign"></i>
                    <span>Planos</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="#about" class="nav-link">
                    <i class="fas fa-info-circle"></i>
                    <span>Sobre</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="#contact" class="nav-link">
                    <i class="fas fa-envelope"></i>
                    <span>Contato</span>
                </a>
            </li>
        {% endif %}
    </ul>
</nav>
