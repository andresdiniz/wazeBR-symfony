<footer class="app-footer footer" data-component="footer">
    <div class="footer-inner">
        <div class="footer-brand-block">
            <a href="{{ path('dashboard') }}" class="footer-brand" aria-label="WazeBR — {{ 'footer.home'|trans }}">
                <span class="footer-brand-mark" aria-hidden="true">W</span>
                <span class="footer-brand-content">
                    <strong>WazeBR</strong>
                    <small>{{ 'footer.brand_tagline'|trans }}</small>
                </span>
            </a>

            <p class="footer-description">{{ 'footer.description'|trans }}</p>
        </div>

        <div class="footer-nav-block">
            <span class="footer-section-label">{{ 'footer.navigation'|trans }}</span>

            <nav class="footer-nav" aria-label="{{ 'footer.footer_navigation'|trans }}">
                <ul class="footer-nav-list">
                    <li><a href="{{ path('dashboard') }}" class="footer-link">{{ 'footer.home'|trans }}</a></li>
                    <li><a href="#" class="footer-link">{{ 'footer.about'|trans }}</a></li>
                    <li><a href="#" class="footer-link">{{ 'footer.contact'|trans }}</a></li>
                </ul>
            </nav>
        </div>

        <div class="footer-meta">
            <div class="footer-system-status" aria-label="{{ 'footer.system_operational'|trans }}">
                <span class="footer-system-status-dot" aria-hidden="true"></span>
                <span>{{ 'footer.system_operational'|trans }}</span>
            </div>

            <p class="footer-copyright">
                &copy;
                <span data-current-year>{{ "now"|date("Y") }}</span>
                WazeBR.
                {{ 'footer.rights_reserved'|trans }}
            </p>

            <span class="footer-version">{{ 'footer.operations_center'|trans }}</span>
        </div>
    </div>

    <div class="footer-bottom">
        <div class="footer-bottom-inner">
            <span class="footer-bottom-line"></span>
            <span class="footer-bottom-text">{{ 'footer.realtime_monitoring'|trans }}</span>
            <span class="footer-bottom-line"></span>
        </div>
    </div>
</footer>
