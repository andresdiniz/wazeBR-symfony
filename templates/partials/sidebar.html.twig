<aside id="app-sidebar" class="app-sidebar sidebar" data-component="sidebar">
    <nav aria-label="Navegação principal">
        <a href="{{ path('dashboard') }}" class="sidebar-link{% if app.request.attributes.get('_route') == 'dashboard' %} is-active{% endif %}">
            <span>Dashboard</span>
        </a>

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_users') }}" class="sidebar-link{% if app.request.attributes.get('_route') starts with 'admin_' %} is-active{% endif %}">
                <span>Usuários</span>
            </a>
        {% endif %}
    </nav>
</aside>
