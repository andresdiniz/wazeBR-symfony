{# partials/_navbar_menu.html.twig — usado dentro da sidebar (base.html.twig) #}
{% set current = app.request.attributes.get('_route') %}

<div class="sidebar-section">
    <div class="sidebar-heading">Visão geral</div>
    <ul class="sidebar-menu">
        <li class="sidebar-menu-item">
            <a href="{{ path('dashboard_index') }}" class="sidebar-menu-link {{ current == 'dashboard_index' or current == 'app_dashboard' ? 'active' : '' }}">
                <span class="sidebar-menu-icon" aria-hidden="true">📊</span>
                <span class="sidebar-menu-text">Dashboard</span>
            </a>
        </li>
        {% if is_granted('ROLE_OPERATOR') or is_granted('ROLE_PARTNER_ADMIN') or is_granted('ROLE_ADMIN') %}
        <li class="sidebar-menu-item">
            <a href="{{ path('operator_live') }}" class="sidebar-menu-link {{ current starts with 'operator_' ? 'active' : '' }}">
                <span class="sidebar-menu-icon" aria-hidden="true">🖥️</span>
                <span class="sidebar-menu-text">Painel do operador</span>
            </a>
        </li>
        {% endif %}
    </ul>
</div>

<div class="sidebar-section">
    <div class="sidebar-heading">Monitoramento</div>
    <ul class="sidebar-menu">
        <li class="sidebar-menu-item">
            <a href="{{ path('alert_index') }}" class="sidebar-menu-link {{ current starts with 'alert_' ? 'active' : '' }}">
                <span class="sidebar-menu-icon" aria-hidden="true">🔔</span>
                <span class="sidebar-menu-text">Alertas</span>
            </a>
        </li>
        <li class="sidebar-menu-item">
            <a href="{{ path('jam_index') }}" class="sidebar-menu-link {{ current starts with 'jam_' ? 'active' : '' }}">
                <span class="sidebar-menu-icon" aria-hidden="true">🚦</span>
                <span class="sidebar-menu-text">Congestionamentos</span>
            </a>
        </li>
        <li class="sidebar-menu-item">
            <a href="{{ path('cifs_index') }}" class="sidebar-menu-link {{ current starts with 'cifs_' ? 'active' : '' }}">
                <span class="sidebar-menu-icon" aria-hidden="true">🚨</span>
                <span class="sidebar-menu-text">Ocorrências CIFS</span>
            </a>
        </li>
        <li class="sidebar-menu-item">
            <a href="{{ path('hydro_live') }}" class="sidebar-menu-link {{ current starts with 'hydro_' ? 'active' : '' }}">
                <span class="sidebar-menu-icon" aria-hidden="true">🌧️</span>
                <span class="sidebar-menu-text">Hidrológico</span>
            </a>
        </li>
        <li class="sidebar-menu-item">
            <a href="{{ path('notification_index') }}" class="sidebar-menu-link {{ current starts with 'notification_' ? 'active' : '' }}">
                <span class="sidebar-menu-icon" aria-hidden="true">📣</span>
                <span class="sidebar-menu-text">Notificações</span>
            </a>
        </li>
    </ul>
</div>

{% if is_granted('ROLE_PARTNER_ADMIN') or is_granted('ROLE_ADMIN') %}
<div class="sidebar-section">
    <div class="sidebar-heading">Gestão do parceiro</div>
    <ul class="sidebar-menu">
        <li class="sidebar-menu-item">
            <a href="{{ path('admin_routes_index') }}" class="sidebar-menu-link {{ current starts with 'admin_routes_' ? 'active' : '' }}">
                <span class="sidebar-menu-icon" aria-hidden="true">🛣️</span>
                <span class="sidebar-menu-text">Rotas</span>
            </a>
        </li>
        <li class="sidebar-menu-item">
            <a href="{{ path('account_link_index') }}" class="sidebar-menu-link {{ current starts with 'account_link_' ? 'active' : '' }}">
                <span class="sidebar-menu-icon" aria-hidden="true">🔗</span>
                <span class="sidebar-menu-text">Links monitorados</span>
            </a>
        </li>
        <li class="sidebar-menu-item">
            <a href="{{ path('monitored_city_index') }}" class="sidebar-menu-link {{ current starts with 'monitored_city_' ? 'active' : '' }}">
                <span class="sidebar-menu-icon" aria-hidden="true">🏙️</span>
                <span class="sidebar-menu-text">Cidades monitoradas</span>
            </a>
        </li>
        <li class="sidebar-menu-item">
            <a href="{{ path('account_user_index') }}" class="sidebar-menu-link {{ current starts with 'account_user_' ? 'active' : '' }}">
                <span class="sidebar-menu-icon" aria-hidden="true">👥</span>
                <span class="sidebar-menu-text">Usuários</span>
            </a>
        </li>
        <li class="sidebar-menu-item">
            <a href="{{ path('account_settings') }}" class="sidebar-menu-link {{ current == 'account_settings' ? 'active' : '' }}">
                <span class="sidebar-menu-icon" aria-hidden="true">⚙️</span>
                <span class="sidebar-menu-text">Configurações</span>
            </a>
        </li>
        <li class="sidebar-menu-item">
            <a href="{{ path('account_logs') }}" class="sidebar-menu-link {{ current == 'account_logs' ? 'active' : '' }}">
                <span class="sidebar-menu-icon" aria-hidden="true">📜</span>
                <span class="sidebar-menu-text">Logs</span>
            </a>
        </li>
    </ul>
</div>
{% endif %}

{% if is_granted('ROLE_ADMIN') %}
<div class="sidebar-section">
    <div class="sidebar-heading">Plataforma</div>
    <ul class="sidebar-menu">
        <li class="sidebar-menu-item">
            <a href="{{ path('admin_partner_index') }}" class="sidebar-menu-link {{ current starts with 'admin_partner_' ? 'active' : '' }}">
                <span class="sidebar-menu-icon" aria-hidden="true">🤝</span>
                <span class="sidebar-menu-text">Parceiros</span>
            </a>
        </li>
        <li class="sidebar-menu-item">
            <a href="{{ path('admin_city_index') }}" class="sidebar-menu-link {{ current starts with 'admin_city_' ? 'active' : '' }}">
                <span class="sidebar-menu-icon" aria-hidden="true">🗺️</span>
                <span class="sidebar-menu-text">Cidades (admin)</span>
            </a>
        </li>
        <li class="sidebar-menu-item">
            <a href="{{ path('admin_station_index') }}" class="sidebar-menu-link {{ current starts with 'admin_station_' ? 'active' : '' }}">
                <span class="sidebar-menu-icon" aria-hidden="true">📡</span>
                <span class="sidebar-menu-text">Estações</span>
            </a>
        </li>
        <li class="sidebar-menu-item">
            <a href="{{ path('admin_settings_index') }}" class="sidebar-menu-link {{ current starts with 'admin_settings_' ? 'active' : '' }}">
                <span class="sidebar-menu-icon" aria-hidden="true">🛠️</span>
                <span class="sidebar-menu-text">Configurações globais</span>
            </a>
        </li>
    </ul>
</div>
{% endif %}
