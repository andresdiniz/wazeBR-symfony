<header class="app-header" data-app-header>
    <div class="app-header__inner">
        <a class="app-header__brand" href="{{ path('dashboard') }}" aria-label="WazeBR - Dashboard">
            <span class="app-header__brand-mark">W</span>
            <span class="app-header__brand-copy"><strong>WazeBR</strong><small>Centro operacional</small></span>
        </a>

        <div class="app-header__actions">
            <label class="theme-control" for="theme-select">
                <span class="theme-control__icon" aria-hidden="true">◐</span>
                <span class="sr-only">Tema da interface</span>
                <select id="theme-select" class="theme-control__select" data-theme-select aria-label="Tema da interface">
                    <option value="system">Sistema</option>
                    <option value="light">Claro</option>
                    <option value="dark">Escuro</option>
                </select>
            </label>
            {% if app.user %}<span class="app-header__user">{{ app.user.name|default(app.user.userIdentifier) }}</span>{% endif %}
        </div>
    </div>
</header>
