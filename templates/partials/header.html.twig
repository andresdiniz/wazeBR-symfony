{#
    * partials/header.html.twig
    * WazeBR — Header global
    #}

   {% set _route = app.request.attributes.get('_route') %}
   {% set _user = app.user %}

   {% set _user_name = _user
       ? (_user.name|default(_user.userIdentifier)|default('Operador'))
       : 'Visitante'
   %}

   {% set _user_role = _user
       ? (
           is_granted('ROLE_SUPER_ADMIN') ? 'Superadministrador'
           : (is_granted('ROLE_ADMIN') ? 'Administrador global'
           : (is_granted('ROLE_ACCOUNT_ADMIN') ? 'Administrador de contas'
           : (is_granted('ROLE_PARTNER_ADMIN') ? 'Administrador de parceiro'
           : (is_granted('ROLE_FIELD_AGENT') ? 'Agente de via'
           : (is_granted('ROLE_OPERATOR') ? 'Operador' : 'Visualizador')))))
         )
       : 'Não autenticado'
   %}

   {% set _user_initial = _user
       ? _user_name|slice(0, 1)|upper
       : 'W'
   %}

   {% set _user_partner = _user and _user.partner is defined ? _user.partner : null %}
   {% set _notifications = header_notifications|default([]) %}

   {% if _user_partner %}
       {% set _notifications = _notifications
           |filter(notification => notification.partner is defined and notification.partner.id == _user_partner.id)
       %}
   {% elseif not _user %}
       {% set _notifications = [] %}
   {% endif %}

   {% set _unread_count = _notifications
       |filter(notification => notification.unread|default(false))
       |length
   %}

   <header class="app-header" data-app-header>
       <div class="app-header__inner">
           <div class="app-header__left">
               <button type="button" class="app-header__mobile-toggle" data-header-mobile-toggle aria-expanded="false" aria-controls="app-header-navigation" aria-label="{{ 'sidebar.collapse_sidebar'|trans }}">
                   <span aria-hidden="true"></span>
                   <span aria-hidden="true"></span>
                   <span aria-hidden="true"></span>
               </button>

               <a class="app-header__brand" href="{{ path('dashboard') }}" aria-label="WazeBR — {{ 'header.dashboard'|trans }}">
                   <span class="app-header__brand-mark" aria-hidden="true">W</span>
                   <span class="app-header__brand-copy">
                       <strong>WazeBR</strong>
                       <small>{{ 'header.brand_subtitle'|trans }}</small>
                   </span>
               </a>

               <span class="app-header__divider" aria-hidden="true"></span>

               <div class="app-header__context">
                   <span class="app-header__context-dot" aria-hidden="true"></span>
                   <span>{{ 'header.operation'|trans }}</span>
                   <strong>{{ _route == 'dashboard' ? 'header.dashboard'|trans : 'header.panel'|trans }}</strong>
               </div>
           </div>

           <nav class="app-header__navigation" id="app-header-navigation" data-header-navigation aria-label="{{ 'sidebar.main_navigation'|trans }}">
               <a href="{{ path('dashboard') }}" class="app-header__nav-link{{ _route == 'dashboard' ? ' is-active' : '' }}" {% if _route == 'dashboard' %}aria-current="page"{% endif %}>
                   <span class="app-header__nav-icon" aria-hidden="true">⌂</span>
                   <span>{{ 'header.overview'|trans }}</span>
               </a>

               {% if is_granted('ROLE_ACCOUNT_ADMIN') or is_granted('ROLE_PARTNER_ADMIN') %}
                   <div class="app-header__nav-admin">
                       <button type="button" class="app-header__nav-link{{ _route starts with 'admin_user' or _route starts with 'admin_partner' ? ' is-active' : '' }}" data-header-admin-toggle aria-expanded="false" aria-haspopup="menu" aria-controls="header-admin-menu">
                           <span class="app-header__nav-icon" aria-hidden="true">▦</span>
                           <span>{{ 'header.administration'|trans }}</span>
                           <span class="app-header__nav-chevron" aria-hidden="true">⌄</span>
                       </button>
                       <div class="app-header__dropdown app-header__admin-menu" id="header-admin-menu" data-header-admin-menu role="menu" aria-label="{{ 'header.administration'|trans }}" hidden>
                           <div class="app-header__dropdown-section">
                               <span class="app-header__dropdown-section-label">{{ 'header.access_management'|trans }}</span>
                               <a href="{{ path('admin_users_index') }}" role="menuitem"{% if _route starts with 'admin_user' %} aria-current="page"{% endif %}>
                                   <span aria-hidden="true">♙</span>{{ 'header.manage_users'|trans }}
                               </a>
                               {% if is_granted('ROLE_PARTNER_ADMIN') and app.user.partner %}
                                   <a href="{{ path('admin_partner_data_index', {id: app.user.partner.id}) }}" role="menuitem"{% if _route starts with 'admin_partner_data' %} aria-current="page"{% endif %}>
                                       <span aria-hidden="true">⌖</span>{{ 'header.partner_data'|trans }}
                                   </a>
                               {% endif %}
                               {% if is_granted('ROLE_ADMIN') and app.user.partner is null %}
                                   <a href="{{ path('admin_partner_index') }}" role="menuitem"{% if _route starts with 'admin_partner' %} aria-current="page"{% endif %}>
                                       <span aria-hidden="true">⌂</span>{{ 'header.manage_partners'|trans }}
                                   </a>
                               {% endif %}
                           </div>
                       </div>
                   </div>
               {% endif %}
           </nav>

           <div class="app-header__right">
               <form class="app-header__search" data-header-search action="{{ path('dashboard') }}" method="get" role="search">
                   <span class="app-header__search-icon" aria-hidden="true">⌕</span>
                   <input type="search" name="q" placeholder="{{ 'header.search'|trans }}" autocomplete="off" spellcheck="false" aria-label="{{ 'header.search'|trans }}" data-header-search-input>
                   <kbd aria-hidden="true">
                       <span class="app-header__search-kbd-command">⌘</span>
                       <span class="app-header__search-kbd-control">Ctrl</span>
                       <span>K</span>
                   </kbd>
               </form>

               <div class="app-header__action-group">
                   <div class="app-header__action-wrap">
                       <button type="button" class="app-header__icon-button" data-header-notifications-toggle aria-expanded="false" aria-haspopup="dialog" aria-controls="header-notifications" aria-label="{{ 'header.notifications'|trans }}{% if _unread_count %} ({{ _unread_count }} {{ 'header.unread'|trans }}){% endif %}">
                           <span class="app-header__notification-icon" aria-hidden="true">
                               <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                   <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/>
                                   <path d="M10 21h4"/>
                               </svg>
                           </span>
                           <i class="app-header__notification-badge" {% if not _unread_count %}hidden{% endif %} aria-hidden="true">{{ _unread_count }}</i>
                       </button>

                       <div class="app-header__dropdown app-header__notifications" id="header-notifications" data-header-notifications role="dialog" aria-label="{{ 'header.notifications'|trans }}" hidden>
                           <div class="app-header__dropdown-head">
                               <div>
                                   <strong>{{ 'header.notifications'|trans }}</strong>
                                   {% if _unread_count %}
                                       <small>{{ _unread_count }} {{ _unread_count == 1 ? 'header.new_update'|trans : 'header.new_updates'|trans }}</small>
                                   {% endif %}
                               </div>
                               {% if _unread_count %}
                                   <button type="button" data-header-notifications-read>{{ 'header.mark_read'|trans }}</button>
                               {% endif %}
                           </div>

                           {% if _notifications is empty %}
                               <div class="app-header__notifications-empty">
                                   <span class="app-header__empty-icon" aria-hidden="true">✓</span>
                                   <strong>{{ 'header.all_good'|trans }}</strong>
                                   <span>{{ 'header.no_notifications'|trans }}</span>
                               </div>
                           {% else %}
                               <div class="app-header__notifications-list">
                                   {% for notification in _notifications %}
                                       <div class="app-header__notification-item{{ notification.unread|default(false) ? ' is-unread' : '' }}" data-notification-item>
                                           <span class="notification-dot is-{{ notification.tone|default('blue') }}" aria-hidden="true"></span>
                                           <div class="app-header__notification-content">
                                               <strong>{{ notification.title }}</strong>
                                               <small>{{ notification.message }}</small>
                                               <time>{{ notification.time }}</time>
                                           </div>
                                       </div>
                                   {% endfor %}
                               </div>
                           {% endif %}

                           <div class="app-header__notifications-footer">
                               <a href="#">{{ 'header.view_all_notifications'|trans }} <span aria-hidden="true">→</span></a>
                           </div>
                       </div>
                   </div>

                   <div class="app-header__language-wrap">
                       <button type="button" class="app-header__icon-button app-header__language-button" data-header-language-toggle aria-expanded="false" aria-haspopup="menu" aria-controls="header-language-menu" aria-label="{{ 'header.select_language'|trans }}">
                           <span class="app-header__language-flag" data-header-language-flag aria-hidden="true">🇧🇷</span>
                           <span class="app-header__chevron" aria-hidden="true">⌄</span>
                       </button>

                       <div class="app-header__dropdown app-header__language-menu" id="header-language-menu" data-header-language-menu role="menu" aria-label="{{ 'header.language'|trans }}" hidden>
                           <a href="#" role="menuitem" class="app-header__language-option" data-language-option="pt_BR">
                               <span class="app-header__language-flag" aria-hidden="true">🇧🇷</span>
                               Português (Brasil)
                           </a>
                           <a href="#" role="menuitem" class="app-header__language-option" data-language-option="en">
                               <span class="app-header__language-flag" aria-hidden="true">🇺🇸</span>
                               English
                           </a>
                           <a href="#" role="menuitem" class="app-header__language-option" data-language-option="es">
                               <span class="app-header__language-flag" aria-hidden="true">🇪🇸</span>
                               Español
                           </a>
                       </div>
                   </div>

                   <label class="theme-control" for="theme-select">
                       <span class="theme-control__icon" aria-hidden="true">◐</span>
                       <span class="sr-only">{{ 'header.theme'|trans }}</span>
                       <select id="theme-select" class="theme-control__select" data-theme-select aria-label="{{ 'header.theme'|trans }}">
                           <option value="system">{{ 'header.theme_system'|trans }}</option>
                           <option value="light">{{ 'header.theme_light'|trans }}</option>
                           <option value="dark">{{ 'header.theme_dark'|trans }}</option>
                       </select>
                   </label>

                   <div class="app-header__user-wrap">
                       <button type="button" class="app-header__user-button" data-header-user-toggle aria-expanded="false" aria-haspopup="menu" aria-controls="header-user-menu">
                           <span class="app-header__avatar" aria-hidden="true">{{ _user_initial }}</span>
                           <span class="app-header__user-copy">
                               <strong>{{ _user_name }}</strong>
                               <small>{{ _user_role }}</small>
                           </span>
                           <span class="app-header__chevron" aria-hidden="true">⌄</span>
                       </button>

                       <div class="app-header__dropdown app-header__user-menu" id="header-user-menu" data-header-user-menu role="menu" aria-label="{{ 'header.account'|trans }}" hidden>
                           <div class="app-header__user-menu-head">
                               <span class="app-header__avatar app-header__avatar--large" aria-hidden="true">{{ _user_initial }}</span>
                               <div>
                                   <strong>{{ _user_name }}</strong>
                                   <small>{{ _user_role }}</small>
                               </div>
                           </div>

                           <div class="app-header__dropdown-section">
                               <span class="app-header__dropdown-section-label">{{ 'header.account'|trans }}</span>
                               <a href="{{ path('dashboard') }}" role="menuitem">
                                   <span aria-hidden="true">▣</span>{{ 'header.my_panel'|trans }}
                               </a>
                               <a href="#" role="menuitem">
                                   <span aria-hidden="true">⚙</span>{{ 'header.preferences'|trans }}
                               </a>
                           </div>

                           {% if _user %}
                               <div class="app-header__dropdown-section">
                                   <a href="{{ path('app_logout') }}" role="menuitem" class="is-danger">
                                       <span aria-hidden="true">↪</span>{{ 'header.logout'|trans }}
                                   </a>
                               </div>
                           {% endif %}
                       </div>
                   </div>
               </div>
           </div>
       </div>
   </header>
