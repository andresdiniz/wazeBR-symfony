{# ========================================
   wazeBR - Ultra Premium Header
   Advanced navigation with animations and role-based features
   ======================================== #}

<header class="site-header" id="site-header" role="banner">
    <div class="header-container">
        {# ========================================
           Logo
           ======================================== #}
        <a href="{{ path('app_home') }}" class="logo" aria-label="wazeBR - Ir para home">
            <div class="logo-wrapper">
                <div class="logo-icon">
                    <i class="fas fa-road" aria-hidden="true"></i>
                </div>
                <div class="logo-badge">
                    <span class="badge-dot"></span>
                </div>
            </div>
            <span class="logo-text">
                waze<span class="highlight">BR</span>
            </span>
        </a>

        {# ========================================
           Navigation
           ======================================== #}
        {% include 'partials/navbar.html.twig' %}

        {# ========================================
           Header Actions
           ======================================== #}
        <div class="header-actions">
            {# ----------------------------------------
               Search Box
               ---------------------------------------- #}
            <div class="search-box" role="search">
                <i class="fas fa-search search-icon" aria-hidden="true"></i>
                <input 
                    type="search" 
                    class="search-input" 
                    placeholder="Buscar..."
                    aria-label="Buscar no site"
                    data-search
                    autocomplete="off"
                >
                <div class="search-shortcut">
                    <kbd>Ctrl</kbd>
                    <kbd>K</kbd>
                </div>
                
                {# Search Results Dropdown #}
                <div class="search-results" role="listbox">
                    <div class="search-results-header">
                        <span>Resultados</span>
                        <button class="clear-search" aria-label="Limpar busca">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="search-results-body">
                        <div class="search-no-results">
                            <i class="fas fa-search" aria-hidden="true"></i>
                            <p>Digite para buscar...</p>
                        </div>
                    </div>
                    <div class="search-results-footer">
                        <span>Pressione <kbd>Enter</kbd> para buscar</span>
                    </div>
                </div>
            </div>

            {# ----------------------------------------
               Notifications
               ---------------------------------------- #}
            <div class="notifications" role="group" aria-label="Notifica\u00e7\u00f5es">
                <button 
                    class="notification-btn" 
                    data-dropdown-toggle="notification-dropdown"
                    aria-label="Ver notifica\u00e7\u00f5es"
                    aria-haspopup="true"
                    aria-expanded="false"
                    data-tooltip="Notifica\u00e7\u00f5es"
                    data-tooltip-position="bottom"
                >
                    <i class="fas fa-bell" aria-hidden="true"></i>
                    <span class="notification-badge" id="notification-count">3</span>
                    <span class="notification-dot"></span>
                </button>

                {# Notification Dropdown #}
                <div 
                    class="notification-dropdown dropdown-menu" 
                    id="notification-dropdown"
                    role="menu"
                    aria-labelledby="notification-btn"
                >
                    <div class="dropdown-header">
                        <div class="header-content">
                            <h4>Notifica\u00e7\u00f5es</h4>
                            <span class="unread-count" id="unread-count">3 n\u00e3o lidas</span>
                        </div>
                        <div class="header-actions">
                            <button class="mark-all-read" data-tooltip="Marcar todas como lidas">
                                <i class="fas fa-check-double"></i>
                                <span>Limpar</span>
                            </button>
                            <a href="#" class="settings-btn" data-tooltip="Configura\u00e7\u00f5es">
                                <i class="fas fa-cog"></i>
                            </a>
                        </div>
                    </div>
                    
                    <div class="dropdown-tabs">
                        <button class="tab-btn active" data-tab="all">
                            <i class="fas fa-inbox"></i>
                            <span>Todas</span>
                        </button>
                        <button class="tab-btn" data-tab="unread">
                            <i class="fas fa-envelope"></i>
                            <span>N\u00e3o lidas</span>
                        </button>
                        <button class="tab-btn" data-tab="archived">
                            <i class="fas fa-archive"></i>
                            <span>Arquivadas</span>
                        </button>
                    </div>
                    
                    <div class="dropdown-body">
                        <ul class="notification-list">
                            {# Critical Alert #}
                            <li class="notification-item critical unread" data-type="alert">
                                <div class="notification-icon critical">
                                    <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                                </div>
                                <div class="notification-content">
                                    <div class="notification-header">
                                        <p class="notification-title">Alerta Cr\u00edtico</p>
                                        <span class="notification-time">Agora</span>
                                    </div>
                                    <p class="notification-message">Congestionamento grave na Av. Principal - 5km de lentid\u00e3o</p>
                                    <div class="notification-meta">
                                        <span class="location"><i class="fas fa-map-marker-alt"></i> Centro</span>
                                        <span class="severity"><i class="fas fa-tachometer-alt"></i> 10 km/h</span>
                                    </div>
                                </div>
                                <button class="notification-action" aria-label="A\u00e7\u00e3o">
                                    <i class="fas fa-chevron-right"></i>
                                </button>
                            </li>
                            
                            {# Warning Alert #}
                            <li class="notification-item warning unread" data-type="warning">
                                <div class="notification-icon warning">
                                    <i class="fas fa-road" aria-hidden="true"></i>
                                </div>
                                <div class="notification-content">
                                    <div class="notification-header">
                                        <p class="notification-title">Obra na Via</p>
                                        <span class="notification-time">H\u00e1 5 min</span>
                                    </div>
                                    <p class="notification-message">Nova obra registrada no centro - Rua das Flores</p>
                                    <div class="notification-meta">
                                        <span class="location"><i class="fas fa-map-marker-alt"></i> Centro</span>
                                        <span class="duration"><i class="fas fa-clock"></i> 30 dias</span>
                                    </div>
                                </div>
                                <button class="notification-action" aria-label="A\u00e7\u00e3o">
                                    <i class="fas fa-chevron-right"></i>
                                </button>
                            </li>
                            
                            {# Info Alert #}
                            <li class="notification-item info unread" data-type="info">
                                <div class="notification-icon info">
                                    <i class="fas fa-info-circle" aria-hidden="true"></i>
                                </div>
                                <div class="notification-content">
                                    <div class="notification-header">
                                        <p class="notification-title">Atualiza\u00e7\u00e3o do Sistema</p>
                                        <span class="notification-time">H\u00e1 15 min</span>
                                    </div>
                                    <p class="notification-message">Novas funcionalidades dispon\u00edveis no dashboard</p>
                                </div>
                                <button class="notification-action" aria-label="A\u00e7\u00e3o">
                                    <i class="fas fa-chevron-right"></i>
                                </button>
                            </li>
                            
                            {# Success Alert #}
                            <li class="notification-item success" data-type="success">
                                <div class="notification-icon success">
                                    <i class="fas fa-check-circle" aria-hidden="true"></i>
                                </div>
                                <div class="notification-content">
                                    <div class="notification-header">
                                        <p class="notification-title">Relat\u00f3rio Gerado</p>
                                        <span class="notification-time">H\u00e1 1 hora</span>
                                    </div>
                                    <p class="notification-message">Seu relat\u00f3rio mensal foi gerado com sucesso</p>
                                </div>
                                <button class="notification-action" aria-label="A\u00e7\u00e3o">
                                    <i class="fas fa-download"></i>
                                </button>
                            </li>
                            
                            {# System Alert #}
                            <li class="notification-item system" data-type="system">
                                <div class="notification-icon system">
                                    <i class="fas fa-server" aria-hidden="true"></i>
                                </div>
                                <div class="notification-content">
                                    <div class="notification-header">
                                        <p class="notification-title">Manuten\u00e7\u00e3o Programada</p>
                                        <span class="notification-time">H\u00e1 2 horas</span>
                                    </div>
                                    <p class="notification-message">Sistema passar\u00e1 por manuten\u00e7\u00e3o domingo \u00e0s 03:00</p>
                                </div>
                                <button class="notification-action" aria-label="A\u00e7\u00e3o">
                                    <i class="fas fa-chevron-right"></i>
                                </button>
                            </li>
                        </ul>
                    </div>
                    
                    <div class="dropdown-footer">
                        <a href="#" class="view-all">
                            <i class="fas fa-list-ul"></i>
                            <span>Ver todas as notifica\u00e7\u00f5es</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            {# ----------------------------------------
               Theme Toggle
               ---------------------------------------- #}
            <button 
                class="theme-toggle" 
                data-theme-toggle
                aria-label="Alternar tema"
                aria-pressed="false"
                data-tooltip="Alternar tema (Ctrl+/)"
                data-tooltip-position="bottom"
            >
                <span class="theme-toggle-inner">
                    <i class="fas fa-moon moon-icon" aria-hidden="true"></i>
                    <i class="fas fa-sun sun-icon" aria-hidden="true"></i>
                </span>
                <span class="toggle-indicator"></span>
            </button>

            {# ----------------------------------------
               User Menu
               ---------------------------------------- #}
            {% if app.user %}
                <div class="user-menu" role="group" aria-label="Menu do usu\u00e1rio">
                    <button 
                        class="user-menu-btn" 
                        data-dropdown-toggle="user-dropdown"
                        aria-label="Abrir menu do usu\u00e1rio"
                        aria-haspopup="true"
                        aria-expanded="false"
                    >
                        <div class="user-avatar-wrapper">
                            <div class="user-avatar">
                                <i class="fas fa-user" aria-hidden="true"></i>
                            </div>
                            <span class="user-status online" title="Online"></span>
                        </div>
                        <div class="user-info">
                            <span class="user-name">{{ app.user.email|split('@')|first }}</span>
                            <span class="user-role">{% if 'ROLE_ACCOUNT_ADMIN' in app.user.roles %}Administrador{% elseif 'ROLE_ADMIN_PARTNER' in app.user.roles %}Partner{% elseif 'ROLE_FIELD_AGENT' in app.user.roles %}Agente{% else %}Usu\u00e1rio{% endif %}</span>
                            <span class="user-arrow">
                                <i class="fas fa-chevron-down" aria-hidden="true"></i>
                            </span>
                        </div>
                    </button>

                    {# User Dropdown #}
                    <div 
                        class="user-dropdown dropdown-menu" 
                        id="user-dropdown"
                        role="menu"
                        aria-labelledby="user-menu-btn"
                    >
                        {# User Profile Card #}
                        <div class="user-profile-card">
                            <div class="profile-background"></div>
                            <div class="profile-content">
                                <div class="user-avatar-large">
                                    <i class="fas fa-user" aria-hidden="true"></i>
                                </div>
                                <div class="user-details">
                                    <div class="user-name">{{ app.user.email|split('@')|first }}</div>
                                    <div class="user-email">{{ app.user.email }}</div>
                                    <div class="user-roles">
                                        {% for role in app.user.roles %}
                                            <span class="role-badge">{{ role|replace({'ROLE_': ''})|replace({'_': ' '})|title }}</span>
                                        {% endfor %}
                                    </div>
                                    <div class="user-stats">
                                        <div class="stat-item">
                                            <span class="stat-value">12</span>
                                            <span class="stat-label">Projetos</span>
                                        </div>
                                        <div class="stat-item">
                                            <span class="stat-value">48</span>
                                            <span class="stat-label">Tarefas</span>
                                        </div>
                                        <div class="stat-item">
                                            <span class="stat-value">7</span>
                                            <span class="stat-label">Alertas</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="dropdown-divider"></div>

                        {# Quick Actions #}
                        <div class="dropdown-section">
                            <span class="dropdown-section-title">
                                <i class="fas fa-bolt"></i>
                                A\u00e7\u00f5es R\u00e1pidas
                            </span>
                            <div class="quick-actions-grid">
                                <a href="#" class="quick-action">
                                    <i class="fas fa-plus"></i>
                                    <span>Novo</span>
                                </a>
                                <a href="#" class="quick-action">
                                    <i class="fas fa-upload"></i>
                                    <span>Upload</span>
                                </a>
                                <a href="#" class="quick-action">
                                    <i class="fas fa-download"></i>
                                    <span>Download</span>
                                </a>
                                <a href="#" class="quick-action">
                                    <i class="fas fa-share"></i>
                                    <span>Compartilhar</span>
                                </a>
                            </div>
                        </div>

                        <div class="dropdown-divider"></div>

                        {# Dashboard Links (Role-based) #}
                        <div class="dropdown-section">
                            <span class="dropdown-section-title">
                                <i class="fas fa-tachometer-alt"></i>
                                Dashboards
                            </span>
                            
                            {% if 'ROLE_ACCOUNT_ADMIN' in app.user.roles %}
                                <a href="{{ path('app_account_admin_dashboard') }}" class="dropdown-item">
                                    <div class="dropdown-item-icon admin">
                                        <i class="fas fa-chart-line"></i>
                                    </div>
                                    <div class="dropdown-item-content">
                                        <span>Dashboard Admin</span>
                                        <span class="dropdown-item-subtitle">Vis\u00e3o geral do sistema</span>
                                    </div>
                                    <i class="fas fa-chevron-right dropdown-item-arrow"></i>
                                </a>
                            {% endif %}
                            
                            {% if 'ROLE_ADMIN_PARTNER' in app.user.roles %}
                                <a href="{{ path('app_partner_dashboard') }}" class="dropdown-item">
                                    <div class="dropdown-item-icon partner">
                                        <i class="fas fa-handshake"></i>
                                    </div>
                                    <div class="dropdown-item-content">
                                        <span>Dashboard Partner</span>
                                        <span class="dropdown-item-subtitle">Gest\u00e3o de parcerias</span>
                                    </div>
                                    <i class="fas fa-chevron-right dropdown-item-arrow"></i>
                                </a>
                            {% endif %}
                            
                            {% if 'ROLE_FIELD_AGENT' in app.user.roles %}
                                <a href="{{ path('app_field_agent_dashboard') }}" class="dropdown-item">
                                    <div class="dropdown-item-icon agent">
                                        <i class="fas fa-map-marker-alt"></i>
                                    </div>
                                    <div class="dropdown-item-content">
                                        <span>Dashboard Agente</span>
                                        <span class="dropdown-item-subtitle">Tarefas de campo</span>
                                    </div>
                                    <i class="fas fa-chevron-right dropdown-item-arrow"></i>
                                </a>
                            {% endif %}
                            
                            {% if 'ROLE_USER' in app.user.roles %}
                                <a href="{{ path('app_user_dashboard') }}" class="dropdown-item">
                                    <div class="dropdown-item-icon user">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <div class="dropdown-item-content">
                                        <span>Meu Dashboard</span>
                                        <span class="dropdown-item-subtitle">Painel pessoal</span>
                                    </div>
                                    <i class="fas fa-chevron-right dropdown-item-arrow"></i>
                                </a>
                            {% endif %}
                        </div>

                        <div class="dropdown-divider"></div>

                        {# Settings & Profile #}
                        <div class="dropdown-section">
                            <span class="dropdown-section-title">
                                <i class="fas fa-cog"></i>
                                Configura\u00e7\u00f5es
                            </span>
                            <a href="#" class="dropdown-item">
                                <div class="dropdown-item-icon">
                                    <i class="fas fa-user-circle"></i>
                                </div>
                                <div class="dropdown-item-content">
                                    <span>Meu Perfil</span>
                                    <span class="dropdown-item-subtitle">Gerencie seus dados</span>
                                </div>
                                <span class="dropdown-item-shortcut">⌘P</span>
                            </a>
                            <a href="#" class="dropdown-item">
                                <div class="dropdown-item-icon">
                                    <i class="fas fa-cog"></i>
                                </div>
                                <div class="dropdown-item-content">
                                    <span>Configura\u00e7\u00f5es</span>
                                    <span class="dropdown-item-subtitle">Prefer\u00eancias da conta</span>
                                </div>
                                <span class="dropdown-item-shortcut">⌘,</span>
                            </a>
                            <a href="#" class="dropdown-item">
                                <div class="dropdown-item-icon">
                                    <i class="fas fa-bell"></i>
                                </div>
                                <div class="dropdown-item-content">
                                    <span>Notifica\u00e7\u00f5es</span>
                                    <span class="dropdown-item-subtitle">Gerencie alertas</span>
                                </div>
                                <span class="notification-badge">3</span>
                            </a>
                            <a href="#" class="dropdown-item">
                                <div class="dropdown-item-icon">
                                    <i class="fas fa-question-circle"></i>
                                </div>
                                <div class="dropdown-item-content">
                                    <span>Ajuda</span>
                                    <span class="dropdown-item-subtitle">Central de suporte</span>
                                </div>
                                <span class="dropdown-item-shortcut">?</span>
                            </a>
                        </div>

                        <div class="dropdown-divider"></div>

                        {# Logout #}
                        <a href="{{ path('app_logout') }}" class="dropdown-item logout">
                            <div class="dropdown-item-icon">
                                <i class="fas fa-sign-out-alt"></i>
                            </div>
                            <div class="dropdown-item-content">
                                <span>Sair</span>
                                <span class="dropdown-item-subtitle">Encerrar sess\u00e3o</span>
                            </div>
                            <span class="dropdown-item-shortcut">⇧⌘Q</span>
                        </a>
                    </div>
                </div>
            {% else %}
                {# ----------------------------------------
                   Auth Buttons (Not logged in)
                   ---------------------------------------- #}
                <div class="auth-buttons">
                    <a href="{{ path('app_login') }}" class="btn btn-ghost">
                        <i class="fas fa-sign-in-alt" aria-hidden="true"></i>
                        <span>Entrar</span>
                    </a>
                    <a href="{{ path('app_register') }}" class="btn btn-primary btn-glow">
                        <i class="fas fa-user-plus" aria-hidden="true"></i>
                        <span>Cadastrar</span>
                        <i class="fas fa-arrow-right btn-arrow" aria-hidden="true"></i>
                    </a>
                </div>
            {% endif %}
        </div>

        {# ----------------------------------------
           Mobile Menu Toggle
           ---------------------------------------- #}
        <button 
            class="mobile-menu-toggle" 
            id="mobile-menu-toggle"
            aria-label="Menu"
            aria-expanded="false"
            aria-controls="mobile-nav"
            data-tooltip="Menu"
            data-tooltip-position="bottom"
        >
            <span class="hamburger" aria-hidden="true">
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
            </span>
        </button>
    </div>
</header>
