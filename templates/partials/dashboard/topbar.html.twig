<header class="dashboard-topbar">
    <div class="dashboard-topbar-start">
        <button
            type="button"
            class="dashboard-sidebar-toggle"
            data-dashboard-sidebar-toggle
            aria-controls="dashboard-sidebar"
            aria-expanded="false"
            aria-label="Abrir menu lateral"
        >
            <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>

        <div class="dashboard-page-heading">
            <p class="dashboard-page-eyebrow">Painel de monitoramento</p>
            <h1>{% block dashboard_page_title %}Dashboard{% endblock %}</h1>
        </div>
    </div>

    <div class="dashboard-topbar-end">
        <div class="dashboard-search">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>

            <input
                type="search"
                class="dashboard-search-input"
                placeholder="Buscar no painel..."
                aria-label="Buscar no painel"
            >

            <kbd>Ctrl K</kbd>
        </div>

        <div class="dashboard-notifications">
            <button
                type="button"
                class="dashboard-icon-button"
                data-dashboard-notifications-toggle
                aria-label="Abrir notificações"
                aria-expanded="false"
            >
                <i class="fa-regular fa-bell" aria-hidden="true"></i>
                <span class="dashboard-icon-badge">3</span>
            </button>

            <div class="dashboard-notification-panel" data-dashboard-notifications-panel hidden>
                <div class="dashboard-notification-panel-header">
                    <div>
                        <strong>Notificações</strong>
                        <span>3 não lidas</span>
                    </div>

                    <button type="button" data-dashboard-notifications-read>
                        Marcar como lidas
                    </button>
                </div>

                <ul class="dashboard-notification-list">
                    <li>
                        <span class="dashboard-notification-icon is-danger">
                            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                        </span>

                        <div>
                            <strong>Alerta de trânsito</strong>
                            <p>Congestionamento detectado na Av. Principal.</p>
                            <time>Há 5 minutos</time>
                        </div>
                    </li>

                    <li>
                        <span class="dashboard-notification-icon is-warning">
                            <i class="fa-solid fa-road" aria-hidden="true"></i>
                        </span>

                        <div>
                            <strong>Obra registrada</strong>
                            <p>Interdição parcial na Rua das Flores.</p>
                            <time>Há 15 minutos</time>
                        </div>
                    </li>
                </ul>

                <a href="#" class="dashboard-notification-panel-footer">
                    Ver todas as notificações
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
        </div>

        <div class="dashboard-account-menu">
            <button
                type="button"
                class="dashboard-account-trigger"
                data-dashboard-account-toggle
                aria-label="Abrir menu da conta"
                aria-expanded="false"
            >
                <span class="dashboard-user-avatar">
                    <i class="fa-solid fa-user" aria-hidden="true"></i>
                </span>

                <span class="dashboard-account-name">
                    {{ app.user ? app.user.email|split('@')|first : 'Usuário' }}
                </span>

                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
            </button>

            <div class="dashboard-account-dropdown" data-dashboard-account-panel hidden>
                <div class="dashboard-account-dropdown-user">
                    <span class="dashboard-user-avatar dashboard-user-avatar-large">
                        <i class="fa-solid fa-user" aria-hidden="true"></i>
                    </span>

                    <div>
                        <strong>{{ app.user ? app.user.email|split('@')|first : 'Usuário' }}</strong>
                        <span>{{ app.user ? app.user.email : '' }}</span>
                    </div>
                </div>

                <div class="dashboard-account-dropdown-divider"></div>

                <a href="#">
                    <i class="fa-regular fa-user" aria-hidden="true"></i>
                    Meu perfil
                </a>

                <a href="#">
                    <i class="fa-solid fa-gear" aria-hidden="true"></i>
                    Configurações
                </a>

                <div class="dashboard-account-dropdown-divider"></div>

                <a href="{{ path('app_logout') }}" class="is-danger">
                    <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                    Sair
                </a>
            </div>
        </div>
    </div>
</header>
