{% extends 'base.html.twig' %}
{% block title %}Recuperar acesso | WazeBR{% endblock %}
{% block meta_description %}Solicite as instruções para redefinir sua senha de acesso ao WazeBR.{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}
{% block flash_messages %}{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/pages/password-recovery.css') }}">
{% endblock %}
{% block body %}
<main class="pr-page" aria-labelledby="password-request-title">
    <div class="pr-shell">
        <div class="pr-brand"><span class="pr-brand__mark" aria-hidden="true">W</span><span>WazeBR<small>Monitoramento e mobilidade</small></span></div>
        <section class="pr-card">
            <header class="pr-header">
                <span class="pr-eyebrow">Recuperação de acesso</span>
                <h1 id="password-request-title">Esqueceu sua senha?</h1>
                <p id="password-request-description">Informe o e-mail da sua conta para solicitar um link de redefinição.</p>
            </header>
            {% for message in app.flashes('success') %}<div class="pr-notice pr-notice--success" role="status">{{ message }}</div>{% endfor %}
            {% for message in app.flashes('error') %}<div class="pr-notice pr-notice--error" role="alert">{{ message }}</div>{% endfor %}
            {{ form_start(form, {attr: {class: 'pr-form', 'aria-describedby': 'password-request-description password-request-privacy'}}) }}
                <div class="pr-errors">{{ form_errors(form) }}</div>
                <div class="pr-field">
                    {{ form_label(form.email, 'E-mail da sua conta') }}
                    {{ form_widget(form.email, {attr: {class: 'pr-input', autocomplete: 'email', inputmode: 'email', autocapitalize: 'none', spellcheck: 'false', placeholder: 'voce@exemplo.com', required: true}}) }}
                    <div class="pr-errors">{{ form_errors(form.email) }}</div>
                </div>
                <button type="submit" class="pr-submit">Enviar link de recuperação</button>
            {{ form_end(form) }}
            <p id="password-request-privacy" class="pr-privacy">Por segurança, a mensagem de confirmação é a mesma para e-mails cadastrados e não cadastrados.</p>
            <aside class="pr-help" aria-label="Ajuda com o e-mail de recuperação"><strong>Não encontrou a mensagem?</strong><p>Confira spam e lixo eletrônico. Se solicitar novamente, utilize o link mais recente.</p></aside>
            <footer class="pr-footer"><a href="{{ path('app_login') }}"><span aria-hidden="true">← </span>Voltar para o login</a></footer>
        </section>
        <p class="pr-caption">Acesso à plataforma WazeBR</p>
    </div>
</main>
{% endblock %}
