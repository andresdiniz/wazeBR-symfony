{% extends 'base.html.twig' %}\n\n{% block title %}Esqueci minha senha{% endblock %}\n\n{% block body %}\n<div class="auth-page">\n    <div class="auth-card">\n        <h1 class="auth-title">Esqueci minha senha</h1>\n        <p class="auth-subtitle">Informe seu e-mail para receber o link de redefinição.</p>\n\n        {% for message in app.flashes('success') %}\n            <div class="alert alert-success">{{ message }}</div>\n        {% endfor %}\n\n        {% for message in app.flashes('error') %}\n            <div class="alert alert-danger">{{ message }}</div>\n        {% endfor %}\n\n        {{ form_start(form) }}\n            {{ form_row(form.email) }}\n\n            <button type="submit" class="btn btn-primary w-100 mt-3">\n                Enviar instruções\n            </button>\n        {{ form_end(form) }}\n\n        <div class="text-center mt-3">\n            <a href="{{ path('app_login') }}">Voltar para o login</a>\n        </div>\n    </div>\n</div>\n{% endblock %}\n