{% extends 'base.html.twig' %}
{% block title %}Redefinir senha | WazeBR{% endblock %}
{% block meta_description %}Defina uma nova senha para sua conta no WazeBR.{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}
{% block flash_messages %}{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/pages/password-recovery.css') }}">
{% endblock %}
{% block body %}
<main class="pr-page" aria-labelledby="password-reset-title">
    <div class="pr-shell">
        <div class="pr-brand"><span class="pr-brand__mark" aria-hidden="true">W</span><span>WazeBR<small>Monitoramento e mobilidade</small></span></div>
        <section class="pr-card">
            <header class="pr-header">
                <span class="pr-eyebrow">Segurança da conta</span>
                <h1 id="password-reset-title">Crie sua nova senha</h1>
                <p id="password-reset-description">Escolha uma senha exclusiva e repita-a para confirmar.</p>
            </header>
            {% for message in app.flashes('success') %}<div class="pr-notice pr-notice--success" role="status">{{ message }}</div>{% endfor %}
            {% for message in app.flashes('error') %}<div class="pr-notice pr-notice--error" role="alert">{{ message }}</div>{% endfor %}
            {{ form_start(form, {attr: {class: 'pr-form', 'aria-describedby': 'password-reset-description'}}) }}
                <div class="pr-errors">{{ form_errors(form) }}{{ form_errors(form.plainPassword) }}</div>
                <div class="pr-field">
                    {{ form_label(form.plainPassword.first, 'Nova senha') }}
                    {{ form_widget(form.plainPassword.first, {attr: {class: 'pr-input', autocomplete: 'new-password', placeholder: 'Digite a nova senha', minlength: 8, required: true, 'aria-describedby': 'password-requirements'}}) }}
                    <div class="pr-errors">{{ form_errors(form.plainPassword.first) }}</div>
                    <p id="password-requirements" class="pr-privacy">Use pelo menos 8 caracteres. Prefira uma senha exclusiva para esta conta.</p>
                </div>
                <div class="pr-field">
                    {{ form_label(form.plainPassword.second, 'Confirme a nova senha') }}
                    {{ form_widget(form.plainPassword.second, {attr: {class: 'pr-input', autocomplete: 'new-password', placeholder: 'Repita a nova senha', minlength: 8, required: true}}) }}
                    <div class="pr-errors">{{ form_errors(form.plainPassword.second) }}</div>
                </div>
                <button type="submit" class="pr-submit">Salvar nova senha</button>
            {{ form_end(form) }}
            <aside class="pr-help" aria-label="Próximo passo"><strong>Seu acesso, renovado</strong><p>Depois de salvar, entre no sistema com sua nova senha. Este link não poderá ser reutilizado.</p></aside>
            <footer class="pr-footer">
                <p style="margin: 0 0 12px"><a href="{{ path('app_forgot_password_request') }}">Solicitar outro link de recuperação</a></p>
                <a href="{{ path('app_login') }}"><span aria-hidden="true">← </span>Voltar para o login</a>
            </footer>
        </section>
        <p class="pr-caption">Acesso à plataforma WazeBR</p>
    </div>
</main>
{% endblock %}
