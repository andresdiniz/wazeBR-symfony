{% extends 'base.html.twig' %}

{% block title %}Redefinir senha | WazeBR{% endblock %}

{% block meta_description %}
    Defina uma nova senha para sua conta no WazeBR.
{% endblock %}

{% block meta_robots %}noindex, nofollow{% endblock %}

{% block flash_messages %}{% endblock %}

{% block body %}
    <main class="auth-page" aria-labelledby="password-reset-title">
        <section class="auth-card">
            <header class="mb-6">
                <p class="text-sm mb-2">WazeBR · Segurança da conta</p>

                <h1 id="password-reset-title" class="auth-title">
                    Redefinir senha
                </h1>

                <p id="password-reset-description" class="auth-subtitle">
                    Escolha uma nova senha e repita-a no campo de confirmação.
                </p>
            </header>

            {% for message in app.flashes('success') %}
                <div class="alert alert-success" role="status">
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger" role="alert">
                    {{ message }}
                </div>
            {% endfor %}

            {{ form_start(form, {
                attr: {
                    'aria-describedby': 'password-reset-description'
                }
            }) }}

                {{ form_errors(form) }}

                <fieldset class="mb-4">
                    <legend class="text-sm mb-3">
                        Nova senha de acesso
                    </legend>

                    {{ form_errors(form.plainPassword) }}

                    <p id="password-requirements" class="text-sm mb-3">
                        Use pelo menos 8 caracteres.
                        Prefira uma senha exclusiva para esta conta.
                    </p>

                    <div class="mb-4">
                        {{ form_row(form.plainPassword.first, {
                            label: 'Nova senha',
                            attr: {
                                autocomplete: 'new-password',
                                placeholder: 'Digite a nova senha',
                                minlength: 8,
                                required: true,
                                'aria-describedby': 'password-requirements'
                            }
                        }) }}
                    </div>

                    <div class="mb-4">
                        {{ form_row(form.plainPassword.second, {
                            label: 'Confirme a nova senha',
                            attr: {
                                autocomplete: 'new-password',
                                placeholder: 'Repita a nova senha',
                                minlength: 8,
                                required: true,
                                'aria-describedby': 'password-requirements'
                            }
                        }) }}
                    </div>
                </fieldset>

                <button
                    type="submit"
                    class="btn btn-primary w-100 mt-3"
                >
                    Salvar nova senha
                </button>

            {{ form_end(form) }}

            <p class="text-sm mt-4">
                Após redefinir a senha, entre no sistema com a nova senha.
            </p>

            <footer class="text-center mt-4">
                <p>
                    <a href="{{ path('app_forgot_password_request') }}">
                        Solicitar outro link de recuperação
                    </a>
                </p>

                <p class="mt-3">
                    <a href="{{ path('app_login') }}">
                        Voltar para o login
                    </a>
                </p>
            </footer>
        </section>
    </main>
{% endblock %}
