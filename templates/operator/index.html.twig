{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Operadores{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-3">Operadores</h1>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            {% if operators|length > 0 %}
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Email</th>
                            <th>Partner</th>
                            <th>Status</th>
                            <th>Aç°µes</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for operator in operators %}
                            <tr>
                                <td>{{ operator.name }}</td>
                                <td>{{ operator.email }}</td>
                                <td>{{ operator.partner.name }}</td>
                                <td>
                                    <span class="badge bg-{{ operator.active ? 'success' : 'danger' }}">
                                        {{ operator.active ? 'Ativo' : 'Inativo' }}
                                    </span>
                                </td>
                                <td>
                                    <a href="{{ path('operator_edit', {id: operator.id}) }}" class="btn btn-sm btn-primary">Editar</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p class="text-muted mb-0">Nenhum operador encontrado</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
