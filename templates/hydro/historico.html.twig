{% extends 'base.html.twig' %}

{% block title %}Nível dos Rios — Histórico{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ── Container ── */
.hydro-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: var(--space-5) var(--space-4);
}

/* ── Toolbar ── */
.hydro-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-3);
  margin-bottom: var(--space-5);
  padding: var(--space-4) var(--space-5);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-sm);
}
.hydro-toolbar-left h1 {
  font-size: var(--text-xl);
  font-weight: 800;
  letter-spacing: -.02em;
  margin: 0;
  color: var(--color-text);
  display: flex;
  align-items: center;
  gap: var(--space-2);
}
.hydro-toolbar-left small {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}
.hydro-toolbar-right {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
  align-items: center;
}

/* ── Filtros ── */
.filter-card {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4) var(--space-5);
  margin-bottom: var(--space-5);
  box-shadow: var(--shadow-sm);
}
.filter-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr auto;
  gap: var(--space-3);
  align-items: end;
}
.filter-label {
  display: block;
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-text-muted);
  margin-bottom: var(--space-1);
  text-transform: uppercase;
  letter-spacing: .02em;
}
.filter-actions {
  display: flex;
  gap: var(--space-2);
}
.form-control-sm {
  padding: .5rem .65rem;
  font-size: var(--text-sm);
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  background: var(--color-bg-card);
  color: var(--color-text);
  width: 100%;
  transition: border-color var(--transition), box-shadow var(--transition);
}
.form-control-sm:focus {
  outline: none;
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px rgba(var(--color-primary-rgb), .15);
}
@media(max-width: 768px) {
  .filter-grid {
    grid-template-columns: 1fr 1fr;
  }
  .filter-grid .filter-full {
    grid-column: 1 / -1;
  }
  .filter-grid .filter-actions {
    grid-column: 1 / -1;
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
}

/* ── Card e tabela ── */
.card {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4) var(--space-5);
  border-bottom: 1px solid var(--color-border);
  background: var(--color-bg-muted);
  flex-wrap: wrap;
  gap: var(--space-2);
}
.card-title {
  font-weight: 600;
  font-size: var(--text-base);
  color: var(--color-text);
}
.badge {
  display: inline-block;
  padding: .25rem .75rem;
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: 600;
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  color: var(--color-text-muted);
}

.table-wrap {
  overflow-x: auto;
  padding: 0;
}
.table-wrap table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--text-sm);
}
.table-wrap table th {
  background: var(--color-bg-muted);
  padding: var(--space-3) var(--space-4);
  text-align: left;
  font-weight: 600;
  color: var(--color-text-muted);
  border-bottom: 1px solid var(--color-border);
  white-space: nowrap;
}
.table-wrap table td {
  padding: var(--space-3) var(--space-4);
  border-bottom: 1px solid var(--color-divider);
  vertical-align: middle;
}
.table-wrap table tbody tr:last-child td { border-bottom: none; }
.table-wrap table tbody tr:hover td {
  background: var(--color-bg-muted);
}

/* ── Row highlight por nível ── */
/* Cores de severidade dedicadas (--color-atencao/--color-alerta-hidro/
   --color-transbordamento, definidas em app.css) — antes usava
   --color-gold/--color-warning/--color-error, que ou não existiam ou
   colidiam com outros usos globais, fazendo "atenção" e "alerta"
   renderizarem com a mesma cor. */
.row-atencao td         { background: color-mix(in srgb, var(--color-atencao) 7%, var(--color-bg-card)); }
.row-alerta td          { background: color-mix(in srgb, var(--color-alerta-hidro) 8%, var(--color-bg-card)); }
.row-transbordamento td { background: color-mix(in srgb, var(--color-transbordamento) 8%, var(--color-bg-card)); }
tr.row-atencao:hover td         { background: color-mix(in srgb, var(--color-atencao) 14%, var(--color-bg-card)); }
tr.row-alerta:hover td          { background: color-mix(in srgb, var(--color-alerta-hidro) 14%, var(--color-bg-card)); }
tr.row-transbordamento:hover td { background: color-mix(in srgb, var(--color-transbordamento) 14%, var(--color-bg-card)); }

.level-icon {
  font-size: 1.2rem;
  line-height: 1;
  display: inline-block;
  text-align: center;
}

/* ── Paginação ── */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
  margin-top: var(--space-5);
  flex-wrap: wrap;
}
.pagination-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36px;
  height: 36px;
  padding: 0 var(--space-2);
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  background: var(--color-bg-card);
  transition: all var(--transition);
  text-decoration: none;
  cursor: pointer;
}
.pagination-btn:hover {
  background: var(--color-bg-muted);
  color: var(--color-text);
  text-decoration: none;
}
.pagination-btn.active {
  background: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
  font-weight: 600;
}
.pagination-btn.disabled {
  opacity: .4;
  pointer-events: none;
}
.pagination-info {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-3);
  text-align: center;
}

/* ── Gráfico de evolução (histórico) ── */
.hydro-chart-wrap {
  position: relative;
  height: 280px;
}
@media (min-width: 768px) {
  .hydro-chart-wrap { height: 340px; }
}

/* ── Empty state ── */
.hydro-empty {
  padding: var(--space-16) var(--space-8);
  text-align: center;
  color: var(--color-text-muted);
}
.hydro-empty-icon {
  font-size: 3rem;
  margin-bottom: var(--space-4);
  opacity: .6;
}
.hydro-empty h3 {
  font-size: var(--text-lg);
  color: var(--color-text);
  margin-bottom: var(--space-2);
  font-weight: 600;
}
</style>
{% endblock %}

{% block body %}

<div class="hydro-container">
  {# ── Toolbar ── #}
  <div class="hydro-toolbar">
    <div class="hydro-toolbar-left">
      <h1>📋 Nível dos Rios — Histórico</h1>
      <small>{{ total }} registro(s) encontrado(s)</small>
    </div>
    <div class="hydro-toolbar-right">
      <a href="{{ path('hydro_historico_export') }}?{{ app.request.queryString }}" class="btn btn-success btn-sm js-download-btn">
        <i data-lucide="download" style="width:15px;height:15px"></i> Exportar CSV
      </a>
      <a href="{{ path('hydro_live') }}" class="btn btn-primary btn-sm">
        <i data-lucide="waves" style="width:15px;height:15px"></i> Ao Vivo
      </a>
    </div>
  </div>

  {# ── Filtros ── #}
  <form method="get" class="filter-card">
    <div class="filter-grid">
      <div class="filter-full">
        <label class="filter-label">Estação</label>
        <select name="station" class="form-control-sm">
          <option value="">Todas as estações</option>
          {% for s in stations %}
            <option value="{{ s.station_code }}" {% if station == s.station_code %}selected{% endif %}>
              {{ s.station_name }} — {{ s.municipality }}/{{ s.state }}
            </option>
          {% endfor %}
        </select>
      </div>
      <div>
        <label class="filter-label">Nível de alerta</label>
        <select name="level" class="form-control-sm">
          <option value="">Todos</option>
          <option value="normal"          {% if level == 'normal'          %}selected{% endif %}>✅ Normal</option>
          <option value="atencao"         {% if level == 'atencao'         %}selected{% endif %}>⚠️ Atenção</option>
          <option value="alerta"          {% if level == 'alerta'          %}selected{% endif %}>🚨 Alerta</option>
          <option value="transbordamento" {% if level == 'transbordamento' %}selected{% endif %}>🌊 Transbordamento</option>
        </select>
      </div>
      <div>
        <label class="filter-label">De</label>
        <input type="date" name="date_from" class="form-control-sm" value="{{ date_from }}">
      </div>
      <div>
        <label class="filter-label">Até</label>
        <input type="date" name="date_to" class="form-control-sm" value="{{ date_to }}">
      </div>
      <div class="filter-actions">
        <button type="submit" class="btn btn-primary btn-sm">
          <i data-lucide="search" style="width:14px;height:14px"></i> Filtrar
        </button>
        <a href="{{ path('hydro_historico') }}" class="btn btn-ghost btn-sm" title="Limpar filtros">
          <i data-lucide="x" style="width:14px;height:14px"></i>
        </a>
      </div>
    </div>
  </form>

  {# ── Gráfico de evolução (só com uma estação selecionada) ── #}
  {% if station != '' %}
    {% if series is not empty %}
      <div id="hydro-series-data"
        data-series="{{ series|json_encode|e('html_attr') }}"
        style="display:none"
      ></div>
      <div class="card" style="margin-bottom:var(--space-5)">
        <div class="card-header">
          <span class="card-title">📈 Evolução do nível — {{ selectedStationName ?? station }}</span>
          <span class="badge">{{ series|length }} leituras no período</span>
        </div>
        <div class="card-body" style="padding:var(--space-4)">
          <div class="hydro-chart-wrap">
            <canvas id="hydro-history-chart"></canvas>
          </div>
        </div>
      </div>
    {% else %}
      <div class="card" style="margin-bottom:var(--space-5)">
        <div class="hydro-empty">
          <div class="hydro-empty-icon">📈</div>
          <h3>Sem leituras no período para esta estação</h3>
          <p>Ajuste o intervalo de datas para ver o gráfico de evolução.</p>
        </div>
      </div>
    {% endif %}
  {% endif %}

  {# ── Tabela ── #}
  <div class="card">
    <div class="card-header">
      <span class="card-title">Registros históricos</span>
      <span class="badge">{{ total }} resultados</span>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th style="width:44px"></th>
            <th>Estação</th>
            <th>Município / UF</th>
            <th style="text-align:right">Nível (m)</th>
            <th style="text-align:right">Atenção</th>
            <th style="text-align:right">Alerta</th>
            <th style="text-align:right">Transb.</th>
            <th style="white-space:nowrap">Medido em</th>
          </tr>
        </thead>
        <tbody>
        {% for r in rows %}
          {% set rowCss = '' %}
          {% set icon   = '✅' %}
          {% if r.alert_level == 'atencao' %}
            {% set rowCss = 'row-atencao' %}{% set icon = '⚠️' %}
          {% elseif r.alert_level == 'alerta' %}
            {% set rowCss = 'row-alerta' %}{% set icon = '🚨' %}
          {% elseif r.alert_level == 'transbordamento' %}
            {% set rowCss = 'row-transbordamento' %}{% set icon = '🌊' %}
          {% endif %}
          <tr class="{{ rowCss }}">
            <td><span class="level-icon" title="{{ r.alert_level|capitalize }}">{{ icon }}</span></td>
            <td>
              <div style="font-weight:600">{{ r.station_name }}</div>
              <div style="font-size:var(--text-xs);color:var(--color-text-muted)">{{ r.station_code }}</div>
            </td>
            <td style="white-space:nowrap">{{ r.municipality }} / {{ r.state }}</td>
            <td style="text-align:right;font-weight:700;font-variant-numeric:tabular-nums">
              {{ r.water_level is not null ? r.water_level|number_format(2,',','.') ~ ' m' : '—' }}
            </td>
            <td style="text-align:right;font-variant-numeric:tabular-nums">
              {{ r.cota_atencao is not null ? r.cota_atencao|number_format(2,',','.') ~ ' m' : '—' }}
            </td>
            <td style="text-align:right;font-variant-numeric:tabular-nums">
              {{ r.cota_alerta is not null ? r.cota_alerta|number_format(2,',','.') ~ ' m' : '—' }}
            </td>
            <td style="text-align:right;font-variant-numeric:tabular-nums">
              {{ r.cota_transbordamento is not null ? r.cota_transbordamento|number_format(2,',','.') ~ ' m' : '—' }}
            </td>
            <td style="white-space:nowrap;font-size:var(--text-xs)">
              <time data-utc="{{ r.measured_at|date('Y-m-d H:i:s') }}" data-fmt="datetime">
                {{ r.measured_at|date('d/m/Y H:i') }}
              </time>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="8">
              <div class="hydro-empty">
                <div class="hydro-empty-icon">🔍</div>
                <h3>Nenhum resultado</h3>
                <p>Tente ajustar os filtros ou ampliar o intervalo de datas.</p>
              </div>
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  {# ── Paginação ── #}
  {% if pages > 1 %}
  <nav class="pagination" aria-label="Paginação">
    {% if page > 1 %}
      <a class="pagination-btn" href="?{{ app.request.query.all|merge({page: page - 1})|url_encode }}" aria-label="Anterior">
        <i data-lucide="chevron-left" style="width:14px;height:14px"></i>
      </a>
    {% else %}
      <span class="pagination-btn disabled" aria-hidden="true">
        <i data-lucide="chevron-left" style="width:14px;height:14px"></i>
      </span>
    {% endif %}

    {% for p in 1..pages %}
      {% if p == page %}
        <span class="pagination-btn active" aria-current="page">{{ p }}</span>
      {% elseif p == 1 or p == pages or (p >= page - 2 and p <= page + 2) %}
        <a class="pagination-btn" href="?{{ app.request.query.all|merge({page: p})|url_encode }}">{{ p }}</a>
      {% elseif p == page - 3 or p == page + 3 %}
        <span class="pagination-btn disabled" aria-hidden="true">…</span>
      {% endif %}
    {% endfor %}

    {% if page < pages %}
      <a class="pagination-btn" href="?{{ app.request.query.all|merge({page: page + 1})|url_encode }}" aria-label="Próxima">
        <i data-lucide="chevron-right" style="width:14px;height:14px"></i>
      </a>
    {% else %}
      <span class="pagination-btn disabled" aria-hidden="true">
        <i data-lucide="chevron-right" style="width:14px;height:14px"></i>
      </span>
    {% endif %}
  </nav>
  <p class="pagination-info">Página {{ page }} de {{ pages }} — {{ total }} registros no total</p>
  {% endif %}
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js" crossorigin=""></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  if (typeof lucide !== 'undefined' && typeof lucide.createIcons === 'function') {
    lucide.createIcons();
  }

  const dataEl = document.getElementById('hydro-series-data');
  const canvas = document.getElementById('hydro-history-chart');
  if (!dataEl || !canvas) return;

  let series;
  try {
    series = JSON.parse(dataEl.dataset.series);
  } catch (e) {
    console.error('[HydroHistorico] Erro ao parsear série:', e);
    return;
  }
  if (!series.length) return;

  const labels = series.map(r => {
    const d = new Date(r.measured_at);
    return d.toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
  });
  const levels = series.map(r => r.water_level !== null ? +r.water_level : null);

  // Cotas de referência: usa o último valor não nulo da série (elas
  // raramente mudam, mas por segurança pegamos o mais recente em vez do
  // primeiro registro, caso a estação tenha sido recalibrada no período).
  const lastWith = (key) => {
    for (let i = series.length - 1; i >= 0; i--) {
      if (series[i][key] !== null && series[i][key] !== undefined) return +series[i][key];
    }
    return null;
  };
  const cotaAtencao = lastWith('cota_atencao');
  const cotaAlerta = lastWith('cota_alerta');
  const cotaTransb = lastWith('cota_transbordamento');

  const flatLine = (value) => value !== null ? series.map(() => value) : null;

  const datasets = [
    {
      label: 'Nível (m)',
      data: levels,
      borderColor: '#0284c7',
      backgroundColor: 'rgba(2,132,199,0.08)',
      fill: true,
      tension: 0.25,
      pointRadius: series.length > 60 ? 0 : 2,
      spanGaps: true,
      borderWidth: 2.5,
      order: 1,
    },
  ];

  const refLine = (label, value, color) => ({
    label: label,
    data: flatLine(value),
    borderColor: color,
    borderDash: [6, 4],
    borderWidth: 1.5,
    pointRadius: 0,
    fill: false,
    order: 2,
  });

  if (cotaAtencao !== null) datasets.push(refLine('Atenção', cotaAtencao, '#f59e0b'));
  if (cotaAlerta !== null) datasets.push(refLine('Alerta', cotaAlerta, '#f97316'));
  if (cotaTransb !== null) datasets.push(refLine('Transbordamento', cotaTransb, '#dc2626'));

  new Chart(canvas, {
    type: 'line',
    data: { labels: labels, datasets: datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { position: 'top', labels: { boxWidth: 12, font: { size: 11 } } },
        tooltip: {
          callbacks: {
            label: ctx => ctx.dataset.label + ': ' + (ctx.parsed.y !== null ? ctx.parsed.y.toFixed(2) + ' m' : '—'),
          },
        },
      },
      scales: {
        x: { ticks: { maxTicksLimit: 12, maxRotation: 45, font: { size: 10 } } },
        y: {
          title: { display: true, text: 'metros' },
          ticks: { callback: v => v + ' m' },
        },
      },
    },
  });
});
</script>
{% endblock %}

