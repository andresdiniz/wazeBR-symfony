{% extends 'base.html.twig' %}

{% block title %}Nível dos Rios — Ao Vivo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/hydro-live.css') }}">
    <style>
        /* fallback CSS para caso o asset não carregue */
    </style>
{% endblock %}

{% block body %}
<div class="hydro-live-container">

    {# ── Mensagem de erro, se houver ── #}
    {% if error is defined and error %}
        <div class="alert alert-danger" role="alert">
            <strong>⚠️ Erro:</strong> {{ error }}
        </div>
    {% endif %}

    {# ── Header ── #}
    <div class="hydro-header">
        <div class="hydro-header-left">
            <h1>
                🌊 Nível dos Rios
                <span class="badge-live">
                    <span class="dot"></span> Ao vivo
                </span>
            </h1>
            <small>
                atualiza a cada 60 s &nbsp;•&nbsp; última leitura: <span id="last-update">—</span>
            </small>
        </div>
        <div class="hydro-header-right">
            <a href="{{ path('hydro_historico') }}" class="btn btn-ghost btn-sm">
                <i data-lucide="history" style="width:16px;height:16px"></i> Histórico
            </a>
            <button id="btn-refresh" class="btn btn-primary btn-sm">
                <i data-lucide="refresh-cw" id="refresh-icon" style="width:16px;height:16px"></i> Atualizar
            </button>
        </div>
    </div>

    {# ── KPIs ── #}
    {% set cnt_normal = 0 %}
    {% set cnt_atencao = 0 %}
    {% set cnt_alerta = 0 %}
    {% set cnt_transb = 0 %}
    {% for r in rows %}
        {% if r.alert_level == 'atencao' %}{% set cnt_atencao = cnt_atencao + 1 %}
        {% elseif r.alert_level == 'alerta' %}{% set cnt_alerta = cnt_alerta + 1 %}
        {% elseif r.alert_level == 'transbordamento' %}{% set cnt_transb = cnt_transb + 1 %}
        {% else %}{% set cnt_normal = cnt_normal + 1 %}
        {% endif %}
    {% endfor %}

    <div class="kpi-grid">
        <div class="kpi-card kpi-normal">
            <div class="kpi-icon">✅</div>
            <div class="kpi-value" id="cnt-normal">{{ cnt_normal }}</div>
            <div class="kpi-label">Normal</div>
        </div>
        <div class="kpi-card kpi-atencao">
            <div class="kpi-icon">⚠️</div>
            <div class="kpi-value" id="cnt-atencao">{{ cnt_atencao }}</div>
            <div class="kpi-label">Atenção</div>
        </div>
        <div class="kpi-card kpi-alerta">
            <div class="kpi-icon">🚨</div>
            <div class="kpi-value" id="cnt-alerta">{{ cnt_alerta }}</div>
            <div class="kpi-label">Alerta</div>
        </div>
        <div class="kpi-card kpi-transb">
            <div class="kpi-icon">🌊</div>
            <div class="kpi-value" id="cnt-transb">{{ cnt_transb }}</div>
            <div class="kpi-label">Transbordamento</div>
        </div>
    </div>

    {# ── Gráfico ── #}
    <div class="hydro-card">
        <div class="hydro-card-header">
            <span class="card-title">📊 Nível por Estação</span>
            <span class="badge-count">{{ rows|length }} estações</span>
        </div>
        <div class="hydro-card-body">
            <div class="chart-container">
                <canvas id="hydro-chart"></canvas>
            </div>
        </div>
    </div>

    {# ── Tabela ── #}
    <div class="hydro-card">
        <div class="hydro-card-header">
            <span class="card-title">📋 Estações monitoradas</span>
            <span class="badge-count" id="total-count">{{ rows|length }} estações</span>
        </div>
        <div class="hydro-card-body">
            <div class="hydro-table-wrap">
                <table class="hydro-table" id="hydro-table">
                    <thead>
                        <tr>
                            <th style="width:44px"></th>
                            <th>Estação</th>
                            <th>Município / UF</th>
                            <th class="text-right">Nível (m)</th>
                            <th class="text-right">Atenção</th>
                            <th class="text-right">Alerta</th>
                            <th class="text-right">Transb.</th>
                            <th>Medido em</th>
                        </tr>
                    </thead>
                    <tbody id="hydro-tbody">
                    {% for r in rows %}
                        {% set rowCss = '' %}
                        {% set icon   = '✅' %}
                        {% set barCss = 'bar-normal' %}
                        {% if r.alert_level == 'atencao' %}
                            {% set rowCss = 'row-atencao' %}{% set icon = '⚠️' %}{% set barCss = 'bar-atencao' %}
                        {% elseif r.alert_level == 'alerta' %}
                            {% set rowCss = 'row-alerta' %}{% set icon = '🚨' %}{% set barCss = 'bar-alerta' %}
                        {% elseif r.alert_level == 'transbordamento' %}
                            {% set rowCss = 'row-transbordamento' %}{% set icon = '🌊' %}{% set barCss = 'bar-transb' %}
                        {% endif %}
                        {% set pct = 0 %}
                        {% if r.cota_transbordamento is not null and r.water_level is not null and r.cota_transbordamento > 0 %}
                            {% set pct_raw = ((r.water_level / r.cota_transbordamento) * 100)|round %}
                            {% set pct = pct_raw > 100 ? 100 : pct_raw %}
                        {% endif %}
                        <tr class="{{ rowCss }}">
                            <td class="text-center"><span class="level-icon" title="{{ r.alert_level|capitalize }}">{{ icon }}</span></td>
                            <td>
                                <div class="station-name">{{ r.station_name }}</div>
                                <div class="station-code">{{ r.station_code }}</div>
                            </td>
                            <td style="white-space:nowrap">{{ r.municipality }} / {{ r.state }}</td>
                            <td class="text-right">
                                <div class="level-value">{{ r.water_level is not null ? r.water_level|number_format(2,',','.') ~ ' m' : '—' }}</div>
                                {% if pct > 0 %}
                                    <div class="level-bar-wrap">
                                        <div class="level-bar {{ barCss }}" style="width:{{ pct }}%"></div>
                                    </div>
                                {% endif %}
                            </td>
                            <td class="text-right">{{ r.cota_atencao is not null ? r.cota_atencao|number_format(2,',','.') ~ ' m' : '—' }}</td>
                            <td class="text-right">{{ r.cota_alerta is not null ? r.cota_alerta|number_format(2,',','.') ~ ' m' : '—' }}</td>
                            <td class="text-right">{{ r.cota_transbordamento is not null ? r.cota_transbordamento|number_format(2,',','.') ~ ' m' : '—' }}</td>
                            <td style="white-space:nowrap;font-size:var(--text-xs)">
                                <time data-utc="{{ r.measured_at|date('Y-m-d H:i:s') }}" data-fmt="datetime">{{ r.measured_at|date('d/m H:i') }}</time>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8">
                                <div class="hydro-empty">
                                    <div class="empty-icon">💧</div>
                                    <h3>Sem dados hidrológicos</h3>
                                    <p>Nenhuma estação cadastrada ou aguardando primeira leitura.</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# ── Hidden field para URL do JS ── #}
    <input type="hidden" id="hydro-live-data-url" value="{{ path('hydro_live_data') }}">
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="{{ asset('js/hydro-live.js') }}"></script>
{% endblock %}
