{% extends 'layouts/dashboard.html.twig' %}
{% block title %}Irregularidades TVT | WazeBR{% endblock %}
{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/pages/tvt-irregularities.css') }}">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous">
<style>.tvi-map-section{margin:20px 0;padding:16px;border:1px solid var(--tvi-border,#d6e0e8);border-radius:14px;background:var(--tvi-surface,#fff)}.tvi-map-section h2{margin:0;font-size:18px}.tvi-map-section p{font-size:13px;line-height:1.7}.tvi-map{height:440px;width:100%;border-radius:10px;z-index:0}.tvi-map-legend{display:flex;flex-wrap:wrap;gap:14px;margin:12px 0;font-size:12px}.tvi-map-legend i{display:inline-block;width:18px;height:5px;vertical-align:middle;margin-right:5px}.tvi-map .leaflet-popup-content{line-height:1.7;color:#172b3a}@media(max-width:640px){.tvi-map{height:330px}}</style>
{% endblock %}
{% macro duration(value) %}{% if value is null %}—{% else %}{% set seconds = value|round(0) %}{{ seconds // 60 }} min {{ seconds % 60 }} s{% endif %}{% endmacro %}
{% block content %}
{% set link_filters = filters %}
{% if not partner_locked and not filters.partner %}{% set link_filters = filters|filter((value,key) => key != 'partner') %}{% endif %}
<div class="tvi-page">
<header class="tvi-heading"><div><a href="{{ path('dashboard') }}">Dashboard</a><span class="tvi-eyebrow">Monitoramento de tráfego</span><h1>Irregularidades TVT</h1><p>Ocorrências recebidas pelo feed, incluindo trechos independentes das rotas monitoradas.</p></div><a class="tvi-button" href="{{ path('tvt_irregularities_index',link_filters|merge({page:page})) }}">Atualizar listagem</a></header>
<aside class="tvi-notice">Situação e tempos refletem a última coleta salva, não uma conexão ao vivo. Cache de até 2 minutos. Dados carregados em {{ loaded_at|date('d/m/Y H:i:s','America/Sao_Paulo','UTC') }} (Brasília).</aside>
<form id="tvi-filter-form" class="tvi-filters" method="get" action="{{ path('tvt_irregularities_index') }}">
<label>Buscar trecho<input type="search" name="q" value="{{ filters.q }}" maxlength="120" placeholder="Nome, via ou cidade"></label>
<label>Situação<select name="status">{% for key,label in {'active':'Ativas na última coleta','inactive':'Inativas','all':'Todas'} %}<option value="{{ key }}" {{ filters.status == key ? 'selected' }}>{{ label }}</option>{% endfor %}</select></label>
<label>Última observação<select name="period">{% for key,label in {'24h':'Últimas 24 horas','7d':'Últimos 7 dias','30d':'Últimos 30 dias','all':'Todo o período'} %}<option value="{{ key }}" {{ filters.period == key ? 'selected' }}>{{ label }}</option>{% endfor %}</select></label>
<label>Nível<select name="level"><option value="all">Todos</option>{% for level in 0..5 %}<option value="{{ level }}" {{ filters.level == level ~ '' ? 'selected' }}>Nível {{ level }}</option>{% endfor %}</select></label>
{% if partner_locked %}<input type="hidden" name="partner" value="{{ filters.partner }}">{% else %}<label>ID do parceiro<input id="tvi-partner-filter" type="number" name="partner" min="0" value="{{ filters.partner ?: '' }}" placeholder="Todos"></label>{% endif %}
<label>Por página<select name="per_page">{% for size in [10,25,50,100] %}<option value="{{ size }}" {{ filters.per_page == size ? 'selected' }}>{{ size }}</option>{% endfor %}</select></label>
<div class="tvi-filter-actions"><button class="tvi-button tvi-button--primary" type="submit">Aplicar filtros</button><a class="tvi-button" href="{{ path('tvt_irregularities_index',partner_locked ? {partner:filters.partner} : {}) }}">Limpar</a></div>
</form>
<div class="tvi-summary"><strong>{{ total }}</strong> ocorrência(s) encontradas · Mostrando {{ first }}–{{ last }}<span>Horários em Brasília</span></div>
<section class="tvi-map-section" aria-labelledby="tvi-map-title">
<h2 id="tvi-map-title">Mapa das ocorrências desta página</h2>
<p>Somente os registros da página atual, com os mesmos filtros e parceiro. Linhas representam os pontos salvos; pontos isolados usam marcadores. Registros sem coordenadas válidas não são desenhados.</p>
<div class="tvi-map-legend">{% for level,color in {0:'#64748b',1:'#16a34a',2:'#65a30d',3:'#ca8a04',4:'#ea580c',5:'#dc2626'} %}<span><i style="background:{{ color }}"></i>Nível {{ level }}</span>{% endfor %}<span>Sem nível: cinza · Inativas: tracejadas</span></div>
<button type="button" class="tvi-button" id="tvi-map-fit">Enquadrar ocorrências</button>
<p id="tvi-map-status" role="status">Carregando mapa…</p><div id="tvi-map" class="tvi-map" role="region" aria-label="Mapa das irregularidades"></div>
</section>
{% if rows is empty %}<section class="tvi-empty"><h2>Nenhuma ocorrência neste recorte</h2><p>Ajuste situação e período. Uma lista vazia não confirma situação normal nem coleta funcionando.</p></section>{% else %}
<div class="tvi-table-wrap" tabindex="0" role="region" aria-label="Tabela de irregularidades com rolagem horizontal"><table class="tvi-table"><caption class="tvi-sr-only">Irregularidades observadas e últimos tempos recebidos</caption><thead><tr><th scope="col">Trecho / parceiro</th><th scope="col">Situação</th><th scope="col">Nível</th><th scope="col">Tempo observado</th><th scope="col">Referência histórica</th><th scope="col">Atraso calculado</th><th scope="col">Primeiro registro</th><th scope="col">Última observação</th><th scope="col">Desativada em</th><th scope="col">Localização</th></tr></thead><tbody>
{% for row in rows %}<tr>
<td><strong>{{ row.name }}</strong><small>{{ row.partner_name ?: 'Parceiro não informado' }} · #{{ row.id }}</small><small>{{ row.route_id ? 'Vinculada à rota #' ~ row.route_id : 'Independente de rota monitorada' }}{% if row.city %} · {{ row.city }}{% endif %}</small><a href="{{ path('tvt_irregularities_evolution',{id:row.id}) }}">Ver evolução</a></td>
<td><span class="tvi-badge {{ row.is_active ? 'tvi-badge--active' : 'tvi-badge--inactive' }}">{{ row.is_active ? 'Ativa na última coleta' : 'Inativa' }}</span></td>
<td><span class="tvi-badge tvi-level-{{ row.level is null ? 'unknown' : row.level }}">{{ row.level is null ? 'Não informado' : 'Nível ' ~ row.level }}</span></td>
<td>{{ _self.duration(row.observed) }}</td><td>{{ _self.duration(row.historic) }}</td><td><strong>{{ _self.duration(row.delay) }}</strong></td>
<td>{{ row.recorded_at ? row.recorded_at|date('d/m/Y H:i','America/Sao_Paulo','UTC') : '—' }}</td><td>{{ row.last_seen_at ? row.last_seen_at|date('d/m/Y H:i','America/Sao_Paulo','UTC') : '—' }}</td><td>{{ row.deactivated_at ? row.deactivated_at|date('d/m/Y H:i','America/Sao_Paulo','UTC') : '—' }}</td>
<td>{% if row.waze_url %}<a href="{{ row.waze_url }}" target="_blank" rel="noopener noreferrer">Abrir no Waze</a><small>Primeiro ponto válido do trecho recebido</small>{% else %}<span>Sem ponto válido na geometria</span>{% endif %}</td>
</tr>{% endfor %}</tbody></table></div>{% endif %}
<nav class="tvi-pagination" aria-label="Paginação de irregularidades"><span>Página {{ page }} de {{ pages }}</span><div>{% if page > 1 %}<a href="{{ path('tvt_irregularities_index',link_filters|merge({page:1})) }}">Primeira</a><a rel="prev" href="{{ path('tvt_irregularities_index',link_filters|merge({page:page-1})) }}">Anterior</a>{% endif %}{% for number in max(1,page-2)..min(pages,page+2) %}{% if number == page %}<span aria-current="page">{{ number }}</span>{% else %}<a href="{{ path('tvt_irregularities_index',link_filters|merge({page:number})) }}">{{ number }}</a>{% endif %}{% endfor %}{% if page < pages %}<a rel="next" href="{{ path('tvt_irregularities_index',link_filters|merge({page:page+1})) }}">Próxima</a><a href="{{ path('tvt_irregularities_index',link_filters|merge({page:pages})) }}">Última</a>{% endif %}</div></nav>
<details class="tvi-help"><summary>Como interpretar os dados</summary><p>Atraso = máximo entre tempo observado menos referência histórica e zero. Sem os dois tempos válidos, fica indisponível. Use Ver evolução para consultar as medições capturadas após a implantação do histórico.</p><p>Primeiro registro e última observação são datas de coleta, não o início exato do congestionamento. Inativa significa ausente na sincronização que a desativou, não comprovação de que o tráfego normalizou.</p><p>O período usa a última observação. O histórico não reconstrói medições anteriores à implantação nem mede a disponibilidade da coleta.</p></details>
</div>
<script type="application/json" id="tvi-map-data">{{ rows|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="anonymous" defer></script>
<script>
(function () {
function init() {
 const form = document.getElementById('tvi-filter-form');
 const partner = document.getElementById('tvi-partner-filter');
 if (form && partner) {
  form.addEventListener('formdata', event => { if (!partner.value.trim()) event.formData.delete('partner'); });
 }
 const status = document.getElementById('tvi-map-status');
 if (!window.L) { status.textContent = 'Não foi possível carregar a biblioteca do mapa. A tabela continua disponível.'; return; }
 let rows;
 try { rows = JSON.parse(document.getElementById('tvi-map-data').textContent); }
 catch (error) { status.textContent = 'Não foi possível ler os dados do mapa.'; return; }
 const map = L.map('tvi-map', {preferCanvas:true,scrollWheelZoom:false}).setView([-15.78,-47.92],4);
 const tiles = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {maxZoom:19,attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'}).addTo(map);
 tiles.on('tileerror', () => { status.textContent = 'Falha ao carregar parte do mapa-base. Os traçados e a tabela usam os dados salvos.'; });
 const colors = ['#64748b','#16a34a','#65a30d','#ca8a04','#ea580c','#dc2626'];
 const bounds = L.latLngBounds([]);
 let mapped = 0;
 const duration = value => {
  if (value === null || value === undefined || !Number.isFinite(Number(value))) return '—';
  const seconds = Math.round(Number(value));
  return `${Math.floor(seconds / 60)} min ${seconds % 60} s`;
 };
 const timestamp = value => {
  if (!value) return '—';
  const date = new Date(String(value).replace(' ', 'T') + 'Z');
  return Number.isNaN(date.getTime()) ? 'Indisponível' : new Intl.DateTimeFormat('pt-BR',{dateStyle:'short',timeStyle:'short',timeZone:'America/Sao_Paulo'}).format(date) + ' (Brasília)';
 };
 rows.forEach(row => {
  const active = row.is_active === true || row.is_active === 1 || row.is_active === '1';
  const color = row.level === null ? colors[0] : colors[Number(row.level)] || colors[0];
  const popup = document.createElement('div');
  const title = document.createElement('strong'); title.textContent = row.name; popup.appendChild(title);
  [row.partner_name || 'Parceiro não informado', active ? 'Ativa na última coleta' : 'Inativa', row.level === null ? 'Nível não informado' : 'Nível ' + row.level, 'Observado: ' + duration(row.observed), 'Histórico: ' + duration(row.historic), 'Atraso calculado: ' + duration(row.delay), 'Última coleta: ' + timestamp(row.last_seen_at)].forEach(text => { const item = document.createElement('div'); item.textContent = text; popup.appendChild(item); });
  let drawn = false;
  (Array.isArray(row.segments) ? row.segments : []).forEach(segment => {
   if (!Array.isArray(segment) || !segment.length) return;
   const valid = segment.every(p => Array.isArray(p) && p.length === 2 && p.every(Number.isFinite) && Math.abs(p[0]) <= 90 && Math.abs(p[1]) <= 180);
   if (!valid) return;
   const options = {color,weight:5,opacity:active ? 0.9 : 0.5,dashArray:active ? null : '7 7'};
   const layer = segment.length > 1 ? L.polyline(segment, options) : L.circleMarker(segment[0], {...options,radius:7,fillOpacity:0.7});
   layer.bindPopup(popup.cloneNode(true)).addTo(map);
   segment.forEach(p => bounds.extend(p)); drawn = true;
  });
  if (drawn) mapped++;
 });
 const fit = () => { if (bounds.isValid()) map.fitBounds(bounds, {padding:[24,24],maxZoom:15}); };
 const fitButton = document.getElementById('tvi-map-fit'); fitButton.disabled = !bounds.isValid(); fitButton.addEventListener('click', fit);
 status.textContent = `${mapped} de ${rows.length} ocorrência(s) desta página com coordenadas válidas. ${rows.length - mapped} sem geometria disponível.`;
 fit();
 requestAnimationFrame(() => map.invalidateSize());
 if (window.ResizeObserver) new ResizeObserver(() => map.invalidateSize()).observe(document.getElementById('tvi-map'));
}
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, {once:true}); else init();
})();
</script>
{% endblock %}
