<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Recupere sua senha do wazeBR">
    <title>Recuperar Senha - wazeBR</title>

    {# Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    {# Icons #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    {# Stylesheets #}
    <link rel="stylesheet" href="{{ asset('css/reset-password.css') }}">

    {# Favicon #}
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
</head>
<body>
    <div class="reset-page">
        {# Left Side - Form #}
        <div class="reset-left">
            <div class="reset-container">
                {# Logo #}
                <a href="{{ path('app_home') }}" class="logo">
                    <div class="logo-icon">
                        <i class="fas fa-road"></i>
                    </div>
                    <span class="logo-text">waze<span class="highlight">BR</span></span>
                </a>

                {# Header #}
                <div class="reset-header">
                    <div class="reset-icon">
                        <i class="fas fa-key"></i>
                    </div>
                    <h1>Esqueceu a senha?</h1>
                    <p>Não se preocupe! Digite seu email abaixo e enviaremos instruções para recuperar sua senha.</p>
                </div>

                {# Success Message #}
                {% for type, messages in app.session.flashBag.all %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type }}">
                            <i class="fas fa-{{ type == 'success' ? 'check-circle' : 'info-circle' }}"></i>
                            <span>{{ message }}</span>
                        </div>
                    {% endfor %}
                {% endfor %}

                {# Reset Form #}
                <form method="post" action="{{ path('app_reset_password_request') }}" class="reset-form" novalidate>
                    <div class="form-group">
                        <label for="email">
                            <i class="fas fa-envelope"></i>
                            <span>Email</span>
                        </label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            autofocus
                            autocomplete="email"
                            placeholder="seu@email.com"
                            class="form-control"
                        >
                        <p class="form-help">
                            <i class="fas fa-info-circle"></i>
                            Digite o email cadastrado na sua conta wazeBR
                        </p>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block btn-reset">
                        <span>Enviar Instruções</span>
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </form>

                {# Back to Login #}
                <div class="back-login">
                    <a href="{{ path('app_login') }}">
                        <i class="fas fa-arrow-left"></i>
                        <span>Voltar para login</span>
                    </a>
                </div>

                {# Info Box #}
                <div class="info-box">
                    <div class="info-icon">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <div class="info-content">
                        <h4>Segurança Garantida</h4>
                        <p>Seu email será usado apenas para enviar as instruções de recuperação de senha. Não compartilhamos seus dados.</p>
                    </div>
                </div>
            </div>
        </div>

        {# Right Side - Visual #}
        <div class="reset-right">
            <div class="reset-visual">
                <div class="visual-content">
                    <div class="visual-header">
                        <div class="logo-large">
                            <i class="fas fa-lock"></i>
                        </div>
                        <h2>Recuperação de Senha</h2>
                    </div>

                    <div class="visual-body">
                        <h3>Como funciona?</h3>
                        <ul class="steps-list">
                            <li>
                                <span class="step-number">1</span>
                                <span class="step-text">Digite seu email cadastrado</span>
                            </li>
                            <li>
                                <span class="step-number">2</span>
                                <span class="step-text">Receba um email com link seguro</span>
                            </li>
                            <li>
                                <span class="step-number">3</span>
                                <span class="step-text">Crie uma nova senha</span>
                            </li>
                            <li>
                                <span class="step-number">4</span>
                                <span class="step-text">Acesse sua conta novamente</span>
                            </li>
                        </ul>
                    </div>

                    <div class="visual-tips">
                        <div class="tip-item">
                            <i class="fas fa-check-circle"></i>
                            <span>Link válido por 1 hora</span>
                        </div>
                        <div class="tip-item">
                            <i class="fas fa-check-circle"></i>
                            <span>Senha mínima de 6 caracteres</span>
                        </div>
                        <div class="tip-item">
                            <i class="fas fa-check-circle"></i>
                            <span>Processo 100% seguro</span>
                        </div>
                    </div>
                </div>

                {# Background Elements #}
                <div class="bg-circle bg-circle-1"></div>
                <div class="bg-circle bg-circle-2"></div>
                <div class="bg-circle bg-circle-3"></div>
            </div>
        </div>
    </div>

    {# JavaScript #}
    <script src="{{ asset('assets/js/reset-password.js') }}"></script>
</body>
</html>
