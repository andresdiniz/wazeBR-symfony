{% extends 'base.html.twig' %}

{% block title %}Esqueci a Senha - wazeBR{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/auth.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('auth') }}
{% endblock %}

{% block body %}
<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Recuperar Senha</h1>
            <p>Digite seu e-mail para receber as instru\u00e7\u00f5es</p>
        </div>

        {% for flash_error in app.flashes('reset_password_error') %}
            <div class="alert alert-danger">{{ flash_error }}</div>
        {% endfor %}

        {% for flash_success in app.flashes('reset_password_success') %}
            <div class="alert alert-success">{{ flash_success }}</div>
        {% endfor %}

        <form method="post" class="auth-form" novalidate>
            {{ form_start(requestForm) }}
                <div class="form-group">
                    {{ form_label(requestForm.email, 'E-mail') }}
                    {{ form_widget(requestForm.email, {
                        'attr': {
                            'autocomplete': 'email',
                            'placeholder': 'seu@email.com',
                            'class': 'form-control'
                        }
                    }) }}
                    {{ form_errors(requestForm.email) }}
                </div>

                <button type="submit" class="btn btn-primary btn-block">
                    Enviar instru\u00e7\u00f5es
                </button>
            {{ form_end(requestForm) }}
        </form>

        <div class="auth-footer">
            <a href="{{ path('app_login') }}">Voltar ao login</a>
        </div>
    </div>
</div>
{% endblock %}
