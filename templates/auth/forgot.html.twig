{% extends 'base.html.twig' %}

{% block title %}Esqueci a Senha | wazeBR{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/auth.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('auth') }}
{% endblock %}

{% block body_class %}auth-page{% endblock %}

{% block body %}
<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Recuperar Senha</h1>
            <p>Digite seu e-mail para receber as instruções</p>
        </div>

        {% for flash_error in app.flashes('reset_password_error') %}
            <div class="auth-alert auth-alert-error" role="alert">{{ flash_error }}</div>
        {% endfor %}

        {% for flash_success in app.flashes('reset_password_success') %}
            <div class="auth-alert auth-alert-success" role="alert">{{ flash_success }}</div>
        {% endfor %}

        {{ form_start(requestForm, { 'attr': { 'class': 'auth-form', 'novalidate': 'novalidate' } }) }}
            {{ form_row(requestForm.email, {
                'label': 'E-mail',
                'attr': {
                    'autocomplete': 'email',
                    'placeholder': 'seu@email.com',
                    'class': 'form-control'
                }
            }) }}

            <button type="submit" class="auth-submit">
                Enviar instruções
            </button>
        {{ form_end(requestForm) }}

        <div class="auth-footer">
            <a href="{{ path('app_login') }}">← Voltar ao login</a>
        </div>
    </div>
</div>
{% endblock %}
