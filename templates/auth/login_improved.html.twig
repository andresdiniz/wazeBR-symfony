{% extends 'base_guest.html.twig' %}

{% block title %}Entrar - WazeBR Monitor{% endblock %}

{% block meta_description %}Acesse o painel de monitoramento de mobilidade urbana. Alertas Waze, congestionamentos, rotas e dados CIFS em tempo real.{% endblock %}

{% block og_title %}Entrar - WazeBR Monitor{% endblock %}
{% block og_description %}Acesse o painel de monitoramento de mobilidade urbana com dados em tempo real.{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            --bg-1: #0c2b3a;
            --bg-2: #0f5266;
            --bg-3: #159bb2;
            --glass: rgba(9, 22, 30, 0.88);
            --glass-border: rgba(255, 255, 255, 0.07);
            --glass-highlight: rgba(255, 255, 255, 0.12);
            --text-main: #f2f8f9;
            --text-soft: rgba(242, 248, 249, 0.76);
            --accent: #8bd34f;
            --accent-strong: #6cb336;
            --danger-bg: rgba(188, 77, 77, 0.18);
            --danger-border: rgba(255, 146, 146, 0.22);
            --input-bg: rgba(6, 15, 20, 0.96);
            --input-border: rgba(255, 255, 255, 0.09);
            --input-focus: rgba(127, 216, 230, 0.90);
            --success-bg: rgba(107, 179, 54, 0.18);
            --success-border: rgba(139, 211, 79, 0.22);
        }

        *, *::before, *::after { box-sizing: border-box; }
        html, body { height: 100%; }

        body.guest-shell {
            margin: 0;
            min-height: 100vh;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: var(--text-main);
            background:
                radial-gradient(circle at 15% 20%, rgba(255,255,255,0.16), transparent 32%),
                radial-gradient(circle at 80% 80%, rgba(0,0,0,0.30), transparent 40%),
                linear-gradient(135deg, var(--bg-1) 0%, var(--bg-2) 45%, var(--bg-3) 100%);
            overflow: hidden;
        }

        .skip-to-content {
            position: absolute;
            top: -40px;
            left: 0;
            background: var(--accent);
            color: #041014;
            padding: 8px 16px;
            z-index: 100;
            text-decoration: none;
            font-weight: 700;
        }

        .skip-to-content:focus {
            top: 0;
        }

        .login-scene {
            min-height: 100vh;
            padding: clamp(18px, 4vw, 42px);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .orb, .orb::before, .orb::after {
            position: absolute;
            border-radius: 999px;
            filter: blur(40px);
            opacity: 0.32;
            pointer-events: none;
        }

        .orb {
            width: 260px;
            height: 260px;
            background: radial-gradient(circle, rgba(255,255,255,0.30), transparent 55%);
            top: 8%;
            left: 10%;
            animation: float 30s infinite alternate ease-in-out;
        }

        .orb::before {
            content: "";
            width: 220px;
            height: 220px;
            background: radial-gradient(circle, rgba(127,216,230,0.38), transparent 60%);
            bottom: -16%;
            right: -18%;
        }

        .orb::after {
            content: "";
            width: 260px;
            height: 260px;
            background: radial-gradient(circle, rgba(98,184,216,0.38), transparent 60%);
            top: 40%;
            left: 68%;
        }

        @keyframes float {
            0% { transform: translate3d(0, 0, 0) scale(1); }
            100% { transform: translate3d(16px, 10px, 0) scale(1.03); }
        }

        .login-frame {
            width: min(1200px, 100%);
            max-width: 1200px;
            display: grid;
            grid-template-columns: minmax(260px, 340px) minmax(340px, 460px);
            align-items: center;
            gap: clamp(32px, 5vw, 64px);
            position: relative;
            z-index: 1;
            justify-content: flex-end;
            animation: card-enter 320ms ease-out;
        }

        @keyframes card-enter {
            from { opacity: 0; transform: translate3d(0, 14px, 0); }
            to { opacity: 1; transform: translate3d(0, 0, 0); }
        }

        .brand-column {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 18px;
            padding-left: clamp(0, 3vw, 32px);
        }

        .brand-pill {
            display: inline-flex;
            align-items: center;
            gap: 14px;
            background: rgba(0,0,0,0.48);
            padding: 10px 16px 10px 12px;
            border-radius: 999px;
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255,255,255,0.14);
            box-shadow: 0 16px 40px rgba(0,0,0,0.35);
        }

        .brand-avatar {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            background: linear-gradient(135deg, #55ccd3 0%, #159bb2 100%);
            display: grid;
            place-items: center;
            color: #f6ffff;
            font-weight: 800;
            font-size: 18px;
            animation: pulse 2200ms infinite ease-in-out;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(127,216,230,0.45); }
            50% { transform: scale(1.06); box-shadow: 0 0 0 8px rgba(127,216,230,0.0); }
        }

        .brand-main { display: flex; flex-direction: column; }

        .brand-name {
            font-weight: 800;
            font-size: 20px;
            letter-spacing: -0.02em;
        }

        .brand-tag {
            font-size: 12px;
            color: rgba(244,239,232,0.68);
        }

        .brand-heading {
            margin-top: 10px;
            max-width: 260px;
            color: rgba(247,244,236,0.92);
            font-size: 24px;
            font-weight: 700;
            letter-spacing: -0.03em;
        }

        .brand-description {
            margin-top: 8px;
            max-width: 280px;
            font-size: 13px;
            color: rgba(247,244,236,0.80);
            line-height: 1.5;
        }

        .form-column { position: relative; }

        .login-card {
            position: relative;
            background: var(--glass);
            border-radius: 18px;
            border: 1px solid var(--glass-border);
            box-shadow: 0 24px 64px rgba(0,0,0,0.48);
            padding: 22px 24px 20px;
            overflow: hidden;
        }

        .login-card::before {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: 18px;
            background: linear-gradient(135deg, var(--glass-highlight), transparent 40%);
            opacity: 0.18;
            pointer-events: none;
        }

        .login-card-inner { position: relative; z-index: 1; }

        .login-kicker {
            margin: 0 0 6px;
            font-size: 11px;
            letter-spacing: 0.26em;
            text-transform: uppercase;
            color: rgba(244,239,232,0.60);
        }

        .login-title {
            margin: 0;
            font-size: clamp(22px, 2.6vw, 28px);
            line-height: 1.1;
            font-weight: 800;
            letter-spacing: -0.03em;
        }

        .login-text {
            margin: 10px 0 18px;
            font-size: 13px;
            color: var(--text-soft);
            line-height: 1.5;
        }

        .alert {
            padding: 10px 11px;
            border-radius: 10px;
            font-size: 13px;
            margin-bottom: 14px;
            display: flex;
            align-items: flex-start;
            gap: 8px;
        }

        .alert-danger {
            background: var(--danger-bg);
            color: #ffd6d6;
            border: 1px solid var(--danger-border);
        }

        .alert-success {
            background: var(--success-bg);
            color: #c8f7d8;
            border: 1px solid var(--success-border);
        }

        .alert-icon {
            flex-shrink: 0;
            width: 16px;
            height: 16px;
            margin-top: 2px;
        }

        .field { margin-bottom: 12px; }
        
        .field-error .input { 
            border-color: var(--danger-border);
            background: rgba(188, 77, 77, 0.08);
        }
        
        .field-error .error-message {
            margin-top: 4px;
            font-size: 11px;
            color: #ffd6d6;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .field-success .input {
            border-color: var(--success-border);
            background: rgba(107, 179, 54, 0.08);
        }

        .label {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
            font-size: 12px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: rgba(244,239,232,0.80);
        }

        .label-help {
            font-size: 10px;
            color: rgba(244,239,232,0.60);
            font-weight: 400;
            text-transform: none;
            letter-spacing: 0;
        }

        .input-shell { position: relative; }

        .input {
            width: 100%;
            height: 44px;
            padding: 0 44px 0 40px;
            border-radius: 12px;
            border: 1px solid var(--input-border);
            background: var(--input-bg);
            color: var(--text-main);
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        }

        .input::placeholder { color: rgba(244,239,232,0.38); }

        .input:focus {
            border-color: var(--input-focus);
            box-shadow: 0 0 0 2px rgba(127,216,230,0.25);
        }

        .input:invalid:not(:placeholder-shown) {
            border-color: var(--danger-border);
            background: rgba(188, 77, 77, 0.08);
        }

        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            width: 16px;
            height: 16px;
            pointer-events: none;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .input-icon svg {
            width: 100%;
            height: 100%;
            stroke: rgba(244,239,232,0.66);
        }

        .toggle-password {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 24px;
            height: 24px;
            border-radius: 999px;
            border: none;
            background: transparent;
            display: grid;
            place-items: center;
            cursor: pointer;
            color: rgba(244,239,232,0.66);
            transition: color 0.2s ease;
            padding: 0;
            font-size: 0;
        }

        .toggle-password:hover { 
            color: var(--accent);
        }

        .toggle-password:focus {
            outline: 2px solid var(--input-focus);
            outline-offset: 2px;
            border-radius: 4px;
        }

        .toggle-password svg {
            width: 18px;
            height: 18px;
        }

        .password-strength {
            margin-top: 6px;
            display: flex;
            gap: 4px;
            align-items: center;
        }

        .strength-bar {
            flex: 1;
            height: 3px;
            background: rgba(255,255,255,0.1);
            border-radius: 999px;
            overflow: hidden;
        }

        .strength-fill {
            height: 100%;
            width: 0%;
            background: #ff6b6b;
            transition: width 0.3s ease, background-color 0.3s ease;
        }

        .strength-fill.weak { background: #ff6b6b; width: 33%; }
        .strength-fill.fair { background: #ffa94d; width: 66%; }
        .strength-fill.strong { background: var(--accent); width: 100%; }

        .strength-text {
            font-size: 10px;
            color: rgba(244,239,232,0.60);
            min-width: 45px;
        }

        .submit {
            margin-top: 10px;
            width: 100%;
            height: 46px;
            border-radius: 12px;
            border: none;
            background: linear-gradient(135deg, var(--accent) 0%, var(--accent-strong) 100%);
            color: #041014;
            font-size: 14px;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            cursor: pointer;
            box-shadow: 0 14px 30px rgba(89,180,199,0.34);
            transform: translateY(0);
            transition: transform 0.16s ease, box-shadow 0.16s ease, filter 0.16s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .submit:hover:not(:disabled) { 
            transform: translateY(-1px); 
            filter: brightness(1.03); 
        }

        .submit:active:not(:disabled) {
            transform: translateY(0);
            box-shadow: 0 10px 22px rgba(89,180,199,0.30);
        }

        .submit:disabled {
            opacity: 0.8;
            cursor: not-allowed;
        }

        .spinner {
            width: 16px;
            height: 16px;
            border: 2px solid rgba(4,16,20,0.4);
            border-top-color: #041014;
            border-radius: 999px;
            animation: spin 600ms linear infinite;
            display: none;
        }

        .submit[data-loading="true"] .spinner {
            display: block;
        }

        .submit[data-loading="true"] .submit-text {
            display: none;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .login-footer {
            margin-top: 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            font-size: 11px;
            color: rgba(244,239,232,0.64);
        }

        .login-footer-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .remember-shell {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .remember-shell input {
            width: 13px;
            height: 13px;
            cursor: pointer;
            accent-color: var(--accent);
        }

        .remember-shell label {
            font-size: 11px;
            color: rgba(244,239,232,0.72);
            cursor: pointer;
        }

        .login-footer a {
            color: var(--accent);
            text-decoration: none;
            transition: text-decoration 0.2s ease;
        }

        .login-footer a:hover { 
            text-decoration: underline; 
        }

        .login-footer a:focus {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
            border-radius: 2px;
        }

        @media (max-width: 900px) {
            .login-frame {
                grid-template-columns: minmax(0, 1fr);
                gap: 24px;
                justify-content: center;
            }

            .brand-column {
                align-items: center;
                text-align: center;
                padding-left: 0;
            }

            .brand-heading,
            .brand-description { max-width: 360px; }

            .form-column {
                max-width: 460px;
                margin: 0 auto;
            }
        }

        @media (max-width: 640px) {
            .login-scene { padding: 18px 16px; }
            .brand-pill { justify-content: center; }
            .login-card { padding: 20px 18px 18px; border-radius: 16px; }
        }

        @media (prefers-reduced-motion: reduce) {
            * {
                animation: none !important;
                transition: none !important;
            }
        }

        @media (prefers-color-scheme: dark) {
            body.guest-shell {
                --bg-1: #0c2b3a;
                --bg-2: #0f5266;
                --bg-3: #159bb2;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="login-scene">
    <div class="orb"></div>

    <div class="login-frame">
        <div class="brand-column" aria-hidden="true">
            <div class="brand-pill">
                <div class="brand-avatar">W</div>
                <div class="brand-main">
                    <span class="brand-name">WazeBR<span style="opacity:.6;font-weight:600"> Monitor</span></span>
                    <span class="brand-tag">Monitoramento em tempo real</span>
                </div>
            </div>

            <h2 class="brand-heading">Painel de mobilidade urbana</h2>
            <p class="brand-description">Alertas Waze, congestionamentos, ocorrências CIFS e dados hidrológicos CEMADEN em uma única interface, pensada para operação.</p>
        </div>

        <div class="form-column">
            <div class="login-card">
                <div class="login-card-inner">
                    <p class="login-kicker">Monitoramento</p>
                    <h1 class="login-title">Acesso ao sistema</h1>
                    <p class="login-text">Entre com seu e-mail e senha para continuar no painel de monitoramento.</p>

                    {% if error %}
                        <div class="alert alert-danger" role="alert">
                            <svg class="alert-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                            </svg>
                            <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                        </div>
                    {% endif %}

                    <form method="post" action="{{ path('auth_login') }}" novalidate id="login-form">
                        <div class="field">
                            <label for="email" class="label">
                                E-mail
                            </label>
                            <div class="input-shell">
                                <span class="input-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6">
                                        <path d="M4 6h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Z" />
                                        <path d="M22 8 12 13 2 8" />
                                    </svg>
                                </span>
                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    class="input"
                                    placeholder="seu@email.com"
                                    value="{{ last_username }}"
                                    required
                                    autocomplete="email"
                                    aria-label="Endereço de e-mail"
                                    aria-describedby="email-help"
                                >
                            </div>
                        </div>

                        <div class="field">
                            <label for="password" class="label">
                                Senha
                            </label>
                            <div class="input-shell">
                                <span class="input-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6">
                                        <path d="M12 1C6.48 1 2 5.48 2 11v10c0 .55.45 1 1 1h1v3c0 .55.45 1 1 1h3c.55 0 1-.45 1-1v-3h4v3c0 .55.45 1 1 1h3c.55 0 1-.45 1-1v-3h1c.55 0 1-.45 1-1V11c0-5.52-4.48-10-10-10zm0 2c4.42 0 8 3.58 8 8v1H4v-1c0-4.42 3.58-8 8-8z" />
                                    </svg>
                                </span>
                                <input
                                    type="password"
                                    id="password"
                                    name="password"
                                    class="input"
                                    placeholder="••••••••"
                                    required
                                    autocomplete="current-password"
                                    aria-label="Senha"
                                    aria-describedby="password-help"
                                >
                                <button
                                    type="button"
                                    class="toggle-password"
                                    id="toggle-password"
                                    aria-label="Mostrar ou ocultar senha"
                                    aria-pressed="false"
                                >
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                </button>
                            </div>
                            <div class="password-strength" id="password-strength" style="display: none;">
                                <div class="strength-bar">
                                    <div class="strength-fill" id="strength-fill"></div>
                                </div>
                                <span class="strength-text" id="strength-text">Fraca</span>
                            </div>
                        </div>

                        <button type="submit" class="submit" id="submit-btn">
                            <span class="spinner"></span>
                            <span class="submit-text">Entrar no painel</span>
                        </button>

                        <div class="login-footer">
                            <div class="login-footer-left">
                                <div class="remember-shell">
                                    <input
                                        type="checkbox"
                                        id="remember_me"
                                        name="remember_me"
                                        value="1"
                                    >
                                    <label for="remember_me">Lembrar-me</label>
                                </div>
                            </div>
                            <a href="{{ path('auth_forgot') }}" title="Recuperar acesso à sua conta">Esqueci a senha</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script nonce="{{ csp_nonce() }}">
    // Password visibility toggle
    const toggleBtn = document.getElementById('toggle-password');
    const passwordInput = document.getElementById('password');
    
    if (toggleBtn && passwordInput) {
        toggleBtn.addEventListener('click', () => {
            const isPassword = passwordInput.type === 'password';
            passwordInput.type = isPassword ? 'text' : 'password';
            toggleBtn.setAttribute('aria-pressed', !isPassword);
        });
    }

    // Password strength indicator
    const passwordField = document.getElementById('password');
    const strengthContainer = document.getElementById('password-strength');
    const strengthFill = document.getElementById('strength-fill');
    const strengthText = document.getElementById('strength-text');

    if (passwordField) {
        passwordField.addEventListener('input', () => {
            const value = passwordField.value;
            let strength = 0;
            let label = 'Fraca';

            if (value.length >= 8) strength++;
            if (/[a-z]/.test(value) && /[A-Z]/.test(value)) strength++;
            if (/[0-9]/.test(value)) strength++;
            if (/[^a-zA-Z0-9]/.test(value)) strength++;

            if (strength <= 1) {
                label = 'Fraca';
                strengthFill.className = 'strength-fill weak';
            } else if (strength === 2) {
                label = 'Razoável';
                strengthFill.className = 'strength-fill fair';
            } else if (strength >= 3) {
                label = 'Forte';
                strengthFill.className = 'strength-fill strong';
            }

            strengthText.textContent = label;
            strengthContainer.style.display = value.length > 0 ? 'flex' : 'none';
        });
    }

    // Form submission
    const form = document.getElementById('login-form');
    const submitBtn = document.getElementById('submit-btn');

    if (form && submitBtn) {
        form.addEventListener('submit', () => {
            submitBtn.setAttribute('data-loading', 'true');
            submitBtn.disabled = true;
        });
    }

    // Prevent form resubmission on back button
    if (window.history.replaceState) {
        window.history.replaceState(null, null, window.location.href);
    }
</script>
{% endblock %}
