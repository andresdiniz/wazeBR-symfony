{% extends 'base.html.twig' %}

{% block title %}Entrar | wazeBR{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/auth.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module" src="{{ asset('controllers/auth_controller.js') }}"></script>
{% endblock %}

{% block body_class %}auth-page{% endblock %}

{% block body %}
<main class="auth-shell">
    <section class="auth-card" aria-labelledby="login-title">
        <div class="auth-brand">
            <div class="auth-logo" aria-hidden="true">w</div>
            <div>
                <h1 id="login-title">wazeBR</h1>
                <p>Monitoramento de tráfego</p>
            </div>
        </div>

        {% if error %}
            <div class="auth-alert auth-alert-error" role="alert">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form action="{{ path('app_login') }}" method="post" class="auth-form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="auth-field">
                <label for="username">E-mail</label>
                <input id="username" name="_username" type="email"
                       value="{{ last_username }}" autocomplete="username"
                       required autofocus placeholder="seu@email.com">
            </div>

            <div class="auth-field">
                <div class="auth-label-row">
                    <label for="password">Senha</label>
                    <a href="{{ path('app_forgot_password') }}">Esqueceu a senha?</a>
                </div>
                <div class="auth-password">
                    <input id="password" name="_password" type="password"
                           autocomplete="current-password" required placeholder="Sua senha">
                    <button type="button" class="auth-password-toggle" data-password-toggle
                            aria-label="Mostrar senha" aria-pressed="false">Mostrar</button>
                </div>
            </div>

            <label class="auth-remember">
                <input type="checkbox" name="_remember_me" value="1">
                <span>Lembrar-me neste dispositivo</span>
            </label>

            <button class="auth-submit" type="submit">Entrar</button>
        </form>
    </section>
</main>
{% endblock %}
