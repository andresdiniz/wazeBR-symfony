{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/auth.js') }}" defer></script>
{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="auth-left">
        <div class="auth-container">
            <a href="{{ path('app_landing') }}" class="auth-brand">
                <div class="auth-brand-mark">
                    <i class="bi bi-signpost-2-fill"></i>
                </div>
                <span class="auth-brand-name">Waze<em>BR</em></span>
            </a>

            <div class="auth-heading">
                <h1>{{ 'login.welcome'|trans }}</h1>
                <p>{{ 'login.subtitle'|trans }}</p>
            </div>

            {% if error %}
                <div class="auth-alert auth-alert-error" role="alert">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                </div>
            {% endif %}

            <form method="post" class="auth-form" novalidate>
                <input type="hidden" name="_target_path" value="{{ path('dashboard') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="auth-field">
                    <label for="username">
                        <i class="bi bi-envelope"></i>
                        {{ 'login.email'|trans }}
                    </label>
                    <input type="email" id="username" name="_username" value="{{ last_username }}" class="auth-input" autocomplete="email" placeholder="{{ 'login.email_placeholder'|trans }}" required autofocus>
                </div>

                <div class="auth-field">
                    <div class="auth-field-row">
                        <label for="password">
                            <i class="bi bi-lock"></i>
                            {{ 'login.password'|trans }}
                        </label>
                        <a href="{{ path('app_forgot_password_request') }}" class="auth-field-link">{{ 'login.forgot_password'|trans }}</a>
                    </div>
                    <div class="auth-input-wrap">
                        <input type="password" id="password" name="_password" class="auth-input" autocomplete="current-password" placeholder="{{ 'login.password_placeholder'|trans }}" required>
                        <button type="button" class="auth-toggle-pw" data-target="password" aria-label="{{ 'login.show_password'|trans }}">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="auth-remember">
                    <label class="auth-checkbox-label">
                        <input type="checkbox" name="_remember_me" id="remember_me">
                        <span class="auth-checkbox-box"></span>
                        {{ 'login.remember_me'|trans }}
                    </label>
                </div>

                <button type="submit" class="auth-btn auth-btn-primary" id="loginSubmit">
                    <span>{{ 'login.submit'|trans }}</span>
                    <i class="bi bi-arrow-right"></i>
                </button>
            </form>

            <div class="auth-footer-link">
                <a href="{{ path('app_landing') }}">
                    <i class="bi bi-arrow-left"></i>
                    {{ 'login.back_home'|trans }}
                </a>
            </div>
        </div>
    </div>

    <div class="auth-right">
        <div class="auth-visual">
            <div class="auth-right-orb auth-right-orb-1" aria-hidden="true"></div>
            <div class="auth-right-orb auth-right-orb-2" aria-hidden="true"></div>

            <div class="auth-visual-content">
                <div class="auth-visual-logo">
                    <i class="bi bi-signpost-2-fill"></i>
                </div>
                <h2>{{ 'login.visual_title'|trans }}</h2>
                <p>{{ 'login.visual_subtitle'|trans }}</p>

                <ul class="auth-features">
                    <li>
                        <span class="auth-feature-icon"><i class="bi bi-broadcast"></i></span>
                        {{ 'login.feature_realtime'|trans }}
                    </li>
                    <li>
                        <span class="auth-feature-icon"><i class="bi bi-exclamation-triangle"></i></span>
                        {{ 'login.feature_alerts'|trans }}
                    </li>
                    <li>
                        <span class="auth-feature-icon"><i class="bi bi-car-front"></i></span>
                        {{ 'login.feature_jams'|trans }}
                    </li>
                    <li>
                        <span class="auth-feature-icon"><i class="bi bi-signpost-2"></i></span>
                        {{ 'login.feature_tvt'|trans }}
                    </li>
                </ul>

                <div class="auth-visual-stats">
                    <div class="auth-stat">
                        <strong>35+</strong>
                        <span>{{ 'login.stat_alerts'|trans }}</span>
                    </div>
                    <div class="auth-stat">
                        <strong>100%</strong>
                        <span>{{ 'login.stat_online'|trans }}</span>
                    </div>
                    <div class="auth-stat">
                        <strong>24h</strong>
                        <span>{{ 'login.stat_monitoring'|trans }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
