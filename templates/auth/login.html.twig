{% extends 'base.html.twig' %}

{% block title %}Entrar | WazeBR Monitor{% endblock %}

{% block body %}
<style>
:root{--login-bg:#f4f8fb;--login-ink:#0f172a;--login-muted:#64748b;--login-brand:#159bb2;--login-dark:#08768b;--login-line:#d9e4ea;--login-radius:26px}
.login-page{min-height:100vh;padding:24px 16px;background:radial-gradient(circle at top left,rgba(21,155,178,.14),transparent 30%),radial-gradient(circle at bottom right,rgba(139,211,79,.12),transparent 28%),var(--login-bg)}
.login-shell{width:min(1120px,100%);margin:auto}.login-brand{display:inline-flex;align-items:center;gap:10px;color:var(--login-ink);font-weight:850;letter-spacing:-.04em;text-decoration:none;margin-bottom:18px}.login-mark{display:grid;width:38px;height:38px;place-items:center;color:#fff;border-radius:12px;background:linear-gradient(135deg,var(--login-brand),#53c6d1)}
.login-grid{display:grid;gap:18px}.login-hero,.login-card{border:1px solid rgba(255,255,255,.8);border-radius:var(--login-radius);box-shadow:0 24px 70px rgba(15,23,42,.12);overflow:hidden}.login-hero{position:relative;min-height:260px;padding:28px;color:#fff;background:linear-gradient(145deg,#0b3143,#0d6b82 55%,var(--login-brand))}.login-hero:before,.login-hero:after{position:absolute;border:1px solid rgba(255,255,255,.14);border-radius:50%;content:""}.login-hero:before{width:240px;height:240px;right:-80px;top:-70px}.login-hero:after{width:320px;height:320px;right:-120px;bottom:-150px}.login-hero-content{position:relative;z-index:1;max-width:520px}.login-kicker{display:inline-flex;padding:8px 12px;border:1px solid rgba(255,255,255,.16);border-radius:999px;background:rgba(255,255,255,.12);font-size:.74rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.login-hero h1{margin:20px 0 12px;font-size:clamp(2.2rem,8vw,4rem);line-height:.98;letter-spacing:-.06em}.login-hero p{margin:0;color:rgba(255,255,255,.82);line-height:1.6}.login-points{display:grid;gap:9px;margin-top:22px}.login-point{display:flex;gap:8px;align-items:center;font-size:.9rem}.login-point i{display:grid;width:20px;height:20px;place-items:center;border-radius:50%;background:rgba(255,255,255,.15);font-style:normal}
.login-card{padding:28px 18px;background:rgba(255,255,255,.9);backdrop-filter:blur(14px)}.login-card h2{margin:0 0 8px;color:var(--login-ink);font-size:1.7rem;letter-spacing:-.04em}.login-subtitle{margin:0 0 24px;color:var(--login-muted);line-height:1.55}.login-group{margin-bottom:16px}.login-label{display:block;margin-bottom:8px;color:#334155;font-size:.9rem;font-weight:700}.login-input-wrap{position:relative}.login-input-wrap>svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#94a3b8;pointer-events:none}.login-input{width:100%;min-height:50px;padding:0 46px 0 42px;border:1px solid var(--login-line);border-radius:14px;background:#fff;color:var(--login-ink);font:inherit;outline:0}.login-input:focus{border-color:rgba(21,155,178,.7);box-shadow:0 0 0 4px rgba(21,155,178,.12)}.login-password-toggle{position:absolute;right:8px;top:50%;display:grid;width:36px;height:36px;place-items:center;transform:translateY(-50%);border:0;border-radius:10px;background:transparent;color:#64748b;cursor:pointer}.login-password-toggle:hover,.login-password-toggle:focus-visible{background:#e8f7f8;color:var(--login-dark);outline:0}.login-password-toggle svg{width:18px;height:18px}
.login-row{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;margin:14px 0 18px}.login-check{display:flex;align-items:center;gap:9px;color:#334155;font-size:.92rem}.login-check input{width:18px;height:18px;accent-color:var(--login-brand)}.login-forgot{color:var(--login-dark);font-size:.92rem;font-weight:700;text-decoration:none}.login-forgot:hover{text-decoration:underline}.login-alert{margin:0 0 16px;padding:14px 16px;border:1px solid #fecdd3;border-radius:14px;background:#fff1f2;color:#9f1239;line-height:1.5}.login-submit{width:100%;min-height:52px;border:0;border-radius:14px;background:linear-gradient(135deg,var(--login-brand),#53c6d1);color:#fff;font:inherit;font-weight:800;cursor:pointer;box-shadow:0 16px 32px rgba(21,155,178,.22)}.login-submit:hover{transform:translateY(-2px);box-shadow:0 20px 36px rgba(21,155,178,.28)}.login-support{margin-top:16px;padding-top:16px;border-top:1px solid var(--login-line);color:var(--login-muted);font-size:.9rem;text-align:center}.login-support a{color:var(--login-dark);font-weight:800;text-decoration:none}.login-note{margin-top:14px;color:#94a3b8;font-size:.78rem;line-height:1.5;text-align:center}@media(min-width:860px){.login-page{padding:32px 24px}.login-grid{grid-template-columns:1.1fr .9fr}.login-hero{min-height:650px;display:flex;align-items:flex-end;padding:40px}.login-card{display:flex;align-items:center;padding:40px}.login-card-inner{width:100%}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}
</style>
<div class="login-page"><div class="login-shell"><a class="login-brand" href="/" aria-label="WazeBR Monitor início"><span class="login-mark" aria-hidden="true">⌁</span><span>WazeBR Monitor</span></a><main class="login-grid"><section class="login-hero" aria-label="Apresentação do sistema"><div class="login-hero-content"><span class="login-kicker">Acesso seguro</span><h1>Bem-vindo de volta.</h1><p>Acesse o painel de monitoramento para acompanhar alertas, rotas e dados operacionais em tempo real.</p><div class="login-points"><div class="login-point"><i aria-hidden="true">✓</i><span>Monitoramento centralizado</span></div><div class="login-point"><i aria-hidden="true">✓</i><span>Interface rápida e responsiva</span></div><div class="login-point"><i aria-hidden="true">✓</i><span>Feito para uso diário da equipe</span></div></div></div></section><section class="login-card" aria-label="Formulário de login"><div class="login-card-inner"><h2>Entrar no sistema</h2><p class="login-subtitle">Use suas credenciais para acessar o painel.</p>{% if error %}<div class="login-alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>{% endif %}<form method="post" action="{{ path('auth_login') }}"><div class="login-group"><label class="login-label" for="username">E-mail</label><div class="login-input-wrap"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg><input class="login-input" type="email" id="username" name="email" value="{{ last_username }}" autocomplete="email" required autofocus></div></div><div class="login-group"><label class="login-label" for="password">Senha</label><div class="login-input-wrap"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="11" width="16" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg><input class="login-input" type="password" id="password" name="_password" autocomplete="current-password" required><button class="login-password-toggle" type="button" id="toggle-password" aria-label="Mostrar senha" aria-pressed="false"><svg id="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"></path><circle cx="12" cy="12" r="2.5"></circle></svg><svg id="eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="m3 3 18 18"></path><path d="M10.6 5.1A10.8 10.8 0 0 1 12 5c6.5 0 10 7 10 7a18 18 0 0 1-3.1 3.8M6.2 6.2C3.4 8.2 2 12 2 12s3.5 7 10 7c1.4 0 2.7-.3 3.8-.8"></path><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"></path></svg></button></div></div><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><div class="login-row"><label class="login-check"><input type="checkbox" name="_remember_me"><span>Lembrar acesso</span></label><a class="login-forgot" href="/esqueci-senha">Esqueceu a senha?</a></div><button class="login-submit" type="submit">Entrar</button></form><div class="login-support">Problemas? <a href="mailto:suporte@wazebr.com">Fale com o suporte</a></div><div class="login-note">Ao entrar, você aceita o uso interno da plataforma para operação e monitoramento.</div></div></section></main></div></div><script>const t=document.getElementById('toggle-password'),p=document.getElementById('password'),o=document.getElementById('eye-open'),c=document.getElementById('eye-closed');if(t){t.addEventListener('click',()=>{const show=p.type==='password';p.type=show?'text':'password';o.style.display=show?'none':'block';c.style.display=show?'block':'none';t.setAttribute('aria-label',show?'Ocultar senha':'Mostrar senha');t.setAttribute('aria-pressed',String(show));});}</script>
{% endblock %}