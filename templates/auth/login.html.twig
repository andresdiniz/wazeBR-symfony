{% extends 'base_guest.html.twig' %}

{% block title %}Entrar - WazeBR{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            --bg-start: #7877e3;
            --bg-end: #8a63d4;
            --panel: #1c1814;
            --panel-line: rgba(255,255,255,.06);
            --text: #f3ece1;
            --muted: rgba(243,236,225,.66);
            --accent: #7fd8e6;
            --accent-strong: #65b9cb;
            --input: #11100e;
            --input-line: rgba(255,255,255,.08);
        }

        html, body { height: 100%; }

        body.guest-shell {
            margin: 0;
            min-height: 100vh;
            background: linear-gradient(135deg, var(--bg-start) 0%, var(--bg-end) 100%);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            overflow: hidden;
        }

        .page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 36px;
        }

        .stage {
            width: min(1220px, 100%);
            min-height: 640px;
            position: relative;
        }

        .brand {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-48%, -50%);
            display: inline-flex;
            align-items: center;
            gap: 14px;
            background: #171512;
            padding: 12px 16px 12px 12px;
            border-radius: 2px;
            box-shadow: 0 16px 32px rgba(0,0,0,.22);
            z-index: 1;
        }

        .brand-mark {
            width: 38px;
            height: 38px;
            border-radius: 9px;
            background: linear-gradient(135deg, #84d8e5 0%, #63b8cb 100%);
            display: grid;
            place-items: center;
            color: #f7fffe;
            font-weight: 800;
            font-size: 18px;
            box-shadow: inset 0 1px 0 rgba(255,255,255,.18);
        }

        .brand-name {
            color: #6ad0e1;
            font-weight: 800;
            font-size: 20px;
            letter-spacing: -.02em;
            line-height: 1;
        }

        .brand-chip {
            color: #8fd1df;
            background: rgba(127,216,230,.08);
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
        }

        .card {
            width: min(520px, 100%);
            margin-left: 284px;
            background: var(--panel);
            color: var(--text);
            border: 1px solid var(--panel-line);
            border-radius: 3px;
            box-shadow: 0 24px 60px rgba(0,0,0,.20);
            padding: 28px 30px 24px;
            position: relative;
            z-index: 2;
        }

        .kicker {
            margin: 0 0 8px;
            font-size: 13px;
            letter-spacing: .28em;
            color: rgba(243,236,225,.52);
            text-transform: uppercase;
        }

        .title {
            margin: 0;
            font-size: clamp(30px, 3vw, 40px);
            line-height: 1.02;
            letter-spacing: -.03em;
            font-weight: 800;
            color: #f5efe6;
        }

        .copy {
            margin: 16px 0 22px;
            max-width: 36ch;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.5;
        }

        .alert {
            margin-bottom: 16px;
            padding: 12px 14px;
            border-radius: 10px;
            font-size: 13px;
        }

        .alert-danger {
            background: rgba(182, 78, 78, .18);
            color: #ffd9d9;
            border: 1px solid rgba(255, 149, 149, .18);
        }

        .field { margin-bottom: 14px; }

        .label {
            display: block;
            margin-bottom: 6px;
            color: rgba(243,236,225,.76);
            font-size: 12px;
            letter-spacing: .10em;
            text-transform: uppercase;
        }

        .input {
            width: 100%;
            height: 48px;
            border: 1px solid var(--input-line);
            border-radius: 11px;
            background: var(--input);
            color: #f4efe8;
            padding: 0 16px;
            outline: none;
            font-size: 15px;
            box-shadow: inset 0 1px 0 rgba(255,255,255,.03);
        }

        .input:focus {
            border-color: rgba(127,216,230,.76);
            box-shadow: 0 0 0 3px rgba(127,216,230,.12);
        }

        .submit {
            width: 100%;
            height: 48px;
            margin-top: 8px;
            border: 0;
            border-radius: 11px;
            background: linear-gradient(135deg, #83d8e6 0%, #6bb8ca 100%);
            color: #061015;
            font-size: 15px;
            font-weight: 900;
            cursor: pointer;
            box-shadow: 0 12px 24px rgba(107,184,202,.20);
        }

        .submit:hover { filter: brightness(1.02); }

        .meta {
            margin-top: 14px;
            display: flex;
            justify-content: space-between;
            gap: 12px;
            font-size: 12px;
            color: rgba(243,236,225,.58);
        }

        .meta a {
            color: #95dde8;
            text-decoration: none;
        }

        .meta a:hover { text-decoration: underline; }

        @media (max-width: 900px) {
            .page { padding: 18px; }
            .stage { min-height: auto; padding-top: 92px; }
            .brand { top: 0; transform: translateX(-50%); }
            .card { margin-left: 0; width: 100%; max-width: 520px; }
        }
    </style>
{% endblock %}

{% block body %}
<div class="page">
    <div class="stage">
        <div class="brand" aria-hidden="true">
            <div class="brand-mark">W</div>
            <div class="brand-name">WazeBR</div>
            <div class="brand-chip">Monitor</div>
        </div>

        <section class="card" aria-label="Login">
            <p class="kicker">Monitoramento</p>
            <h1 class="title">Acesso ao sistema</h1>
            <p class="copy">Entre com seu e-mail e senha para continuar no painel de monitoramento.</p>

            {% if error %}
                <div class="alert alert-danger">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('auth_login') }}" novalidate>
                <div class="field">
                    <label for="email" class="label">E-mail</label>
                    <input type="email" id="email" name="email" class="input" value="{{ last_username|default('') }}" autocomplete="email" autofocus required>
                </div>

                <div class="field">
                    <label for="password" class="label">Senha</label>
                    <input type="password" id="password" name="password" class="input" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="submit">Entrar</button>
            </form>

            <div class="meta">
                <span>WazeBR Security</span>
                <a href="{{ path('auth_forgot') }}">Esqueceu sua senha?</a>
            </div>
        </section>
    </div>
</div>
{% endblock %}
