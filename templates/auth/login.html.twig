<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Entrar | WazeBR Monitor</title>
    <meta name="description" content="Acesse o painel de monitoramento do WazeBR Monitor.">
    <style>
        :root {
            --bg: #f4f8fb;
            --surface: rgba(255,255,255,.9);
            --ink: #0f172a;
            --muted: #64748b;
            --brand: #159bb2;
            --brand-dark: #08768b;
            --line: #d9e4ea;
            --shadow: 0 24px 70px rgba(15, 23, 42, .12);
            --radius: 26px;
        }
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body { margin: 0; min-height: 100vh; color: var(--ink); background: radial-gradient(circle at top left, rgba(21,155,178,.14), transparent 30%), radial-gradient(circle at bottom right, rgba(139,211,79,.12), transparent 28%), var(--bg); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
        a { color: inherit; }
        .auth-shell { min-height: 100vh; display: grid; grid-template-columns: 1fr; }
        .auth-brandbar { padding: 18px 16px 0; display: flex; justify-content: center; }
        .auth-brand { display: inline-flex; align-items: center; gap: 10px; padding: 10px 14px; text-decoration: none; font-weight: 850; letter-spacing: -.04em; border: 1px solid rgba(255,255,255,.7); border-radius: 999px; background: rgba(255,255,255,.65); backdrop-filter: blur(10px); box-shadow: 0 10px 30px rgba(15,23,42,.06); }
        .auth-brand-mark { display: grid; width: 34px; height: 34px; place-items: center; color: #fff; border-radius: 11px; background: linear-gradient(135deg, var(--brand), #53c6d1); }
        .auth-layout { width: min(1180px, calc(100% - 24px)); margin: 14px auto 24px; display: grid; gap: 18px; }
        .auth-hero, .auth-card { border: 1px solid rgba(255,255,255,.78); border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; }
        .auth-hero { position: relative; min-height: 220px; padding: 28px; color: #fff; background: linear-gradient(145deg, #0b3143, #0d6b82 55%, #159bb2); }
        .auth-hero::before, .auth-hero::after { content: ""; position: absolute; inset: auto; border-radius: 50%; border: 1px solid rgba(255,255,255,.14); }
        .auth-hero::before { width: 220px; height: 220px; right: -70px; top: -55px; }
        .auth-hero::after { width: 300px; height: 300px; right: -110px; bottom: -120px; }
        .auth-hero-content { position: relative; z-index: 1; display: grid; gap: 16px; max-width: 520px; }
        .auth-kicker { display: inline-flex; align-items: center; gap: 8px; width: fit-content; padding: 8px 12px; border-radius: 999px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.14); font-size: .74rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
        .auth-hero h1 { margin: 0; font-size: clamp(2.1rem, 7vw, 3.8rem); line-height: .98; letter-spacing: -.06em; }
        .auth-hero p { margin: 0; max-width: 42ch; color: rgba(255,255,255,.82); font-size: 1rem; line-height: 1.6; }
        .auth-points { display: grid; gap: 10px; margin-top: 10px; }
        .auth-point { display: inline-flex; align-items: center; gap: 8px; color: rgba(255,255,255,.92); font-size: .9rem; }
        .auth-point i { font-style: normal; width: 20px; height: 20px; display: inline-grid; place-items: center; border-radius: 50%; background: rgba(255,255,255,.15); }
        .auth-card { background: var(--surface); backdrop-filter: blur(14px); padding: 28px 18px; }
        .auth-card h2 { margin: 0 0 8px; font-size: 1.6rem; letter-spacing: -.04em; }
        .auth-card .subtitle { margin: 0 0 24px; color: var(--muted); line-height: 1.55; }
        .form-group { margin-bottom: 16px; }
        label { display: block; margin-bottom: 8px; font-size: .9rem; font-weight: 700; color: #334155; }
        .input-wrap { position: relative; }
        .input-wrap svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; pointer-events: none; }
        input[type="email"], input[type="password"], input[type="text"] { width: 100%; min-height: 50px; padding: 0 16px 0 42px; border: 1px solid var(--line); border-radius: 14px; background: #fff; color: var(--ink); font: inherit; outline: none; transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease; }
        input:focus { border-color: rgba(21,155,178,.7); box-shadow: 0 0 0 4px rgba(21,155,178,.12); }
        .toggle-row { display: flex; justify-content: space-between; gap: 12px; align-items: center; margin: 14px 0 18px; flex-wrap: wrap; }
        .check { display: inline-flex; align-items: center; gap: 10px; font-size: .92rem; color: #334155; }
        .check input { width: 18px; height: 18px; accent-color: var(--brand); }
        .forgot { color: var(--brand-dark); text-decoration: none; font-size: .92rem; font-weight: 700; }
        .forgot:hover { text-decoration: underline; }
        .alert { margin: 0 0 16px; padding: 14px 16px; border-radius: 14px; background: #fff1f2; border: 1px solid #fecdd3; color: #9f1239; font-size: .94rem; line-height: 1.5; }
        .btn-submit { width: 100%; min-height: 52px; border: 0; border-radius: 14px; background: linear-gradient(135deg, var(--brand), #53c6d1); color: #fff; font: inherit; font-weight: 800; cursor: pointer; box-shadow: 0 16px 32px rgba(21,155,178,.22); transition: transform .2s ease, box-shadow .2s ease, filter .2s ease; }
        .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 20px 36px rgba(21,155,178,.28); }
        .btn-submit:focus { outline: none; box-shadow: 0 0 0 4px rgba(21,155,178,.16), 0 16px 32px rgba(21,155,178,.22); }
        .support { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--muted); font-size: .9rem; text-align: center; }
        .support a { color: var(--brand-dark); font-weight: 800; text-decoration: none; }
        .support a:hover { text-decoration: underline; }
        .footer-note { margin-top: 14px; color: #94a3b8; font-size: .78rem; text-align: center; line-height: 1.5; }
        @media (min-width: 860px) { .auth-layout { grid-template-columns: 1.1fr .9fr; align-items: stretch; margin-top: 24px; } .auth-hero { min-height: 650px; display: flex; align-items: flex-end; padding: 40px; } .auth-card { display: flex; align-items: center; padding: 40px; } .auth-card-inner { width: 100%; } .auth-brandbar { justify-content: flex-start; width: min(1180px, calc(100% - 24px)); margin: 0 auto; padding-left: 0; } .auth-card h2 { font-size: 1.95rem; } }
        @media (max-width: 480px) { .auth-layout { width: min(1180px, calc(100% - 16px)); } .auth-hero { padding: 22px; } .auth-card { padding: 22px 16px; } .auth-hero h1 { font-size: 2.1rem; } }
        @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; animation: none !important; transition: none !important; } }
    </style>
</head>
<body>
    <div class="auth-shell">
        <div class="auth-brandbar"><a class="auth-brand" href="/" aria-label="WazeBR Monitor início"><span class="auth-brand-mark" aria-hidden="true">⌁</span><span>WazeBR Monitor</span></a></div>
        <main class="auth-layout">
            <section class="auth-hero" aria-label="Apresentação do sistema"><div class="auth-hero-content"><div class="auth-kicker">Acesso seguro</div><h1>Bem-vindo de volta.</h1><p>Acesse o painel de monitoramento para acompanhar alertas, rotas e dados operacionais em tempo real.</p><div class="auth-points"><div class="auth-point"><i aria-hidden="true">✓</i><span>Monitoramento centralizado</span></div><div class="auth-point"><i aria-hidden="true">✓</i><span>Interface rápida e responsiva</span></div><div class="auth-point"><i aria-hidden="true">✓</i><span>Feito para uso diário da equipe</span></div></div></div></section>
            <section class="auth-card" aria-label="Formulário de login"><div class="auth-card-inner"><h2>Entrar no sistema</h2><p class="subtitle">Use suas credenciais para acessar o painel.</p>
                {% if error %}<div class="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>{% endif %}
                <form method="post" action="{{ path('auth_login') }}" novalidate>
                    <div class="form-group"><label for="username">E-mail</label><div class="input-wrap"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg><input type="email" id="username" name="email" value="{{ last_username }}" autocomplete="email" required autofocus></div></div>
                    <div class="form-group"><label for="password">Senha</label><div class="input-wrap"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="11" width="16" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg><input type="password" id="password" name="_password" autocomplete="current-password" required></div></div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <div class="toggle-row"><label class="check"><input type="checkbox" name="_remember_me"><span>Lembrar acesso</span></label><a class="forgot" href="{{ path('auth_forgot') }}">Esqueceu a senha?</a></div>
                    <button class="btn-submit" type="submit">Entrar</button>
                </form>
                <div class="support">Problemas? <a href="mailto:suporte@wazebr.com">Fale com o suporte</a></div><div class="footer-note">Ao entrar, você aceita o uso interno da plataforma para operação e monitoramento.</div>
            </div></section>
        </main>
    </div>
</body>
</html>