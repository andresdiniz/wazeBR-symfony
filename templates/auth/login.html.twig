{% extends 'base_guest.html.twig' %}

{% block title %}Entrar - WazeBR{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            --bg-start: #7277e8;
            --bg-end: #8a62d6;
            --panel: #171512;
            --panel-soft: rgba(255,255,255,.06);
            --text-main: #f3eee4;
            --text-soft: rgba(243,238,228,.68);
            --brand: #7fd8e8;
            --brand-strong: #61b8ca;
            --input: #10100e;
            --input-border: rgba(255,255,255,.08);
            --shadow: 0 24px 60px rgba(0,0,0,.22);
        }

        html, body {
            height: 100%;
        }

        body.guest-shell {
            margin: 0;
            min-height: 100vh;
            background:
                radial-gradient(circle at 18% 18%, rgba(255,255,255,.09), transparent 24%),
                linear-gradient(135deg, var(--bg-start) 0%, var(--bg-end) 100%);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            overflow: hidden;
        }

        .login-stage {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 42px;
        }

        .login-canvas {
            width: min(1240px, 100%);
            min-height: 640px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .brand-strip {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-52%, -50%);
            display: inline-flex;
            align-items: center;
            gap: 16px;
            padding: 13px 18px 13px 14px;
            background: #171512;
            border-radius: 2px;
            box-shadow: 0 16px 34px rgba(0,0,0,.24);
            z-index: 1;
        }

        .brand-mark {
            width: 38px;
            height: 38px;
            border-radius: 9px;
            background: linear-gradient(135deg, #7ed8e8 0%, #69bfd0 100%);
            color: #f7fffd;
            display: grid;
            place-items: center;
            font-weight: 800;
            font-size: 19px;
            letter-spacing: .02em;
            box-shadow: inset 0 1px 0 rgba(255,255,255,.22);
        }

        .brand-name {
            color: #5bc0d8;
            font-weight: 800;
            letter-spacing: -.02em;
            font-size: 21px;
        }

        .brand-tag {
            color: #8bcfdc;
            font-size: 12px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 999px;
            background: rgba(127,216,232,.09);
        }

        .login-panel {
            width: min(470px, 100%);
            margin-left: 300px;
            background: var(--panel);
            color: var(--text-main);
            border: 1px solid rgba(255,255,255,.05);
            border-radius: 3px;
            box-shadow: var(--shadow);
            position: relative;
            z-index: 2;
            padding: 26px 28px 22px;
        }

        .login-kicker {
            margin: 0 0 8px;
            font-size: 13px;
            letter-spacing: .36em;
            color: rgba(243,238,228,.46);
            text-transform: uppercase;
        }

        .login-title {
            margin: 0;
            font-size: clamp(28px, 3vw, 38px);
            line-height: 1.06;
            font-weight: 800;
            letter-spacing: -.03em;
            color: #f5efe6;
        }

        .login-copy {
            margin: 14px 0 22px;
            color: var(--text-soft);
            font-size: 14px;
            line-height: 1.5;
            max-width: 34ch;
        }

        .alert {
            padding: 12px 14px;
            margin-bottom: 16px;
            border-radius: 10px;
            font-size: 13px;
        }

        .alert-danger {
            background: rgba(188, 77, 77, .18);
            color: #ffd6d6;
            border: 1px solid rgba(255, 146, 146, .20);
        }

        .field {
            margin-bottom: 14px;
        }

        .label {
            display: block;
            margin-bottom: 6px;
            color: rgba(243,238,228,.72);
            font-size: 12px;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .input {
            width: 100%;
            height: 48px;
            padding: 0 16px;
            border: 1px solid var(--input-border);
            border-radius: 10px;
            background: var(--input);
            color: #f6f2ea;
            font-size: 15px;
            outline: none;
            box-shadow: inset 0 1px 0 rgba(255,255,255,.03);
            transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
        }

        .input:focus {
            border-color: rgba(127,216,232,.8);
            box-shadow: 0 0 0 3px rgba(127,216,232,.14);
        }

        .submit {
            width: 100%;
            height: 48px;
            margin-top: 8px;
            border: 0;
            border-radius: 10px;
            background: linear-gradient(135deg, #7fd8e8 0%, #65b8ca 100%);
            color: #061015;
            font-size: 15px;
            font-weight: 900;
            letter-spacing: .06em;
            text-transform: none;
            cursor: pointer;
            box-shadow: 0 12px 26px rgba(101,184,202,.22);
        }

        .submit:hover {
            filter: brightness(1.02);
        }

        .login-meta {
            margin-top: 14px;
            display: flex;
            justify-content: space-between;
            gap: 12px;
            font-size: 12px;
            color: rgba(243,238,228,.58);
        }

        .login-meta a {
            color: #96dde9;
            text-decoration: none;
        }

        .login-meta a:hover {
            text-decoration: underline;
        }

        @media (max-width: 900px) {
            .login-stage {
                padding: 20px;
            }

            .login-canvas {
                min-height: auto;
                padding-top: 96px;
            }

            .brand-strip {
                top: 0;
                transform: translateX(-50%);
            }

            .login-panel {
                margin-left: 0;
                width: 100%;
                max-width: 470px;
            }
        }

        @media (max-width: 640px) {
            .brand-strip {
                flex-wrap: wrap;
                justify-content: center;
                gap: 10px;
            }

            .login-panel {
                padding: 22px 18px 18px;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="login-stage">
    <div class="login-canvas">
        <div class="brand-strip" aria-hidden="true">
            <div class="brand-mark">W</div>
            <div class="brand-name">WazeBR</div>
            <div class="brand-tag">Monitor</div>
        </div>

        <section class="login-panel" aria-label="Login">
            <p class="login-kicker">Monitoramento</p>
            <h1 class="login-title">Acesso ao sistema</h1>
            <p class="login-copy">Entre com seu e-mail e senha para continuar no painel de monitoramento.</p>

            {% if error %}
                <div class="alert alert-danger">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('auth_login') }}" novalidate>
                <div class="field">
                    <label for="email" class="label">E-mail</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="input"
                        value="{{ last_username|default('') }}"
                        autocomplete="email"
                        autofocus
                        required
                    >
                </div>

                <div class="field">
                    <label for="password" class="label">Senha</label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        class="input"
                        autocomplete="current-password"
                        required
                    >
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="submit" type="submit">Entrar</button>
            </form>

            <div class="login-meta">
                <span>WazeBR Security</span>
                <a href="{{ path('auth_forgot') }}">Esqueceu sua senha?</a>
            </div>
        </section>
    </div>
</div>
{% endblock %}
