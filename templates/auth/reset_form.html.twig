{% extends 'base_guest.html.twig' %}

{% block title %}Definir nova senha - WazeBR{% endblock %}

{% block stylesheets %}
    <style>
        body.guest-shell {
            min-height: 100vh;
            margin: 0;
            background: linear-gradient(135deg, #755be9 0%, #8b63e0 45%, #5b9be9 100%);
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .reset-shell {
            width: 100%;
            max-width: 480px;
            padding: 24px;
        }

        .reset-card {
            background: rgba(14, 13, 24, 0.90);
            border-radius: 18px;
            border: 1px solid rgba(255,255,255,0.08);
            box-shadow: 0 24px 64px rgba(0,0,0,0.55);
            padding: 22px 24px 20px;
            color: #f7f1e8;
        }

        .reset-title {
            margin: 0 0 6px;
            font-size: 20px;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .reset-text {
            margin: 8px 0 18px;
            font-size: 13px;
            color: rgba(244,239,232,0.76);
        }

        .field { margin-bottom: 12px; }

        .label {
            display: block;
            margin-bottom: 6px;
            font-size: 12px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: rgba(244,239,232,0.80);
        }

        .input {
            width: 100%;
            height: 44px;
            padding: 0 14px;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.10);
            background: rgba(7,7,12,0.96);
            color: #f7f1e8;
            font-size: 14px;
            outline: none;
        }

        .input::placeholder { color: rgba(244,239,232,0.42); }

        .input:focus {
            border-color: rgba(127,216,230,0.90);
            box-shadow: 0 0 0 2px rgba(127,216,230,0.22);
        }

        .submit {
            margin-top: 10px;
            width: 100%;
            height: 44px;
            border-radius: 12px;
            border: none;
            background: linear-gradient(135deg, #7fd8e6 0%, #59b4c7 100%);
            color: #041014;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            cursor: pointer;
        }

        .submit:hover { filter: brightness(1.03); }

        .footer {
            margin-top: 14px;
            font-size: 11px;
            color: rgba(244,239,232,0.64);
            text-align: center;
        }

        .footer a { color: #7fd8e6; text-decoration: none; }
        .footer a:hover { text-decoration: underline; }
    </style>
{% endblock %}

{% block body %}
<div class="reset-shell">
    <div class="reset-card">
        <h1 class="reset-title">Definir nova senha</h1>
        <p class="reset-text">Crie uma nova senha para sua conta. Use uma combinação segura e não reutilize senhas de outros serviços.</p>

        {% for message in app.flashes('reset_password_error') %}
            <p class="reset-text">{{ message }}</p>
        {% endfor %}

        <form method="post" action="{{ path('auth_reset') }}" novalidate>
            <div class="field">
                <label for="password" class="label">Nova senha</label>
                <input type="password" id="password" name="password" class="input" required autocomplete="new-password">
            </div>

            <div class="field">
                <label for="password_confirm" class="label">Confirmar senha</label>
                <input type="password" id="password_confirm" name="password_confirm" class="input" required autocomplete="new-password">
            </div>

            <button type="submit" class="submit">Atualizar senha</button>
        </form>

        <div class="footer">
            <a href="{{ path('auth_login') }}">Voltar ao login</a>
        </div>
    </div>
</div>
{% endblock %}
