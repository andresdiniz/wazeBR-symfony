<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Crie uma nova senha - wazeBR">
    <title>Criar Nova Senha - wazeBR</title>
    
    {# Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    {# Icons #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    {# Stylesheets #}
    <link rel="stylesheet" href="{{ asset('assets/css/reset-password.css') }}">
    
    {# Favicon #}
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
</head>
<body>
    <div class="reset-page">
        {# Left Side - Form #}
        <div class="reset-left">
            <div class="reset-container">
                {# Logo #}
                <a href="{{ path('app_home') }}" class="logo">
                    <div class="logo-icon">
                        <i class="fas fa-road"></i>
                    </div>
                    <span class="logo-text">waze<span class="highlight">BR</span></span>
                </a>

                {# Header #}
                <div class="reset-header">
                    <div class="reset-icon">
                        <i class="fas fa-lock"></i>
                    </div>
                    <h1>Crie uma nova senha</h1>
                    <p>Sua nova senha deve ser diferente da anterior e ter pelo menos 6 caracteres.</p>
                </div>

                {# Success/Error Messages #}
                {% for type, messages in app.session.flashBag.all %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type }}">
                            <i class="fas fa-{{ type == 'success' ? 'check-circle' : 'exclamation-circle' }}"></i>
                            <span>{{ message }}</span>
                        </div>
                    {% endfor %}
                {% endfor %}

                {# Reset Form #}
                <form method="post" class="reset-form" novalidate>
                    <div class="form-group">
                        <label for="password">
                            <i class="fas fa-lock"></i>
                            <span>Nova Senha</span>
                        </label>
                        <div class="password-wrapper">
                            <input 
                                type="password" 
                                id="password" 
                                name="password" 
                                required 
                                minlength="6"
                                autofocus
                                autocomplete="new-password"
                                placeholder="M\u00ed\u00ednimo 6 caracteres"
                                class="form-control"
                            >
                            <button type="button" class="toggle-password" onclick="togglePassword('password', 'toggleIcon1')">
                                <i class="fas fa-eye" id="toggleIcon1"></i>
                            </button>
                        </div>
                        <p class="form-help">
                            <i class="fas fa-info-circle"></i>
                            Use pelo menos 6 caracteres
                        </p>
                    </div>

                    <div class="form-group">
                        <label for="confirm_password">
                            <i class="fas fa-lock"></i>
                            <span>Confirmar Nova Senha</span>
                        </label>
                        <div class="password-wrapper">
                            <input 
                                type="password" 
                                id="confirm_password" 
                                name="confirm_password" 
                                required 
                                minlength="6"
                                autocomplete="new-password"
                                placeholder="Repita a nova senha"
                                class="form-control"
                            >
                            <button type="button" class="toggle-password" onclick="togglePassword('confirm_password', 'toggleIcon2')">
                                <i class="fas fa-eye" id="toggleIcon2"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block btn-reset">
                        <span>Alterar Senha</span>
                        <i class="fas fa-check"></i>
                    </button>
                </form>

                {# Password Requirements #}
                <div class="requirements-box">
                    <h4>Requisitos de senha segura:</h4>
                    <ul class="requirements-list">
                        <li><i class="fas fa-check"></i> M\u00ed\u00ednimo de 6 caracteres</li>
                        <li><i class="fas fa-check"></i> Use letras e n\u00fameros</li>
                        <li><i class="fas fa-check"></i> Evite senhas \u00f3bvias</li>
                        <li><i class="fas fa-check"></i> N\u00e3o use dados pessoais</li>
                    </ul>
                </div>

                {# Back to Login #}
                <div class="back-login">
                    <a href="{{ path('app_login') }}">
                        <i class="fas fa-arrow-left"></i>
                        <span>Voltar para login</span>
                    </a>
                </div>
            </div>
        </div>

        {# Right Side - Visual #}
        <div class="reset-right">
            <div class="reset-visual">
                <div class="visual-content">
                    <div class="visual-header">
                        <div class="logo-large">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <h2>Seguran\u00e7a em Primeiro Lugar</h2>
                    </div>
                    
                    <div class="visual-body">
                        <h3>Dicas para uma senha forte</h3>
                        <p>Uma senha forte \u00e9 a melhor defesa contra acessos n\u00e3o autorizados.</p>
                        
                        <div class="security-features">
                            <div class="security-item">
                                <i class="fas fa-key"></i>
                                <span>Use combina\u00e7\u00f5es \u00fanicas</span>
                            </div>
                            <div class="security-item">
                                <i class="fas fa-random"></i>
                                <span>Misture letras, n\u00fameros e s\u00ed\u00edmbolos</span>
                            </div>
                            <div class="security-item">
                                <i class="fas fa-user-secret"></i>
                                <span>N\u00e3o compartilhe sua senha</span>
                            </div>
                        </div>
                    </div>

                    <div class="visual-stats">
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-lock"></i>
                            </div>
                            <div class="stat-info">
                                <strong>100%</strong>
                                <span>Seguro</span>
                            </div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-bolt"></i>
                            </div>
                            <div class="stat-info">
                                <strong>R\u00e1pido</strong>
                                <span>Processo</span>
                            </div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-check"></i>
                            </div>
                            <div class="stat-info">
                                <strong>F\u00e1cil</strong>
                                <span>Alterar</span>
                            </div>
                        </div>
                    </div>
                </div>

                {# Background Elements #}
                <div class="bg-circle bg-circle-1"></div>
                <div class="bg-circle bg-circle-2"></div>
                <div class="bg-circle bg-circle-3"></div>
            </div>
        </div>
    </div>

    {# JavaScript #}
    <script src="{{ asset('assets/js/reset-password.js') }}"></script>
    <script>
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
</body>
</html>
