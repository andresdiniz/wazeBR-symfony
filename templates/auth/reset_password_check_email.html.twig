                        </li>
                        <li>
                            <i class="fas fa-key"></i>
                            <span>Crie uma nova senha</span>
                        </li>
                    </ol>
                </div>

                {# Info Alert #}
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i>
                    <div>
                        <strong>Não recebeu o email?</strong>
                        <p>Verifique sua caixa de spam ou tente novamente em alguns minutos.</p>
                    </div>
                </div>

                {# Resend Link #}
                <div class="resend-section">
                    <p>O email não chegou?</p>
                    <a href="{{ path('app_reset_password_request') }}" class="btn btn-outline">
                        <i class="fas fa-redo"></i>
                        <span>Reenviar instruções</span>
                    </a>
                </div>

                {# Back to Login #}
                <div class="back-login">
                    <a href="{{ path('app_login') }}">
                        <i class="fas fa-arrow-left"></i>
                        <span>Voltar para login</span>
                    </a>
                </div>
            </div>
        </div>

        {# Right Side - Visual #}
        <div class="reset-right">
            <div class="reset-visual">
                <div class="visual-content">
                    <div class="visual-header">
                        <div class="logo-large">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <h2>Segurança em Primeiro Lugar</h2>
                    </div>

                    <div class="visual-body">
                        <p>Seu link de recuperação de senha é válido por apenas 1 hora e pode ser usado apenas uma vez.</p>

                        <div class="security-features">
                            <div class="security-item">
                                <i class="fas fa-lock"></i>
                                <span>Link criptografado</span>
                            </div>
                            <div class="security-item">
                                <i class="fas fa-clock"></i>
                                <span>Válido por 1 hora</span>
                            </div>
                            <div class="security-item">
                                <i class="fas fa-undo"></i>
                                <span>Uso único</span>
                            </div>
                        </div>
                    </div>

                    <div class="visual-stats">
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-user-shield"></i>
                            </div>
                            <div class="stat-info">
                                <strong>100%</strong>
                                <span>Seguro</span>
                            </div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-bolt"></i>
                            </div>
                            <div class="stat-info">
                                <strong>Rápido</strong>
                                <span>Processo</span>
                            </div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-check"></i>
                            </div>
                            <div class="stat-info">
                                <strong>Fácil</strong>
                                <span>Recuperar</span>
                            </div>
                        </div>
                    </div>
