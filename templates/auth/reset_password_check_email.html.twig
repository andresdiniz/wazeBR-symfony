<body>
    <div class="reset-page">
        {# Left Side - Success Message #}
        <div class="reset-left">
            <div class="reset-container">
                {# Logo #}
                <a href="{{ path('app_home') }}" class="logo">
                    <div class="logo-icon">
                        <i class="fas fa-road"></i>
                    </div>
                    <span class="logo-text">waze<span class="highlight">BR</span></span>
                </a>

                {# Success Icon #}
                <div class="success-section">
                    <div class="success-icon-large">
                        <i class="fas fa-envelope-open-text"></i>
                    </div>
                    <h1>Email enviado!</h1>
                    <p>Enviamos um email com instruções para recuperar sua senha.</p>
                </div>

                {# Instructions #}
                <div class="instructions-box">
                    <h3>O que fazer agora?</h3>
                    <ol class="instructions-list">
                        <li>
                            <i class="fas fa-inbox"></i>
                            <span>Verifique sua caixa de entrada</span>
                        </li>
                        <li>
                            <i class="fas fa-search"></i>
                            <span>Procure por "Recuperação de Senha wazeBR"</span>
                        </li>
