{% extends 'base_guest.html.twig' %}

{% block title %}Meu perfil - WazeBR Monitor{% endblock %}

{% block stylesheets %}
    <style>
        :root { --brand:#159bb2; --brand-dark:#08768b; --ink:#102033; --muted:#607084; --line:#dfecef; --bg:#f7fbfc; }
        body.guest-shell {
            min-height: 100vh;
            margin: 0;
            background: var(--bg);
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: var(--ink);
        }

        .profile-shell { width: min(560px, calc(100% - 32px)); margin: 0 auto; padding: 48px 0; }

        .profile-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 18px;
            color: var(--muted);
            font-size: 13px;
            text-decoration: none;
        }
        .profile-back:hover { color: var(--brand); }

        .profile-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 24px;
            padding: 28px 26px;
            box-shadow: 0 10px 30px rgba(16,32,51,0.06);
        }

        .profile-header { display: flex; align-items: center; gap: 14px; margin-bottom: 24px; }
        .profile-avatar {
            width: 52px; height: 52px; border-radius: 16px;
            display: grid; place-items: center;
            background: linear-gradient(145deg, var(--brand), #50c0cb);
            color: #fff; font-weight: 800; font-size: 20px;
        }
        .profile-title { margin: 0; font-size: 20px; font-weight: 800; letter-spacing: -0.02em; }
        .profile-subtitle { margin: 2px 0 0; font-size: 13px; color: var(--muted); }

        .field { margin-bottom: 16px; }
        .label {
            display: block;
            margin-bottom: 6px;
            font-size: 12px;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .input {
            width: 100%;
            height: 46px;
            padding: 0 14px;
            border-radius: 12px;
            border: 1px solid var(--line);
            background: #fbfdfe;
            font-size: 14px;
            outline: none;
        }
        .input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px #159bb21f; }
        .input:disabled { color: var(--muted); background: #f2f6f7; }

        .hint { margin: 6px 0 0; font-size: 12px; color: var(--muted); }

        .submit {
            width: 100%;
            height: 46px;
            margin-top: 6px;
            border: none;
            border-radius: 12px;
            background: var(--brand);
            color: #fff;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            transition: .2s ease;
        }
        .submit:hover { background: var(--brand-dark); transform: translateY(-1px); }

        .alert { padding: 10px 12px; border-radius: 10px; font-size: 13px; margin-bottom: 16px; }
        .alert-error { background: #fdeaea; color: #b23a3a; border: 1px solid #f4c6c6; }
        .alert-success { background: #eaf9ee; color: #2f8f4e; border: 1px solid #c7ecd2; }

        .divider { height: 1px; background: var(--line); margin: 22px 0; }
    </style>
{% endblock %}

{% block body %}
<div class="profile-shell">
    <a class="profile-back" href="{{ path('dashboard_index') }}">← Voltar ao painel</a>

    <div class="profile-card">
        <div class="profile-header">
            <div class="profile-avatar">{{ user.name|default('?')|slice(0, 1)|upper }}</div>
            <div>
                <h1 class="profile-title">Meu perfil</h1>
                <p class="profile-subtitle">{{ user.email }}</p>
            </div>
        </div>

        {% for message in app.flashes('error') %}
            <p class="alert alert-error">{{ message }}</p>
        {% endfor %}
        {% for message in app.flashes('success') %}
            <p class="alert alert-success">{{ message }}</p>
        {% endfor %}

        <form method="post" action="{{ path('auth_profile') }}" novalidate>
            <div class="field">
                <label for="name" class="label">Nome</label>
                <input type="text" id="name" name="name" class="input" value="{{ user.name }}" required>
            </div>

            <div class="field">
                <label class="label">E-mail</label>
                <input type="email" class="input" value="{{ user.email }}" disabled>
                <p class="hint">O e-mail é o identificador da conta e não pode ser alterado por aqui.</p>
            </div>

            {% if user.lastLoginAt %}
            <div class="field">
                <label class="label">Último acesso</label>
                <p class="hint" style="margin-top:0;">
                    {{ user.lastLoginAt|date('d/m/Y \\à\\s H:i') }}{% if user.lastLoginIp %} — IP {{ user.lastLoginIp }}{% endif %}
                </p>
            </div>
            {% endif %}

            <div class="divider"></div>

            <div class="field">
                <label for="password" class="label">Nova senha (opcional)</label>
                <input type="password" id="password" name="password" class="input" minlength="8" pattern="(?=.*[A-Za-z])(?=.*\d).{8,}" title="Mínimo de 8 caracteres, com letras e números" autocomplete="new-password" placeholder="Deixe em branco para manter a senha atual">
                <p class="hint">Preencha apenas se quiser trocar sua senha. Mínimo de 8 caracteres, incluindo letras e números.</p>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('auth_profile') }}">

            <button type="submit" class="submit">Salvar alterações</button>
        </form>
    </div>
</div>
{% endblock %}
