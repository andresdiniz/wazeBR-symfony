<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Redefinir Senha{% endblock %} - wazeBR</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Public Pages CSS -->
    <link rel="stylesheet" href="{{ asset('css/public-pages.css') }}">
    
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {% block body %}
    <div class="auth-page-wrapper">
        <div class="auth-container">
            <div class="auth-card">
                <div class="auth-header">
                    <div class="auth-logo">
                        <i class="bi bi-speedometer2"></i>
                    </div>
                    <h1 class="auth-title">Redefinir Senha</h1>
                    <p class="auth-subtitle">Crie uma nova senha para sua conta</p>
                </div>
                
                <div class="auth-body">
                    {% for type, messages in app.flashes %}
                    {% for message in messages %}
                    <div class="alert alert-{{ type }} alert-dismissible fade show auth-alert" role="alert" data-timeout="5000">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    {% endfor %}
                    {% endfor %}
                    
                    <form method="POST" class="auth-form" data-validate="true">
                        <div class="auth-form-group">
                            <label class="auth-form-label" for="password">Nova Senha</label>
                            <div class="auth-input-wrapper">
                                <i class="bi bi-lock auth-input-icon"></i>
                                <input type="password" id="password" name="password" class="auth-form-input with-icon" data-required="true" placeholder="••••••••" minlength="6" required autofocus>
                                <button type="button" class="auth-password-toggle" title="Mostrar senha">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <small class="text-muted">
                                <i class="bi bi-shield-check me-1"></i>
                                Mínimo de 6 caracteres
                            </small>
                        </div>
                        
                        <div class="auth-form-group">
                            <label class="auth-form-label" for="confirm_password">Confirmar Senha</label>
                            <div class="auth-input-wrapper">
                                <i class="bi bi-lock-fill auth-input-icon"></i>
                                <input type="password" id="confirm_password" name="confirm_password" class="auth-form-input with-icon" data-required="true" placeholder="••••••••" required>
                            </div>
                        </div>
                        
                        <button type="submit" class="auth-form-submit">
                            <i class="bi bi-check-lg me-2"></i>
                            Redefinir Senha
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    {% endblock %}
    
    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Public Pages JS -->
    <script type="module">
        import initPublicPages, { initAlerts } from '{{ asset('js/public-pages.js') }}';
        initPublicPages();
        initAlerts();
    </script>
    
    {% block javascripts %}{% endblock %}
</body>
</html>
