{% extends 'base.html.twig' %}

{% block title %}Redefinir Senha | wazeBR{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/auth.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('controllers/reset_password.js') }}"></script>
{% endblock %}

{% block body_class %}auth-page{% endblock %}

{% block body %}
<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Nova Senha</h1>
            <p>Escolha uma senha forte e segura</p>
        </div>

        {% for flash_error in app.flashes('reset_password_error') %}
            <div class="auth-alert auth-alert-error" role="alert">{{ flash_error }}</div>
        {% endfor %}

        {{ form_start(resetForm, { 'attr': { 'class': 'auth-form', 'novalidate': 'novalidate' } }) }}
            <!-- Campo: Nova senha -->
            <div class="auth-field">
                <label for="{{ resetForm.plainPassword.vars.id }}">Nova senha</label>
                <div class="auth-password">
                    {{ form_widget(resetForm.plainPassword, {
                        'attr': {
                            'autocomplete': 'new-password',
                            'placeholder': 'Mínimo 8 caracteres',
                            'class': 'form-control',
                            'data-strength': 'true',
                            'aria-describedby': 'password-strength'
                        }
                    }) }}
                    <button type="button" class="auth-password-toggle" data-password-toggle
                            aria-label="Mostrar senha" aria-pressed="false">Mostrar</button>
                </div>
                <div id="password-strength" style="font-size: 0.85rem; margin-top: 0.3rem; min-height: 1.5rem;"></div>
                <div class="password-strength-container" aria-hidden="true">
                    <div class="password-strength-bar" id="strength-bar"></div>
                </div>
                {{ form_errors(resetForm.plainPassword) }}
            </div>

            <!-- Campo: Confirmar senha -->
            <div class="auth-field">
                <label for="{{ resetForm.confirmPassword.vars.id }}">Confirmar senha</label>
                <div class="auth-password">
                    {{ form_widget(resetForm.confirmPassword, {
                        'attr': {
                            'autocomplete': 'new-password',
                            'placeholder': 'Confirme sua nova senha',
                            'class': 'form-control',
                            'data-confirm': 'true',
                            'onpaste': 'return false',
                            'oncopy': 'return false',
                            'oncut': 'return false',
                            'ondrag': 'return false',
                            'aria-describedby': 'confirm-message'
                        }
                    }) }}
                    <button type="button" class="auth-password-toggle" data-password-toggle
                            aria-label="Mostrar senha" aria-pressed="false">Mostrar</button>
                </div>
                <div id="confirm-message" style="font-size: 0.85rem; margin-top: 0.3rem; min-height: 1.5rem;">
                    As senhas devem coincidir
                </div>
                {{ form_errors(resetForm.confirmPassword) }}
            </div>

            <button type="submit" class="auth-submit">
                Redefinir Senha
            </button>
        {{ form_end(resetForm) }}

        <div class="auth-footer">
            <a href="{{ path('app_login') }}">← Voltar ao login</a>
        </div>
    </div>
</div>
{% endblock %}
