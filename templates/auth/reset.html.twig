{% extends 'base.html.twig' %}

{% block title %}Redefinir Senha - wazeBR{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/auth.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('auth') }}
{% endblock %}

{% block body %}
<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Nova Senha</h1>
            <p>Digite sua nova senha abaixo</p>
        </div>

        {% for flash_error in app.flashes('reset_password_error') %}
            <div class="alert alert-danger">{{ flash_error }}</div>
        {% endfor %}

        <form method="post" class="auth-form" novalidate>
            {{ form_start(resetForm) }}
                <div class="form-group">
                    {{ form_label(resetForm.plainPassword, 'Nova Senha') }}
                    <div class="password-input-wrapper">
                        {{ form_widget(resetForm.plainPassword, {
                            'attr': {
                                'autocomplete': 'new-password',
                                'placeholder': 'M\u00ed\u00ednimo 6 caracteres',
                                'class': 'form-control'
                            }
                        }) }}
                        <button type="button" class="toggle-password" aria-label="Mostrar senha">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    {{ form_errors(resetForm.plainPassword) }}
                </div>

                <button type="submit" class="btn btn-primary btn-block">
                    Redefinir Senha
                </button>
            {{ form_end(resetForm) }}
        </form>
    </div>
</div>
{% endblock %}
