{% extends 'admin/base.html.twig' %}
{% block title %}Admin Dashboard{% endblock %}
{% block header_title %}Admin Dashboard{% endblock %}
{% block body %}
<div class="row g-4 mb-4">
  <div class="col-md-2">
    <div class="card shadow-sm">
      <div class="card-body">
        <h6 class="card-subtitle text-muted">Traffic Jams (24h)</h6>
        <h2 class="card-title mb-0">{{ trafficJamCount }}</h2>
      </div>
    </div>
  </div>
  <div class="col-md-2">
    <div class="card shadow-sm">
      <div class="card-body">
        <h6 class="card-subtitle text-muted">Alerts (24h)</h6>
        <h2 class="card-title mb-0">{{ alertCount }}</h2>
      </div>
    </div>
  </div>
  <div class="col-md-2">
    <div class="card shadow-sm">
      <div class="card-body">
        <h6 class="card-subtitle text-muted">Irregularities</h6>
        <h2 class="card-title mb-0">{{ irregularityCount }}</h2>
      </div>
    </div>
  </div>
  <div class="col-md-2">
    <div class="card shadow-sm">
      <div class="card-body">
        <h6 class="card-subtitle text-muted">Routes</h6>
        <h2 class="card-title mb-0">{{ routeCount }}</h2>
      </div>
    </div>
  </div>
  <div class="col-md-2">
    <div class="card shadow-sm">
      <div class="card-body">
        <h6 class="card-subtitle text-muted">Hydro Data (24h)</h6>
        <h2 class="card-title mb-0">{{ hydroDataCount }}</h2>
      </div>
    </div>
  </div>
</div>
<div class="row g-4">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header"><h5 class="mb-0">Recent Traffic Jams</h5></div>
      <div class="card-body">
        {% if recentTrafficJams|length > 0 %}
          <ul class="list-group list-group-flush">
            {% for jam in recentTrafficJams %}
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                  <strong>{{ jam.streetName|default('Sem rua') }}</strong>
                  {% if jam.city %}<small class="text-muted">- {{ jam.city }}</small>{% endif %}
                </div>
                <span class="badge bg-{{ jam.level >= 4 ? 'danger' : (jam.level >= 2 ? 'warning' : 'success') }}">Level {{ jam.level }}</span>
              </li>
            {% endfor %}
          </ul>
        {% else %}<p class="text-muted mb-0">No recent traffic jams.</p>{% endif %}
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header"><h5 class="mb-0">Recent Alerts</h5></div>
      <div class="card-body">
        {% if recentAlerts|length > 0 %}
          <ul class="list-group list-group-flush">
            {% for alert in recentAlerts %}
              <li class="list-group-item">
                <div>
                  <strong>{{ alert.subtype|default('Alert') }}</strong>
                  {% if alert.streetName %}<small class="text-muted">- {{ alert.streetName }}</small>{% endif %}
                  {% if alert.reportedAt %}<br><small class="text-muted">{{ alert.reportedAt|date('d/m/Y H:i') }}</small>{% endif %}
                </div>
              </li>
            {% endfor %}
          </ul>
        {% else %}<p class="text-muted mb-0">No recent alerts.</p>{% endif %}
      </div>
    </div>
  </div>
</div>
{% endblock %}