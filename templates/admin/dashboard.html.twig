{% extends 'base_dashboard.html.twig' %}

{% block title %}Admin Dashboard - WazeBR{% endblock %}

{% block header_title %}Admin Dashboard{% endblock %}

{% block header_subtitle %}Painel de administraçº£o do sistema{% endblock %}

{% block body %}
<div class="space-y-6">
    {# Admin Stats Overview #}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {# Total Partners #}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Total de Parceiros</p>
                    <p class="text-2xl font-bold text-gray-900">{{ partnerCount|default(0) }}</p>
                </div>
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-building text-blue-600"></i>
                </div>
            </div>
        </div>
        
        {# Total Cities #}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Total de Cidades</p>
                    <p class="text-2xl font-bold text-gray-900">{{ cityCount|default(0) }}</p>
                </div>
                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-city text-green-600"></i>
                </div>
            </div>
        </div>
        
        {# Total Routes #}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Total de Rotas</p>
                    <p class="text-2xl font-bold text-gray-900">{{ routeCount|default(0) }}</p>
                </div>
                <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-map-marked text-purple-600"></i>
                </div>
            </div>
        </div>
        
        {# Total Users #}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600">Total de UsuÃ¡rios</p>
                    <p class="text-2xl font-bold text-gray-900">{{ userCount|default(0) }}</p>
                </div>
                <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-users text-orange-600"></i>
                </div>
            </div>
        </div>
    </div>
    
    {# Quick Actions #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Açºµes RÃ¡pidas</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <a href="{{ path('admin_partner_index') }}" class="flex items-center space-x-3 p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                <i class="fas fa-plus-circle text-blue-600"></i>
                <span class="font-medium text-gray-700">Novo Parceiro</span>
            </a>
            <a href="{{ path('admin_city_index') }}" class="flex items-center space-x-3 p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                <i class="fas fa-plus-circle text-green-600"></i>
                <span class="font-medium text-gray-700">Nova Cidade</span>
            </a>
            <a href="{{ path('admin_route_index') }}" class="flex items-center space-x-3 p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                <i class="fas fa-plus-circle text-purple-600"></i>
                <span class="font-medium text-gray-700">Nova Rota</span>
            </a>
            <a href="{{ path('admin_settings_index') }}" class="flex items-center space-x-3 p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                <i class="fas fa-cog text-gray-600"></i>
                <span class="font-medium text-gray-700">Configuraçºµes</span>
            </a>
        </div>
    </div>
    
    {# Recent Activity #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Atividade Recente</h2>
        <div class="space-y-4">
            <div class="flex items-center space-x-3 text-sm text-gray-600">
                <i class="fas fa-info-circle text-blue-500"></i>
                <span>Sistema atualizado com sucesso</span>
                <span class="text-gray-400 ml-auto">Agora mesmo</span>
            </div>
        </div>
    </div>
</div>
{% endblock %}
