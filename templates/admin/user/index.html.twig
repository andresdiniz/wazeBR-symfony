{% extends 'base.html.twig' %}

{% block title %}UsuÃ¡rios{% endblock %}

{% block page_stylesheets %}
<style>
    .users-list { list-style: none; padding: 0; margin: 0; }
    .user-item { background: #fff; border: 1px solid #e0e0e0; border-radius: 8px; padding: 16px; margin-bottom: 12px; }
    .user-item h3 { margin: 0 0 8px 0; font-size: 1rem; }
    .user-meta { font-size: 0.85rem; color: #666; }
</style>
{% endblock %}

{% block body_class %}dashboard-page{% endblock %}

{% block body %}
<div class="dashboard-layout">
    {% include 'partials/sidebar.html.twig' %}
    <main class="dashboard-content">
        {% include 'partials/topbar.html.twig' %}
        <div class="dashboard-content-inner">
            <h1>UsuÃ¡rios</h1>
            {% if users is empty %}
                <p>Nenhum usuÃ¡rio encontrado.</p>
            {% else %}
                <ul class="users-list">
                    {% for user in users %}
                        <li class="user-item">
                            <h3>{{ user.email }}</h3>
                            <p class="user-meta">ID: {{ user.id }}</p>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </main>
</div>
{% endblock %}
