<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin{% endblock %} - wazeBR</title>
    
    {# Favicon #}
    <link rel="icon" href="{{ asset('favicon.ico') }}">
    
    {# Styles #}
    {{ encore_entry_link_tags('app') }}
    <link rel="stylesheet" href="{{ asset('styles/base.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/layout.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <div class="layout-admin">
        {# Sidebar #}
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <a href="{{ path('admin_dashboard') }}" class="sidebar-brand">wazeBR Admin</a>
                <button type="button" class="sidebar-toggle" aria-label="Toggle sidebar">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"/>
                    </svg>
                </button>
            </div>
            
            <nav class="sidebar-nav">
                {# Admin Section #}
                <div class="sidebar-section">
                    <div class="sidebar-heading">Admin</div>
                    <ul class="sidebar-menu">
                        <li class="sidebar-menu-item">
                            <a href="{{ path('admin_dashboard') }}" class="sidebar-menu-link {{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'active' : '' }}">
                                <span class="sidebar-menu-icon">📊</span>
                                <span class="sidebar-menu-text">Dashboard</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a href="{{ path('admin_routes_index') }}" class="sidebar-menu-link {{ app.request.attributes.get('_route') == 'admin_routes_index' ? 'active' : '' }}">
                                <span class="sidebar-menu-icon">🛣️</span>
                                <span class="sidebar-menu-text">Rotas</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a href="{{ path('admin_partners_index') }}" class="sidebar-menu-link {{ app.request.attributes.get('_route') == 'admin_partners_index' ? 'active' : '' }}">
                                <span class="sidebar-menu-icon">🤝</span>
                                <span class="sidebar-menu-text">Parceiros</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a href="{{ path('admin_city_index') }}" class="sidebar-menu-link {{ app.request.attributes.get('_route') == 'admin_city_index' ? 'active' : '' }}">
                                <span class="sidebar-menu-icon">🏙️</span>
                                <span class="sidebar-menu-text">Cidades</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a href="{{ path('admin_link_index') }}" class="sidebar-menu-link {{ app.request.attributes.get('_route') == 'admin_link_index' ? 'active' : '' }}">
                                <span class="sidebar-menu-icon">🔗</span>
                                <span class="sidebar-menu-text">Links</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a href="{{ path('admin_station_index') }}" class="sidebar-menu-link {{ app.request.attributes.get('_route') == 'admin_station_index' ? 'active' : '' }}">
                                <span class="sidebar-menu-icon">📡</span>
                                <span class="sidebar-menu-text">Estac̃oes</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a href="{{ path('admin_settings_index') }}" class="sidebar-menu-link {{ app.request.attributes.get('_route') == 'admin_settings_index' ? 'active' : '' }}">
                                <span class="sidebar-menu-icon">⚙️</span>
                                <span class="sidebar-menu-text">Configuraçı¥es</span>
                            </a>
                        </li>
                    </ul>
                </div>
                
                {# Platform Section #}
                <div class="sidebar-section">
                    <div class="sidebar-heading">Plataforma</div>
                    <ul class="sidebar-menu">
                        <li class="sidebar-menu-item">
                            <a href="{{ path('dashboard_index') }}" class="sidebar-menu-link {{ app.request.attributes.get('_route') == 'dashboard_index' ? 'active' : '' }}">
                                <span class="sidebar-menu-icon">📈</span>
                                <span class="sidebar-menu-text">Dashboard Geral</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>
            
            {# Sidebar Footer #}
            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <div class="sidebar-user-avatar">
                        {{ app.user.email|first|upper }}
                    </div>
                    <div class="sidebar-user-info">
                        <div class="sidebar-user-name">{{ app.user.email }}</div>
                        <div class="sidebar-user-role">Administrador</div>
                    </div>
                </div>
            </div>
        </aside>
        
        {# Main Content #}
        <main class="main-content">
            {# Header #}
            <header class="header">
                <div class="header-left">
                    <h1 class="header-title">{% block header_title %}Admin{% endblock %}</h1>
                </div>
                <div class="header-right">
                    <div class="header-actions">
                        <a href="{{ path('app_logout') }}" class="btn btn-secondary">
                            Sair
                        </a>
                    </div>
                </div>
            </header>
            
            {# Content Area #}
            <div class="content-area">
                {% block body %}{% endblock %}
            </div>
            
            {# Footer #}
            <footer class="footer">
                <div class="footer-left">
                    <span>&copy; {{ date('Y') }} wazeBR</span>
                </div>
                <div class="footer-right">
                    <div class="footer-links">
                        <a href="#" class="footer-link">Suporte</a>
                        <a href="#" class="footer-link">Termos</a>
                        <a href="#" class="footer-link">Privacidade</a>
                    </div>
                </div>
            </footer>
        </main>
    </div>
    
    {# Scripts #}
    {{ encore_entry_script_tags('app') }}
    <script src="{{ asset('js/main.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>