<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin{% endblock %} - wazeBR</title>
    <link rel="icon" href="{{ asset('favicon.ico') }}">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/layout.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
{% set current = app.request.attributes.get('_route') %}
<div class="app-shell">
    <div class="sidebar-overlay" data-sidebar-overlay></div>

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <a href="{{ path('admin_dashboard') }}" class="sidebar-brand">
                <span class="sidebar-brand-mark" aria-hidden="true">⌁</span>
                <span class="sidebar-brand-text">wazeBR Admin</span>
            </a>
            <button type="button" class="sidebar-toggle" data-sidebar-toggle aria-label="Recolher menu">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"/>
                </svg>
            </button>
        </div>

        <nav class="sidebar-nav">
            <div class="sidebar-section">
                <div class="sidebar-heading">Admin</div>
                <ul class="sidebar-menu">
                    <li class="sidebar-menu-item">
                        <a href="{{ path('admin_dashboard') }}" class="sidebar-menu-link {{ current == 'admin_dashboard' ? 'active' : '' }}">
                            <span class="sidebar-menu-icon" aria-hidden="true">📊</span>
                            <span class="sidebar-menu-text">Dashboard</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a href="{{ path('admin_routes_index') }}" class="sidebar-menu-link {{ current starts with 'admin_routes_' ? 'active' : '' }}">
                            <span class="sidebar-menu-icon" aria-hidden="true">🛣️</span>
                            <span class="sidebar-menu-text">Rotas</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a href="{{ path('admin_partner_index') }}" class="sidebar-menu-link {{ current starts with 'admin_partner_' ? 'active' : '' }}">
                            <span class="sidebar-menu-icon" aria-hidden="true">🤝</span>
                            <span class="sidebar-menu-text">Parceiros</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a href="{{ path('admin_city_index') }}" class="sidebar-menu-link {{ current starts with 'admin_city_' ? 'active' : '' }}">
                            <span class="sidebar-menu-icon" aria-hidden="true">🏙️</span>
                            <span class="sidebar-menu-text">Cidades</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a href="{{ path('admin_link_index') }}" class="sidebar-menu-link {{ current starts with 'admin_link_' ? 'active' : '' }}">
                            <span class="sidebar-menu-icon" aria-hidden="true">🔗</span>
                            <span class="sidebar-menu-text">Links</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a href="{{ path('admin_station_index') }}" class="sidebar-menu-link {{ current starts with 'admin_station_' ? 'active' : '' }}">
                            <span class="sidebar-menu-icon" aria-hidden="true">📡</span>
                            <span class="sidebar-menu-text">Estações</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a href="{{ path('admin_settings_index') }}" class="sidebar-menu-link {{ current starts with 'admin_settings_' ? 'active' : '' }}">
                            <span class="sidebar-menu-icon" aria-hidden="true">⚙️</span>
                            <span class="sidebar-menu-text">Configurações</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-heading">Plataforma</div>
                <ul class="sidebar-menu">
                    <li class="sidebar-menu-item">
                        <a href="{{ path('dashboard_index') }}" class="sidebar-menu-link {{ current == 'dashboard_index' ? 'active' : '' }}">
                            <span class="sidebar-menu-icon" aria-hidden="true">📈</span>
                            <span class="sidebar-menu-text">Dashboard geral</span>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-user">
                <div class="sidebar-user-avatar">{{ app.user.email|first|upper }}</div>
                <div class="sidebar-user-info">
                    <div class="sidebar-user-name">{{ app.user.email }}</div>
                    <div class="sidebar-user-role">Administrador</div>
                </div>
            </div>
        </div>
    </aside>

    <div class="main-content">
        <header class="topbar">
            <div class="topbar-left">
                <button type="button" class="mobile-sidebar-toggle" data-sidebar-mobile-toggle aria-label="Abrir menu">
                    <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"/>
                    </svg>
                </button>
                <h1 class="header-title">{% block header_title %}Admin{% endblock %}</h1>
            </div>
            <div class="topbar-right">
                <a href="{{ path('app_logout') }}" class="btn btn-secondary">Sair</a>
            </div>
        </header>

        {% if app.flashes|length > 0 %}
            <div class="flash-stack">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="flash flash-{{ label }}" role="status">
                            <span>{{ message }}</span>
                            <button type="button" class="flash-close" data-flash-close aria-label="Fechar">&times;</button>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}

        <div class="content-area">
            {% block body %}{% endblock %}
        </div>

        <footer class="footer">
            <span>&copy; {{ "now"|date('Y') }} wazeBR</span>
            <div class="footer-links">
                <a href="#" class="footer-link">Suporte</a>
                <a href="#" class="footer-link">Termos</a>
                <a href="#" class="footer-link">Privacidade</a>
            </div>
        </footer>
    </div>
</div>

<script src="{{ asset('js/main.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
