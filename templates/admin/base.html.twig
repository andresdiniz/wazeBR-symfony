{# templates/admin/base.html.twig #}
{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
    {# Bootstrap Icons via CDN (se preferir, pode remover e importar via JS) #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('admin') }}
    {# Se houver scripts específicos, podem ser adicionados aqui #}
{% endblock %}

{% block body_class %}admin-page{% endblock %}

{% block body %}
<div class="admin-wrapper">

    {# ===== TOPBAR ===== #}
    <header class="admin-topbar">
        <div class="admin-topbar-inner">
            <a href="{{ path('dashboard_index') }}" class="admin-brand">
                <span class="brand-icon">🚗</span>
                <span class="brand-name">wazeBR</span>
                <span class="brand-badge">Admin</span>
            </a>

            <div class="admin-topbar-right">
                <span class="admin-user">
                    <span class="user-avatar">{{ app.user.email|first|upper }}</span>
                    <span class="user-email">{{ app.user.email }}</span>
                </span>
                <a href="{{ path('app_logout') }}" class="btn btn-sm btn-ghost" title="Sair">
                    <i class="bi bi-box-arrow-right"></i>
                </a>
            </div>
        </div>
    </header>

    {# ===== LAYOUT PRINCIPAL ===== #}
    <div class="admin-layout">

        {# ===== SIDEBAR ===== #}
        <aside class="admin-sidebar">
            <nav class="admin-nav">
                <ul class="nav-list">

                    {# Dashboard #}
                    <li class="nav-item">
                        <a href="{{ path('dashboard_index') }}"
                           class="nav-link {{ app.request.attributes.get('_route') starts with 'dashboard' ? 'active' : '' }}">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>

                    {# Parceiros #}
                    <li class="nav-item">
                        <a href="{{ path('admin_partner_index') }}"
                           class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_partner' ? 'active' : '' }}">
                            <i class="bi bi-building"></i>
                            <span>Parceiros</span>
                        </a>
                    </li>

                    {# Links #}
                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ACCOUNT_ADMIN') %}
    <li class="nav-item">
        <a href="{{ path('admin_link_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_link' ? 'active' : '' }}">
            <i class="bi bi-link-45deg"></i>
            <span>Links</span>
        </a>
    </li>
{% endif %}

                    {# Cidades #}
                    <li class="nav-item">
                        <a href="{{ path('admin_city_index') }}"
                           class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_city' ? 'active' : '' }}">
                            <i class="bi bi-geo-alt"></i>
                            <span>Cidades</span>
                        </a>
                    </li>

                    {# Estações CEMADEN #}
                    <li class="nav-item">
                        <a href="{{ path('admin_station_index') }}"
                           class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_station' ? 'active' : '' }}">
                            <i class="bi bi-radio"></i>
                            <span>Estações CEMADEN</span>
                        </a>
                    </li>

                    {# Configurações #}
                    <li class="nav-item">
                        <a href="{{ path('admin_settings_index') }}"
                           class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_settings' ? 'active' : '' }}">
                            <i class="bi bi-sliders2"></i>
                            <span>Configurações</span>
                        </a>
                    </li>

                </ul>
            </nav>
            <div class="admin-sidebar-footer">
                <span class="version">wazeBR v2.0</span>
            </div>
        </aside>

        {# ===== CONTEÚDO PRINCIPAL ===== #}
        <main class="admin-content">
            <div class="admin-page-header">
                <div>
                    <h1 class="page-title">{% block admin_title %}Painel Administrativo{% endblock %}</h1>
                    <p class="page-subtitle">{% block admin_subtitle %}Gerencie todos os recursos da plataforma.{% endblock %}</p>
                </div>
                {% block admin_actions %}{% endblock %}
            </div>
            <div class="admin-page-content">
                {% block content %}{% endblock %}
            </div>
        </main>

    </div>
</div>
{% endblock %}
