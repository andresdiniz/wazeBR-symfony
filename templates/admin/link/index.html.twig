{# templates/admin/link/index.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block admin_title %}Links Monitorados{% endblock %}
{% block admin_subtitle %}Feeds de dados Waze por parceiro{% endblock %}

{% block admin_actions %}
    <a href="{{ path('admin_link_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Novo Link
    </a>
{% endblock %}

{% block content %}
    {% if by_partner is empty %}
        <div class="empty">
            <i class="bi bi-link-45deg" style="font-size:2.5rem;display:block;margin-bottom:0.5rem;color:var(--admin-text-muted)"></i>
            <h3>Nenhum link cadastrado</h3>
            <p>Adicione o primeiro feed de dados.</p>
            <a href="{{ path('admin_link_new') }}" class="btn btn-primary">Novo Link</a>
        </div>
    {% else %}
        {% for group in by_partner %}
            <div class="card" style="margin-bottom:1.5rem">
                <div class="card-header">
                    <div style="display:flex;align-items:center;gap:0.75rem">
                        <i class="bi bi-building" style="color:var(--admin-text-muted)"></i>
                        <span class="card-title">{{ group.partner ? group.partner.name : 'Sem parceiro' }}</span>
                        {% if group.partner %}
                            <span class="badge badge-gray">{{ group.partner.slug }}</span>
                        {% endif %}
                    </div>
                    <span style="font-size:0.75rem;color:var(--admin-text-muted)">{{ group.links|length }} link(s)</span>
                </div>
                <div style="overflow-x:auto">
                    <table>
                        <thead>
                            <tr>
                                <th>Rótulo</th>
                                <th>URL</th>
                                <th>Formato</th>
                                <th>Última Coleta</th>
                                <th>Status</th>
                                <th style="text-align:right">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for link in group.links %}
                            <tr style="opacity:{{ link.isActive ? 1 : 0.5 }}">
                                <td style="font-weight:500">{{ link.label ?? '—' }}</td>
                                <td style="font-size:0.75rem;color:var(--admin-text-muted);max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                    <a href="{{ link.url }}" target="_blank" rel="noopener" title="{{ link.url }}">
                                        {{ link.url|length > 50 ? link.url|slice(0,50) ~ '…' : link.url }}
                                    </a>
                                </td>
                                <td><span class="badge badge-gray">Feed {{ link.feedFormat }}</span></td>
                                <td style="font-size:0.75rem;font-variant-numeric:tabular-nums">
                                    {% if link.lastCollectedAt %}
                                        {{ link.lastCollectedAt|date('d/m H:i') }}
                                    {% else %}
                                        <span style="color:var(--admin-text-muted)">Nunca</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if link.isActive %}
                                        <span class="badge" style="background:#dcfce7;color:#166534">Ativo</span>
                                    {% else %}
                                        <span class="badge badge-gray">Inativo</span>
                                    {% endif %}
                                </td>
                                {% if is_granted('ROLE_ADMIN') or (app.user.partner and link.partner.id == app.user.partner.id) %}
    <td style="white-space:nowrap;text-align:right">
        <a href="{{ path('admin_link_edit', {id: link.id}) }}" class="btn btn-sm btn-ghost" title="Editar">
            <i class="bi bi-pencil"></i>
        </a>
        <form method="post" action="{{ path('admin_link_toggle', {id: link.id}) }}" style="display:inline">
            <button class="btn btn-sm btn-ghost" title="{{ link.isActive ? 'Desativar' : 'Ativar' }}">
                <i class="bi {{ link.isActive ? 'bi-pause' : 'bi-play' }}"></i>
            </button>
        </form>
        <form method="post" action="{{ path('admin_link_delete', {id: link.id}) }}" style="display:inline" onsubmit="return confirm('Excluir este link?')">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_link_' ~ link.id) }}">
            <button class="btn btn-sm" style="color:#dc2626;border-color:#fecaca" title="Excluir">
                <i class="bi bi-trash3"></i>
            </button>
        </form>
    </td>
{% else %}
    <td style="text-align:right"><span class="text-muted small">Apenas leitura</span></td>
{% endif %}
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endfor %}
    {% endif %}
{% endblock %}
