{# templates/admin/link/new.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block admin_title %}Novo Link Monitorado{% endblock %}
{% block admin_subtitle %}Cadastre um novo feed de dados Waze ou CEMADEN.{% endblock %}

{% block content %}
<div class="card shadow-sm p-4" style="max-width:640px;margin:0 auto">

    {% for flash in app.flashes('error') %}
        <div class="flash flash-error">{{ flash }}</div>
    {% endfor %}
    {% for flash in app.flashes('success') %}
        <div class="flash flash-success">{{ flash }}</div>
    {% endfor %}

    <form method="post" action="{{ path('admin_link_new') }}">

        <div class="form-group">
            <label class="form-label" for="partner_id">Parceiro <span class="text-danger">*</span></label>
            <select name="partner_id" class="form-control" required>
                <option value="">Selecione o parceiro...</option>
                {% for partner in partners %}
                    <option value="{{ partner.id }}">{{ partner.name }} ({{ partner.slug }})</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label class="form-label" for="label">Rótulo / Nome do link</label>
            <input type="text" name="label" class="form-control" placeholder="Ex: PBH — Alertas Centro-Sul">
        </div>

        <div class="form-group">
            <label class="form-label" for="link_type">Tipo <span class="text-danger">*</span></label>
            <select name="link_type" class="form-control" required id="type-select">
                {% for type in link_types %}
                    <option value="{{ type.value }}">
                        {% if type.value == 'waze_feed' %}🚨 {% endif %}
                        {% if type.value == 'waze_tvt'  %}🚗 {% endif %}
                        {% if type.value == 'cemaden'   %}🌧 {% endif %}
                        {% if type.value == 'camera'    %}📷 {% endif %}
                        {% if type.value == 'sensor'    %}📡 {% endif %}
                        {% if type.value == 'other'     %}🔗 {% endif %}
                        {{ type.label() }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label class="form-label" for="feed_format">Formato do Feed</label>
            <select name="feed_format" class="form-control" id="feed-format-select">
                <option value="1">1 — JSON PartnerHub (Alertas/Jams)</option>
                <option value="2">2 — TVT (Tempos de Viagem)</option>
            </select>
            <span class="form-hint">Preenchido automaticamente ao escolher o tipo.</span>
        </div>

        <div class="form-group">
            <label class="form-label" for="url">URL do feed <span class="text-danger">*</span></label>
            <input type="url" name="url" class="form-control" required placeholder="https://www.waze.com/row-partnerhub-api/...">
        </div>

        {# Dicas dinâmicas por tipo #}
        <div id="hint-waze_feed" class="flash flash-info d-none" style="background:#eff6ff;border-left-color:#3b82f6">
            <strong>🚨 Alertas / Jams:</strong><br>
            <code style="font-size:0.75rem">https://www.waze.com/row-partnerhub-api/partners/{ID}/waze-feeds/{UUID}?format=1</code>
        </div>
        <div id="hint-waze_tvt" class="flash flash-info d-none" style="background:#eff6ff;border-left-color:#3b82f6">
            <strong>🚗 Tráfego TVT:</strong><br>
            <code style="font-size:0.75rem">https://www.waze.com/row-partnerhub-api/feeds-tvt/{UUID}?id={partnerID}</code>
        </div>
        <div id="hint-cemaden" class="flash flash-info d-none" style="background:#eff6ff;border-left-color:#3b82f6">
            <strong>🌧 CEMADEN:</strong><br>
            <code style="font-size:0.75rem">https://cemaden.gov.br/feed/{UF}</code>
        </div>
        <div id="hint-camera" class="flash flash-info d-none" style="background:#eff6ff;border-left-color:#3b82f6">
            <strong>📷 Câmera:</strong><br>
            <code style="font-size:0.75rem">https://cameras.pbh.gov.br/afonso-pena</code>
        </div>
        <div id="hint-sensor" class="flash flash-info d-none" style="background:#eff6ff;border-left-color:#3b82f6">
            <strong>📡 Sensor:</strong><br>
            <code style="font-size:0.75rem">https://sensores.contagem.mg.gov.br/rai</code>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Salvar</button>
            <a href="{{ path('admin_link_index') }}" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function() {
    const typeSelect   = document.getElementById('type-select');
    const formatSelect = document.getElementById('feed-format-select');
    const allHints     = document.querySelectorAll('[id^="hint-"]');

    const formatMap = {
        'waze_feed': '1',
        'waze_tvt':  '2',
        'camera':    '1',
        'sensor':    '1',
        'cemaden':   '1',
        'other':     '1',
    };

    function updateUI() {
        const val = typeSelect.value;
        formatSelect.value = formatMap[val] ?? '1';
        allHints.forEach(h => h.classList.add('d-none'));
        const hint = document.getElementById('hint-' + val);
        if (hint) hint.classList.remove('d-none');
    }

    typeSelect.addEventListener('change', updateUI);
    updateUI();
})();
</script>
{% endblock %}
