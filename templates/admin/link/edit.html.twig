{# templates/admin/link/edit.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block admin_title %}Editar Link — {{ link.label ?? link.url }}{% endblock %}
{% block admin_subtitle %}Parceiro: {{ link.partner ? link.partner.name : 'sem parceiro' }}{% endblock %}

{% block content %}
<div class="card shadow-sm p-4" style="max-width:640px;margin:0 auto">

    {% for flash in app.flashes('error') %}
        <div class="flash flash-error">{{ flash }}</div>
    {% endfor %}
    {% for flash in app.flashes('success') %}
        <div class="flash flash-success">{{ flash }}</div>
    {% endfor %}

    <form method="post" action="{{ path('admin_link_edit', {id: link.id}) }}">

        <div class="form-group">
            <label class="form-label" for="label">Rótulo / Nome</label>
            <input type="text" name="label" class="form-control" value="{{ link.label }}" placeholder="Ex: PBH — Alertas Centro-Sul">
        </div>

        <div class="form-group">
            <label class="form-label" for="link_type">Tipo <span class="text-danger">*</span></label>
            <select name="link_type" class="form-control" required id="type-select">
                {% for type in link_types %}
                    <option value="{{ type.value }}" {% if type.value == link.linkType.value %}selected{% endif %}>
                        {{ type.label() }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label class="form-label" for="feed_format">Formato do Feed</label>
            <select name="feed_format" class="form-control" id="feed-format-select">
                <option value="1" {% if link.feedFormat == 1 %}selected{% endif %}>1 — JSON PartnerHub (Alertas/Jams)</option>
                <option value="2" {% if link.feedFormat == 2 %}selected{% endif %}>2 — TVT (Tempos de Viagem)</option>
            </select>
            <span class="form-hint">Preenchido automaticamente ao escolher o tipo.</span>
        </div>

        <div class="form-group">
            <label class="form-label" for="url">URL <span class="text-danger">*</span></label>
            <input type="url" name="url" class="form-control" value="{{ link.url }}" required placeholder="https://www.waze.com/row-partnerhub-api/...">
        </div>

        {% if link.lastCollectedAt %}
            <div class="flash flash-info" style="background:#f1f5f9;border-left-color:#94a3b8">
                <strong>Última coleta:</strong> {{ link.lastCollectedAt|date('d/m/Y H:i:s') }}
            </div>
        {% endif %}

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Salvar</button>
            <a href="{{ path('admin_link_index') }}" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function() {
    const typeSelect   = document.getElementById('type-select');
    const formatSelect = document.getElementById('feed-format-select');

    const formatMap = {
        'waze_feed': '1',
        'waze_tvt':  '2',
        'camera':    '1',
        'sensor':    '1',
        'cemaden':   '1',
        'other':     '1',
    };

    typeSelect.addEventListener('change', function() {
        formatSelect.value = formatMap[this.value] ?? '1';
    });
})();
</script>
{% endblock %}
