{% extends 'admin/dashboard_base.html.twig' %}

{% block title %}User Dashboard{% endblock %}

{% block user_role %}Usu\u00e1rio{% endblock %}

{% block page_title %}Meu Dashboard{% endblock %}

{% block sidebar_menu %}
<ul class="nav-list">
    <li class="nav-item">
        <a href="{{ path('app_user_dashboard') }}" class="nav-link active">
            <i class="fas fa-home"></i>
            <span>Dashboard</span>
        </a>
    </li>
    <li class="nav-item">
        <a href="#" class="nav-link">
            <i class="fas fa-route"></i>
            <span>Minhas Rotas</span>
        </a>
    </li>
    <li class="nav-item">
        <a href="#" class="nav-link">
            <i class="fas fa-bell"></i>
            <span>Alertas</span>
        </a>
    </li>
    <li class="nav-item">
        <a href="#" class="nav-link">
            <i class="fas fa-user-cog"></i>
            <span>Perfil</span>
        </a>
    </li>
</ul>
{% endblock %}

{% block content %}
<div class="dashboard-content">
    {# Welcome Card #}
    <div class="welcome-card">
        <div class="welcome-content">
            <h2>Ol\u00e1, {{ app.user.email|split('@')|first }}! 👋</h2>
            <p>Bem-vindo ao seu dashboard. Aqui voc\u00ea pode acompanhar suas rotas, alertas e prefer\u00eancias.</p>
        </div>
        <div class="welcome-actions">
            <a href="#" class="btn btn-primary">
                <i class="fas fa-plus"></i>
                <span>Nova Rota</span>
            </a>
            <a href="#" class="btn btn-outline">
                <i class="fas fa-cog"></i>
                <span>Configura\u00e7\u00f5es</span>
            </a>
        </div>
    </div>

    {# Stats Grid #}
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="fas fa-route"></i>
            </div>
            <div class="stat-info">
                <h3>24</h3>
                <p>Rotas Salv</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon green">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-info">
                <h3>12h</h3>
                <p>Tempo Economizado</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon orange">
                <i class="fas fa-bell"></i>
            </div>
            <div class="stat-info">
                <h3>5</h3>
                <p>Alertas Ativos</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon purple">
                <i class="fas fa-star"></i>
            </div>
            <div class="stat-info">
                <h3>4.8</h3>
                <p>Avalia\u00e7\u00e3o</p>
            </div>
        </div>
    </div>

    {# User Content #}
    <div class="content-grid">
        <div class="card">
            <div class="card-header">
                <h3>Rotas Frequentes</h3>
                <a href="#" class="view-all">Ver todas</a>
            </div>
            <div class="card-body">
                <ul class="route-list">
                    <li class="route-item">
                        <div class="route-icon">
                            <i class="fas fa-home"></i>
                        </div>
                        <div class="route-info">
                            <p><strong>Casa → Trabalho</strong></p>
                            <span class="route-details">Av. Paulista → Rua Oscar Freire</span>
                        </div>
                        <div class="route-meta">
                            <span class="route-time">25 min</span>
                            <span class="route-distance">8.5 km</span>
                        </div>
                    </li>
                    <li class="route-item">
                        <div class="route-icon">
                            <i class="fas fa-shopping-cart"></i>
                        </div>
                        <div class="route-info">
                            <p><strong>Casa → Shopping</strong></p>
                            <span class="route-details">Av. Paulista → Shopping Morumbi</span>
                        </div>
                        <div class="route-meta">
                            <span class="route-time">18 min</span>
                            <span class="route-distance">5.2 km</span>
                        </div>
                    </li>
                    <li class="route-item">
                        <div class="route-icon">
                            <i class="fas fa-utensils"></i>
                        </div>
                        <div class="route-info">
                            <p><strong>Trabalho → Restaurante</strong></p>
                            <span class="route-details">Rua Oscar Freire → Vila Madalena</span>
                        </div>
                        <div class="route-meta">
                            <span class="route-time">12 min</span>
                            <span class="route-distance">3.8 km</span>
                        </div>
                    </li>
                </ul>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Alertas Recentes</h3>
                <a href="#" class="view-all">Ver todos</a>
            </div>
            <div class="card-body">
                <ul class="alert-list">
                    <li class="alert-item warning">
                        <div class="alert-icon">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <div class="alert-info">
                            <p><strong>Acidente na Marginal</strong></p>
                            <span class="alert-time">H\u00e1 10 minutos</span>
                        </div>
                    </li>
                    <li class="alert-item info">
                        <div class="alert-icon">
                            <i class="fas fa-info-circle"></i>
                        </div>
                        <div class="alert-info">
                            <p><strong>Obra na Av. Faria Lima</strong></p>
                            <span class="alert-time">H\u00e1 1 hora</span>
                        </div>
                    </li>
                    <li class="alert-item success">
                        <div class="alert-icon">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="alert-info">
                            <p><strong>Tr\u00e2nsito liberado na Av. Paulista</strong></p>
                            <span class="alert-time">H\u00e1 2 horas</span>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
{% endblock %}
