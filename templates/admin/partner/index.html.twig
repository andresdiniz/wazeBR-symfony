{% extends 'base.html.twig' %}

{% block title %}Parceiros{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('admin_partner') }}
{% endblock %}

{% block header_title %}Parceiros{% endblock %}

{% block body %}
    <main class="partner-page" data-partner-index>
        <section class="partner-hero">
            <div>
                <span class="partner-eyebrow">Administração</span>
                <h1>Parceiros</h1>
                <p>Gerencie organizações, integrações e usuários vinculados.</p>
            </div>

            {% if can_edit|default(false) %}
                <a href="{{ path('admin_partner_new') }}" class="partner-button partner-button-primary">
                    <span aria-hidden="true">＋</span>
                    Novo parceiro
                </a>
            {% endif %}
        </section>

        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="partner-alert partner-alert-{{ type }}" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% set total = partners|length %}
        {% set active_count = 0 %}
        {% for partner in partners %}
            {% if partner.active %}{% set active_count = active_count + 1 %}{% endif %}
        {% endfor %}

        <section class="partner-stats" aria-label="Resumo de parceiros">
            <article class="partner-stat-card">
                <span class="partner-stat-label">Total</span>
                <strong>{{ total }}</strong>
                <span>parceiro{{ total == 1 ? '' : 's' }} cadastrado{{ total == 1 ? '' : 's' }}</span>
            </article>
            <article class="partner-stat-card partner-stat-success">
                <span class="partner-stat-label">Ativos</span>
                <strong>{{ active_count }}</strong>
                <span>integrações disponíveis</span>
            </article>
            <article class="partner-stat-card partner-stat-muted">
                <span class="partner-stat-label">Inativos</span>
                <strong>{{ total - active_count }}</strong>
                <span>requerem atenção</span>
            </article>
        </section>

        <section class="partner-panel">
            <div class="partner-toolbar">
                <div>
                    <h2>Lista de parceiros</h2>
                    <p>{{ total }} registro{{ total == 1 ? '' : 's' }} encontrado{{ total == 1 ? '' : 's' }}</p>
                </div>
                <label class="partner-search">
                    <span class="visually-hidden">Pesquisar parceiros</span>
                    <input type="search" data-partner-search placeholder="Pesquisar por nome, código ou e-mail..." autocomplete="off">
                </label>
            </div>

            {% if partners is not empty %}
                <div class="partner-table-wrapper">
                    <table class="partner-table">
                        <thead>
                            <tr>
                                <th>Parceiro</th>
                                <th>Código</th>
                                <th>Contato</th>
                                <th>Usuários</th>
                                <th>Status</th>
                                <th class="partner-actions-column">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for item in partners %}
                            {% set partner = item.0 is defined ? item.0 : item %}
                            {% set user_count = item.userCount is defined ? item.userCount : partner.users|length %}
                            <tr data-partner-row data-search="{{ (partner.name ~ ' ' ~ partner.code ~ ' ' ~ partner.email)|lower|e('html_attr') }}">
                                <td data-label="Parceiro">
                                    <div class="partner-identity">
                                        <span class="partner-avatar">{{ partner.name|default('?')|first|upper }}</span>
                                        <div>
                                            <a href="{{ path('admin_partner_show', {id: partner.id}) }}" class="partner-name">{{ partner.name|default('Sem nome') }}</a>
                                            <small>{{ partner.slug|default('') }}</small>
                                        </div>
                                    </div>
                                </td>
                                <td data-label="Código"><code>{{ partner.code|default('—') }}</code></td>
                                <td data-label="Contato">{{ partner.email|default('—') }}</td>
                                <td data-label="Usuários"><span class="partner-count">{{ user_count }}</span></td>
                                <td data-label="Status">
                                    <span class="partner-status {{ partner.active ? 'is-active' : 'is-inactive' }}">
                                        <span></span>{{ partner.active ? 'Ativo' : 'Inativo' }}
                                    </span>
                                </td>
                                <td data-label="Ações" class="partner-actions">
                                    <a href="{{ path('admin_partner_show', {id: partner.id}) }}" class="partner-action" title="Visualizar">Ver</a>
                                    {% if can_edit|default(false) %}
                                        <a href="{{ path('admin_partner_edit', {id: partner.id}) }}" class="partner-action">Editar</a>
                                        <form method="post" action="{{ path('admin_partner_toggle_active', {id: partner.id}) }}" class="partner-inline-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_' ~ partner.id) }}">
                                            <button type="submit" class="partner-action partner-action-muted">{{ partner.active ? 'Desativar' : 'Ativar' }}</button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <p class="partner-empty partner-empty-filter" data-partner-empty-filter hidden>Nenhum parceiro corresponde à pesquisa.</p>
            {% else %}
                <div class="partner-empty">
                    <div class="partner-empty-icon">◌</div>
                    <h3>Nenhum parceiro cadastrado</h3>
                    <p>Comece adicionando o primeiro parceiro ao sistema.</p>
                    {% if can_edit|default(false) %}
                        <a href="{{ path('admin_partner_new') }}" class="partner-button partner-button-primary">Cadastrar parceiro</a>
                    {% endif %}
                </div>
            {% endif %}
        </section>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('admin_partner') }}
{% endblock %}
