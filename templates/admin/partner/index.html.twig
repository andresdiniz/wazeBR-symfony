{% extends 'admin/base.html.twig' %}

{% block admin_title %}Parceiros{% endblock %}
{% block admin_subtitle %}Gerencie órgãos públicos e concessionárias cadastrados na plataforma.{% endblock %}

{% block admin_actions %}
    <a href="{{ path('admin_partner_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Novo parceiro
    </a>
{% endblock %}

{% block content %}
<div class="card">
    <div class="card-header">
        <span class="card-title">Todos os parceiros</span>
        <span class="badge badge-gray">{{ partners|length }} cadastrado{{ partners|length != 1 ? 's' }}</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Código</th>
                    <th>Status</th>
                    <th style="text-align:center">Usuários</th>
                    <th style="text-align:right">Ações</th>
                </tr>
            </thead>
            <tbody>
            {% for item in partners %}
                {% set partner = item[0] %}
                <tr>
                    <td>
                        <a href="{{ path('admin_partner_show', {id: partner.id}) }}" style="font-weight:600;color:var(--admin-primary)">
                            {{ partner.name }}
                        </a>
                    </td>
                    <td><code>{{ partner.code }}</code></td>
                    <td>
                        {% if partner.active %}
                            <span class="badge badge-green">Ativo</span>
                        {% else %}
                            <span class="badge badge-gray">Inativo</span>
                        {% endif %}
                    </td>
                    <td style="text-align:center">{{ item.userCount }}</td>
                    <td style="text-align:right;white-space:nowrap">
                        <a href="{{ path('admin_partner_user_new', {id: partner.id}) }}" class="btn btn-sm btn-primary" title="Adicionar usuário">
                            <i class="bi bi-person-plus"></i>
                        </a>
                        <a href="{{ path('admin_partner_show', {id: partner.id}) }}" class="btn btn-sm btn-ghost" title="Ver detalhes">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a href="{{ path('admin_partner_edit', {id: partner.id}) }}" class="btn btn-sm btn-ghost" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">
                        <div class="empty">
                            <i class="bi bi-building" style="font-size:2.5rem;display:block;margin-bottom:0.5rem;color:var(--admin-text-muted)"></i>
                            <h3>Nenhum parceiro cadastrado</h3>
                            <p>Cadastre o primeiro órgão público ou concessionária para começar.</p>
                            <a href="{{ path('admin_partner_new') }}" class="btn btn-primary">Criar primeiro parceiro</a>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
