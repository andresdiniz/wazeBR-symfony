{% extends 'admin/base.html.twig' %}

{% block admin_title %}Editar: {{ partner.name }}{% endblock %}
{% block admin_subtitle %}Atualize os dados do parceiro.{% endblock %}

{% block content %}
<div class="card shadow-sm p-4" style="max-width:760px;margin:0 auto">

    {% for flash_error in app.flashes('error') %}
        <div class="flash flash-error">{{ flash_error }}</div>
    {% endfor %}
    {% for flash_success in app.flashes('success') %}
        <div class="flash flash-success">{{ flash_success }}</div>
    {% endfor %}

    {# ===== FORMULÁRIO PRINCIPAL ===== #}
    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}

        {{ form_errors(form) }}

        <div class="form-group">
            {{ form_label(form.name) }}
            {{ form_widget(form.name, {attr: {class: 'form-control', required: true}}) }}
            {{ form_errors(form.name) }}
        </div>

        <div class="form-group">
            {{ form_label(form.code) }}
            {{ form_widget(form.code, {attr: {class: 'form-control'}}) }}
            {{ form_errors(form.code) }}
        </div>

        <div class="form-group">
            {{ form_label(form.slug) }}
            {{ form_widget(form.slug, {attr: {class: 'form-control'}}) }}
            <span class="form-hint">Apenas letras minúsculas, números e hífens.</span>
            {{ form_errors(form.slug) }}
        </div>

        <div class="form-group">
            {{ form_label(form.email) }}
            {{ form_widget(form.email, {attr: {class: 'form-control'}}) }}
            {{ form_errors(form.email) }}
        </div>

        <div class="form-group">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {attr: {class: 'form-control', rows: 3}}) }}
            {{ form_errors(form.description) }}
        </div>

        <div class="form-group">
            {{ form_label(form.bbox) }}
            {{ form_widget(form.bbox, {attr: {class: 'form-control', rows: 3, style: 'font-family:monospace;font-size:0.8rem;resize:vertical'}}) }}
            <span class="form-hint">Preenchido automaticamente ao desenhar no mapa, ou cole um WKT manualmente.</span>
            {{ form_errors(form.bbox) }}
        </div>

        <div class="form-check">
            {{ form_widget(form.active, {attr: {class: 'form-check-input'}}) }}
            {{ form_label(form.active, null, {label_attr: {class: 'form-check-label'}}) }}
        </div>

        {# ===== API TOKEN (APENAS EXIBIÇÃO) ===== #}
        <div class="card mt-3 p-3" style="background:#f8fafc;border:1px solid var(--admin-border)">
            <h2 style="font-size:0.85rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--admin-text-muted);margin-bottom:0.5rem">API Token</h2>
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <code style="flex:1;min-width:0;font-size:0.8rem;background:#fff;padding:0.5rem 0.75rem;border-radius:0.375rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;border:1px solid var(--admin-border)">{{ partner.apiToken }}</code>
                {# O botão de regenerar foi movido para fora do formulário principal #}
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Salvar alterações</button>
            <a href="{{ path('admin_partner_show', {id: partner.id}) }}" class="btn btn-outline-secondary">Cancelar</a>
        </div>

        {# ===== GARANTE QUE O TOKEN CSRF SEJA RENDERIZADO ===== #}
        {{ form_rest(form) }}
    {{ form_end(form, {'render_rest': false}) }}

    {# ===== FORMULÁRIO DE REGENERAR TOKEN (FORA DO PRINCIPAL) ===== #}
    <form method="post" action="{{ path('admin_partner_regenerate_token', {id: partner.id}) }}" class="mt-2">
        <input type="hidden" name="_token" value="{{ csrf_token('regen_token_' ~ partner.id) }}">
        <button type="submit" class="btn btn-ghost btn-sm" onclick="return confirm('Atenção: o token atual deixará de funcionar imediatamente. Confirmar?')">
            <i class="bi bi-arrow-repeat"></i> Regenerar token
        </button>
    </form>

</div>
{% endblock %}
