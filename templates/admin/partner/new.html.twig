{% extends 'admin/base.html.twig' %}

{% block admin_title %}Novo parceiro{% endblock %}
{% block admin_subtitle %}Cadastre um órgão público ou concessionária na plataforma.{% endblock %}

{% block content %}
<div class="card shadow-sm p-4" style="max-width:760px;margin:0 auto">
    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}

        <div class="form-group">
            {{ form_label(form.name) }}
            {{ form_widget(form.name, {attr: {class: 'form-control', placeholder: 'Nome do parceiro', autofocus: true}}) }}
            {{ form_errors(form.name) }}
        </div>

        <div class="form-group">
            {{ form_label(form.code) }}
            {{ form_widget(form.code, {attr: {class: 'form-control', placeholder: 'Código interno (opcional)'}}) }}
            {{ form_errors(form.code) }}
        </div>

        <div class="form-group">
            {{ form_label(form.slug) }}
            {{ form_widget(form.slug, {attr: {class: 'form-control', placeholder: 'slug-identificador'}}) }}
            <span class="form-hint">Apenas letras minúsculas, números e hífens. Gerado automaticamente.</span>
            {{ form_errors(form.slug) }}
        </div>

        <div class="form-group">
            {{ form_label(form.email) }}
            {{ form_widget(form.email, {attr: {class: 'form-control', placeholder: 'contato@parceiro.com'}}) }}
            {{ form_errors(form.email) }}
        </div>

        <div class="form-group">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {attr: {class: 'form-control', rows: 3, placeholder: 'Descrição opcional'}}) }}
            {{ form_errors(form.description) }}
        </div>

        <div class="form-group">
            {{ form_label(form.bbox) }}
            {{ form_widget(form.bbox, {attr: {class: 'form-control', rows: 2, placeholder: 'POLYGON((-43.8 -20.6, ...))'}}) }}
            <span class="form-hint">Delimitação geográfica no formato WKT (opcional).</span>
            {{ form_errors(form.bbox) }}
        </div>

        <div class="form-check">
            {{ form_widget(form.active, {attr: {class: 'form-check-input'}}) }}
            {{ form_label(form.active, null, {label_attr: {class: 'form-check-label'}}) }}
        </div>

        <div class="form-group">
            <label class="form-label">API Token</label>
            <div class="input-group">
                <input type="text" class="form-control" value="{{ partner.apiToken }}" readonly style="font-family:monospace;font-size:0.8rem;">
                <button class="btn btn-outline-secondary" type="button" onclick="this.previousElementSibling.select();document.execCommand('copy');alert('Token copiado!')">Copiar</button>
            </div>
            <span class="form-hint">Gerado automaticamente. Copie e guarde em local seguro.</span>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Criar parceiro</button>
            <a href="{{ path('admin_partner_index') }}" class="btn btn-outline-secondary">Cancelar</a>
        </div>

    {{ form_end(form) }}
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    const nameInput = document.getElementById('{{ form.name.vars.id }}');
    const slugInput = document.getElementById('{{ form.slug.vars.id }}');
    if (nameInput && slugInput) {
        nameInput.addEventListener('input', () => {
            if (slugInput.dataset.edited) return;
            slugInput.value = nameInput.value
                .toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-+|-+$/g, '');
        });
        slugInput.addEventListener('input', () => { slugInput.dataset.edited = '1'; });
    }
</script>
{% endblock %}
