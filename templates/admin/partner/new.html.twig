{% extends 'admin/layout.html.twig' %}

{% block title %}Novo parceiro — Administração{% endblock %}

{% block content %}
<div class="admin-page" data-admin-partner>

    <header class="admin-page__header">
        <div>
            <h1 class="admin-page__title">Novo parceiro</h1>
            <p class="admin-page__subtitle">
                Um diretório e o arquivo <code>feed.json</code> serão
                criados automaticamente em
                <code>/public/feed/{código}/feed.json</code>.
            </p>
        </div>

        <a
            href="{{ path('admin_partner_index') }}"
            class="btn btn-ghost"
        >
            ← Voltar
        </a>
    </header>

    <form
        method="post"
        class="admin-form"
        action="{{ path('admin_partner_new') }}"
        novalidate
    >
        <input
            type="hidden"
            name="_token"
            value="{{ csrf_token('admin_partner_new') }}"
        >

        <div class="admin-card">
            <div class="admin-form__grid">

                <div class="form-group">
                    <label for="partner-name">Nome *</label>
                    <input
                        id="partner-name"
                        class="form-control"
                        type="text"
                        name="name"
                        required
                        maxlength="255"
                        autocomplete="off"
                    >
                </div>

                <div class="form-group">
                    <label for="partner-code">Código *</label>
                    <input
                        id="partner-code"
                        class="form-control"
                        type="text"
                        name="code"
                        required
                        maxlength="50"
                        pattern="[A-Za-z0-9_-]+"
                        autocomplete="off"
                        spellcheck="false"
                        data-code-input
                    >
                    <small class="form-hint">
                        Letras, números, hífen ou underscore.
                        Vira o nome da pasta.
                    </small>
                </div>

                <div class="form-group">
                    <label for="partner-city">Cidade</label>
                    <input
                        id="partner-city"
                        class="form-control"
                        type="text"
                        name="city"
                        maxlength="255"
                    >
                </div>

                <div class="form-group">
                    <label for="partner-state">UF</label>
                    <input
                        id="partner-state"
                        class="form-control"
                        type="text"
                        name="state"
                        maxlength="2"
                        data-uppercase
                    >
                </div>

                <div class="form-group">
                    <label for="partner-frequency">Frequência de coleta</label>
                    <input
                        id="partner-frequency"
                        class="form-control"
                        type="number"
                        name="fetchFrequency"
                        min="1"
                        value="5"
                    >
                </div>

                <div class="form-group">
                    <label for="partner-unit">Unidade</label>
                    <select
                        id="partner-unit"
                        class="form-select"
                        name="fetchFrequencyUnit"
                    >
                        <option value="minutes">Minutos</option>
                        <option value="seconds">Segundos</option>
                        <option value="hours">Horas</option>
                    </select>
                </div>

            </div>

            <div
                class="admin-form__preview"
                data-feed-preview
                hidden
            >
                <span class="admin-form__preview-label">
                    Feed será criado em:
                </span>
                <code data-feed-preview-url></code>
            </div>
        </div>

        <div class="admin-form__actions">
            <a
                href="{{ path('admin_partner_index') }}"
                class="btn btn-ghost"
            >
                Cancelar
            </a>

            <button type="submit" class="btn btn-primary">
                Criar parceiro
            </button>
        </div>
    </form>

</div>
{% endblock %}
