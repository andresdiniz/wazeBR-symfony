{% extends 'admin/base.html.twig' %}

{% block admin_title %}Novo usuário{% endblock %}
{% block admin_subtitle %}Parceiro: {{ partner.name }}{% endblock %}

{% block content %}
<div class="card shadow-sm p-4" style="max-width:620px;margin:0 auto">

    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}

        <div class="form-group">
            {{ form_label(form.name) }}
            {{ form_widget(form.name, {attr: {class: 'form-control', placeholder: 'Nome completo'}}) }}
            {{ form_errors(form.name) }}
        </div>

        <div class="form-group">
            {{ form_label(form.email) }}
            {{ form_widget(form.email, {attr: {class: 'form-control', placeholder: 'usuario@empresa.com'}}) }}
            {{ form_errors(form.email) }}
        </div>

        <div class="form-group">
            {{ form_label(form.plainPassword.first) }}
            {{ form_widget(form.plainPassword.first, {attr: {class: 'form-control', placeholder: 'Mínimo 6 caracteres'}}) }}
            {{ form_errors(form.plainPassword.first) }}
        </div>

        <div class="form-group">
            {{ form_label(form.plainPassword.second) }}
            {{ form_widget(form.plainPassword.second, {attr: {class: 'form-control', placeholder: 'Confirme a senha'}}) }}
            {{ form_errors(form.plainPassword.second) }}
        </div>

        <div class="form-check">
            {{ form_widget(form.isActive, {attr: {class: 'form-check-input'}}) }}
            {{ form_label(form.isActive, null, {label_attr: {class: 'form-check-label'}}) }}
        </div>

        <div class="form-group">
            <label class="form-label fw-semibold">{{ form_label(form.roles) }}</label>
            <div class="d-flex flex-column gap-2">
            {% for child in form.roles %}
                <div class="form-check">
                    {{ form_widget(child, {attr: {class: 'form-check-input'}}) }}
                    {{ form_label(child, null, {label_attr: {class: 'form-check-label'}}) }}
                </div>
            {% endfor %}
            </div>
            {{ form_errors(form.roles) }}
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Criar usuário</button>
            <a href="{{ path('admin_partner_show', {id: partner.id}) }}" class="btn btn-outline-secondary">Cancelar</a>
        </div>

    {{ form_end(form) }}

</div>
{% endblock %}
