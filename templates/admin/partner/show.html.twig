{% extends 'base.html.twig' %}

{% block title %}Detalhes do Parceiro{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Detalhes do Parceiro</h1>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title">{{ partner.name }}</h5>

                <p><strong>ID:</strong> {{ partner.id }}</p>
                <p><strong>E-mail:</strong> {{ partner.email }}</p>
                <p>
                    <strong>Ativo:</strong>
                    {% if partner.active %}
                        <span class="badge bg-success">Sim</span>
                    {% else %}
                        <span class="badge bg-danger">Não</span>
                    {% endif %}
                </p>

                {% if can_view_full %}
                    <hr>
                    <h6>Dados completos (visão admin/partner)</h6>
                    <p><strong>API Key:</strong> {{ partner.apiKey }}</p>
                    <p><strong>Webhook URL:</strong> {{ partner.webhookUrl }}</p>
                    <p><strong>Criado em:</strong> {{ partner.createdAt|date('Y-m-d H:i:s') }}</p>
                    <p><strong>Atualizado em:</strong> {{ partner.updatedAt|date('Y-m-d H:i:s') }}</p>
                {% endif %}

                <div class="mt-3">
                    <a href="{{ path('app_partner_admin_index') }}" class="btn btn-secondary">
                        Voltar à lista
                    </a>

                    {% if can_view_full %}
                        <a href="{{ path('app_partner_admin_edit', {'id': partner.id}) }}" class="btn btn-warning">
                            Editar
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
