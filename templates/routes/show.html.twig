{% extends 'layouts/dashboard.html.twig' %}

{% block title %}{{ route.name }} | Rotas | WazeBR{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous" />
    <link rel="stylesheet" href="{{ asset('css/pages/route-show.css') }}">
{% endblock %}

{% block content %}
{# ── Valores normalizados (seguros com strict_variables) ───────────────── #}
{% set cur = {
    name: null, city: null, state: null, time: null, historicTime: null,
    delaySeconds: null, delayRatio: null, level: null, jamLevel: null,
    recordedAt: null, ageMinutes: null, isStale: false
}|merge(current ?? {}) %}

{% set DOW_SHORT = ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom'] %}
{% set exportBase     = path('routes_export_csv', {id: route.id}) %}
{% set exportHistBase = path('routes_export_historico_csv', {id: route.id}) %}

{# Nomes dos trechos para tooltips (chave 's<id>': merge() renumeraria chaves inteiras). #}
{% set subNames = {} %}
{% for s in topSubRoutes %}
    {% set subNames = subNames|merge({('s' ~ s.id): s.name}) %}
{% endfor %}

{# Dados para o JS: um único bloco JSON (sem atributos data-* gigantes). #}
{% set payload = {
    routeId:           route.id,
    routePolyline:     routePolyline,
    subRoutesPolyline: subRoutesPolyline,
    nearbyAlerts:      nearbyAlerts,
    irregularities:    irregularities,
    heatmap:           heatmap,
    timeline:          timeline,
    byHour:            byHour,
    byDow:             byDow,
    jamDistribution:   jamDistribution,
    recentWindow:      recentWindow,
    subNames:          subNames
} %}

<div class="rs-page"
     data-route-show
     data-route-id="{{ route.id }}"
     data-timezone="{{ app_timezone }}"
     data-live-stream="{{ path('routes_live_stream') }}"
     data-live-url="{{ path('routes_live_state', {id: route.id}) }}"
     data-live-since="{{ cur.recordedAt ?? '' }}"
     data-share-url="{{ path('routes_report_share', {id: route.id}) }}"
     data-share-token="{{ csrf_token('route_share_' ~ route.id) }}">

    <script type="application/json" data-route-show-data>{{ payload|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>

    <div class="rs-container">

        {# ── Breadcrumb ──────────────────────────────────────────── #}
        <nav class="rs-breadcrumb" aria-label="Navegação">
            <a href="{{ path('routes_index') }}">Rotas</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{{ route.name }}</span>
        </nav>

        {# ── Avisos de estado ────────────────────────────────────── #}
        {% if not route.isActive %}
            <div class="rs-notice rs-notice--bad" role="status">
                <strong>Rota desativada</strong>
                <span>
                    {% if route.deactivatedAt %}Desativada em {{ route.deactivatedAt|date('d/m/Y H:i') }}. {% endif %}
                    Os dados abaixo são históricos e não são mais atualizados.
                </span>
            </div>
        {% elseif cur.isStale %}
            <div class="rs-notice rs-notice--warn" role="status" data-live-stale>
                <strong>Dados desatualizados</strong>
                <span>
                    A última leitura foi há {{ cur.ageMinutes >= 60 ? (cur.ageMinutes // 60) ~ ' h' : cur.ageMinutes ~ ' min' }}
                    ({{ cur.recordedAt|date('d/m H:i') }}). Os indicadores “atuais” podem não refletir o trânsito agora.
                </span>
            </div>
        {% endif %}

        {# ── Header ──────────────────────────────────────────────── #}
        <header class="rs-header">
            <div class="rs-header__main">
                <span class="rs-eyebrow"><i></i> Análise de rota</span>
                <h1>{{ route.name }}</h1>
                <p class="rs-header__path">
                    {% if route.from and route.to %}
                        {{ route.from }} → {{ route.to }}
                    {% elseif route.from %}
                        {{ route.from }}
                    {% elseif route.to %}
                        {{ route.to }}
                    {% else %}
                        Sem descrição de trajeto
                    {% endif %}
                    {% if route.lengthMeters %}
                        · {{ (route.lengthMeters / 1000)|number_format(1, ',', '.') }} km
                    {% endif %}
                    {% if cur.city %}
                        · {{ cur.city }}{% if cur.state %}/{{ cur.state }}{% endif %}
                    {% endif %}
                    {% if cur.recordedAt %}
                        · atualizado às <time data-live-updated datetime="{{ cur.recordedAt }}">{{ cur.recordedAt|date('H:i') }}</time>
                    {% endif %}
                    <span class="rs-live" data-live-badge hidden title="Recebendo atualizações em tempo real">● ao vivo</span>
                </p>
            </div>

            <div class="rs-header__aside">
                {# ── Favoritar (formulário: funciona mesmo sem JavaScript) ── #}
                <form class="rs-favorite" method="post" data-favorite-form
                      action="{{ path('routes_favorite_toggle', {id: route.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('route_favorite_' ~ route.id) }}">
                    <button type="submit" class="rs-iconbtn" data-favorite-toggle
                            aria-pressed="{{ isFavorite ? 'true' : 'false' }}"
                            title="{{ isFavorite ? 'Remover dos favoritos' : 'Adicionar aos favoritos' }}">
                        <span aria-hidden="true" data-favorite-icon>{{ isFavorite ? '★' : '☆' }}</span>
                        <span class="rs-sr">{{ isFavorite ? 'Remover dos favoritos' : 'Adicionar aos favoritos' }}</span>
                    </button>
                </form>

                {# ── Relatório: link direto (funciona mesmo sem JavaScript) ── #}
                <a class="rs-export__btn rs-report-link" href="{{ path('routes_report', {id: route.id}) }}"
                   target="_blank" rel="noopener">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 1.5h5.5L13 5v9.5H4z"/><path d="M9.5 1.5V5H13M6 8.5h5M6 11h5"/>
                    </svg>
                    Relatório
                </a>

                {# ── Compartilhar: link público com validade ──────── #}
                <div class="rs-export rs-share" data-share-menu>
                    <button class="rs-export__btn" type="button" data-share-toggle
                            aria-haspopup="true" aria-expanded="false">
                        Compartilhar
                        <svg class="rs-export__caret" width="10" height="10" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><path d="M2 3.5l3 3 3-3"/></svg>
                    </button>
                    <div class="rs-export__dropdown rs-share__panel" data-share-panel hidden>
                        <p class="rs-export__label">Link para enviar (sem login)</p>
                        <div class="rs-share__row">
                            <label class="rs-sr" for="rs-share-days">Validade do link</label>
                            <select id="rs-share-days" data-share-days>
                                <option value="1">1 dia</option>
                                <option value="7" selected>7 dias</option>
                                <option value="30">30 dias</option>
                            </select>
                            <button type="button" class="rs-recent__btn" data-share-generate>Gerar link</button>
                        </div>
                        <div class="rs-share__result" data-share-result hidden>
                            <input type="text" readonly data-share-link aria-label="Link do relatório">
                            <button type="button" class="rs-recent__btn" data-share-copy>Copiar</button>
                            <small data-share-expires></small>
                        </div>
                        <p class="rs-share__warn">Quem tiver o link vê o relatório desta rota até a validade.</p>
                    </div>
                </div>

                {# ── Botão Exportar ─────────────────────────────── #}
                <div class="rs-export" data-export-menu>
                    <button class="rs-export__btn" type="button" data-export-toggle
                            aria-haspopup="true" aria-expanded="false"
                            aria-label="Exportar dados desta rota">
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true">
                            <path d="M8 1v9M4 7l4 4 4-4M2 13h12"/>
                        </svg>
                        Exportar
                        <svg class="rs-export__caret" width="10" height="10" viewBox="0 0 10 10"
                             fill="currentColor" aria-hidden="true">
                            <path d="M2 3.5l3 3 3-3"/>
                        </svg>
                    </button>

                    <div class="rs-export__dropdown" data-export-dropdown hidden>
                        <p class="rs-export__label">Exportar como CSV</p>

                        <a class="rs-export__item" href="{{ exportBase }}?type=timeline" download>
                            <span class="rs-export__item-icon" aria-hidden="true">📈</span>
                            <span><strong>Evolução do atraso</strong><small>Timeline · últimos 7 dias</small></span>
                        </a>
                        <a class="rs-export__item" href="{{ exportBase }}?type=by_hour" download>
                            <span class="rs-export__item-icon" aria-hidden="true">🕐</span>
                            <span><strong>Média por hora</strong><small>Padrão horário · 30 dias</small></span>
                        </a>
                        <a class="rs-export__item" href="{{ exportBase }}?type=by_dow" download>
                            <span class="rs-export__item-icon" aria-hidden="true">📅</span>
                            <span><strong>Média por dia da semana</strong><small>Padrão semanal · 30 dias</small></span>
                        </a>
                        <a class="rs-export__item" href="{{ exportBase }}?type=occurrences" download>
                            <span class="rs-export__item-icon" aria-hidden="true">⚠️</span>
                            <span><strong>Ocorrências</strong><small>Alertas Waze + irregularidades TVT</small></span>
                        </a>
                        <a class="rs-export__item" href="{{ exportBase }}?type=subroutes" download>
                            <span class="rs-export__item-icon" aria-hidden="true">🔀</span>
                            <span><strong>Trechos problemáticos</strong><small>Sub-rotas com métricas</small></span>
                        </a>

                        <hr class="rs-export__sep">
                        <p class="rs-export__label">Histórico bruto para análise externa</p>

                        <a class="rs-export__item" href="{{ exportHistBase }}?days=30" download>
                            <span class="rs-export__item-icon" aria-hidden="true">🗂️</span>
                            <span><strong>Histórico 30 dias</strong><small>Linha a linha · velocidade, tempos, jam</small></span>
                        </a>
                        <a class="rs-export__item" href="{{ exportHistBase }}?days=90" download>
                            <span class="rs-export__item-icon" aria-hidden="true">📦</span>
                            <span><strong>Histórico 90 dias</strong><small>Linha a linha · velocidade, tempos, jam</small></span>
                        </a>
                        <a class="rs-export__item" href="{{ exportHistBase }}?days=365" download>
                            <span class="rs-export__item-icon" aria-hidden="true">🗄️</span>
                            <span><strong>Histórico 1 ano</strong><small>Máx. 50.000 linhas</small></span>
                        </a>
                        <a class="rs-export__item rs-export__item--python" href="{{ exportHistBase }}?days=90&amp;sep=," download>
                            <span class="rs-export__item-icon" aria-hidden="true">🐍</span>
                            <span><strong>Histórico 90 dias (Python/R)</strong><small>Separador vírgula · pandas / tidyverse</small></span>
                        </a>
                    </div>
                </div>

                {# ── Health ─────────────────────────────────────── #}
                <div class="rs-health rs-health--{{ stats.healthLevel }}">
                    <span class="rs-health__value">{{ stats.health }}<small>%</small></span>
                    <span class="rs-health__label">{{ stats.healthLabel }}</span>
                </div>
            </div>
        </header>

        {# ── Alertas novos (atualização ao vivo) ─────────────────── #}
        <div class="rs-notice rs-notice--live" data-live-alerts role="status" aria-live="polite" hidden></div>

        {# ── KPIs ─────────────────────────────────────────────────── #}
        <section class="rs-kpis" aria-label="Indicadores">
            <article class="rs-kpi">
                <span class="rs-kpi__label">Tempo atual</span>
                {% if cur.time is not null %}
                    {% set t = cur.time|round(0) %}
                    <strong class="rs-kpi__value rs-kpi__value--{{ cur.level ?? 'good' }}" data-live-kpi="time">
                        {% if t >= 60 %}{{ (t // 60)|round(0, 'floor') }}<small>min</small> {{ '%02d'|format(t % 60) }}<small>s</small>{% else %}{{ t }}<small>s</small>{% endif %}
                    </strong>
                    <span class="rs-kpi__hint" data-live-kpi="time-hint">
                        {% if cur.historicTime is not null %}normal: {{ cur.historicTime|round(0) }}s{% else %}sem tempo histórico{% endif %}
                    </span>
                {% else %}
                    <strong class="rs-kpi__value" data-live-kpi="time">—</strong>
                    <span class="rs-kpi__hint" data-live-kpi="time-hint">Sem leitura recente</span>
                {% endif %}
            </article>

            <article class="rs-kpi">
                <span class="rs-kpi__label">Atraso atual</span>
                {% if cur.delaySeconds is not null %}
                    <strong class="rs-kpi__value rs-kpi__value--{{ cur.level ?? 'good' }}" data-live-kpi="delay">
                        +{{ cur.delaySeconds }}<small>s</small>
                    </strong>
                    <span class="rs-kpi__hint" data-live-kpi="delay-hint">
                        {% if cur.delayRatio is not null %}{{ (cur.delayRatio * 100)|round(0) }}% acima do histórico{% endif %}
                    </span>
                {% else %}
                    <strong class="rs-kpi__value" data-live-kpi="delay">—</strong>
                    <span class="rs-kpi__hint" data-live-kpi="delay-hint">Sem leitura recente</span>
                {% endif %}
            </article>

            <article class="rs-kpi">
                <span class="rs-kpi__label">Média 24h</span>
                {% if stats.avgDelay24h is not null %}
                    <strong class="rs-kpi__value">{{ stats.avgDelay24h >= 0 ? '+' : '−' }}{{ stats.avgDelay24h|abs|round(0) }}<small>s</small></strong>
                    <span class="rs-kpi__hint">{{ ((stats.avgRatio24h ?? 0) * 100)|round(0) }}% vs histórico</span>
                {% else %}
                    <strong class="rs-kpi__value">—</strong>
                    <span class="rs-kpi__hint">Sem dados nas últimas 24h</span>
                {% endif %}
            </article>

            <article class="rs-kpi">
                <span class="rs-kpi__label">Média 7 dias</span>
                {% if stats.avgDelay7d is not null %}
                    <strong class="rs-kpi__value">{{ stats.avgDelay7d >= 0 ? '+' : '−' }}{{ stats.avgDelay7d|abs|round(0) }}<small>s</small></strong>
                    <span class="rs-kpi__hint">{{ ((stats.avgRatio7d ?? 0) * 100)|round(0) }}% vs histórico</span>
                {% else %}
                    <strong class="rs-kpi__value">—</strong>
                    <span class="rs-kpi__hint">Sem dados nos últimos 7 dias</span>
                {% endif %}
            </article>

            <article class="rs-kpi">
                <span class="rs-kpi__label">Pior hora do dia</span>
                {% if stats.worstHour %}
                    <strong class="rs-kpi__value">{{ '%02d'|format(stats.worstHour.hour) }}<small>h</small></strong>
                    <span class="rs-kpi__hint">
                        {{ (stats.worstHour.avgRatio * 100)|round(0) }}% · {{ (stats.worstHour.avgDelay ?? 0) >= 0 ? '+' : '−' }}{{ (stats.worstHour.avgDelay ?? 0)|abs|round(0) }}s
                    </span>
                {% else %}
                    <strong class="rs-kpi__value">—</strong>
                    <span class="rs-kpi__hint">Amostra insuficiente</span>
                {% endif %}
            </article>

            <article class="rs-kpi">
                <span class="rs-kpi__label">Pior dia</span>
                {% if stats.worstDow %}
                    <strong class="rs-kpi__value">{{ DOW_SHORT[stats.worstDow.dow] }}</strong>
                    <span class="rs-kpi__hint">
                        {{ (stats.worstDow.avgRatio * 100)|round(0) }}% · {{ (stats.worstDow.avgDelay ?? 0) >= 0 ? '+' : '−' }}{{ (stats.worstDow.avgDelay ?? 0)|abs|round(0) }}s
                    </span>
                {% else %}
                    <strong class="rs-kpi__value">—</strong>
                    <span class="rs-kpi__hint">Amostra insuficiente</span>
                {% endif %}
            </article>

            <article class="rs-kpi">
                <span class="rs-kpi__label">Amostras</span>
                <strong class="rs-kpi__value">{{ stats.sampleCount30d|number_format(0, ',', '.') }}</strong>
                <span class="rs-kpi__hint">Últimos 30 dias</span>
            </article>
        </section>

        {# ── Mapa principal ───────────────────────────────────────── #}
        <section class="rs-panel rs-map-panel" aria-labelledby="rs-map-title">
            <header class="rs-panel__header">
                <div>
                    <span class="rs-panel__kicker">Traçado e ocorrências</span>
                    <h2 id="rs-map-title">Mapa da rota</h2>
                </div>
                <div class="rs-panel__legend rs-panel__legend--map">
                    <span><i class="rs-legend-line"></i>Traçado</span>
                    <span><i class="rs-legend-line rs-legend-line--sub"></i>Trecho</span>
                    <span><i class="rs-legend-dot rs-legend-dot--alert"></i>Alertas Waze</span>
                    <span><i class="rs-legend-dot rs-legend-dot--irr"></i>Irregularidades TVT</span>
                </div>
            </header>
            <div class="rs-map" data-rs-map role="region" aria-label="Mapa da rota com alertas e irregularidades">
                <div class="rs-map__fallback" data-rs-map-fallback hidden>
                    <strong>Sem traçado geográfico</strong>
                    <small>Esta rota não possui geometria cadastrada.</small>
                </div>
            </div>
        </section>

        {# ── Mapa das últimas horas (slider) ──────────────────────── #}
        <section class="rs-panel rs-recent" aria-labelledby="rs-recent-title">
            <header class="rs-panel__header">
                <div>
                    <span class="rs-panel__kicker">Últimas {{ recentWindow.hours }} horas · cor = % vs histórico</span>
                    <h2 id="rs-recent-title">Trânsito na rota nas últimas {{ recentWindow.hours }}h</h2>
                </div>
                <div class="rs-legend">
                    <span class="rs-legend__label">Normal</span>
                    <span class="rs-legend__gradient"></span>
                    <span class="rs-legend__label">Muito lento</span>
                </div>
            </header>

            {% if recentWindow.frames is empty %}
                <div class="rs-empty">
                    <strong>Sem leituras nas últimas {{ recentWindow.hours }}h</strong>
                    <small>Quando houver novos snapshots, o mapa aparece aqui.</small>
                </div>
            {% else %}
                <div class="rs-map rs-map--recent" data-recent-map role="region"
                     aria-label="Mapa do trânsito nas últimas {{ recentWindow.hours }} horas"></div>

                <div class="rs-recent__controls">
                    <button type="button" class="rs-recent__btn" data-recent-play aria-pressed="false">▶ Reproduzir</button>
                    <input type="range" class="rs-recent__slider" data-recent-slider
                           min="0" max="{{ recentWindow.frames|length - 1 }}" step="1"
                           value="{{ recentWindow.frames|length - 1 }}" aria-label="Momento das últimas {{ recentWindow.hours }} horas">
                    <output class="rs-recent__time" data-recent-time aria-live="polite">—</output>
                    <button type="button" class="rs-recent__btn" data-recent-avg aria-pressed="false">Média {{ recentWindow.hours }}h</button>
                </div>

                <p class="rs-panel__hint">
                    Arraste o controle (ou use <strong>Reproduzir</strong>) para ver a evolução. Cada trecho é pintado pela
                    razão entre o tempo medido e o histórico naquele momento. Os pontos são alertas e irregularidades
                    registrados no período.
                    {% if not recentWindow.hasSubData %}Os snapshots não trazem dados por trecho: a rota inteira é pintada.{% endif %}
                </p>
            {% endif %}
        </section>

        {# ── Heatmap ──────────────────────────────────────────────── #}
        <section class="rs-panel rs-heatmap-panel" aria-labelledby="rs-heatmap-title">
            <header class="rs-panel__header">
                <div>
                    <span class="rs-panel__kicker">Padrão semanal · baseado em % vs histórico</span>
                    <h2 id="rs-heatmap-title">Mapa de calor · dia da semana × hora</h2>
                </div>
                <div class="rs-legend">
                    <span class="rs-legend__label">Sem atraso</span>
                    <span class="rs-legend__gradient"></span>
                    <span class="rs-legend__label">Muito atraso</span>
                </div>
            </header>

            <div class="rs-heatmap-scroll">
                <div class="rs-heatmap" data-heatmap role="img"
                     aria-label="Mapa de calor do atraso médio por dia da semana e hora"></div>
            </div>

            <p class="rs-panel__hint">
                Cada célula mostra a <strong>razão</strong> entre tempo atual e histórico naquela hora/dia.
                Uma rota de 180s com +2s de atraso fica verde (1.1%); uma rota de 20s com +2s fica amarela (10%).
                Células vazias não têm amostras suficientes.
            </p>
        </section>

        {# ── Timeline ─────────────────────────────────────────────── #}
        <section class="rs-panel" aria-labelledby="rs-timeline-title">
            <header class="rs-panel__header">
                <div>
                    <span class="rs-panel__kicker">Últimos 7 dias</span>
                    <h2 id="rs-timeline-title">Evolução do atraso</h2>
                </div>
                <div class="rs-panel__legend">
                    <span><i class="rs-dot rs-dot--blue"></i>Atraso (s)</span>
                    <span><i class="rs-dot rs-dot--red"></i>% vs histórico</span>
                    <span><i class="rs-dot rs-dot--alert"></i>Alertas</span>
                </div>
            </header>
            <div class="rs-chart-wrap rs-chart-wrap--tall">
                <canvas data-chart="route-timeline" role="img"
                        aria-label="Evolução horária do atraso nos últimos 7 dias"></canvas>
            </div>
            <p class="rs-panel__hint">
                As linhas verticais tracejadas marcam as horas com alertas Waze registrados perto do traçado.
                Cruze visualmente com os picos de atraso.
            </p>
        </section>

        {# ── Grid: por hora + por dia ─────────────────────────────── #}
        <div class="rs-two-col">
            <section class="rs-panel" aria-labelledby="rs-hour-title">
                <header class="rs-panel__header">
                    <div>
                        <span class="rs-panel__kicker">Últimos 30 dias</span>
                        <h2 id="rs-hour-title">Média por hora do dia</h2>
                    </div>
                </header>
                <div class="rs-chart-wrap">
                    <canvas data-chart="route-by-hour" role="img" aria-label="Atraso médio por hora do dia"></canvas>
                </div>
            </section>

            <section class="rs-panel" aria-labelledby="rs-dow-title">
                <header class="rs-panel__header">
                    <div>
                        <span class="rs-panel__kicker">Últimos 30 dias</span>
                        <h2 id="rs-dow-title">Média por dia da semana</h2>
                    </div>
                </header>
                <div class="rs-chart-wrap">
                    <canvas data-chart="route-by-dow" role="img" aria-label="Atraso médio por dia da semana"></canvas>
                </div>
            </section>
        </div>

        {# ── Grid: jam + sub-rotas ────────────────────────────────── #}
        <div class="rs-two-col">

            <section class="rs-panel" aria-labelledby="rs-jam-title">
                <header class="rs-panel__header">
                    <div>
                        <span class="rs-panel__kicker">Últimos 30 dias</span>
                        <h2 id="rs-jam-title">Distribuição de congestionamento</h2>
                    </div>
                </header>
                <div class="rs-chart-wrap">
                    <canvas data-chart="route-jam-dist" role="img" aria-label="Distribuição dos níveis de congestionamento"></canvas>
                </div>
            </section>

            <section class="rs-panel" aria-labelledby="rs-sub-title">
                <header class="rs-panel__header">
                    <div>
                        <span class="rs-panel__kicker">Estado atual · ordenados por % vs histórico</span>
                        <h2 id="rs-sub-title">Trechos mais problemáticos</h2>
                    </div>
                    <span class="rs-panel__count">{{ topSubRoutes|length }}</span>
                </header>

                <div class="rs-subroutes">
                    {% for sub in topSubRoutes %}
                        {% set lvl = sub.level %}
                        <div class="rs-subroute rs-subroute--{{ lvl }}" data-subroute-id="{{ sub.id }}">
                            <div class="rs-subroute__content">
                                <div class="rs-subroute__head">
                                    <strong class="rs-subroute__name">{{ sub.name }}</strong>
                                    <span class="rs-subroute__badge rs-subroute__badge--{{ lvl }}">
                                        {{ sub.delayRatio is not null ? (sub.delayRatio * 100)|round(0) ~ '%' : '—' }}
                                    </span>
                                </div>

                                {% if sub.from and sub.to and sub.name != (sub.from ~ ' → ' ~ sub.to) %}
                                    <small class="rs-subroute__path">{{ sub.from }} → {{ sub.to }}</small>
                                {% endif %}

                                <div class="rs-subroute__bar">
                                    <span style="width: {{ min(100, ((sub.delayRatio ?? 0) * 100))|round(1) }}%"></span>
                                </div>

                                <div class="rs-subroute__meta">
                                    <span class="rs-subroute__meta-item"><em>+{{ sub.delaySeconds ?? 0 }}s</em></span>
                                    {% if sub.time is not null %}
                                        <span class="rs-subroute__meta-item"><em>agora {{ sub.time|round(0) }}s</em></span>
                                    {% endif %}
                                    {% if sub.historicTime is not null %}
                                        <span class="rs-subroute__meta-item"><em>{{ sub.historicTime|round(0) }}s normais</em></span>
                                    {% endif %}
                                    {% if sub.jamLevel is not null and sub.jamLevel > 0 %}
                                        <span class="rs-subroute__meta-item rs-subroute__meta-item--jam">Jam nível {{ sub.jamLevel }}</span>
                                    {% endif %}
                                    {% if sub.lengthMeters %}
                                        <span class="rs-subroute__meta-item">{{ (sub.lengthMeters / 1000)|number_format(2, ',', '.') }} km</span>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="rs-subroute__map-wrap">
                                <div class="rs-subroute__map" data-subroute-map data-subroute-id="{{ sub.id }}"
                                     aria-label="Mini-mapa do trecho {{ sub.name }}"></div>
                            </div>
                        </div>
                    {% else %}
                        <div class="rs-empty">
                            <strong>Sem sub-rotas cadastradas</strong>
                            <small>Esta rota não tem trechos detalhados.</small>
                        </div>
                    {% endfor %}
                </div>
            </section>

        </div>

        {# ── Ocorrências (Waze + TVT, mais recentes primeiro) ─────── #}
        <section class="rs-panel" aria-labelledby="rs-occ-title">
            <header class="rs-panel__header">
                <div>
                    <span class="rs-panel__kicker">Últimos 7 dias · até 60 m do traçado</span>
                    <h2 id="rs-occ-title">Ocorrências na rota</h2>
                </div>
                <div class="rs-panel__legend">
                    <span><i class="rs-dot rs-dot--purple"></i>Irregularidades ({{ irregularities|length }})</span>
                    <span><i class="rs-dot rs-dot--waze"></i>Waze Alertas ({{ nearbyAlerts|length }})</span>
                </div>
            </header>

            {% if occurrences is empty %}
                <div class="rs-empty">
                    <span aria-hidden="true">✓</span>
                    <strong>Nenhuma ocorrência recente</strong>
                    <small>Nada foi registrado nesta rota nos últimos 7 dias.</small>
                </div>
            {% else %}
                <div class="rs-occurrences">
                    {% for o in occurrences %}
                        {% set isWaze = o.source == 'waze' %}
                        <div class="rs-occ rs-occ--{{ isWaze ? 'waze' : 'tvt' }}">
                            <span class="rs-occ__icon" aria-hidden="true">{{ o.icon }}</span>
                            <div class="rs-occ__body">
                                <strong>{{ o.type }}</strong>
                                {% if o.subtype %}<em>{{ o.subtype }}</em>{% endif %}
                                <small>
                                    {% set parts = [o.street, o.city, o.severity]|filter(p => p) %}
                                    {{ parts|join(' · ') }}
                                    {% if isWaze and o.distanceMeters is not null %}
                                        <span class="rs-occ__dist">{{ o.distanceMeters }} m do traçado</span>
                                    {% endif %}
                                </small>
                            </div>
                            <div class="rs-occ__meta">
                                {% if o.at %}
                                    <time datetime="{{ o.at }}">{{ o.at|date('d/m H:i') }}</time>
                                {% else %}
                                    <time>—</time>
                                {% endif %}
                                <span class="rs-occ__badge rs-occ__badge--{{ isWaze ? 'waze' : 'tvt' }}">{{ isWaze ? 'Waze' : 'TVT' }}</span>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </section>

    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# route-show.js e route-forecast.js são carregados pelo registry de assets/js/app.js
       (match: [data-route-show]). Aqui só as libs externas que o JS espera como globais. #}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.1/chart.umd.min.js" integrity="sha512-WoViKhKD4qI2WruSZqv9+kvM4WfFhUMQCLN4QlDTt5aU56fLQy2gYoxWIqlEnXqJy/+Ac5q/hk1oWfqnMDhwMA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
{% endblock %}
