<!doctype html>
<html lang="{{ app.request.locale|replace({'_': '-'}) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <title>{{ 'Relatório'|trans({}, 'routes_ui') }} · {{ route.name }} · WazeBR</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous">
    <style>{% include 'routes/_report_styles.html.twig' %}</style>
</head>
<body>
<div data-routes-i18n="{{ routes_i18n()|json_encode|e('html_attr') }}" hidden></div>
{% set cur = {
    time: null, historicTime: null, delaySeconds: null, delayRatio: null, level: null,
    recordedAt: null, city: null, state: null
}|merge(current ?? {}) %}

<main class="rr-page" data-route-report>

    <div class="rr-toolbar no-print">
        {% if not public %}
            <a class="rr-btn" href="{{ path('routes_show', {id: route.id}) }}">← {{ 'Voltar à rota'|trans({}, 'routes_ui') }}</a>
        {% else %}
            <span></span>
        {% endif %}
        <button type="button" class="rr-btn rr-btn--primary" data-report-print>{{ 'Imprimir / Salvar em PDF'|trans({}, 'routes_ui') }}</button>
    </div>

    <header class="rr-header">
        <div>
            <span class="rr-eyebrow">{{ 'Relatório de trânsito · WazeBR'|trans({}, 'routes_ui') }}</span>
            <h1>{{ route.name }}</h1>
            <p class="rr-sub">
                {% if route.from and route.to %}{{ route.from }} → {{ route.to }}{% elseif route.from %}{{ route.from }}{% elseif route.to %}{{ route.to }}{% endif %}
                {% if route.lengthMeters %} · {{ (route.lengthMeters / 1000)|number_format(1, ',', '.') }} km{% endif %}
                {% if cur.city %} · {{ cur.city }}{% if cur.state %}/{{ cur.state }}{% endif %}{% endif %}
            </p>
        </div>
        <div class="rr-meta">
            <div class="rr-health rr-health--{{ stats.healthLevel }}">
                <strong>{{ stats.health }}<small>%</small></strong>
                <span>{{ routes_label(stats.healthLabel) }}</span>
            </div>
            <small>{{ 'Gerado em'|trans({}, 'routes_ui') }} {{ 'now'|date('d/m/Y H:i') }}</small>
            {% if public and expiresAt %}<small>{{ 'Link válido até'|trans({}, 'routes_ui') }} {{ routes_date(expiresAt, true, app_timezone|default('America/Sao_Paulo')) }}</small>{% endif %}
        </div>
    </header>

    {% if not route.isActive %}
        <p class="rr-note rr-note--bad">{{ 'Rota desativada: os dados abaixo são históricos.'|trans({}, 'routes_ui') }}</p>
    {% endif %}

    {# ── Resumo ────────────────────────────────────────────────── #}
    <section class="rr-section rr-summary">
        <h2>{{ 'Resumo'|trans({}, 'routes_ui') }}</h2>
        <ul>
            {% for line in report.summary %}<li>{{ line }}</li>{% endfor %}
        </ul>
    </section>

    {# ── Indicadores ───────────────────────────────────────────── #}
    <section class="rr-kpis">
        <div class="rr-kpi">
            <span>{{ 'Tempo atual'|trans({}, 'routes_ui') }}</span>
            {% if cur.time is not null %}
                {% set t = cur.time|round(0) %}
                <strong>{% if t >= 60 %}{{ (t // 60)|round(0, 'floor') }}min {{ '%02d'|format(t % 60) }}s{% else %}{{ t }}s{% endif %}</strong>
                <small>{% if cur.historicTime is not null %}{{ 'normal'|trans({}, 'routes_ui') }}: {{ cur.historicTime|round(0) }}s{% endif %}</small>
            {% else %}<strong>—</strong><small>{{ 'sem leitura'|trans({}, 'routes_ui') }}</small>{% endif %}
        </div>
        <div class="rr-kpi">
            <span>{{ 'Média 24h'|trans({}, 'routes_ui') }}</span>
            {% if stats.avgDelay24h is not null %}
                <strong>{{ stats.avgDelay24h >= 0 ? '+' : '−' }}{{ stats.avgDelay24h|abs|round(0) }}s</strong>
                <small>{{ ((stats.avgRatio24h ?? 0) * 100)|round(0) }}{{ '% vs histórico'|trans({}, 'routes_ui') }}</small>
            {% else %}<strong>—</strong><small>{{ 'sem dados'|trans({}, 'routes_ui') }}</small>{% endif %}
        </div>
        <div class="rr-kpi">
            <span>{{ 'Média 7 dias'|trans({}, 'routes_ui') }}</span>
            {% if stats.avgDelay7d is not null %}
                <strong>{{ stats.avgDelay7d >= 0 ? '+' : '−' }}{{ stats.avgDelay7d|abs|round(0) }}s</strong>
                <small>{{ ((stats.avgRatio7d ?? 0) * 100)|round(0) }}{{ '% vs histórico'|trans({}, 'routes_ui') }}</small>
            {% else %}<strong>—</strong><small>{{ 'sem dados'|trans({}, 'routes_ui') }}</small>{% endif %}
        </div>
        <div class="rr-kpi">
            <span>{{ 'Pior hora'|trans({}, 'routes_ui') }}</span>
            {% if stats.worstHour %}
                <strong>{{ '%02d'|format(stats.worstHour.hour) }}h</strong>
                <small>{{ (stats.worstHour.avgRatio * 100)|round(0) }}{{ '% vs histórico'|trans({}, 'routes_ui') }}</small>
            {% else %}<strong>—</strong><small>{{ 'amostra insuficiente'|trans({}, 'routes_ui') }}</small>{% endif %}
        </div>
        <div class="rr-kpi">
            <span>{{ 'Pior dia'|trans({}, 'routes_ui') }}</span>
            {% if stats.worstDow %}
                <strong>{{ [('Seg'|trans({}, 'routes_ui')), ('Ter'|trans({}, 'routes_ui')), ('Qua'|trans({}, 'routes_ui')), ('Qui'|trans({}, 'routes_ui')), ('Sex'|trans({}, 'routes_ui')), ('Sáb'|trans({}, 'routes_ui')), ('Dom'|trans({}, 'routes_ui'))][stats.worstDow.dow] }}</strong>
                <small>{{ (stats.worstDow.avgRatio * 100)|round(0) }}{{ '% vs histórico'|trans({}, 'routes_ui') }}</small>
            {% else %}<strong>—</strong><small>{{ 'amostra insuficiente'|trans({}, 'routes_ui') }}</small>{% endif %}
        </div>
        <div class="rr-kpi">
            <span>{{ 'Amostras'|trans({}, 'routes_ui') }}</span>
            <strong>{{ stats.sampleCount30d|number_format(0, ',', '.') }}</strong>
            <small>{{ 'últimos 30 dias'|trans({}, 'routes_ui') }}</small>
        </div>
    </section>

    {# ── Mapa ──────────────────────────────────────────────────── #}
    <section class="rr-section">
        <h2>{{ 'Traçado e ocorrências'|trans({}, 'routes_ui') }}</h2>
        {% if report.map %}
            {% set m = report.map %}
            <div class="rr-mapwrap" data-report-mapwrap>
                {# Reserva: esquema do traçado em SVG (aparece se o mapa com ruas não carregar). #}
                <svg class="rr-map-fallback" viewBox="0 0 {{ m.w }} {{ m.h }}" role="img"
                     aria-label="{{ 'Esquema do traçado da rota com alertas e irregularidades'|trans({}, 'routes_ui') }}">
                    <rect width="{{ m.w }}" height="{{ m.h }}" fill="#f1f5f9"/>
                    {% if m.main %}<path d="{{ m.main }}" fill="none" stroke="#cbd5e1" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>{% endif %}
                    {% for s in m.subs %}
                        <path d="{{ s.d }}" fill="none" stroke="{{ s.color }}" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><title>{{ s.title }}</title></path>
                    {% endfor %}
                    {% if m.main and not m.subs %}<path d="{{ m.main }}" fill="none" stroke="#2563eb" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>{% endif %}
                    {% for p in m.alerts %}<circle cx="{{ p.x }}" cy="{{ p.y }}" r="5" fill="{{ p.color }}" stroke="#fff" stroke-width="1.5"/>{% endfor %}
                    {% for p in m.irr %}<circle cx="{{ p.x }}" cy="{{ p.y }}" r="5" fill="{{ p.color }}" stroke="#fff" stroke-width="1.5"/>{% endfor %}
                </svg>
                {# Mapa com ruas (OpenStreetMap), montado por route-report.js. #}
                <div class="rr-map-live" data-report-live-map aria-label="{{ 'Mapa da rota'|trans({}, 'routes_ui') }}"></div>
            </div>
            <script type="application/json" data-report-map>{{ m.live|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>

            <p class="rr-legend">
                {% if m.colorSource == 'avg' %}
                    {{ 'Trechos coloridos pela média das últimas'|trans({}, 'routes_ui') }} {{ recentWindow.hours }} h
                {% elseif m.colorSource == 'current' %}
                    Trechos coloridos pelo {{ 'estado atual'|trans({}, 'routes_ui') }}
                {% else %}
                    Trechos {{ 'sem dados'|trans({}, 'routes_ui') }} para colorir
                {% endif %}
                (<span class="rr-grad"></span> {{ 'normal'|trans({}, 'routes_ui') }} → muito lento).
                {% for l in m.legend %}
                    <span class="rr-dot" style="background:{{ l.color }}"></span>{{ routes_label(l.label) }}{% if l.count > 1 %} ({{ l.count }}){% endif %}
                {% endfor %}
            </p>
            <p class="rr-legend rr-legend--credit" data-report-map-credit>{{ 'Esquema do traçado, sem mapa de fundo.'|trans({}, 'routes_ui') }}</p>
        {% else %}
            <p class="rr-empty">{{ 'Esta rota não possui geometria cadastrada.'|trans({}, 'routes_ui') }}</p>
        {% endif %}
    </section>

    {# ── Heatmap ───────────────────────────────────────────────── #}
    <section class="rr-section">
        <h2>{{ 'Padrão semanal — dia × hora'|trans({}, 'routes_ui') }} <small>({{ 'últimos 30 dias'|trans({}, 'routes_ui') }}, {{ '% acima do histórico'|trans({}, 'routes_ui') }})</small></h2>
        <div class="rr-heat">
            <div class="rr-heat__row rr-heat__row--head">
                <span></span>
                {% for h in 0..23 %}<span>{{ '%02d'|format(h) }}</span>{% endfor %}
            </div>
            {% for row in report.heatmap %}
                <div class="rr-heat__row">
                    <span class="rr-heat__label">{{ routes_label(row.label) }}</span>
                    {% for c in row.cells %}
                        <i title="{{ c.title }}" style="{% if c.color %}background:{{ c.color }}{% endif %}"{% if not c.color %} class="is-empty"{% endif %}></i>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
        <p class="rr-legend"><span class="rr-grad"></span> {{ 'sem atraso → muito atraso · células cinza: sem amostras suficientes.'|trans({}, 'routes_ui') }}</p>
    </section>

    {# ── Timeline ──────────────────────────────────────────────── #}
    <section class="rr-section">
        <h2>{{ 'Evolução do atraso'|trans({}, 'routes_ui') }} <small>(últimos {{ '7 dias'|trans({}, 'routes_ui') }} · 0 s = tempo histórico da {{ 'rota'|trans({}, 'routes_ui') }})</small></h2>
        {% if report.timeline %}
            {% set c = report.timeline %}
            <svg class="rr-chart" viewBox="0 0 {{ c.w }} {{ c.h }}" role="img" style="display:block;width:100%;height:auto"
                 aria-label="{{ 'Evolução horária do atraso nos últimos 7 dias'|trans({}, 'routes_ui') }}">
                <defs>
                    <clipPath id="rr-clip-slow"><rect x="{{ c.padL }}" y="{{ c.padT }}" width="{{ c.plotW }}" height="{{ c.zeroY - c.padT }}"/></clipPath>
                    <clipPath id="rr-clip-fast"><rect x="{{ c.padL }}" y="{{ c.zeroY }}" width="{{ c.plotW }}" height="{{ c.plotB - c.zeroY }}"/></clipPath>
                </defs>
                {# fins de semana e lacunas de dados #}
                {% for wk in c.weekends %}<rect x="{{ wk.x }}" y="{{ c.padT }}" width="{{ wk.w }}" height="{{ c.plotB - c.padT }}" fill="#f1f5f9"/>{% endfor %}
                {% for g in c.gaps %}
                    <rect x="{{ g.x }}" y="{{ c.padT }}" width="{{ g.w }}" height="{{ c.plotB - c.padT }}" fill="#e2e8f0" opacity=".75"/>
                    {% if g.w > 44 %}<text x="{{ g.x + g.w / 2 }}" y="{{ (c.padT + c.plotB) / 2 }}" text-anchor="middle" font-size="9" fill="#94a3b8" font-family="Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif">{{ 'sem dados'|trans({}, 'routes_ui') }}</text>{% endif %}
                {% endfor %}
                {# grade horizontal + escala (s) #}
                {% for tk in c.ticks %}
                    <line x1="{{ c.padL }}" x2="{{ c.plotR }}" y1="{{ tk.y }}" y2="{{ tk.y }}" stroke="#e2e8f0" stroke-width="1"/>
                    <text x="{{ c.padL - 6 }}" y="{{ tk.y + 3 }}" text-anchor="end" font-size="10" fill="#64748b" font-family="Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif">{{ tk.label }}</text>
                {% endfor %}
                {# separadores de dia + rótulos #}
                {% for d in c.days %}
                    {% if d.line is not null %}<line x1="{{ d.line }}" x2="{{ d.line }}" y1="{{ c.padT }}" y2="{{ c.plotB }}" stroke="#cbd5e1" stroke-width="1" stroke-dasharray="3 3"/>{% endif %}
                    {% if d.width > 34 %}<text x="{{ d.cx }}" y="{{ c.h - 9 }}" text-anchor="middle" font-size="10" font-weight="{{ d.weekend ? '700' : '400' }}" fill="#64748b" font-family="Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif">{{ d.label }}</text>{% endif %}
                {% endfor %}
                {# áreas: laranja = mais lento que o normal, verde = mais rápido #}
                {% for seg in c.paths %}
                    {% if seg.area %}
                        <path d="{{ seg.area }}" fill="rgba(234,88,12,.30)" clip-path="url(#rr-clip-slow)"/>
                        <path d="{{ seg.area }}" fill="rgba(22,163,74,.30)" clip-path="url(#rr-clip-fast)"/>
                    {% endif %}
                {% endfor %}
                <line x1="{{ c.padL }}" x2="{{ c.plotR }}" y1="{{ c.zeroY }}" y2="{{ c.zeroY }}" stroke="#64748b" stroke-width="1.2"/>
                {% for seg in c.paths %}<path d="{{ seg.line }}" fill="none" stroke="#1d4ed8" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round"/>{% endfor %}
                {# média dos 7 dias #}
                {% if c.meanY is not null %}
                    <line x1="{{ c.padL }}" x2="{{ c.plotR + 4 }}" y1="{{ c.meanY }}" y2="{{ c.meanY }}" stroke="#64748b" stroke-width="1.2" stroke-dasharray="5 4"/>
                    <text x="{{ c.plotR + 7 }}" y="{{ c.meanY + 3 }}" text-anchor="start" font-size="9.5" fill="#475569" font-family="Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif">{{ c.meanLabel }}</text>
                {% endif %}
                {# pico #}
                {% if c.peak %}
                    <circle cx="{{ c.peak.x }}" cy="{{ c.peak.y }}" r="3.8" fill="#dc2626" stroke="#fff" stroke-width="1.4"/>
                    <text x="{{ c.peak.labelX }}" y="{{ c.peak.labelY }}" text-anchor="middle" font-size="10" font-weight="700" fill="#b91c1c" font-family="Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif">{{ c.peak.label }}</text>
                {% endif %}
            </svg>
            <p class="rr-legend">
                <span class="rr-key rr-key--slow"></span>{{ 'mais lento que o normal'|trans({}, 'routes_ui') }}
                <span class="rr-key rr-key--fast"></span>{{ 'mais rápido que o normal'|trans({}, 'routes_ui') }}
                <span class="rr-key rr-key--mean"></span>{{ 'média do período'|trans({}, 'routes_ui') }}
                <span class="rr-key rr-key--weekend"></span>fim de semana
                {% if c.gaps %}<span class="rr-key rr-key--gap"></span>{{ 'sem dados'|trans({}, 'routes_ui') }}{% endif %}
            </p>
            <p class="rr-axis">
                <span>de {{ c.from|slice(8, 2) }}/{{ c.from|slice(5, 2) }} {{ c.from|slice(11, 5) }}</span>
                <span>{% if c.peak %}<span class="rr-dot rr-dot--first" style="background:#dc2626"></span>{{ 'pico:'|trans({}, 'routes_ui') }} {{ c.peak.label }} em {{ c.peak.at|slice(8, 2) }}/{{ c.peak.at|slice(5, 2) }} {{ c.peak.at|slice(11, 5) }}{% endif %}</span>
                <span>até {{ c.to|slice(8, 2) }}/{{ c.to|slice(5, 2) }} {{ c.to|slice(11, 5) }}</span>
            </p>
        {% else %}
            <p class="rr-empty">{{ 'Sem dados suficientes nos últimos 7 dias.'|trans({}, 'routes_ui') }}</p>
        {% endif %}
    </section>

    {# ── Por hora / por dia ────────────────────────────────────── #}
    <div class="rr-cols">
        {% for item in [{chart: report.byHour, title: ('Média por hora do dia'|trans({}, 'routes_ui')), aria: ('Atraso médio por hora do dia'|trans({}, 'routes_ui'))}, {chart: report.byDow, title: ('Média por dia da semana'|trans({}, 'routes_ui')), aria: ('Atraso médio por dia da semana'|trans({}, 'routes_ui'))}] %}
            {% set chart = item.chart %}
            <section class="rr-section">
                <h2>{{ routes_label(item.title) }} <small>({{ '30 dias'|trans({}, 'routes_ui') }})</small></h2>
                <svg class="rr-chart rr-chart--bars" viewBox="0 0 {{ chart.w }} {{ chart.h }}" role="img" aria-label="{{ routes_label(item.aria) }}">
                    {% for tk in chart.ticks %}
                        <line x1="{{ chart.padL }}" x2="{{ chart.plotR }}" y1="{{ tk.y }}" y2="{{ tk.y }}" stroke="{{ loop.first ? '#94a3b8' : '#e2e8f0' }}" stroke-width="1"/>
                        <text x="{{ chart.padL - 5 }}" y="{{ tk.y + 3 }}" text-anchor="end" font-size="9" fill="#64748b" font-family="Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif">{{ tk.label }}</text>
                    {% endfor %}
                    {% for b in chart.bars %}
                        <rect x="{{ b.x }}" y="{{ b.y }}" width="{{ b.w }}" height="{{ b.h }}" rx="1.5" fill="{{ b.color }}"><title>{{ b.title }}</title></rect>
                        {% if b.label is not null %}<text x="{{ b.cx }}" y="{{ chart.labelY }}" text-anchor="middle" font-size="9" fill="#64748b" font-family="Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif">{{ routes_label(b.label) }}</text>{% endif %}
                    {% endfor %}
                </svg>
            </section>
        {% endfor %}
    </div>

    {# ── Trechos ───────────────────────────────────────────────── #}
    <section class="rr-section">
        <h2>{{ 'Trechos mais problemáticos'|trans({}, 'routes_ui') }} <small>({{ 'estado atual'|trans({}, 'routes_ui') }})</small></h2>
        {% if report.subRoutes %}
            <div class="rr-table-wrap" tabindex="0" role="region" aria-label="{{ 'Relatório'|trans({}, 'routes_ui') }}"><table class="rr-table">
                <thead><tr><th>{{ 'Trecho'|trans({}, 'routes_ui') }}</th><th>{{ 'Agora'|trans({}, 'routes_ui') }}</th><th>{{ 'Normal'|trans({}, 'routes_ui') }}</th><th>{{ 'Atraso'|trans({}, 'routes_ui') }}</th><th>{{ '% vs histórico'|trans({}, 'routes_ui') }}</th><th>{{ 'Extensão'|trans({}, 'routes_ui') }}</th></tr></thead>
                <tbody>
                {% for s in report.subRoutes %}
                    <tr>
                        <td>{{ s.name }}</td>
                        <td>{{ s.time is not null ? (s.time|round(0)) ~ ' s' : '—' }}</td>
                        <td>{{ s.historicTime is not null ? (s.historicTime|round(0)) ~ ' s' : '—' }}</td>
                        <td>+{{ s.delaySeconds ?? 0 }} s</td>
                        <td><span class="rr-pill rr-pill--{{ s.level }}">{{ s.delayRatio is not null ? (s.delayRatio * 100)|round(0) ~ '%' : '—' }}</span></td>
                        <td>{{ s.lengthMeters ? (s.lengthMeters / 1000)|number_format(2, ',', '.') ~ ' km' : '—' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table></div>
        {% else %}
            <p class="rr-empty">{{ 'Sem sub-rotas cadastradas.'|trans({}, 'routes_ui') }}</p>
        {% endif %}
    </section>

    {# ── Ocorrências ───────────────────────────────────────────── #}
    <section class="rr-section">
        <h2>{{ 'Ocorrências recentes'|trans({}, 'routes_ui') }} <small>({{ '7 dias'|trans({}, 'routes_ui') }} · até 60 {{ 'm do traçado'|trans({}, 'routes_ui') }})</small></h2>
        {% if report.occurrences %}
            <div class="rr-table-wrap" tabindex="0" role="region" aria-label="{{ 'Relatório'|trans({}, 'routes_ui') }}"><table class="rr-table">
                <thead><tr><th>{{ 'Quando'|trans({}, 'routes_ui') }}</th><th>{{ 'Fonte'|trans({}, 'routes_ui') }}</th><th>{{ 'Tipo'|trans({}, 'routes_ui') }}</th><th>{{ 'Local'|trans({}, 'routes_ui') }}</th></tr></thead>
                <tbody>
                {% for o in report.occurrences %}
                    <tr>
                        <td>{{ o.at ? routes_date(o.at, false, app_timezone|default('America/Sao_Paulo')) : '—' }}</td>
                        <td>{{ o.source == 'waze' ? 'Waze' : 'TVT' }}</td>
                        <td>{{ routes_label(o.type) }}{% if o.subtype %} · {{ routes_label(o.subtype) }}{% endif %}</td>
                        <td>{{ [o.street, o.city]|filter(p => p)|join(' · ') ?: '—' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table></div>
        {% else %}
            <p class="rr-empty">{{ 'Nenhuma ocorrência registrada no período.'|trans({}, 'routes_ui') }}</p>
        {% endif %}
    </section>

    <footer class="rr-foot">
        <p><strong>{{ 'Como ler:'|trans({}, 'routes_ui') }}</strong> {{ '“% vs histórico” = (tempo medido − tempo histórico) ÷ tempo histórico. A escala de cores usa essa razão, não o atraso em segundos, para tratar igual uma rota curta e uma longa. Horas com menos de 2 amostras ficam em cinza.'|trans({}, 'routes_ui') }}</p>
        <p>{{ 'Fonte: dados de trânsito coletados via Waze (Traffic View) e organizados pelo WazeBR. Horários no fuso'|trans({}, 'routes_ui') }} {{ app_timezone }}.</p>
    </footer>
</main>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script type="module">{% include 'routes/_report_script.html.twig' %}</script>
</body>
</html>
