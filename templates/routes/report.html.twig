<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <title>Relatório · {{ route.name }} · WazeBR</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('css/pages/route-report.css') }}">
</head>
<body>
{% set cur = {
    time: null, historicTime: null, delaySeconds: null, delayRatio: null, level: null,
    recordedAt: null, city: null, state: null
}|merge(current ?? {}) %}

<main class="rr-page" data-route-report>

    <div class="rr-toolbar no-print">
        {% if not public %}
            <a class="rr-btn" href="{{ path('routes_show', {id: route.id}) }}">← Voltar à rota</a>
        {% else %}
            <span></span>
        {% endif %}
        <button type="button" class="rr-btn rr-btn--primary" data-report-print>Imprimir / Salvar em PDF</button>
    </div>

    <header class="rr-header">
        <div>
            <span class="rr-eyebrow">Relatório de trânsito · WazeBR</span>
            <h1>{{ route.name }}</h1>
            <p class="rr-sub">
                {% if route.from and route.to %}{{ route.from }} → {{ route.to }}{% elseif route.from %}{{ route.from }}{% elseif route.to %}{{ route.to }}{% endif %}
                {% if route.lengthMeters %} · {{ (route.lengthMeters / 1000)|number_format(1, ',', '.') }} km{% endif %}
                {% if cur.city %} · {{ cur.city }}{% if cur.state %}/{{ cur.state }}{% endif %}{% endif %}
            </p>
        </div>
        <div class="rr-meta">
            <div class="rr-health rr-health--{{ stats.healthLevel }}">
                <strong>{{ stats.health }}<small>%</small></strong>
                <span>{{ stats.healthLabel }}</span>
            </div>
            <small>Gerado em {{ 'now'|date('d/m/Y H:i') }}</small>
            {% if public and expiresAt %}<small>Link válido até {{ expiresAt|date('d/m/Y H:i') }}</small>{% endif %}
        </div>
    </header>

    {% if not route.isActive %}
        <p class="rr-note rr-note--bad">Rota desativada: os dados abaixo são históricos.</p>
    {% endif %}

    {# ── Resumo ────────────────────────────────────────────────── #}
    <section class="rr-section rr-summary">
        <h2>Resumo</h2>
        <ul>
            {% for line in report.summary %}<li>{{ line }}</li>{% endfor %}
        </ul>
    </section>

    {# ── Indicadores ───────────────────────────────────────────── #}
    <section class="rr-kpis">
        <div class="rr-kpi">
            <span>Tempo atual</span>
            {% if cur.time is not null %}
                {% set t = cur.time|round(0) %}
                <strong>{% if t >= 60 %}{{ (t // 60)|round(0, 'floor') }}min {{ '%02d'|format(t % 60) }}s{% else %}{{ t }}s{% endif %}</strong>
                <small>{% if cur.historicTime is not null %}normal: {{ cur.historicTime|round(0) }}s{% endif %}</small>
            {% else %}<strong>—</strong><small>sem leitura</small>{% endif %}
        </div>
        <div class="rr-kpi">
            <span>Média 24h</span>
            {% if stats.avgDelay24h is not null %}
                <strong>{{ stats.avgDelay24h >= 0 ? '+' : '−' }}{{ stats.avgDelay24h|abs|round(0) }}s</strong>
                <small>{{ ((stats.avgRatio24h ?? 0) * 100)|round(0) }}% vs histórico</small>
            {% else %}<strong>—</strong><small>sem dados</small>{% endif %}
        </div>
        <div class="rr-kpi">
            <span>Média 7 dias</span>
            {% if stats.avgDelay7d is not null %}
                <strong>{{ stats.avgDelay7d >= 0 ? '+' : '−' }}{{ stats.avgDelay7d|abs|round(0) }}s</strong>
                <small>{{ ((stats.avgRatio7d ?? 0) * 100)|round(0) }}% vs histórico</small>
            {% else %}<strong>—</strong><small>sem dados</small>{% endif %}
        </div>
        <div class="rr-kpi">
            <span>Pior hora</span>
            {% if stats.worstHour %}
                <strong>{{ '%02d'|format(stats.worstHour.hour) }}h</strong>
                <small>{{ (stats.worstHour.avgRatio * 100)|round(0) }}% vs histórico</small>
            {% else %}<strong>—</strong><small>amostra insuficiente</small>{% endif %}
        </div>
        <div class="rr-kpi">
            <span>Pior dia</span>
            {% if stats.worstDow %}
                <strong>{{ ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom'][stats.worstDow.dow] }}</strong>
                <small>{{ (stats.worstDow.avgRatio * 100)|round(0) }}% vs histórico</small>
            {% else %}<strong>—</strong><small>amostra insuficiente</small>{% endif %}
        </div>
        <div class="rr-kpi">
            <span>Amostras</span>
            <strong>{{ stats.sampleCount30d|number_format(0, ',', '.') }}</strong>
            <small>últimos 30 dias</small>
        </div>
    </section>

    {# ── Mapa ──────────────────────────────────────────────────── #}
    <section class="rr-section">
        <h2>Traçado e ocorrências</h2>
        {% if report.map %}
            {% set m = report.map %}
            <div class="rr-mapwrap" data-report-mapwrap>
                {# Reserva: esquema do traçado em SVG (aparece se o mapa com ruas não carregar). #}
                <svg class="rr-map-fallback" viewBox="0 0 {{ m.w }} {{ m.h }}" role="img"
                     aria-label="Esquema do traçado da rota com alertas e irregularidades">
                    <rect width="{{ m.w }}" height="{{ m.h }}" fill="#f1f5f9"/>
                    {% if m.main %}<path d="{{ m.main }}" fill="none" stroke="#cbd5e1" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>{% endif %}
                    {% for s in m.subs %}
                        <path d="{{ s.d }}" fill="none" stroke="{{ s.color }}" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><title>{{ s.title }}</title></path>
                    {% endfor %}
                    {% if m.main and not m.subs %}<path d="{{ m.main }}" fill="none" stroke="#2563eb" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>{% endif %}
                    {% for p in m.alerts %}<circle cx="{{ p.x }}" cy="{{ p.y }}" r="5" fill="{{ p.color }}" stroke="#fff" stroke-width="1.5"/>{% endfor %}
                    {% for p in m.irr %}<circle cx="{{ p.x }}" cy="{{ p.y }}" r="5" fill="{{ p.color }}" stroke="#fff" stroke-width="1.5"/>{% endfor %}
                </svg>
                {# Mapa com ruas (OpenStreetMap), montado por route-report.js. #}
                <div class="rr-map-live" data-report-live-map aria-label="Mapa da rota"></div>
            </div>
            <script type="application/json" data-report-map>{{ m.live|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>

            <p class="rr-legend">
                {% if m.colorSource == 'avg' %}
                    Trechos coloridos pela média das últimas {{ recentWindow.hours }} h
                {% elseif m.colorSource == 'current' %}
                    Trechos coloridos pelo estado atual
                {% else %}
                    Trechos sem dados para colorir
                {% endif %}
                (<span class="rr-grad"></span> normal → muito lento).
                {% for l in m.legend %}
                    <span class="rr-dot" style="background:{{ l.color }}"></span>{{ l.label }}{% if l.count > 1 %} ({{ l.count }}){% endif %}
                {% endfor %}
            </p>
            <p class="rr-legend rr-legend--credit" data-report-map-credit>Esquema do traçado, sem mapa de fundo.</p>
        {% else %}
            <p class="rr-empty">Esta rota não possui geometria cadastrada.</p>
        {% endif %}
    </section>

    {# ── Heatmap ───────────────────────────────────────────────── #}
    <section class="rr-section">
        <h2>Padrão semanal — dia × hora <small>(últimos 30 dias, % acima do histórico)</small></h2>
        <div class="rr-heat">
            <div class="rr-heat__row rr-heat__row--head">
                <span></span>
                {% for h in 0..23 %}<span>{{ '%02d'|format(h) }}</span>{% endfor %}
            </div>
            {% for row in report.heatmap %}
                <div class="rr-heat__row">
                    <span class="rr-heat__label">{{ row.label }}</span>
                    {% for c in row.cells %}
                        <i title="{{ c.title }}" style="{% if c.color %}background:{{ c.color }}{% endif %}"{% if not c.color %} class="is-empty"{% endif %}></i>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
        <p class="rr-legend"><span class="rr-grad"></span> sem atraso → muito atraso · células cinza: sem amostras suficientes.</p>
    </section>

    {# ── Timeline ──────────────────────────────────────────────── #}
    <section class="rr-section">
        <h2>Evolução do atraso <small>(últimos 7 dias, segundos acima do histórico)</small></h2>
        {% if report.timeline %}
            {% set c = report.timeline %}
            <svg class="rr-chart" viewBox="0 0 {{ c.w }} {{ c.h }}" role="img"
                 aria-label="Evolução horária do atraso nos últimos 7 dias">
                {# grade horizontal + escala (s) #}
                {% for tk in c.ticks %}
                    <line x1="{{ c.padL }}" x2="{{ c.plotR }}" y1="{{ tk.y }}" y2="{{ tk.y }}" stroke="#e2e8f0" stroke-width="1"/>
                    <text x="{{ c.padL - 5 }}" y="{{ tk.y + 3 }}" text-anchor="end" font-size="9" fill="#64748b" font-family="Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif">{{ tk.label }}</text>
                {% endfor %}
                {# separadores de dia + rótulos #}
                {% for d in c.days %}
                    {% if d.line is not null %}<line x1="{{ d.line }}" x2="{{ d.line }}" y1="{{ c.padT }}" y2="{{ c.plotB }}" stroke="#cbd5e1" stroke-width="1" stroke-dasharray="3 3"/>{% endif %}
                    {% if d.width > 34 %}<text x="{{ d.cx }}" y="{{ c.h - 8 }}" text-anchor="middle" font-size="9" fill="#64748b" font-family="Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif">{{ d.label }}</text>{% endif %}
                {% endfor %}
                <line x1="{{ c.padL }}" x2="{{ c.plotR }}" y1="{{ c.zeroY }}" y2="{{ c.zeroY }}" stroke="#94a3b8" stroke-width="1"/>
                {% for seg in c.paths %}
                    {% if seg.area %}<path d="{{ seg.area }}" fill="rgba(37,99,235,.13)"/>{% endif %}
                    <path d="{{ seg.line }}" fill="none" stroke="#2563eb" stroke-width="1.6" stroke-linejoin="round"/>
                {% endfor %}
                {% if c.peak %}
                    <circle cx="{{ c.peak.x }}" cy="{{ c.peak.y }}" r="3.5" fill="#dc2626" stroke="#fff" stroke-width="1.2"/>
                {% endif %}
            </svg>
            <p class="rr-axis">
                <span>de {{ c.from|slice(8, 2) }}/{{ c.from|slice(5, 2) }} {{ c.from|slice(11, 5) }}</span>
                <span><span class="rr-dot rr-dot--first" style="background:#dc2626"></span>pico: +{{ c.max }} s{% if c.peak %} em {{ c.peak.at|slice(8, 2) }}/{{ c.peak.at|slice(5, 2) }} {{ c.peak.at|slice(11, 5) }}{% endif %}</span>
                <span>até {{ c.to|slice(8, 2) }}/{{ c.to|slice(5, 2) }} {{ c.to|slice(11, 5) }}</span>
            </p>
        {% else %}
            <p class="rr-empty">Sem dados suficientes nos últimos 7 dias.</p>
        {% endif %}
    </section>

    {# ── Por hora / por dia ────────────────────────────────────── #}
    <div class="rr-cols">
        {% for item in [{chart: report.byHour, title: 'Média por hora do dia', aria: 'Atraso médio por hora do dia'}, {chart: report.byDow, title: 'Média por dia da semana', aria: 'Atraso médio por dia da semana'}] %}
            {% set chart = item.chart %}
            <section class="rr-section">
                <h2>{{ item.title }} <small>(30 dias)</small></h2>
                <svg class="rr-chart rr-chart--bars" viewBox="0 0 {{ chart.w }} {{ chart.h }}" role="img" aria-label="{{ item.aria }}">
                    {% for tk in chart.ticks %}
                        <line x1="{{ chart.padL }}" x2="{{ chart.plotR }}" y1="{{ tk.y }}" y2="{{ tk.y }}" stroke="{{ loop.first ? '#94a3b8' : '#e2e8f0' }}" stroke-width="1"/>
                        <text x="{{ chart.padL - 5 }}" y="{{ tk.y + 3 }}" text-anchor="end" font-size="9" fill="#64748b" font-family="Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif">{{ tk.label }}</text>
                    {% endfor %}
                    {% for b in chart.bars %}
                        <rect x="{{ b.x }}" y="{{ b.y }}" width="{{ b.w }}" height="{{ b.h }}" rx="1.5" fill="{{ b.color }}"><title>{{ b.title }}</title></rect>
                        {% if b.label is not null %}<text x="{{ b.cx }}" y="{{ chart.labelY }}" text-anchor="middle" font-size="9" fill="#64748b" font-family="Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif">{{ b.label }}</text>{% endif %}
                    {% endfor %}
                </svg>
            </section>
        {% endfor %}
    </div>

    {# ── Trechos ───────────────────────────────────────────────── #}
    <section class="rr-section">
        <h2>Trechos mais problemáticos <small>(estado atual)</small></h2>
        {% if report.subRoutes %}
            <table class="rr-table">
                <thead><tr><th>Trecho</th><th>Agora</th><th>Normal</th><th>Atraso</th><th>% vs histórico</th><th>Extensão</th></tr></thead>
                <tbody>
                {% for s in report.subRoutes %}
                    <tr>
                        <td>{{ s.name }}</td>
                        <td>{{ s.time is not null ? (s.time|round(0)) ~ ' s' : '—' }}</td>
                        <td>{{ s.historicTime is not null ? (s.historicTime|round(0)) ~ ' s' : '—' }}</td>
                        <td>+{{ s.delaySeconds ?? 0 }} s</td>
                        <td><span class="rr-pill rr-pill--{{ s.level }}">{{ s.delayRatio is not null ? (s.delayRatio * 100)|round(0) ~ '%' : '—' }}</span></td>
                        <td>{{ s.lengthMeters ? (s.lengthMeters / 1000)|number_format(2, ',', '.') ~ ' km' : '—' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="rr-empty">Sem sub-rotas cadastradas.</p>
        {% endif %}
    </section>

    {# ── Ocorrências ───────────────────────────────────────────── #}
    <section class="rr-section">
        <h2>Ocorrências recentes <small>(7 dias · até 60 m do traçado)</small></h2>
        {% if report.occurrences %}
            <table class="rr-table">
                <thead><tr><th>Quando</th><th>Fonte</th><th>Tipo</th><th>Local</th></tr></thead>
                <tbody>
                {% for o in report.occurrences %}
                    <tr>
                        <td>{{ o.at ? o.at|date('d/m H:i') : '—' }}</td>
                        <td>{{ o.source == 'waze' ? 'Waze' : 'TVT' }}</td>
                        <td>{{ o.type }}{% if o.subtype %} · {{ o.subtype }}{% endif %}</td>
                        <td>{{ [o.street, o.city]|filter(p => p)|join(' · ') ?: '—' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="rr-empty">Nenhuma ocorrência registrada no período.</p>
        {% endif %}
    </section>

    <footer class="rr-foot">
        <p><strong>Como ler:</strong> “% vs histórico” = (tempo medido − tempo histórico) ÷ tempo histórico. A escala de cores usa essa razão, não o atraso em segundos, para tratar igual uma rota curta e uma longa. Horas com menos de 2 amostras ficam em cinza.</p>
        <p>Fonte: dados de trânsito coletados via Waze (Traffic View) e organizados pelo WazeBR. Horários no fuso {{ app_timezone }}.</p>
    </footer>
</main>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script type="module" src="{{ asset('js/pages/route-report.js') }}"></script>
</body>
</html>
