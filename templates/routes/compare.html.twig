{% extends 'layouts/dashboard.html.twig' %}

{% block title %}{{ 'Comparar rotas'|trans({}, 'route_compare') }} | WazeBR{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous" />
    <link rel="stylesheet" href="{{ asset('css/pages/route-compare.css') }}">
{% endblock %}

{% block content %}
{% set _rc_messages = {} %}
{% for _rc_key in ['Comparar rotas', 'Rotas', 'Comparar', 'Navegação', 'Análise comparativa', 'Veja qual das duas rotas performa melhor em cada horário.', 'Rota A', 'Rota B', '— Selecione —', 'Inverter A e B', 'Selecione duas rotas para começar', 'Escolha uma rota em cada campo acima e clique em Comparar.', 'vence', 'métricas comparadas', 'Empate técnico', 'Cada rota vence em', 'métrica', 'Melhor agora', 'Pior agora', 'Empate', 'Sem descrição', 'Agora', 'sobre o tempo histórico', 'melhor em 7d', 'Métrica', 'Atraso atual', 'Média 24h', 'Média 7 dias', '% vs histórico 7d', 'Pior hora · 30d', 'Pior dia · 30d', 'Traçados sobrepostos', 'Mapa comparativo', 'Sem traçado geográfico', 'Uma ou ambas as rotas não têm geometria cadastrada.', 'Onde cada uma ganha', 'Mapa diferencial · dia da semana × hora', 'A melhor', 'B melhor', 'Cada célula compara a média das duas rotas naquele slot nos últimos 30 dias.', 'Verde = A mais rápida; vermelho = B mais rápida.', 'Últimos 7 dias', 'Evolução comparada', 'Últimos 30 dias', 'Por hora do dia', 'Por dia da semana', 'Interseção entre as duas', 'Trechos compartilhados', 'Sem trechos coincidentes', 'As duas rotas não compartilham nenhum ponto identificável.', 'Últimos 7 dias · ≤ 60 m do traçado', 'Alertas Waze cruzados', 'Em ambas', 'Só em', 'Nenhum', 'Sem amostras', 'Rota A melhor', 'Rota B melhor', 'Diferença (p.p.)', 'segundos', 'Atraso', 'Sem dados', 'Mapa indisponível', 'Não foi possível carregar o mapa. Os demais dados continuam disponíveis.', 'Gráfico indisponível', 'Não foi possível carregar o gráfico.', 'Selecione duas rotas diferentes.', 'Comparando…', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom', 'Pular para a comparação', 'A menor razão de atraso é melhor. Valores ausentes não são considerados zero.', 'Mapa de calor da comparação de rotas', 'Diferença entre razões de atraso de A e B', 'ui.winner', 'ui.score', 'ui.tie.one', 'ui.tie.many'] %}
    {% set _rc_messages = _rc_messages|merge({(_rc_key): _rc_key|trans({}, 'route_compare')}) %}
{% endfor %}

<a class="rc-skip-link" href="#rc-main">{{ 'Pular para a comparação'|trans({}, 'route_compare') }}</a>
<div id="rc-main" tabindex="-1" class="rc-page" data-route-compare data-rc-locale="{{ app.request.locale }}" data-rc-messages="{{ _rc_messages|json_encode|e('html_attr') }}">

    <div class="rc-container">

        <nav class="rc-breadcrumb" aria-label="{{ 'Navegação'|trans({}, 'route_compare') }}">
            <a href="{{ path('routes_index') }}">{{ 'Rotas'|trans({}, 'route_compare') }}</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{{ 'Comparar'|trans({}, 'route_compare') }}</span>
        </nav>

        {# ── Cabeçalho + picker ─────────────────────────────────── #}
        <header class="rc-header">
            <div class="rc-header__top">
                <div>
                    <span class="rc-eyebrow"><i></i> {{ 'Análise comparativa'|trans({}, 'route_compare') }}</span>
                    <h1>{{ 'Comparar rotas'|trans({}, 'route_compare') }}</h1>
                    <p>{{ 'Veja qual das duas rotas performa melhor em cada horário.'|trans({}, 'route_compare') }}</p>
                </div>
            </div>

            <form method="get" action="{{ path('routes_compare') }}"
                  class="rc-picker" data-rc-form>

                <div class="rc-picker__field">
                    <label for="rc-route-a" class="rc-picker__label rc-picker__label--a">{{ 'Rota A'|trans({}, 'route_compare') }}</label>
                    <select id="rc-route-a" name="a" data-rc-select-a required>
                        <option value="">{{ '— Selecione —'|trans({}, 'route_compare') }}</option>
                        {% for r in routes %}
                            <option value="{{ r.id }}" {{ aId == r.id ? 'selected' }}>
                                {{ r.name }}{% if r.from and r.to %} · {{ r.from }} → {{ r.to }}{% endif %}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="rc-picker__vs" aria-hidden="true">VS</div>

                <div class="rc-picker__field">
                    <label for="rc-route-b" class="rc-picker__label rc-picker__label--b">{{ 'Rota B'|trans({}, 'route_compare') }}</label>
                    <select id="rc-route-b" name="b" data-rc-select-b required>
                        <option value="">{{ '— Selecione —'|trans({}, 'route_compare') }}</option>
                        {% for r in routes %}
                            <option value="{{ r.id }}" {{ bId == r.id ? 'selected' }}>
                                {{ r.name }}{% if r.from and r.to %} · {{ r.from }} → {{ r.to }}{% endif %}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="rc-picker__actions">
                    <button type="button" class="rc-icon-btn" data-rc-swap
                            title="{{ 'Inverter A e B'|trans({}, 'route_compare') }}" aria-label="{{ 'Inverter A e B'|trans({}, 'route_compare') }}">
                        ⇄
                    </button>
                    <button type="submit" class="rc-button rc-button--primary">
                        {{ 'Comparar'|trans({}, 'route_compare') }}
                    </button>
                </div>
            </form>
        </header>

        {% if compare is null %}
            <section class="rc-empty">
                <span aria-hidden="true">⇄</span>
                <strong>{{ 'Selecione duas rotas para começar'|trans({}, 'route_compare') }}</strong>
                <small>{{ 'Escolha uma rota em cada campo acima e clique em Comparar.'|trans({}, 'route_compare') }}</small>
            </section>
        {% else %}

            {% set a = compare.a %}
            {% set b = compare.b %}
            {% set st = compare.stats %}
            {% set pointsA = st.pointsA|default(0) %}
            {% set pointsB = st.pointsB|default(0) %}

            {# ── Veredito ──────────────────────────────────────── #}
            <section class="rc-verdict rc-verdict--{{ pointsA > pointsB ? 'a' : (pointsB > pointsA ? 'b' : 'tie') }}">
                <div class="rc-verdict__icon" aria-hidden="true">
                    {% if pointsA > pointsB %}◀
                    {% elseif pointsB > pointsA %}▶
                    {% else %}≡{% endif %}
                </div>
                <div class="rc-verdict__text">
                    {% if pointsA > pointsB %}
                        <strong>{{ 'ui.winner'|trans({'%name%': a.name}, 'route_compare') }}</strong>
                        <span>{{ 'ui.score'|trans({'%won%': pointsA, '%total%': pointsA + pointsB}, 'route_compare') }}</span>
                    {% elseif pointsB > pointsA %}
                        <strong>{{ 'ui.winner'|trans({'%name%': b.name}, 'route_compare') }}</strong>
                        <span>{{ 'ui.score'|trans({'%won%': pointsB, '%total%': pointsA + pointsB}, 'route_compare') }}</span>
                    {% else %}
                        <strong>{{ 'Empate técnico'|trans({}, 'route_compare') }}</strong>
                        <span>{{ (pointsA == 1 ? 'ui.tie.one' : 'ui.tie.many')|trans({'%count%': pointsA}, 'route_compare') }}</span>
                    {% endif %}
                </div>
                <div class="rc-verdict__score">
                    <span class="rc-verdict__score-a">{{ pointsA }}</span>
                    <span class="rc-verdict__score-sep">×</span>
                    <span class="rc-verdict__score-b">{{ pointsB }}</span>
                </div>
            </section>

            {# ── Banner VS ─────────────────────────────────────── #}
            <section class="rc-vs">

                <article class="rc-vs__card rc-vs__card--a">
                    <header class="rc-vs__head">
                        <span class="rc-vs__badge-label">{{ 'Rota A'|trans({}, 'route_compare') }}</span>
                        {% if st.winnerNow == 'a' %}
                            <span class="rc-vs__status rc-vs__status--win">{{ 'Melhor agora'|trans({}, 'route_compare') }}</span>
                        {% elseif st.winnerNow == 'b' %}
                            <span class="rc-vs__status rc-vs__status--lose">{{ 'Pior agora'|trans({}, 'route_compare') }}</span>
                        {% elseif st.winnerNow == 'tie' %}
                            <span class="rc-vs__status rc-vs__status--tie">{{ 'Empate'|trans({}, 'route_compare') }}</span>
                        {% endif %}
                    </header>
                    <h2 class="rc-vs__name">{{ a.name }}</h2>
                    <p class="rc-vs__path">
                        {% if a.from and a.to %}{{ a.from }} → {{ a.to }}{% else %}{{ 'Sem descrição'|trans({}, 'route_compare') }}{% endif %}
                        {% if a.lengthMeters %} · {{ (a.lengthMeters / 1000)|number_format(1, app.request.locale == 'en' ? '.' : ',', app.request.locale == 'en' ? ',' : '.') }} km{% endif %}
                    </p>
                    <div class="rc-vs__spacer"></div>
                    <div class="rc-vs__current">
                        <span class="rc-vs__current-label">{{ 'Agora'|trans({}, 'route_compare') }}</span>
                        <div class="rc-vs__current-row">
                            {% if a.current and a.current.delaySeconds is not null %}
                                <strong class="rc-vs__current-value">+{{ a.current.delaySeconds }}<small>s</small></strong>
                                {% if a.current.delayRatio is not null %}
                                    <span class="rc-vs__current-ratio">{{ (a.current.delayRatio * 100)|round(0) }}%</span>
                                {% endif %}
                            {% else %}
                                <strong class="rc-vs__current-value">—</strong>
                            {% endif %}
                        </div>
                        <small class="rc-vs__current-hint">{{ 'sobre o tempo histórico'|trans({}, 'route_compare') }}</small>
                    </div>
                </article>

                <div class="rc-vs__center">
                    <div class="rc-vs__center-title">VS</div>
                    {% if st.winner7d %}
                        <div class="rc-vs__center-winner">
                            {{ 'melhor em 7d'|trans({}, 'route_compare') }}
                            <strong>{{ st.winner7d == 'a' ? 'A' : (st.winner7d == 'b' ? 'B' : 'Empate'|trans({}, 'route_compare')) }}</strong>
                        </div>
                    {% endif %}
                </div>

                <article class="rc-vs__card rc-vs__card--b">
                    <header class="rc-vs__head">
                        <span class="rc-vs__badge-label">{{ 'Rota B'|trans({}, 'route_compare') }}</span>
                        {% if st.winnerNow == 'b' %}
                            <span class="rc-vs__status rc-vs__status--win">{{ 'Melhor agora'|trans({}, 'route_compare') }}</span>
                        {% elseif st.winnerNow == 'a' %}
                            <span class="rc-vs__status rc-vs__status--lose">{{ 'Pior agora'|trans({}, 'route_compare') }}</span>
                        {% elseif st.winnerNow == 'tie' %}
                            <span class="rc-vs__status rc-vs__status--tie">{{ 'Empate'|trans({}, 'route_compare') }}</span>
                        {% endif %}
                    </header>
                    <h2 class="rc-vs__name">{{ b.name }}</h2>
                    <p class="rc-vs__path">
                        {% if b.from and b.to %}{{ b.from }} → {{ b.to }}{% else %}{{ 'Sem descrição'|trans({}, 'route_compare') }}{% endif %}
                        {% if b.lengthMeters %} · {{ (b.lengthMeters / 1000)|number_format(1, app.request.locale == 'en' ? '.' : ',', app.request.locale == 'en' ? ',' : '.') }} km{% endif %}
                    </p>
                    <div class="rc-vs__spacer"></div>
                    <div class="rc-vs__current">
                        <span class="rc-vs__current-label">{{ 'Agora'|trans({}, 'route_compare') }}</span>
                        <div class="rc-vs__current-row">
                            {% if b.current and b.current.delaySeconds is not null %}
                                <strong class="rc-vs__current-value">+{{ b.current.delaySeconds }}<small>s</small></strong>
                                {% if b.current.delayRatio is not null %}
                                    <span class="rc-vs__current-ratio">{{ (b.current.delayRatio * 100)|round(0) }}%</span>
                                {% endif %}
                            {% else %}
                                <strong class="rc-vs__current-value">—</strong>
                            {% endif %}
                        </div>
                        <small class="rc-vs__current-hint">{{ 'sobre o tempo histórico'|trans({}, 'route_compare') }}</small>
                    </div>
                </article>

            </section>

            {# ── Tabela comparativa ────────────────────────────── #}
            <section class="rc-compare">

                <header class="rc-compare__head">
                    <span class="rc-compare__col-label">{{ 'Métrica'|trans({}, 'route_compare') }}</span>
                    <span class="rc-compare__col-name rc-compare__col-name--a">{{ a.name }}</span>
                    <span class="rc-compare__col-name rc-compare__col-name--b">{{ b.name }}</span>
                </header>

                {% set rows = [
                    { label: ('Atraso atual'|trans({}, 'route_compare')),       a: a.current ? a.current.delaySeconds : null, b: b.current ? b.current.delaySeconds : null, fmt: 'sec' },
                    { label: ('Média 24h'|trans({}, 'route_compare')),          a: a.stats.avgDelay24h, b: b.stats.avgDelay24h, fmt: 'sec' },
                    { label: ('Média 7 dias'|trans({}, 'route_compare')),       a: a.stats.avgDelay7d,  b: b.stats.avgDelay7d,  fmt: 'sec' },
                    { label: ('% vs histórico 7d'|trans({}, 'route_compare')),  a: a.stats.avgRatio7d,  b: b.stats.avgRatio7d,  fmt: 'pct' }
                ] %}

                {% for r in rows %}
                    {% set aVal = r.a %}
                    {% set bVal = r.b %}
                    {% set aWin = aVal is not null and (bVal is null or aVal < bVal) %}
                    {% set bWin = bVal is not null and (aVal is null or bVal < aVal) %}
                    {% set tie  = aVal is not null and bVal is not null and aVal == bVal %}
                    {% set aCls = tie ? 'is-tie' : (aWin ? 'is-win' : (bWin ? 'is-lose' : '')) %}
                    {% set bCls = tie ? 'is-tie' : (bWin ? 'is-win' : (aWin ? 'is-lose' : '')) %}

                    <div class="rc-compare__row">
                        <span class="rc-compare__col-label">{{ r.label }}</span>
                        <span class="rc-compare__col-val {{ aCls }}">
                            {% if aVal is null %}—
                            {% elseif r.fmt == 'sec' %}+{{ aVal|round(0) }}s
                            {% elseif r.fmt == 'pct' %}{{ (aVal * 100)|round(0) }}%
                            {% else %}{{ aVal }}{% endif %}
                            {% if not tie and aWin %}<i class="rc-flag" aria-hidden="true">▲</i>{% endif %}
                        </span>
                        <span class="rc-compare__col-val {{ bCls }}">
                            {% if bVal is null %}—
                            {% elseif r.fmt == 'sec' %}+{{ bVal|round(0) }}s
                            {% elseif r.fmt == 'pct' %}{{ (bVal * 100)|round(0) }}%
                            {% else %}{{ bVal }}{% endif %}
                            {% if not tie and bWin %}<i class="rc-flag" aria-hidden="true">▲</i>{% endif %}
                        </span>
                    </div>
                {% endfor %}

                {# Pior hora #}
                {% set aW = a.stats.worstHour %}
                {% set bW = b.stats.worstHour %}
                {% set aWin = aW and (not bW or aW.avgRatio < bW.avgRatio) %}
                {% set bWin = bW and (not aW or bW.avgRatio < aW.avgRatio) %}
                <div class="rc-compare__row">
                    <span class="rc-compare__col-label">{{ 'Pior hora · 30d'|trans({}, 'route_compare') }}</span>
                    <span class="rc-compare__col-val {{ aWin ? 'is-win' : (bWin ? 'is-lose' : '') }}">
                        {% if aW %}{{ '%02d'|format(aW.hour) }}h · {{ (aW.avgRatio * 100)|round(0) }}%
                        {% else %}—{% endif %}
                    </span>
                    <span class="rc-compare__col-val {{ bWin ? 'is-win' : (aWin ? 'is-lose' : '') }}">
                        {% if bW %}{{ '%02d'|format(bW.hour) }}h · {{ (bW.avgRatio * 100)|round(0) }}%
                        {% else %}—{% endif %}
                    </span>
                </div>

                {# Pior dia #}
                {% set aD = a.stats.worstDow %}
                {% set bD = b.stats.worstDow %}
                {% set aWin = aD and (not bD or aD.avgRatio < bD.avgRatio) %}
                {% set bWin = bD and (not aD or bD.avgRatio < aD.avgRatio) %}
                <div class="rc-compare__row">
                    <span class="rc-compare__col-label">{{ 'Pior dia · 30d'|trans({}, 'route_compare') }}</span>
                    <span class="rc-compare__col-val {{ aWin ? 'is-win' : (bWin ? 'is-lose' : '') }}">
                        {% if aD %}{{ [('Seg'|trans({}, 'route_compare')),('Ter'|trans({}, 'route_compare')),('Qua'|trans({}, 'route_compare')),('Qui'|trans({}, 'route_compare')),('Sex'|trans({}, 'route_compare')),('Sáb'|trans({}, 'route_compare')),('Dom'|trans({}, 'route_compare'))][aD.dow] }} · {{ (aD.avgRatio * 100)|round(0) }}%
                        {% else %}—{% endif %}
                    </span>
                    <span class="rc-compare__col-val {{ bWin ? 'is-win' : (aWin ? 'is-lose' : '') }}">
                        {% if bD %}{{ [('Seg'|trans({}, 'route_compare')),('Ter'|trans({}, 'route_compare')),('Qua'|trans({}, 'route_compare')),('Qui'|trans({}, 'route_compare')),('Sex'|trans({}, 'route_compare')),('Sáb'|trans({}, 'route_compare')),('Dom'|trans({}, 'route_compare'))][bD.dow] }} · {{ (bD.avgRatio * 100)|round(0) }}%
                        {% else %}—{% endif %}
                    </span>
                </div>

            </section>

            {# ── Mapa ──────────────────────────────────────────── #}
            <section class="rc-panel">
                <header class="rc-panel__header">
                    <div>
                        <span class="rc-panel__kicker">{{ 'Traçados sobrepostos'|trans({}, 'route_compare') }}</span>
                        <h2>{{ 'Mapa comparativo'|trans({}, 'route_compare') }}</h2>
                    </div>
                    <div class="rc-panel__legend">
                        <span><i class="rc-dot rc-dot--a"></i>{{ a.name }}</span>
                        <span><i class="rc-dot rc-dot--b"></i>{{ b.name }}</span>
                    </div>
                </header>
                <div class="rc-map"
                     data-rc-map
                     data-rc-a='{{ a.geometry|json_encode|e('html_attr') }}'
                     data-rc-b='{{ b.geometry|json_encode|e('html_attr') }}'>
                    <div class="rc-map__fallback" data-rc-map-fallback hidden>
                        <strong>{{ 'Sem traçado geográfico'|trans({}, 'route_compare') }}</strong>
                        <small>{{ 'Uma ou ambas as rotas não têm geometria cadastrada.'|trans({}, 'route_compare') }}</small>
                    </div>
                </div>
            </section>

            {# ── Heatmap diferencial ──────────────────────────── #}
            <section class="rc-panel">
                <header class="rc-panel__header">
                    <div>
                        <span class="rc-panel__kicker">{{ 'Onde cada uma ganha'|trans({}, 'route_compare') }}</span>
                        <h2>{{ 'Mapa diferencial · dia da semana × hora'|trans({}, 'route_compare') }}</h2>
                    </div>
                    <div class="rc-heat-legend">
                        <span><i class="rc-heat-chip rc-heat-chip--a"></i>{{ 'A melhor'|trans({}, 'route_compare') }}</span>
                        <span><i class="rc-heat-chip rc-heat-chip--tie"></i>{{ 'Empate'|trans({}, 'route_compare') }}</span>
                        <span><i class="rc-heat-chip rc-heat-chip--b"></i>{{ 'B melhor'|trans({}, 'route_compare') }}</span>
                    </div>
                </header>
                <div class="rc-heatmap-scroll">
                    <div class="rc-heatmap" data-rc-heatmap
                         data-rc-heatmap-data='{{ compare.heatmapDiff|json_encode|e('html_attr') }}'></div>
                </div>
                <p class="rc-panel__hint">
                    {{ 'Cada célula compara a média das duas rotas naquele slot nos últimos 30 dias.'|trans({}, 'route_compare') }}
                    {{ 'Verde = A mais rápida; vermelho = B mais rápida.'|trans({}, 'route_compare') }}
                </p>
            </section>

            {# ── Timeline ──────────────────────────────────────── #}
            <section class="rc-panel">
                <header class="rc-panel__header">
                    <div>
                        <span class="rc-panel__kicker">{{ 'Últimos 7 dias'|trans({}, 'route_compare') }}</span>
                        <h2>{{ 'Evolução comparada'|trans({}, 'route_compare') }}</h2>
                    </div>
                    <div class="rc-panel__legend">
                        <span><i class="rc-dot rc-dot--a"></i>{{ a.name }}</span>
                        <span><i class="rc-dot rc-dot--b"></i>{{ b.name }}</span>
                    </div>
                </header>
                <div class="rc-chart-wrap rc-chart-wrap--tall">
                    <canvas data-chart="rc-timeline" role="img" aria-label="{{ 'Evolução comparada'|trans({}, 'route_compare') }}"
                            data-chart-data='{{ compare.timeline|json_encode|e('html_attr') }}'></canvas>
                </div>
            </section>

            {# ── Por hora / por dia ────────────────────────────── #}
            <div class="rc-two-col">
                <section class="rc-panel">
                    <header class="rc-panel__header">
                        <div>
                            <span class="rc-panel__kicker">{{ 'Últimos 30 dias'|trans({}, 'route_compare') }}</span>
                            <h2>{{ 'Por hora do dia'|trans({}, 'route_compare') }}</h2>
                        </div>
                        <div class="rc-panel__legend">
                            <span><i class="rc-dot rc-dot--a"></i>A</span>
                            <span><i class="rc-dot rc-dot--b"></i>B</span>
                        </div>
                    </header>
                    <div class="rc-chart-wrap">
                        <canvas data-chart="rc-by-hour" role="img" aria-label="{{ 'Por hora do dia'|trans({}, 'route_compare') }}"
                                data-chart-data='{{ compare.byHour|json_encode|e('html_attr') }}'></canvas>
                    </div>
                </section>

                <section class="rc-panel">
                    <header class="rc-panel__header">
                        <div>
                            <span class="rc-panel__kicker">{{ 'Últimos 30 dias'|trans({}, 'route_compare') }}</span>
                            <h2>{{ 'Por dia da semana'|trans({}, 'route_compare') }}</h2>
                        </div>
                        <div class="rc-panel__legend">
                            <span><i class="rc-dot rc-dot--a"></i>A</span>
                            <span><i class="rc-dot rc-dot--b"></i>B</span>
                        </div>
                    </header>
                    <div class="rc-chart-wrap">
                        <canvas data-chart="rc-by-dow" role="img" aria-label="{{ 'Por dia da semana'|trans({}, 'route_compare') }}"
                                data-chart-data='{{ compare.byDow|json_encode|e('html_attr') }}'></canvas>
                    </div>
                </section>
            </div>

            {# ── Trechos comuns ────────────────────────────────── #}
            <section class="rc-panel">
                <header class="rc-panel__header">
                    <div>
                        <span class="rc-panel__kicker">{{ 'Interseção entre as duas'|trans({}, 'route_compare') }}</span>
                        <h2>{{ 'Trechos compartilhados'|trans({}, 'route_compare') }}</h2>
                    </div>
                    <span class="rc-panel__count">{{ compare.commonSubRoutes|length }}</span>
                </header>

                {% if compare.commonSubRoutes is empty %}
                    <div class="rc-empty rc-empty--inline">
                        <strong>{{ 'Sem trechos coincidentes'|trans({}, 'route_compare') }}</strong>
                        <small>{{ 'As duas rotas não compartilham nenhum ponto identificável.'|trans({}, 'route_compare') }}</small>
                    </div>
                {% else %}
                    <div class="rc-common">
                        {% for c in compare.commonSubRoutes %}
                            <div class="rc-common__item">
                                <div class="rc-common__head">
                                    <strong>{{ c.a.name ?: 'Trecho' }}</strong>
                                    <span class="rc-common__match">{{ c.matched }}</span>
                                </div>
                                <div class="rc-common__grid">
                                    <div class="rc-common__side rc-common__side--a">
                                        <span class="rc-common__side-label">A</span>
                                        <span class="rc-common__path">{{ c.a.from ?: '—' }} → {{ c.a.to ?: '—' }}</span>
                                        {% set r = c.a.delayRatio %}
                                        <span class="rc-common__val {{ r and r >= 0.22 ? 'is-bad' : (r and r >= 0.10 ? 'is-warn' : 'is-ok') }}">
                                            {{ r is not null ? (r * 100)|round(0) ~ '%' : '—' }}
                                        </span>
                                    </div>
                                    <div class="rc-common__side rc-common__side--b">
                                        <span class="rc-common__side-label">B</span>
                                        <span class="rc-common__path">{{ c.b.from ?: '—' }} → {{ c.b.to ?: '—' }}</span>
                                        {% set r = c.b.delayRatio %}
                                        <span class="rc-common__val {{ r and r >= 0.22 ? 'is-bad' : (r and r >= 0.10 ? 'is-warn' : 'is-ok') }}">
                                            {{ r is not null ? (r * 100)|round(0) ~ '%' : '—' }}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>

            {# ── Alertas cruzados ──────────────────────────────── #}
            <section class="rc-panel">
                <header class="rc-panel__header">
                    <div>
                        <span class="rc-panel__kicker">{{ 'Últimos 7 dias · ≤ 60 m do traçado'|trans({}, 'route_compare') }}</span>
                        <h2>{{ 'Alertas Waze cruzados'|trans({}, 'route_compare') }}</h2>
                    </div>
                </header>

                <div class="rc-alerts-grid">

                    <div class="rc-alerts-col rc-alerts-col--shared">
                        <h3><span class="rc-alerts-col__dot"></span>{{ 'Em ambas'|trans({}, 'route_compare') }} · {{ compare.alerts.shared|length }}</h3>
                        {% for al in compare.alerts.shared %}
                            <div class="rc-alert">
                                <strong>{{ al.typeLabel }}</strong>
                                <small>{{ al.street ?: '—' }} · A {{ al.distanceA }}m / B {{ al.distanceB }}m</small>
                            </div>
                        {% else %}
                            <div class="rc-empty rc-empty--small">{{ 'Nenhum'|trans({}, 'route_compare') }}</div>
                        {% endfor %}
                    </div>

                    <div class="rc-alerts-col rc-alerts-col--a">
                        <h3><span class="rc-alerts-col__dot"></span>{{ 'Só em'|trans({}, 'route_compare') }} {{ a.name }} · {{ compare.alerts.onlyA|length }}</h3>
                        {% for al in compare.alerts.onlyA %}
                            <div class="rc-alert">
                                <strong>{{ al.typeLabel }}</strong>
                                <small>{{ al.street ?: '—' }} · {{ al.distanceA }}m</small>
                            </div>
                        {% else %}
                            <div class="rc-empty rc-empty--small">{{ 'Nenhum'|trans({}, 'route_compare') }}</div>
                        {% endfor %}
                    </div>

                    <div class="rc-alerts-col rc-alerts-col--b">
                        <h3><span class="rc-alerts-col__dot"></span>{{ 'Só em'|trans({}, 'route_compare') }} {{ b.name }} · {{ compare.alerts.onlyB|length }}</h3>
                        {% for al in compare.alerts.onlyB %}
                            <div class="rc-alert">
                                <strong>{{ al.typeLabel }}</strong>
                                <small>{{ al.street ?: '—' }} · {{ al.distanceB }}m</small>
                            </div>
                        {% else %}
                            <div class="rc-empty rc-empty--small">{{ 'Nenhum'|trans({}, 'route_compare') }}</div>
                        {% endfor %}
                    </div>

                </div>
            </section>

        {% endif %}

    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.1/chart.umd.min.js" integrity="sha512-WoViKhKD4qI2WruSZqv9+kvM4WfFhUMQCLN4QlDTt5aU56fLQy2gYoxWIqlEnXqJy/+Ac5q/hk1oWfqnMDhwMA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script type="module" src="{{ asset('js/pages/route-compare.js') }}"></script>
{% endblock %}
