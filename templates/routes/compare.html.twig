{% extends 'layouts/dashboard.html.twig' %}
{% macro duration(value) %}{% if value is null %}—{% else %}{% set s = value|round(0) %}+{% if s >= 60 %}{{ (s / 60)|round(0, 'floor') }} min {% endif %}{{ s % 60 }} s{% endif %}{% endmacro %}
{% import _self as ui %}
{% block title %}{{ 'Comparar rotas'|trans({}, 'route_compare') }} | WazeBR{% endblock %}
{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous">
<link rel="stylesheet" href="{{ asset('css/pages/route-compare.css') }}">
<link rel="stylesheet" href="{{ asset('css/pages/route-compare-kpis.css') }}">
<link rel="stylesheet" href="{{ asset('css/pages/route-compare-alerts.css') }}">
{% endblock %}
{% block content %}
<div class="rc-page" data-route-compare data-rc-locale="{{ app.request.locale }}"><div class="rc-container">
<nav class="rc-breadcrumb"><a href="{{ path('routes_index') }}">{{ 'Rotas'|trans({}, 'route_compare') }}</a><span>/</span><span>{{ 'Comparar'|trans({}, 'route_compare') }}</span></nav>
<header class="rc-header"><div class="rc-header__top"><h1>{{ 'Comparar rotas'|trans({}, 'route_compare') }}</h1><p>Compare atraso relativo e duração total separadamente.</p></div>
<form method="get" action="{{ path('routes_compare') }}" class="rc-picker" data-rc-form>
<input type="hidden" name="bucket" value="10">
<input type="hidden" name="hours" value="{{ hours }}">
{% for side in ['a', 'b'] %}<div class="rc-picker__field"><label for="rc-route-{{ side }}" class="rc-picker__label rc-picker__label--{{ side }}">Rota {{ side|upper }}</label><select id="rc-route-{{ side }}" name="{{ side }}" data-rc-select-{{ side }} required><option value="">— Selecione —</option>{% for r in routes %}<option value="{{ r.id }}" {{ (side == 'a' ? aId : bId) == r.id ? 'selected' : '' }}>{{ r.name }}{% if r.from and r.to %} · {{ r.from }} → {{ r.to }}{% endif %}</option>{% endfor %}</select></div>{% if side == 'a' %}<div class="rc-picker__vs">VS</div>{% endif %}{% endfor %}
<div class="rc-picker__actions"><button type="button" class="rc-icon-btn" data-rc-swap aria-label="Inverter A e B">⇄</button><button class="rc-button rc-button--primary" type="submit">Comparar</button></div></form></header>
{% if compare is null %}<section class="rc-empty"><strong>Selecione duas rotas diferentes para comparar.</strong></section>{% else %}
{% set a = compare.a %}{% set b = compare.b %}{% set decimal = app.request.locale == 'en' ? '.' : ',' %}
{% set ratioA = a.stats.avgRatio7d %}{% set ratioB = b.stats.avgRatio7d %}
{% set overall = ratioA is null or ratioB is null ? null : (((ratioA - ratioB)|abs < 0.02) ? 'tie' : (ratioA < ratioB ? 'a' : 'b')) %}
<section class="rc-verdict rc-verdict--{{ overall in ['a', 'b'] ? overall : 'tie' }}"><div class="rc-verdict__text"><strong>{% if overall is null %}Sem dados suficientes em 7 dias{% elseif overall == 'tie' %}Empate técnico em atraso relativo · 7 dias{% else %}Rota {{ overall|upper }} com menor atraso relativo · 7 dias{% endif %}</strong><span>{% if overall is not null %}Diferença: {{ ((ratioA - ratioB)|abs * 100)|number_format(1, decimal, '') }} p.p. · Empate técnico quando a diferença é menor que 2,0 p.p.{% endif %} Menor atraso não significa necessariamente menor tempo total.</span></div></section>
<section class="rc-vs">
{% for side, route in {a: a, b: b} %}
<article class="rc-vs__card rc-vs__card--{{ side }}"><header class="rc-vs__head"><span class="rc-vs__badge-label">Rota {{ side|upper }}</span><span class="rc-vs__status rc-vs__status--tie">Atraso sobre histórico</span></header><h2 class="rc-vs__name">{{ route.name }}</h2><p class="rc-vs__path">{{ route.from ?: '—' }} → {{ route.to ?: '—' }}{% if route.lengthMeters %} · {{ (route.lengthMeters / 1000)|number_format(1, decimal, '') }} km{% endif %}</p>
<div class="rc-vs__current"><span class="rc-vs__current-label">Atraso na última coleta</span><div class="rc-vs__current-row"><strong class="rc-vs__current-value">{{ ui.duration(route.current ? route.current.delaySeconds : null) }}</strong><span class="rc-vs__current-ratio">{{ route.current and route.current.delayRatio is not null ? (route.current.delayRatio * 100)|number_format(1, decimal, '') ~ '%' : '—' }}</span></div>
<dl class="rc-kpi-details"><div><dt>Tempo total</dt><dd>{{ route.current and route.current.time is not null ? (route.current.time / 60)|number_format(1, decimal, '') ~ ' min' : '—' }}</dd></div><div><dt>Tempo histórico</dt><dd>{{ route.current and route.current.historicTime is not null ? (route.current.historicTime / 60)|number_format(1, decimal, '') ~ ' min' : '—' }}</dd></div></dl>
<small class="rc-vs__current-hint">Última coleta: {{ route.current ? route.current.recordedAt : 'sem dados' }} · horário conforme registrado na origem.</small></div></article>
{% if side == 'a' %}<div class="rc-vs__center"><span class="rc-vs__center-title">VS</span><small>Atraso ≠ duração</small></div>{% endif %}
{% endfor %}</section>
{% if a.current and b.current and a.current.delaySeconds is not null and b.current.delaySeconds is not null %}<p class="rc-kpi-summary">{% set gap = a.current.delaySeconds - b.current.delaySeconds %}{% if gap == 0 %}Mesmo atraso nas últimas coletas.{% else %}Rota {{ gap > 0 ? 'B' : 'A' }} com {{ ui.duration(gap|abs)|trim('+') }} menos atraso nas últimas coletas.{% endif %} As coletas podem ter horários diferentes; isso não é uma estimativa de economia de viagem.</p>{% endif %}
<section class="rc-compare"><header class="rc-compare__head"><span>Métrica</span><span class="rc-compare__col-name rc-compare__col-name--a">{{ a.name }}</span><span class="rc-compare__col-name rc-compare__col-name--b">{{ b.name }}</span></header>
{% set rows = [ {label: 'Atraso atual', x: a.current ? a.current.delaySeconds : null, y: b.current ? b.current.delaySeconds : null, pct: false}, {label: 'Atraso médio · 24h', x: a.stats.avgDelay24h, y: b.stats.avgDelay24h, pct: false}, {label: 'Atraso médio · 7 dias', x: a.stats.avgDelay7d, y: b.stats.avgDelay7d, pct: false}, {label: 'Atraso relativo · 7 dias', x: ratioA, y: ratioB, pct: true} ] %}
{% for row in rows %}{% set valid = row.x is not null and row.y is not null %}{% set tie = valid and (row.pct ? (row.x - row.y)|abs < 0.02 : row.x|round(0) == row.y|round(0)) %}<div class="rc-compare__row"><span class="rc-compare__col-label">{{ row.label }}</span>{% for value in [row.x, row.y] %}{% set win = valid and not tie and (loop.first ? row.x < row.y : row.y < row.x) %}<span class="rc-compare__col-val {{ valid and not tie ? (win ? 'is-win' : 'is-lose') : '' }}">{% if value is null %}—{% elseif row.pct %}{{ (value * 100)|number_format(1, decimal, '') }}%{% else %}{{ ui.duration(value) }}{% endif %}{% if tie %}<small>empate{% if row.pct %} técnico{% endif %}</small>{% endif %}</span>{% endfor %}</div>{% endfor %}
{% for key, label in {worstHour: 'Pior hora · 30 dias', worstDow: 'Pior dia · 30 dias'} %}<div class="rc-compare__row"><span class="rc-compare__col-label">{{ label }}</span>{% for route in [a, b] %}{% set worst = attribute(route.stats, key) %}<span class="rc-compare__col-val">{% if worst %}{{ key == 'worstHour' ? '%02d'|format(worst.hour) ~ 'h' : ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom'][worst.dow] }} · {{ (worst.avgRatio * 100)|number_format(1, decimal, '') }}%{% else %}—{% endif %}</span>{% endfor %}</div>{% endfor %}</section>
<section class="rc-panel"><header class="rc-panel__header"><h2>Mapa comparativo</h2><div class="rc-panel__legend"><span><i class="rc-dot rc-dot--a"></i>{{ a.name }}</span><span><i class="rc-dot rc-dot--b"></i>{{ b.name }}</span></div></header><div class="rc-map" data-rc-map data-rc-a="{{ a.geometry|json_encode|e('html_attr') }}" data-rc-b="{{ b.geometry|json_encode|e('html_attr') }}" data-rc-segments-a="{{ a.geometrySegments|default([])|json_encode|e('html_attr') }}" data-rc-segments-b="{{ b.geometrySegments|default([])|json_encode|e('html_attr') }}"></div><p class="rc-panel__hint">Traçados cadastrados, desenhados por segmento. Não são criadas ligações entre trechos separados; este mapa não calcula novas rotas.</p></section>
<section class="rc-panel"><header class="rc-panel__header"><h2>Diferença de atraso relativo · dia × hora</h2></header><div class="rc-heatmap-scroll"><div class="rc-heatmap" data-rc-heatmap data-rc-heatmap-data="{{ compare.heatmapDiff|json_encode|e('html_attr') }}"></div></div><p class="rc-panel__hint">30 dias · Verde: A com menor atraso relativo; vermelho: B. Neutro: diferença menor que 2,0 p.p. Sem dados não equivale a zero.</p></section>
{% for kind, title in {'rc-timeline': 'Evolução do atraso · médias a cada 10 minutos', 'rc-by-hour': 'Perfil histórico por hora · 30 dias', 'rc-by-dow': 'Perfil histórico por dia da semana · 30 dias'} %}<section class="rc-panel"><header class="rc-panel__header"><h2>{{ title }}</h2>{% if kind == 'rc-timeline' %}<small>Janela: {{ compare.timelineHours }}h · intervalos de {{ compare.timelineBucketMinutes }} min</small>{% endif %}</header><div class="rc-chart-wrap"><canvas data-chart="{{ kind }}" role="img" aria-label="{{ title }}" data-chart-data="{{ (kind == 'rc-timeline' ? compare.timeline : (kind == 'rc-by-hour' ? compare.byHour : compare.byDow))|json_encode|e('html_attr') }}"></canvas></div>{% if kind == 'rc-timeline' %}<p class="rc-panel__hint">Linhas A e B: média das amostras de cada intervalo de 10 minutos. O eixo pode omitir rótulos para facilitar a leitura; os pontos mantêm a granularidade de 10 minutos. Intervalos sem amostras não são considerados atraso zero.</p>{% endif %}</section>{% endfor %}
<section class="rc-panel"><h2>Trechos compartilhados</h2><div class="rc-common">{% for item in compare.commonSubRoutes %}<article class="rc-common__item"><strong>{{ item.a.name }}</strong><p>{{ item.a.from }} → {{ item.a.to }}</p><div class="rc-common__grid">{% for side, sub in {a: item.a, b: item.b} %}<div class="rc-common__side rc-common__side--{{ side }}">Rota {{ side|upper }}: {{ ui.duration(sub.delaySeconds) }}</div>{% endfor %}</div></article>{% else %}<p>Sem trechos coincidentes identificados.</p>{% endfor %}</div></section>
<section class="rc-panel"><header class="rc-panel__header"><h2>Alertas Waze · 7 dias · até 60 m do traçado</h2></header><p class="rc-panel__hint">Role dentro de cada lista. Clique em um alerta para abrir seus detalhes. Horários de coleta conforme registrados na origem.</p><div class="rc-alerts-grid">{% for key, label in {shared: 'Em ambas', onlyA: 'Só na rota A', onlyB: 'Só na rota B'} %}{% set alerts = attribute(compare.alerts, key) %}<section class="rc-alerts-col"><h3 id="rc-alert-heading-{{ key }}">{{ label }} <small>{{ alerts|length }} registros</small></h3><div class="rc-alert-list" role="region" aria-labelledby="rc-alert-heading-{{ key }}" tabindex="0">{% for alert in alerts %}<a class="rc-alert-link" href="{{ path('alert_show', {id: alert.id}) }}"><strong>{{ alert.typeLabel == 'Hazard' or alert.typeLabel == 'HAZARD' ? 'Risco na via' : alert.typeLabel }}</strong><small>{{ alert.street ?: 'Via não informada' }} · {{ alert.city ?: 'Cidade não informada' }}</small><time>{{ alert.collectedAt }}</time><span class="rc-alert-link__action">Ver detalhes do alerta →</span></a>{% else %}<p>Nenhum alerta encontrado.</p>{% endfor %}</div></section>{% endfor %}</div></section>
{% endif %}</div></div>
{% endblock %}
{% block javascripts %}{{ parent() }}<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="anonymous" defer></script><script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js" defer></script><script type="module" src="{{ asset('js/pages/route-compare.js') }}"></script>{% endblock %}
