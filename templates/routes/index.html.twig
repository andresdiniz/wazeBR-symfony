{% extends 'layouts/dashboard.html.twig' %}

{% block title %}{{ 'Rotas'|trans({}, 'routes_ui') }} | WazeBR{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous" />
    <link rel="stylesheet" href="{{ asset('css/pages/routes.css') }}">
    <link rel="stylesheet" href="{{ asset('css/pages/routes-enhancements.css') }}">
    <link rel="stylesheet" href="{{ asset('css/pages/routes-overview.css') }}">
{% endblock %}

{% block content %}
<div data-routes-i18n="{{ routes_i18n()|json_encode|e('html_attr') }}" hidden></div>
{% set total = stats.total|default(0) %}
{% set delayed = stats.delayed|default(0) %}
{% set severe = stats.severe|default(0) %}
{% set heavy = stats.heavy|default(0) %}
{% set avgDelay = stats.avgDelaySeconds|default(0) %}
{% set avgPct = stats.avgDelayPercent|default(0) %}

<div class="routes-page" data-routes-page>

    <div class="routes-container">

        <header class="routes-page-header">
            <div>
                <span class="routes-eyebrow"><i></i> {{ 'Monitoramento de rotas'|trans({}, 'routes_ui') }}</span>
                <h1>{{ 'Rotas Monitoradas'|trans({}, 'routes_ui') }}</h1>
                <p>
                    {{ 'Atraso'|trans({}, 'routes_ui') }} por {{ 'rota'|trans({}, 'routes_ui') }}, congestionamento por trecho e irregularidades.
                    {% if partner %} — <strong>{{ partner.name }}</strong>{% endif %}
                </p>
            </div>
            <div class="routes-header-tools">
                <a href="{{ path('routes_compare') }}" class="routes-button">
                    ⇄ {{ 'Comparar rotas'|trans({}, 'routes_ui') }}
                </a>
                <span class="routes-last-update">
                    <i></i> {{ 'Atualizado em'|trans({}, 'routes_ui') }}
                    <time data-routes-clock>{{ "now"|date('d/m H:i') }}</time>
                </span>
                <button type="button" class="routes-button" data-action="refresh-routes">
                    <span>↻</span> {{ 'Atualizar'|trans({}, 'routes_ui') }}
                </button>
            </div>
        </header>

        <section class="routes-stats-grid" aria-label="{{ 'Indicadores de rotas'|trans({}, 'routes_ui') }}">
            <article class="routes-stat">
                <span class="routes-stat-icon">⇉</span>
                <strong class="routes-stat-value" data-stat="total">{{ total }}</strong>
                <span class="routes-stat-label">{{ 'Rotas monitoradas'|trans({}, 'routes_ui') }}</span>
            </article>
            <article class="routes-stat routes-stat--warning">
                <span class="routes-stat-icon">⏱</span>
                <strong class="routes-stat-value" data-stat="delayed">{{ delayed }}</strong>
                <span class="routes-stat-label">{{ 'Com atraso'|trans({}, 'routes_ui') }}</span>
            </article>
            <article class="routes-stat routes-stat--danger">
                <span class="routes-stat-icon">⚠</span>
                <strong class="routes-stat-value" data-stat="severe">{{ severe }}</strong>
                <span class="routes-stat-label">{{ 'Críticas'|trans({}, 'routes_ui') }}</span>
                <small data-stat="heavy-label">{{ heavy }} {{ 'alto'|trans({}, 'routes_ui') }}{{ heavy != 1 ? 's' : '' }}</small>
            </article>
            <article class="routes-stat routes-stat--info">
                <span class="routes-stat-icon">Σ</span>
                <strong class="routes-stat-value" data-stat="avg-delay">
                    {{ avgDelay }}<small>s</small>
                </strong>
                <span class="routes-stat-label">{{ 'Atraso médio'|trans({}, 'routes_ui') }}</span>
                <small>{{ (avgPct * 100)|round(0) }}{{ '% acima do histórico'|trans({}, 'routes_ui') }}</small>
            </article>
        </section>

        <section class="routes-filter-panel" aria-label="{{ 'Filtros de rotas'|trans({}, 'routes_ui') }}">
            <form class="routes-filter-form" data-routes-filter-form>
                <label class="routes-filter-field routes-filter-field--grow">
                    <span>{{ 'Buscar'|trans({}, 'routes_ui') }}</span>
                    <input type="search" name="q" data-routes-search
                           value="{{ filters.query }}"
                           placeholder="{{ 'Nome, origem, destino ou cidade...'|trans({}, 'routes_ui') }}"
                           autocomplete="off">
                </label>

                <label class="routes-filter-field">
                    <span>{{ 'Nível de atraso'|trans({}, 'routes_ui') }}</span>
                    <select name="level" data-routes-level>
                        <option value="all"      {{ filters.level == 'all'      ? 'selected' }}>{{ 'Todos'|trans({}, 'routes_ui') }}</option>
                        <option value="severe"   {{ filters.level == 'severe'   ? 'selected' }}>{{ 'Crítico'|trans({}, 'routes_ui') }}</option>
                        <option value="heavy"    {{ filters.level == 'heavy'    ? 'selected' }}>{{ 'Alto'|trans({}, 'routes_ui') }}</option>
                        <option value="moderate" {{ filters.level == 'moderate' ? 'selected' }}>{{ 'Moderado'|trans({}, 'routes_ui') }}</option>
                        <option value="light"    {{ filters.level == 'light'    ? 'selected' }}>{{ 'Leve'|trans({}, 'routes_ui') }}</option>
                        <option value="none"     {{ filters.level == 'none'     ? 'selected' }}>{{ 'No prazo'|trans({}, 'routes_ui') }}</option>
                    </select>
                </label>

                <div class="routes-filter-actions">
                    <button type="button" class="routes-button routes-button--link" data-routes-clear>
                        {{ 'Limpar'|trans({}, 'routes_ui') }}
                    </button>
                </div>
            </form>

            <p class="routes-filter-feedback" data-routes-feedback role="status" aria-live="polite"></p>
        </section>

        <section class="routes-overview" data-routes-overview
                 data-overview-url="{{ path('routes_api_data') }}">
            <header class="routes-overview-header">
                <div>
                    <span class="routes-overview-kicker">{{ 'Central de rotas'|trans({}, 'routes_ui') }}</span>
                    <h2>{{ 'Situação agora'|trans({}, 'routes_ui') }}</h2>
                </div>
                <span class="routes-overview-updated">
                    <i></i>
                    {{ 'Atualizado em'|trans({}, 'routes_ui') }}
                    <time data-overview-clock>{{ "now"|date('H:i') }}</time>
                </span>
            </header>

            <div class="routes-overview-grid" data-overview-grid>
                {% for route in overview.routes %}
                    {% set incidentCount = route.incidentCount|default(0) %}
                    <article class="route-card route-card--{{ route.statusClass }}"
                             data-route-card
                             data-route-id="{{ route.id }}"
                             data-route-status="{{ route.statusClass }}">
                        <header class="route-card-header">
                            <div class="route-card-title">
                                <strong>{{ route.name }}</strong>
                                <small>
                                    {% if route.from and route.to %}
                                        {{ route.from }} → {{ route.to }}
                                    {% elseif route.city %}
                                        {{ route.city }}
                                    {% endif %}
                                </small>
                            </div>
                            <span class="route-card-badge route-card-badge--{{ route.statusClass }}">
                                {{ route.statusLabel }}
                            </span>
                        </header>

                        <div class="route-card-metrics">
                            <div class="route-card-metric">
                                <span>{{ 'Tempo estimado'|trans({}, 'routes_ui') }}</span>
                                <strong data-route-time-value>{{ route.timeLabel|default('—') }}</strong>
                            </div>
                            <div class="route-card-metric">
                                <span>{{ 'vs. habitual'|trans({}, 'routes_ui') }}</span>
                                <strong data-route-delay-value>{{ route.delayLabel|default('—') }}</strong>
                                {% if route.delayPercent %}
                                    <small data-route-delay-percent-value>{{ route.delayPercent }}</small>
                                {% endif %}
                            </div>
                        </div>

                        <div class="route-card-incidents">
                            {% if route.incidents|length > 0 %}
                                <span class="route-card-incidents-title">{{ 'Últimos incidentes'|trans({}, 'routes_ui') }}</span>
                                <ul>
                                    {% for incident in route.incidents %}
                                        <li>
                                            <strong>{{ incident.type|default('Incidente') }}</strong>
                                            <span>{{ incident.street|default(incident.city|default('Local não informado')) }}</span>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                <span class="route-card-incidents-empty">{{ 'Sem incidentes recentes'|trans({}, 'routes_ui') }}</span>
                            {% endif %}
                        </div>

                        <div class="route-card-map-wrapper">
                            <svg class="route-card-map"
                                 data-route-mini-map
                                 data-route-path="{{ route.miniMapPath|json_encode|e('html_attr') }}"
                                 data-route-incidents="{{ route.incidents|json_encode|e('html_attr') }}"
                                 viewBox="0 0 240 110"
                                 role="img"
                                 aria-label="{{ 'Mini-mapa da rota'|trans({}, 'routes_ui') }}">
                            </svg>
                        </div>

                        <footer class="route-card-footer">
                            <a href="{{ path('routes_show', { id: route.id }) }}" class="route-card-action">
                                {{ 'Ver detalhes'|trans({}, 'routes_ui') }}
                            </a>
                            <span class="route-card-incidents-count">
                                {{ incidentCount }} {{ 'incidente'|trans({}, 'routes_ui') }}{{ incidentCount != 1 ? 's' : '' }}
                            </span>
                        </footer>
                    </article>
                {% else %}
                    <div class="routes-overview-empty">
                        <strong>{{ 'Nenhuma rota monitorada'|trans({}, 'routes_ui') }}</strong>
                        <small>{{ 'Cadastre ou ative rotas para acompanhar a situação em tempo real.'|trans({}, 'routes_ui') }}</small>
                    </div>
                {% endfor %}
            </div>
        </section>

        <div class="routes-layout">

            <section class="routes-panel routes-list-panel">
                <header class="routes-panel-header">
                    <div>
                        <span class="routes-panel-kicker">{{ 'Ordenadas por atraso'|trans({}, 'routes_ui') }}</span>
                        <h2>{{ 'Rotas'|trans({}, 'routes_ui') }}</h2>
                    </div>
                    <span class="routes-panel-count" data-routes-count>
                        {{ routes|length }} {{ 'rota'|trans({}, 'routes_ui') }}{{ routes|length != 1 ? 's' : '' }}
                    </span>
                </header>

                <div class="routes-list" data-routes-list>
                    {% for route in routes %}
                        {% set lvl = route.delayLevel %}
                        <a href="{{ path('routes_show', { id: route.id }) }}"
                            class="routes-list-detail"
                            data-route-detail
                            aria-label="{{ 'Ver detalhes de'|trans({}, 'routes_ui') }} {{ route.name }}">
                                {{ 'Detalhes →'|trans({}, 'routes_ui') }}
                        </a>
                        <button type="button"
                                class="routes-list-item routes-list-item--{{ lvl }}"
                                data-route-id="{{ route.id }}"
                                data-route-name="{{ route.name }}"
                                data-route-level="{{ lvl }}"
                                data-route-delay="{{ route.delaySeconds|default(0) }}"
                                data-route-search="{{ (route.name ~ ' ' ~ (route.from|default('')) ~ ' ' ~ (route.to|default('')) ~ ' ' ~ (route.city|default(''))) |lower }}">
                            <span class="routes-list-marker routes-list-marker--{{ lvl }}"></span>

                            <span class="routes-list-body">
                                <strong class="routes-list-name">{{ route.name }}</strong>
                                <small class="routes-list-path">
                                    {% if route.from and route.to %}
                                        {{ route.from }} → {{ route.to }}
                                    {% elseif route.city %}
                                        {{ route.city }}
                                    {% else %}
                                        Sem trajeto detalhado
                                    {% endif %}
                                </small>
                                {% if route.irregularityCount > 0 %}
                                    <span class="routes-list-flag">
                                        ⚠ {{ route.irregularityCount }}
                                        irregularidade{{ route.irregularityCount != 1 ? 's' : '' }}
                                    </span>
                                {% endif %}
                            </span>

                            <span class="routes-list-delay">
                                {% if route.delaySeconds is not null and route.delaySeconds > 0 %}
                                    <strong>{{ (route.delayRatio * 100)|round(0) }}%</strong>
                                    <small>+{{ route.delaySeconds }}s</small>
                                {% elseif route.jamLevel is not null %}
                                    <strong>N{{ route.jamLevel }}</strong>
                                    <small>{{ 'jam'|trans({}, 'routes_ui') }}</small>
                                {% else %}
                                    <strong>—</strong>
                                    <small>{{ 'no prazo'|trans({}, 'routes_ui') }}</small>
                                {% endif %}
                            </span>
                        </button>
                    {% else %}
                        <div class="routes-empty">
                            <span aria-hidden="true">✓</span>
                            <strong>{{ 'Nenhuma rota encontrada'|trans({}, 'routes_ui') }}</strong>
                            <small>{{ 'Ajuste os filtros ou verifique as fontes.'|trans({}, 'routes_ui') }}</small>
                        </div>
                    {% endfor %}
                </div>
            </section>

            <section class="routes-panel routes-map-panel">
                <header class="routes-panel-header">
                    <div>
                        <span class="routes-panel-kicker">{{ 'Geolocalização'|trans({}, 'routes_ui') }}</span>
                        <h2>{{ 'Mapa de congestionamento'|trans({}, 'routes_ui') }}</h2>
                    </div>
                    <div class="routes-map-legend" aria-label="{{ 'Legenda'|trans({}, 'routes_ui') }}">
                        <span class="routes-legend-item"><i class="routes-legend-dot routes-legend-dot--none"></i>{{ 'No prazo'|trans({}, 'routes_ui') }}</span>
                        <span class="routes-legend-item"><i class="routes-legend-dot routes-legend-dot--light"></i>{{ 'Leve'|trans({}, 'routes_ui') }}</span>
                        <span class="routes-legend-item"><i class="routes-legend-dot routes-legend-dot--moderate"></i>{{ 'Moderado'|trans({}, 'routes_ui') }}</span>
                        <span class="routes-legend-item"><i class="routes-legend-dot routes-legend-dot--heavy"></i>{{ 'Alto'|trans({}, 'routes_ui') }}</span>
                        <span class="routes-legend-item"><i class="routes-legend-dot routes-legend-dot--severe"></i>{{ 'Crítico'|trans({}, 'routes_ui') }}</span>
                    </div>
                </header>

                <div class="routes-map"
                     data-routes-map
                     data-routes-map-center='{{ map.center|json_encode|e('html_attr') }}'></div>
            </section>
        </div>

    </div>

    <script type="application/json" data-routes-payload>
        {{ map|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}
    </script>

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="{{ asset('js/routes-overview.js') }}" defer></script>
{% endblock %}
