{% extends 'layouts/dashboard.html.twig' %}

{% block title %}{{ alerts_label(alert.type) }} · {{ 'Alerta'|trans({}, 'alerts_ui') }} #{{ alert.id }} | WazeBR{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous" />
    <link rel="stylesheet" href="{{ asset('css/pages/alerts-show.css') }}">
{% endblock %}

{% block content %}
<div data-alerts-i18n="{{ alerts_i18n()|json_encode|e('html_attr') }}" hidden></div>
    {% set alertJson = {
        'id':         alert.id,
        'type':       alert.type,
        'subtype':    alert.subtype,
        'city':       alert.city,
        'street':     alert.street,
        'lat':        alert.latitude,
        'lng':        alert.longitude,
        'confidence': alert.confidence,
        'when':       alert.collectedAt ? alert.collectedAt|date('c') : null,
        'pubMillis':  alert.pubMillis,
    } %}

    <div class="alert-show-page"
         data-alert-show
         data-alert='{{ alertJson|json_encode|e('html_attr') }}'>

        <div class="alert-show-container">

            <nav class="alert-show-breadcrumb" aria-label="{{ 'Navegação'|trans({}, 'alerts_ui') }}">
                <a href="{{ path('alert_index') }}" class="alert-show-back">
                    <span aria-hidden="true">←</span> {{ 'Voltar para alertas'|trans({}, 'alerts_ui') }}
                </a>
            </nav>

            <header class="alert-show-header">
                <div>
                    <div class="alert-show-header-top">
                        <span class="alert-show-badge alert-show-badge--{{ alert.type|lower }}">
                            {{ alerts_label(alert.type) }}
                        </span>
                        <span class="alert-show-status alert-show-status--{{ alert.isActive ? 'active' : 'inactive' }}">
                            {{ alert.isActive ? ('Ativo'|trans({}, 'alerts_ui')) : ('Encerrado'|trans({}, 'alerts_ui')) }}
                        </span>
                        <span class="alert-show-id">#{{ alert.id }}</span>
                    </div>
                    <h1>{{ alerts_label(alert.subtype, 'Alerta Waze'|trans({}, 'alerts_ui')) }}</h1>
                    <p class="alert-show-subtitle">
                        {{ alert.street|default(('Rua não informada'|trans({}, 'alerts_ui'))) }}
                        {% if alert.city %} · {{ alert.city }}{% endif %}
                        {% if alert.country %} · {{ alert.country }}{% endif %}
                    </p>
                </div>
                <div class="alert-show-header-actions">
                    {% if alert.latitude and alert.longitude %}
                        <a class="alert-show-button is-primary"
                           target="_blank" rel="noopener"
                           href="https://www.waze.com/pt-BR/live-map/?lat={{ alert.latitude }}&lng={{ alert.longitude }}&zoom=17">
                            ↗ {{ 'Ver no Waze'|trans({}, 'alerts_ui') }}
                        </a>
                        <a class="alert-show-button"
                           target="_blank" rel="noopener"
                           href="https://www.openstreetmap.org/?mlat={{ alert.latitude }}&mlon={{ alert.longitude }}#map=17/{{ alert.latitude }}/{{ alert.longitude }}">
                            ↗ {{ 'OpenStreetMap'|trans({}, 'alerts_ui') }}
                        </a>
                    {% endif %}
                </div>
            </header>

            <div class="alert-show-grid">

                {# Mapa #}
                <section class="alert-show-panel alert-show-map-panel">
                    <header class="alert-show-panel-header">
                        <div>
                            <span class="alert-show-kicker">{{ 'Localização'|trans({}, 'alerts_ui') }}</span>
                            <h2>{{ 'Onde foi registrado'|trans({}, 'alerts_ui') }}</h2>
                        </div>
                        <span class="alert-show-coords">
                            {{ alert.latitude|default('—') }}, {{ alert.longitude|default('—') }}
                        </span>
                    </header>
                    <div class="alert-show-map" data-alert-show-map></div>
                </section>

                {# Detalhes técnicos #}
                <aside class="alert-show-panel alert-show-details">
                    <header class="alert-show-panel-header">
                        <div>
                            <span class="alert-show-kicker">{{ 'Dados'|trans({}, 'alerts_ui') }}</span>
                            <h2>{{ 'Detalhes do alerta'|trans({}, 'alerts_ui') }}</h2>
                        </div>
                    </header>

                    <dl class="alert-show-list">
                        <div><dt>{{ 'Tipo'|trans({}, 'alerts_ui') }}</dt>        <dd>{{ alerts_label(alert.type) }}</dd></div>
                        <div><dt>{{ 'Subtipo'|trans({}, 'alerts_ui') }}</dt>     <dd>{{ alerts_label(alert.subtype) }}</dd></div>
                        <div><dt>{{ 'Confiança'|trans({}, 'alerts_ui') }}</dt>   <dd>{{ alert.confidence }}</dd></div>
                        <div><dt>{{ 'Confiabilidade'|trans({}, 'alerts_ui') }}</dt><dd>{{ alert.reliability }}</dd></div>
                        <div><dt>{{ 'Rating do report'|trans({}, 'alerts_ui') }}</dt><dd>{{ alert.reportRating }}</dd></div>
                        <div><dt>{{ 'Thumbs up'|trans({}, 'alerts_ui') }}</dt>   <dd>{{ alert.nThumbsUp }}</dd></div>
                        <div><dt>{{ 'Road type'|trans({}, 'alerts_ui') }}</dt>   <dd>{{ alert.roadType }}</dd></div>
                        <div><dt>{{ 'Magvar'|trans({}, 'alerts_ui') }}</dt>      <dd>{{ alert.magvar }}°</dd></div>
                        <div><dt>{{ 'Reportado por município'|trans({}, 'alerts_ui') }}</dt><dd>{{ alert.reportByMunicipalityUser ? ('Sim'|trans({}, 'alerts_ui')) : ('Não'|trans({}, 'alerts_ui')) }}</dd></div>
                        <div><dt>{{ 'País'|trans({}, 'alerts_ui') }}</dt>        <dd>{{ alert.country|default('—') }}</dd></div>
                    </dl>
                </aside>

                {# Timeline #}
                <section class="alert-show-panel">
                    <header class="alert-show-panel-header">
                        <div>
                            <span class="alert-show-kicker">{{ 'Linha do tempo'|trans({}, 'alerts_ui') }}</span>
                            <h2>{{ 'Quando aconteceu'|trans({}, 'alerts_ui') }}</h2>
                        </div>
                    </header>

                    <dl class="alert-show-list">
                        <div>
                            <dt>{{ 'Publicado pela Waze'|trans({}, 'alerts_ui') }}</dt>
                            <dd>
                                {% if alert.pubDateTime %}
                                    {{ alerts_date(alert.pubDateTime, true, true) }}
                                    <small>{{ alert.pubMillis }} {{ 'ms (epoch)'|trans({}, 'alerts_ui') }}</small>
                                {% else %}—{% endif %}
                            </dd>
                        </div>
                        <div>
                            <dt>{{ 'Coletado em (Horario de São Paulo)'|trans({}, 'alerts_ui') }}</dt>
                            <dd>
                                {% if alert.collectedAt %}
                                    {{ alerts_date(alert.collectedAt, true, true) }}
                                    <small>{{ alert.collectedAt|date('c', 'America/Sao_Paulo') }}</small>
                                {% else %}—{% endif %}
                            </dd>
                        </div>
                        <div>
                            <dt>{{ 'Última vez visto (Horario de São Paulo)'|trans({}, 'alerts_ui') }}</dt>
                            <dd>
                                {% if alert.lastSeenAt %}
                                    {{ alerts_date(alert.lastSeenAt, true, true) }}
                                {% else %}—{% endif %}
                            </dd>
                        </div>
                        <div>
                            <dt>{{ 'Desativado em (Horario de São Paulo)'|trans({}, 'alerts_ui') }}</dt>
                            <dd>
                                {% if alert.deactivatedAt %}
                                    {{ alerts_date(alert.deactivatedAt, true, true) }}
                                {% else %}—{% endif %}
                            </dd>
                        </div>
                    </dl>
                </section>

                {# Endereço #}
                <section class="alert-show-panel">
                    <header class="alert-show-panel-header">
                        <div>
                            <span class="alert-show-kicker">{{ 'Endereço'|trans({}, 'alerts_ui') }}</span>
                            <h2>{{ 'Local textual'|trans({}, 'alerts_ui') }}</h2>
                        </div>
                    </header>

                    <dl class="alert-show-list">
                        <div><dt>{{ 'Rua'|trans({}, 'alerts_ui') }}</dt>      <dd>{{ alert.street|default('—') }}</dd></div>
                        <div><dt>{{ 'Cidade'|trans({}, 'alerts_ui') }}</dt>   <dd>{{ alert.city|default('—') }}</dd></div>
                        <div><dt>{{ 'Latitude'|trans({}, 'alerts_ui') }}</dt> <dd>{{ alert.latitude|default('—') }}</dd></div>
                        <div><dt>{{ 'Longitude'|trans({}, 'alerts_ui') }}</dt><dd>{{ alert.longitude|default('—') }}</dd></div>
                    </dl>
                </section>

                {# IDs #}
                <section class="alert-show-panel">
                    <header class="alert-show-panel-header">
                        <div>
                            <span class="alert-show-kicker">{{ 'Identificadores'|trans({}, 'alerts_ui') }}</span>
                            <h2>{{ 'Chaves internas'|trans({}, 'alerts_ui') }}</h2>
                        </div>
                    </header>

                    <dl class="alert-show-list">
                        <div>
                            <dt>{{ 'UUID'|trans({}, 'alerts_ui') }}</dt>
                            <dd class="alert-show-mono">{{ alert.uuid|default('—') }}</dd>
                        </div>
                        <div>
                            <dt>{{ 'Partner'|trans({}, 'alerts_ui') }}</dt>
                            <dd>{{ alert.partner ? alert.partner.name : '—' }}</dd>
                        </div>
                    </dl>
                </section>

                {% if alert.reportDescription %}
                    <section class="alert-show-panel alert-show-panel--wide">
                        <header class="alert-show-panel-header">
                            <div>
                                <span class="alert-show-kicker">{{ 'Descrição'|trans({}, 'alerts_ui') }}</span>
                                <h2>{{ 'Report enviado pela Waze'|trans({}, 'alerts_ui') }}</h2>
                            </div>
                        </header>
                        <p class="alert-show-description">{{ alert.reportDescription }}</p>
                    </section>
                {% endif %}

            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script type="module" src="{{ asset('js/pages/alerts-show.js') }}"></script>
{% endblock %}
