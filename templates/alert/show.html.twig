{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Detalhes do Alerta{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/alerts.css') }}">
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-3">Detalhes do Alerta</h1>
            <a href="{{ path('alert_index') }}" class="btn btn-sm btn-secondary mb-3">Voltar</a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h5>Tipo</h5>
                    <p>{{ alert.type }}</p>
                    
                    <h5>Subtipo</h5>
                    <p>{{ alert.subtype }}</p>
                    
                    <h5>Rua</h5>
                    <p>{{ alert.street }}</p>
                    
                    <h5>Cidade</h5>
                    <p>{{ alert.city }}</p>
                </div>
                <div class="col-md-6">
                    <h5>Estado</h5>
                    <p>{{ alert.state }}</p>
                    
                    <h5>Pa&iacute;s</h5>
                    <p>{{ alert.country }}</p>
                    
                    <h5>Magr&uave;</h5>
                    <p>{{ alert.magr }}</p>
                    
                    <h5>&Uacute;ltima Vez</h5>
                    <p>{{ alert.lastSeenAt|date('d/m/Y H:i:s') }}</p>
                </div>
            </div>
            
            <div class="row mt-4">
                <div class="col-md-6">
                    <h5>Latitude</h5>
                    <p>{{ alert.latitude }}</p>
                    
                    <h5>Longitude</h5>
                    <p>{{ alert.longitude }}</p>
                </div>
                <div class="col-md-6">
                    <h5>Reliabilidade</h5>
                    <p>{{ alert.reliability }}</p>
                    
                    <h5>Confian&ccedil;a</h5>
                    <p>{{ alert.confidence }}</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
