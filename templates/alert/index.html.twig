{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Alertas{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-3">Alertas</h1>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            {% if alerts|length > 0 %}
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Subtipo</th>
                            <th>Rua</th>
                            <th>Cidade</th>
                            <th>Data</th>
                            <th>Aç°µes</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for alert in alerts %}
                            <tr>
                                <td>{{ alert.type }}</td>
                                <td>{{ alert.subtype }}</td>
                                <td>{{ alert.street }}</td>
                                <td>{{ alert.city }}</td>
                                <td>{{ alert.lastSeenAt|date('d/m/Y H:i') }}</td>
                                <td>
                                    <a href="{{ path('alert_show', {id: alert.id}) }}" class="btn btn-sm btn-primary">Ver</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p class="text-muted mb-0">Nenhum alerta encontrado</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
