{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Alertas | wazeBR{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/alerts.css') }}">
{% endblock %}

{% block page_body_class %}alerts-page{% endblock %}

{% block dashboard_page_title %}Alertas{% endblock %}

{% block page_content %}
    <div class="dashboard-content alerts-content">
        {# ── Hero + Filtros ───────────────────────────────────── #}
        <section class="dashboard-hero">
            <div>
                <p class="dashboard-hero-kicker">Monitoramento</p>
                <h2>Alertas Waze</h2>
                <p>
                    Explore os alertas coletados do feed do Waze para o parceiro
                    <strong>{{ partner.name|default('Parceiro') }}</strong>.
                </p>
            </div>

            <div class="dashboard-hero-actions">
                <span class="badge badge-primary">
                    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                    {{ total }} alerta(s)
                </span>

                <a
                    href="{{ path('alert_export', app.request.query.all) }}"
                    class="btn btn-ghost"
                    title="Exportar CSV"
                >
                    <i class="fa-solid fa-download" aria-hidden="true"></i>
                    Exportar CSV
                </a>

                <a
                    href="{{ path('alert_live') }}"
                    class="btn btn-primary"
                >
                    <i class="fa-solid fa-broadcast-tower" aria-hidden="true"></i>
                    Ao vivo
                </a>
            </div>
        </section>

        {# ── Filtros ──────────────────────────────────────────── #}
        <section class="card dashboard-card">
            <header class="card-header">
                <div>
                    <h3>Filtros</h3>
                    <p>
                        Refine a lista de alertas por período, tipo, subtipo, cidade e rua.
                    </p>
                </div>
            </header>

            <div class="card-body">
                <form method="get" class="alerts-filters-form">
                    <div class="filters-grid">
                        {# Período #}
                        <div class="filter-group">
                            <label for="period">Período</label>
                            <select
                                id="period"
                                name="period"
                                class="form-control"
                                onchange="this.form.submit()"
                            >
                                <option value="">Período personalizado</option>

                                {% for key, preset in periods %}
                                    <option value="{{ key }}" {{ period == key ? 'selected' : '' }}>
                                        {{ preset.label }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        {# De / Até #}
                        <div class="filter-group">
                            <label for="dateFrom">De</label>
                            <input
                                type="date"
                                id="dateFrom"
                                name="dateFrom"
                                class="form-control"
                                value="{{ dateFrom ? dateFrom|date('Y-m-d') : '' }}"
                            />
                        </div>

                        <div class="filter-group">
                            <label for="dateTo">Até</label>
                            <input
                                type="date"
                                id="dateTo"
                                name="dateTo"
                                class="form-control"
                                value="{{ dateTo ? dateTo|date('Y-m-d') : '' }}"
                            />
                        </div>

                        {# Tipo #}
                        <div class="filter-group">
                            <label for="type">Tipo</label>
                            <select
                                id="type"
                                name="type"
                                class="form-control"
                                onchange="this.form.submit()"
                            >
                                <option value="">Todos os tipos</option>
                                {% for t in types %}
                                    <option value="{{ t }}" {{ type == t ? 'selected' : '' }}>
                                        {{ typesMap[t]|default(t) }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        {# Subtipo #}
                        <div class="filter-group">
                            <label for="subtype">Subtipo</label>
                            <select
                                id="subtype"
                                name="subtype"
                                class="form-control"
                                onchange="this.form.submit()"
                            >
                                <option value="">Todos os subtipos</option>
                                {% for s in subtypes %}
                                    <option value="{{ s }}" {{ subtype == s ? 'selected' : '' }}>
                                        {{ subtypesMap[type ~ '|' ~ s]|default(s) }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        {# Cidade #}
                        <div class="filter-group">
                            <label for="city">Cidade</label>
                            <select
                                id="city"
                                name="city"
                                class="form-control"
                                onchange="this.form.submit()"
                            >
                                <option value="">Todas as cidades</option>
                                {% for c in cities %}
                                    <option value="{{ c }}" {{ city == c ? 'selected' : '' }}>
                                        {{ c }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        {# Rua #}
                        <div class="filter-group">
                            <label for="street">Rua</label>
                            <select
                                id="street"
                                name="street"
                                class="form-control"
                                onchange="this.form.submit()"
                            >
                                <option value="">Todas as ruas</option>
                                {% for r in streets %}
                                    <option value="{{ r }}" {{ street == r ? 'selected' : '' }}>
                                        {{ r }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        {# Excluir rua #}
                        <div class="filter-group">
                            <label for="excludeStreet">Excluir rua</label>
                            <select
                                id="excludeStreet"
                                name="excludeStreet"
                                class="form-control"
                                onchange="this.form.submit()"
                            >
                                <option value="">Nenhuma exclusão</option>
                                {% for r in streets %}
                                    <option value="{{ r }}" {{ excludeStreet == r ? 'selected' : '' }}>
                                        {{ r }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    {% if type or subtype or city or street or excludeStreet or dateFrom or dateTo or period %}
                        <div class="filters-actions">
                            <a
                                href="{{ path('alert_index') }}"
                                class="btn btn-ghost btn-sm"
                            >
                                <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                                Limpar filtros
                            </a>
                        </div>
                    {% endif %}
                </form>
            </div>
        </section>

        {# ── Métricas ─────────────────────────────────────────── #}
        <section class="stats-grid alerts-stats">
            <article class="stat-card">
                <div class="stat-icon blue">
                    <i class="fa-solid fa-list" aria-hidden="true"></i>
                </div>

                <div class="stat-info">
                    <span>Total filtrado</span>
                    <strong>{{ total }}</strong>
                    <small>
                        Página {{ page }} de {{ pages }}
                    </small>
                </div>
            </article>

            <article class="stat-card">
                <div class="stat-icon purple">
                    <i class="fa-solid fa-chart-pie" aria-hidden="true"></i>
                </div>

                <div class="stat-info">
                    <span>Por subtipo</span>
                    <strong>{{ bySubtype|length }}</strong>
                    <small>Subtipos distintos</small>
                </div>
            </article>

            <article class="stat-card">
                <div class="stat-icon orange">
                    <i class="fa-solid fa-bullseye" aria-hidden="true"></i>
                </div>

                <div class="stat-info">
                    <span>Hotspots</span>
                    <strong>{{ hotspots|length }}</strong>
                    <small>Locais com maior incidência</small>
                </div>
            </article>

            <article class="stat-card">
                <div class="stat-icon green">
                    <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
                </div>

                <div class="stat-info">
                    <span>Mapa</span>
                    <strong>{{ mapAlerts|length }}</strong>
                    <small>Alertas para visualização</small>
                </div>
            </article>
        </section>

        {# ── Gráficos e painéis ──────────────────────────────── #}
        <section class="dashboard-grid">
            {# Distribuição por confiança #}
            <article class="card dashboard-card">
                <header class="card-header">
                    <div>
                        <h3>Confiabilidade</h3>
                        <p>Distribuição dos alertas por faixa de confiança.</p>
                    </div>
                </header>

                <div class="card-body">
                    <dl class="details-list details-list-single">
                        {% for range, count in byConfidence %}
                            <div>
                                <dt>{{ range }}</dt>
                                <dd>
                                    <span class="badge badge-secondary">
                                        {{ count }}
                                    </span>
                                </dd>
                            </div>
                        {% endfor %}
                    </dl>
                </div>
            </article>

            {# Top subtipos #}
            <article class="card dashboard-card">
                <header class="card-header">
                    <div>
                        <h3>Top subtipos</h3>
                        <p>Subtipos mais frequentes no período selecionado.</p>
                    </div>
                </header>

                <div class="card-body">
                    {% if bySubtype is not empty %}
                        <ul class="top-list">
                            {% for item in bySubtype %}
                                <li class="top-item">
                                    <span class="top-label">{{ item.label }}</span>
                                    <span class="top-value">
                                        <span class="badge badge-primary">
                                            {{ item.total }}
                                        </span>
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <div class="empty-state">
                            <span class="empty-state-icon">
                                <i class="fa-solid fa-chart-simple" aria-hidden="true"></i>
                            </span>
                            <h3>Sem dados</h3>
                            <p>Não há subtipos para os filtros aplicados.</p>
                        </div>
                    {% endif %}
                </div>
            </article>
        </section>

        <section class="dashboard-grid">
            {# Evolução por hora/dia #}
            <article class="card dashboard-card">
                <header class="card-header">
                    <div>
                        <h3>Evolução temporal</h3>
                        <p>
                            Série por
                            {{ trendType == 'hour' ? 'hora do dia' : 'dia' }}
                            no período selecionado.
                        </p>
                    </div>
                </header>

                <div class="card-body">
                    {% if byHourTrend is not empty %}
                        <div class="time-series-placeholder">
                            <i class="fa-solid fa-chart-line" aria-hidden="true"></i>
                            <p>
                                Gráfico de série temporal:
                                {% for point in byHourTrend %}
                                    {{ point.hour_label|default(point.label) }}:
                                    {{ point.total }}{% if not loop.last %}, {% endif %}
                                {% endfor %}
                            </p>
                        </div>
                    {% else %}
                        <div class="empty-state">
                            <span class="empty-state-icon">
                                <i class="fa-solid fa-chart-line" aria-hidden="true"></i>
                            </span>
                            <h3>Sem série temporal</h3>
                            <p>Não há dados para o período ou filtros aplicados.</p>
                        </div>
                    {% endif %}
                </div>
            </article>

            {# Top ruas #}
            <article class="card dashboard-card">
                <header class="card-header">
                    <div>
                        <h3>Top ruas</h3>
                        <p>Ruas com maior número de alertas no filtro atual.</p>
                    </div>
                </header>

                <div class="card-body">
                    {% if topStreets is not empty %}
                        <ul class="top-list">
                            {% for item in topStreets %}
                                <li class="top-item">
                                    <span class="top-label">{{ item.street }}</span>
                                    <span class="top-value">
                                        <span class="badge badge-secondary">
                                            {{ item.total }}
                                        </span>
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <div class="empty-state">
                            <span class="empty-state-icon">
                                <i class="fa-solid fa-road" aria-hidden="true"></i>
                            </span>
                            <h3>Sem ruas destacadas</h3>
                            <p>Não há ruas com volume relevante para este filtro.</p>
                        </div>
                    {% endif %}
                </div>
            </article>
        </section>

        {# ── Hotspots ─────────────────────────────────────────── #}
        <section class="card dashboard-card">
            <header class="card-header">
                <div>
                    <h3>Hotspots</h3>
                    <p>Locais com maior concentração de alertas.</p>
                </div>
            </header>

            <div class="card-body">
                {% if hotspots is not empty %}
                    <div class="hotspots-grid">
                        {% for hs in hotspots %}
                            <div class="hotspot-card">
                                <div class="hotspot-main">
                                    <strong>{{ hs.street|default('Localização') }}</strong>
                                    <small>{{ hs.city|default('Cidade não informada') }}</small>
                                </div>

                                <div class="hotspot-metrics">
                                    <span class="metric">
                                        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                                        {{ hs.total }}
                                    </span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="empty-state">
                        <span class="empty-state-icon">
                            <i class="fa-solid fa-fire" aria-hidden="true"></i>
                        </span>
                        <h3>Sem hotspots</h3>
                        <p>Não foram identificados hotspots para este filtro.</p>
                    </div>
                {% endif %}
            </div>
        </section>

        {# ── Mapa ────────────────────────────────────────────── #}
        <section class="card dashboard-card">
            <header class="card-header">
                <div>
                    <h3>Mapa de alertas</h3>
                    <p>
                        Visualização geográfica dos últimos
                        {{ mapAlerts|length }} alertas.
                    </p>
                </div>
            </header>

            <div class="card-body">
                {% if mapAlerts is not empty %}
                    <div class="map-placeholder">
                        <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
                        <p>
                            Mapa interativo com
                            {{ mapAlerts|length }} pontos.
                        </p>
                        <ul class="map-legend">
                            {% for alert in mapAlerts|slice(0, 5) %}
                                <li>
                                    <strong>{{ typesMap[alert.type]|default(alert.type) }}</strong>
                                    <small>
                                        {{ alert.street|default('Sem rua') }}
                                    </small>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% else %}
                    <div class="empty-state">
                        <span class="empty-state-icon">
                            <i class="fa-solid fa-map" aria-hidden="true"></i>
                        </span>
                        <h3>Sem pontos no mapa</h3>
                        <p>Não há alertas para exibir no mapa com os filtros atuais.</p>
                    </div>
                {% endif %}
            </div>
        </section>

        {# ── Lista de alertas ───────────────────────────────── #}
        <section class="card dashboard-card">
            <header class="card-header">
                <div>
                    <h3>Lista de alertas</h3>
                    <p>
                        Resultados paginados da consulta aplicada.
                    </p>
                </div>

                <div class="pagination-summary">
                    Página {{ page }} de {{ pages }}
                </div>
            </header>

            <div class="card-body">
                {% if alerts is not empty %}
                    <div class="admin-table-wrapper">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Tipo</th>
                                    <th>Subtipo</th>
                                    <th>Rua</th>
                                    <th>Cidade</th>
                                    <th>Publicado</th>
                                    <th>Confiança</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>

                            <tbody>
                                {% for alert in alerts %}
                                    <tr>
                                        <td>
                                            <span class="table-id">#{{ alert.id }}</span>
                                        </td>

                                        <td>
                                            <strong>
                                                {{ typesMap[alert.type]|default(alert.type) }}
                                            </strong>
                                        </td>

                                        <td>
                                            {{ subtypesMap[alert.type ~ '|' ~ alert.subtype]|default(alert.subtype|default('—')) }}
                                        </td>

                                        <td>
                                            <span class="table-location">
                                                {{ alert.street|default('Não informado') }}
                                            </span>
                                        </td>

                                        <td>
                                            {{ alert.city|default('Não informada') }}
                                        </td>

                                        <td>
                                            {% if alert.pubDate is defined and alert.pubDate %}
                                                {{ alert.pubDate|date('d/m/Y H:i') }}
                                            {% else %}
                                                —
                                            {% endif %}
                                        </td>

                                        <td>
                                            {% if alert.confidence is not null %}
                                                <span class="badge
                                                    {% if alert.confidence >= 7 %}
                                                        badge-success
                                                    {% elseif alert.confidence >= 4 %}
                                                        badge-warning
                                                    {% else %}
                                                        badge-danger
                                                    {% endif %}
                                                ">
                                                    {{ alert.confidence }}
                                                </span>
                                            {% else %}
                                                <span class="badge badge-muted">—</span>
                                            {% endif %}
                                        </td>

                                        <td class="admin-table-actions">
                                            <a
                                                href="{{ path('alert_show', { id: alert.id }) }}"
                                                class="btn btn-primary btn-sm"
                                            >
                                                <i class="fa-solid fa-eye" aria-hidden="true"></i>
                                                Ver
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {# Paginação simples #}
                    {% if pages > 1 %}
                        <nav class="pagination" aria-label="Paginação de alertas">
                            {% if page > 1 %}
                                <a
                                    href="{{ path('alert_index', app.request.query.all|merge({ page: page - 1 })) }}"
                                    class="btn btn-ghost btn-sm"
                                >
                                    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                                    Anterior
                                </a>
                            {% endif %}

                            {% if page < pages %}
                                <a
                                    href="{{ path('alert_index', app.request.query.all|merge({ page: page + 1 })) }}"
                                    class="btn btn-ghost btn-sm"
                                >
                                    Próxima
                                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                                </a>
                            {% endif %}
                        </nav>
                    {% endif %}
                {% else %}
                    <div class="empty-state">
                        <span class="empty-state-icon">
                            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                        </span>

                        <h3>Nenhum alerta encontrado</h3>
                        <p>
                            Não foram encontrados alertas para os filtros aplicados.
                        </p>

                        <a
                            href="{{ path('alert_index') }}"
                            class="btn btn-primary"
                        >
                            <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                            Limpar filtros
                        </a>
                    </div>
                {% endif %}
            </div>
        </section>
    </div>
{% endblock %}
