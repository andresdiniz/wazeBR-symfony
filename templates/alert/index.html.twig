{% extends 'base.html.twig' %}
{% block title %}Alertas — Análise histórica{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/alert.css') }}">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css">
{% endblock %}

{% block body %}
<div class="alerts-page">
  <div class="page-header">
    <div>
      <h1 class="page-title">📊 Análise histórica de alertas</h1>
      <p class="page-subtitle">{{ total|number_format(0, ',', '.') }} alerta(s) encontrado(s) com os filtros atuais</p>
    </div>
    <div class="alert-toolbar">
      <a href="{{ path('alert_export', app.request.query.all|filter((value, key) => key != 'page')) }}" class="alert-export-button btn btn-primary">
        <i class="bi bi-download"></i> Exportar CSV
      </a>
    </div>
  </div>

  <div class="btn-row" style="margin-bottom:1.25rem">
    {% for key, p in periods %}
      <a href="?{{ app.request.query.all|merge({period: key, dateFrom: null, dateTo: null, page: null})|url_encode }}" class="btn btn-sm {{ period == key and not dateFrom ? 'btn-primary' : 'btn-ghost' }}">{{ p.label }}</a>
    {% endfor %}
    <a href="{{ path('alert_index') }}" class="btn btn-sm btn-ghost"><i class="bi bi-x-circle me-1"></i>Limpar tudo</a>
  </div>

  <div class="card" style="margin-bottom:1.25rem">
    <div class="card-body">
      <form method="get" style="display:flex;flex-direction:column;gap:1rem">
        <div style="display:flex;flex-wrap:wrap;gap:1rem">
          <div class="form-group"><label class="form-label">Tipo</label><select name="type" class="form-select"><option value="">Todos</option>{% for t in types %}<option value="{{ t }}" {{ type == t ? 'selected' : '' }}>{{ typesMap[t] ?? t }}</option>{% endfor %}</select></div>
          <div class="form-group"><label class="form-label">Subtipo</label><select name="subtype" class="form-select"><option value="">Todos</option>{% for s in subtypes %}<option value="{{ s }}" {{ subtype == s ? 'selected' : '' }}>{{ subtypesMap[(type ?? '') ~ '|' ~ s] ?? s }}</option>{% endfor %}</select></div>
          <div class="form-group"><label class="form-label">Cidade</label><input type="text" name="city" class="form-input" value="{{ city }}" placeholder="ex: Conselheiro Lafaiete" list="cityList"><datalist id="cityList">{% for c in cities %}<option value="{{ c }}">{% endfor %}</datalist></div>
          <div class="form-group"><label class="form-label">De</label><input type="date" name="dateFrom" class="form-input" value="{{ dateFrom }}"></div>
          <div class="form-group"><label class="form-label">Até</label><input type="date" name="dateTo" class="form-input" value="{{ dateTo }}"></div>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:1rem">
          <div class="form-group" style="min-width:220px"><label class="form-label"><i class="bi bi-signpost-split me-1"></i>Incluir apenas esta via</label><input type="text" name="street" class="form-input" value="{{ street }}" placeholder="ex: BR-040" list="streetList"></div>
          <div class="form-group" style="min-width:220px"><label class="form-label"><i class="bi bi-slash-circle me-1"></i>Excluir vias (separe por vírgula)</label><input type="text" name="excludeStreet" class="form-input" value="{{ excludeStreet }}" placeholder="ex: BR-040, Av. Central" list="streetList"></div>
          <datalist id="streetList">{% for s in streets %}<option value="{{ s }}">{% endfor %}</datalist>
        </div>
        <div class="btn-row"><button type="submit" class="btn btn-primary">Filtrar</button><a href="{{ path('alert_index') }}" class="btn btn-ghost">Limpar</a><span class="form-hint" style="margin-left:auto">Datas e horários consideram o fuso de Brasília.</span></div>
      </form>
    </div>
  </div>

  {% if alerts is empty %}
    <div class="card"><div class="empty-state-inline">Nenhum alerta encontrado para os filtros atuais.</div></div>
  {% else %}
    <div class="grid-2">
      <div class="card" style="margin-bottom:0"><div class="card-header"><span class="card-title">Por subtipo</span></div><div class="card-body"><div class="chart-wrap"><canvas id="chart-subtype"></canvas></div></div></div>
      <div class="card" style="margin-bottom:0"><div class="card-header"><span class="card-title">Ao longo do tempo</span></div><div class="card-body"><div class="chart-wrap"><canvas id="chart-trend"></canvas></div></div></div>
    </div>
    <div class="grid-3">
      <div class="card" style="margin-bottom:0"><div class="card-header"><span class="card-title">Por hora do dia</span></div><div class="card-body"><div class="chart-wrap sm"><canvas id="chart-hour"></canvas></div></div></div>
      <div class="card" style="margin-bottom:0"><div class="card-header"><span class="card-title">Por dia da semana</span></div><div class="card-body"><div class="chart-wrap sm"><canvas id="chart-weekday"></canvas></div></div></div>
      <div class="card" style="margin-bottom:0"><div class="card-header"><span class="card-title">Confiança dos alertas</span></div><div class="card-body"><div class="chart-wrap sm"><canvas id="chart-confidence"></canvas></div></div></div>
    </div>
    <div class="card" id="map-card"><div class="card-header"><span class="card-title">🗺️ Mapa de alertas</span><span style="font-size:0.75rem;color:var(--color-text-muted)">{{ mapAlerts|length }} ponto(s) exibido(s){% if mapAlerts|length >= 500 %} (limite atingido — refine o filtro para ver todos){% endif %}</span></div><div id="alert-map"></div></div>
    <div class="grid-2">
      <div class="card" style="margin-bottom:0"><div class="card-header"><span class="card-title"><i class="bi bi-geo-alt me-1"></i>Hotspots (correlação por coordenadas)</span></div><div class="card-body"><p class="form-hint" style="margin-top:0">Pontos onde vários alertas caem na mesma área (~110m), mesmo com nomes de via diferentes ou ausentes.</p>{% for h in hotspots %}<div class="hotspot-item"><div class="hotspot-badge">{{ h.total }}×</div><div style="min-width:0;flex:1"><div style="font-weight:600;font-size:0.9rem" class="text-truncate">{{ h.street ?? 'Via não identificada' }}</div><div style="font-size:0.75rem;color:var(--color-text-muted)">{{ h.city ?? '—' }}</div></div><a class="btn btn-ghost btn-sm" target="_blank" rel="noopener" href="https://www.google.com/maps?q={{ h.lat }},{{ h.lng }}"><i class="bi bi-box-arrow-up-right"></i></a></div>{% else %}<p class="text-muted mb-0">Nenhum ponto com 3+ ocorrências próximas no filtro atual.</p>{% endfor %}</div></div>
      <div class="card" style="margin-bottom:0"><div class="card-header"><span class="card-title">🏆 Principais vias (texto)</span></div><div class="card-body">{% for s in topStreets %}<div class="street-rank-item"><div style="display:flex;align-items:center;gap:10px;min-width:0"><div class="street-rank-pos">{{ loop.index }}</div><div style="min-width:0"><div style="font-weight:600;font-size:0.9rem" class="text-truncate">{{ s.street ?? 'Sem nome' }}</div><div style="font-size:0.75rem;color:var(--color-text-muted)">{{ s.city ?? '—' }}</div></div></div><div style="display:flex;align-items:center;gap:6px;flex-shrink:0"><span class="badge badge-gray">{{ s.total }}</span><a class="btn btn-ghost btn-sm" title="Focar nesta via" href="?{{ app.request.query.all|merge({street: s.street, page: null})|url_encode }}"><i class="bi bi-funnel"></i></a><a class="btn btn-ghost btn-sm" title="Excluir esta via" href="?{{ app.request.query.all|merge({excludeStreet: (excludeStreet ? excludeStreet ~ ', ' ~ s.street : s.street), page: null})|url_encode }}"><i class="bi bi-slash-circle"></i></a></div></div>{% endfor %}</div></div>
    </div>
    <div class="card"><div class="card-header"><span class="card-title">📋 Lista de alertas</span><span style="font-size:0.75rem;color:var(--color-text-muted)">Página {{ page }} de {{ pages }}</span></div><div style="overflow-x:auto"><table><thead><tr><th>Tipo</th><th>Subtipo</th><th>Via</th><th>Cidade</th><th style="text-align:center">Conf.</th><th style="text-align:center">👍</th><th>Publicado</th><th></th></tr></thead><tbody>{% for a in alerts %}<tr><td><span class="badge badge-{{ a.type == 'ACCIDENT' ? 'red' : (a.type == 'JAM' ? 'orange' : (a.type == 'HAZARD' or a.type == 'WEATHERHAZARD' ? 'yellow' : 'gray')) }}">{{ typesMap[a.type] ?? a.type }}</span></td><td style="font-size:0.75rem;color:var(--color-text-muted)">{{ a.subtype ? (subtypesMap[a.type ~ '|' ~ a.subtype] ?? a.subtype) : '—' }}</td><td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ a.street ?? '—' }}</td><td style="font-size:0.75rem">{{ a.city ?? '—' }}</td><td style="text-align:center;font-size:0.75rem">{% if a.confidence is not null %}{% set c = a.confidence %}<span class="badge {{ c >= 7 ? 'badge-green' : (c >= 4 ? 'badge-orange' : 'badge-red') }}">{{ c }}</span>{% else %}—{% endif %}</td><td style="text-align:center;font-size:0.75rem;color:var(--color-text-muted)">{{ a.nThumbsUp ?? 0 }}</td><td style="font-size:0.75rem;color:var(--color-text-muted);white-space:nowrap">{{ a.pubDate|date('d/m H:i') }}</td><td><a href="{{ path('alert_show', {id: a.id}) }}" class="btn btn-ghost btn-sm"><i class="bi bi-eye"></i> Ver</a></td></tr>{% endfor %}</tbody></table></div>{% if pages > 1 %}<div class="pagination">{% if page > 1 %}<a href="?{{ app.request.query.all|merge({page: page - 1})|url_encode }}">&#8249;</a>{% endif %}{% for p in max(1, page-2)..min(pages, page+2) %}{% if p == page %}<span class="current">{{ p }}</span>{% else %}<a href="?{{ app.request.query.all|merge({page: p})|url_encode }}">{{ p }}</a>{% endif %}{% endfor %}{% if page < pages %}<a href="?{{ app.request.query.all|merge({page: page + 1})|url_encode }}">&#8250;</a>{% endif %}</div>{% endif %}</div>
  {% endif %}
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
  <script>
    // Dados passados para o JS
    window.alertData = {
      bySubtype: {{ bySubtype|json_encode|raw }},
      byDay: {{ byDay|json_encode|raw }},
      byHourTrend: {{ byHourTrend|json_encode|raw }},
      trendType: '{{ trendType }}',
      byHour: {{ byHour|json_encode|raw }},
      byWeekday: {{ byWeekday|json_encode|raw }},
      byConfidence: {{ byConfidence|json_encode|raw }},
      mapAlerts: {{ mapAlerts|map(a => {id:a.id,lat:a.latitude,lng:a.longitude,type:a.type,subtype:a.subtype,street:a.street,city:a.city,conf:a.confidence,thumbs:a.nThumbsUp})|json_encode|raw }},
      typesMap: {{ typesMap|json_encode|raw }},
      subtypesMap: {{ subtypesMap|json_encode|raw }},
      dateFrom: '{{ dateFrom }}',
      dateTo: '{{ dateTo }}',
    };
  </script>
  <script src="{{ asset('js/alert.js') }}" defer></script>
{% endblock %}
