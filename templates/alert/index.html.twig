{% extends 'base.html.twig' %}

{% block title %}Alertas{% endblock %}

{% block page_name %}alerts{% endblock %}

{% block content %}
<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-title-wrapper">
            <div>
                <h1 class="page-title">
                    <i class="bi bi-exclamation-triangle text-danger"></i>
                    Alertas
                </h1>
                <p class="page-subtitle">Gerenciamento de alertas e ocorrê££ncias</p>
            </div>
            <div>
                <a href="{{ path('alert_new') }}" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    Novo Alerta
                </a>
            </div>
        </div>
        
        <!-- Filters -->
        <div class="dashboard-filters mt-4">
            <form method="get" class="d-flex gap-3 flex-wrap">
                <div class="filter-group">
                    <label class="filter-label">Status:</label>
                    <select name="status" class="form-select form-select-sm" style="min-width: 150px;">
                        <option value="">Todos</option>
                        <option value="active" {{ app.request.query.get('status') == 'active' ? 'selected' : '' }}>Ativos</option>
                        <option value="resolved" {{ app.request.query.get('status') == 'resolved' ? 'selected' : '' }}>Resolvidos</option>
                        <option value="archived" {{ app.request.query.get('status') == 'archived' ? 'selected' : '' }}>Arquivados</option>
                    </select>
                </div>
                
                <div class="filter-group">
                    <label class="filter-label">Tipo:</label>
                    <select name="type" class="form-select form-select-sm" style="min-width: 150px;">
                        <option value="">Todos</option>
                        <option value="accident" {{ app.request.query.get('type') == 'accident' ? 'selected' : '' }}>Acidente</option>
                        <option value="hazard" {{ app.request.query.get('type') == 'hazard' ? 'selected' : '' }}>Perigo</option>
                        <option value="police" {{ app.request.query.get('type') == 'police' ? 'selected' : '' }}>Polí££a</option>
                        <option value="traffic" {{ app.request.query.get('type') == 'traffic' ? 'selected' : '' }}>Trâ®®ego</option>
                        <option value="weather" {{ app.request.query.get('type') == 'weather' ? 'selected' : '' }}>Clima</option>
                    </select>
                </div>
                
                <div class="filter-group">
                    <label class="filter-label">Cidade:</label>
                    <select name="city" class="form-select form-select-sm" style="min-width: 200px;">
                        <option value="">Todas</option>
                        {% for city in cities|default([]) %}
                        <option value="{{ city.id }}" {{ app.request.query.get('city') == city.id ? 'selected' : '' }}>
                            {{ city.name }}
                        </option>
                        {% endfor %}
                    </select>
                </div>
                
                <div class="filter-group">
                    <input type="text" name="search" class="form-control form-control-sm" 
                           placeholder="Buscar..." value="{{ app.request.query.get('search') }}" 
                           style="min-width: 250px;">
                </div>
                
                <button type="submit" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-funnel"></i>
                    Filtrar
                </button>
            </form>
        </div>
    </div>
    
    <!-- Alerts Table -->
    <div class="table-container">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>Tipo</th>
                    <th>Tí££ulo</th>
                    <th>Localizaçª£o</th>
                    <th>Cidade</th>
                    <th>Status</th>
                    <th>Data</th>
                    <th style="width: 120px;">Açµµ</th>
                </tr>
            </thead>
            <tbody>
                {% for alert in alerts|default([]) %}
                <tr class="{{ not alert.isActive ? 'table-secondary' : '' }}">
                    <td>
                        <span class="badge rounded-pill bg-{{ alert.type|default('warning') }}">
                            {{ alert.id }}
                        </span>
                    </td>
                    <td>
                        <span class="table-badge {{ alert.type|default('warning') }}">
                            <i class="bi bi-{{ alert.icon|default('exclamation-triangle') }}"></i>
                            {{ alert.typeLabel|default('Alerta') }}
                        </span>
                    </td>
                    <td>
                        <div class="fw-medium">{{ alert.title }}</div>
                        {% if alert.description %}
                        <div class="text-muted small">{{ alert.description|truncate(50) }}</div>
                        {% endif %}
                    </td>
                    <td>
                        <i class="bi bi-geo-alt text-muted"></i>
                        {{ alert.location|truncate(30) }}
                    </td>
                    <td>{{ alert.city.name|default('N/A') }}</td>
                    <td>
                        {% if alert.isResolved %}
                        <span class="table-badge success">
                            <i class="bi bi-check-circle"></i>
                            Resolvido
                        </span>
                        {% elseif alert.isActive %}
                        <span class="table-badge warning">
                            <i class="bi bi-exclamation-circle"></i>
                            Ativo
                        </span>
                        {% else %}
                        <span class="table-badge neutral">
                            <i class="bi bi-archive"></i>
                            Arquivado
                        </span>
                        {% endif %}
                    </td>
                    <td>
                        <div>{{ alert.createdAt|date('d/m/Y') }}</div>
                        <div class="text-muted small">{{ alert.createdAt|date('H:i') }}</div>
                    </td>
                    <td>
                        <div class="table-actions">
                            <a href="{{ path('alert_show', {id: alert.id}) }}" class="table-action-btn view" title="Ver">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a href="{{ path('alert_edit', {id: alert.id}) }}" class="table-action-btn edit" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a href="{{ path('alert_delete', {id: alert.id}) }}" class="table-action-btn delete" 
                               title="Excluir" 
                               data-confirm="Tem certeza que deseja excluir este alerta?">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="8" class="text-center py-5">
                        <div class="table-empty">
                            <div class="table-empty-icon">
                                <i class="bi bi-inbox"></i>
                            </div>
                            <h5 class="table-empty-title">Nenhum alerta encontrado</h5>
                            <p class="table-empty-text">
                                Comece criando um novo alerta ou ajuste os filtros de busca.
                            </p>
                            <a href="{{ path('alert_new') }}" class="btn btn-primary mt-3">
                                <i class="bi bi-plus-lg"></i>
                                Criar Alerta
                            </a>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    
    <!-- Pagination -->
    {% if pagination|default(false) %}
    <div class="d-flex justify-content-between align-items-center mt-4">
        <div class="text-muted">
            Mostrando {{ pagination.from }} a {{ pagination.to }} de {{ pagination.total }} resultados
        </div>
        <nav>
            <ul class="pagination pagination-sm mb-0">
                {% if pagination.hasPrevious %}
                <li class="page-item">
                    <a class="page-link" href="?page={{ pagination.previous }}&{{ app.request.query.all|url_encode }}">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                {% endif %}
                
                {% for page in pagination.pages %}
                <li class="page-item {{ page == pagination.current ? 'active' : '' }}">
                    <a class="page-link" href="?page={{ page }}&{{ app.request.query.all|url_encode }}">
                        {{ page }}
                    </a>
                </li>
                {% endfor %}
                
                {% if pagination.hasNext %}
                <li class="page-item">
                    <a class="page-link" href="?page={{ pagination.next }}&{{ app.request.query.all|url_encode }}">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
                {% endif %}
            </ul>
        </nav>
    </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
<script>
import { initAlerts } from '../../js/pages/alerts.js';

document.addEventListener('DOMContentLoaded', () => {
  initAlerts({
    confirmDelete: true,
    bulkActions: true,
  });
});
</script>
{% endblock %}
