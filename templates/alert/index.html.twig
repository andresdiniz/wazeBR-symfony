{% extends 'base.html.twig' %}
{% block title %}Alertas — Análise histórica{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/alert.css') }}">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css">
{% endblock %}

{% block body %}
<div class="alerts-page">
  <div class="page-header">
    <div>
      <h1 class="page-title">Análise histórica de alertas</h1>
      <p class="page-subtitle">{{ total|number_format(0, ',', '.') }} alerta(s) encontrado(s) com os filtros atuais</p>
    </div>
    <div class="alert-toolbar">
      <a href="{{ path('alert_export', app.request.query.all|filter((value, key) => key != 'page')) }}" class="btn btn-primary alert-export-button"><i class="bi bi-download"></i> Exportar CSV</a>
    </div>
  </div>

  <div class="btn-row" style="margin-bottom:var(--space-4)">
    {% for key, p in periods %}
      <a href="?{{ app.request.query.all|merge({period: key, dateFrom: null, dateTo: null, page: null})|url_encode }}" class="btn btn-sm {{ period == key and not dateFrom ? 'btn-primary' : 'btn-ghost' }}">{{ p.label }}</a>
    {% endfor %}
    <a href="{{ path('alert_index') }}" class="btn btn-sm btn-ghost"><i class="bi bi-x-circle me-1"></i>Limpar tudo</a>
  </div>

  <div class="card" style="margin-bottom:var(--space-6)">
    <div class="card-body">
      <form method="get" style="display:flex;flex-direction:column;gap:var(--space-4)">
        <div style="display:flex;flex-wrap:wrap;gap:var(--space-4)">
          <div class="form-group" style="margin:0;flex:1;min-width:150px"><label class="form-label">Tipo</label><select name="type" class="form-select"><option value="">Todos</option>{% for t in types %}<option value="{{ t }}" {{ type == t ? 'selected' : '' }}>{{ typesMap[t] ?? t }}</option>{% endfor %}</select></div>
          <div class="form-group" style="margin:0;flex:1;min-width:160px"><label class="form-label">Subtipo</label><select name="subtype" class="form-select"><option value="">Todos</option>{% for s in subtypes %}<option value="{{ s }}" {{ subtype == s ? 'selected' : '' }}>{{ subtypesMap[(type ?? '') ~ '|' ~ s] ?? s }}</option>{% endfor %}</select></div>
          <div class="form-group" style="margin:0;flex:1;min-width:150px"><label class="form-label">Cidade</label><input type="text" name="city" class="form-input" value="{{ city }}" placeholder="ex: Conselheiro Lafaiete" list="cityList"><datalist id="cityList">{% for c in cities %}<option value="{{ c }}">{% endfor %}</datalist></div>
          <div class="form-group" style="margin:0;flex:1;min-width:130px"><label class="form-label">De</label><input type="date" name="dateFrom" class="form-input" value="{{ dateFrom }}"></div>
          <div class="form-group" style="margin:0;flex:1;min-width:130px"><label class="form-label">Até</label><input type="date" name="dateTo" class="form-input" value="{{ dateTo }}"></div>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:var(--space-4)"><div class="form-group" style="margin:0;flex:1;min-width:220px"><label class="form-label"><i class="bi bi-signpost-split me-1"></i>Incluir apenas esta via</label><input type="text" name="street" class="form-input" value="{{ street }}" placeholder="ex: BR-040" list="streetList"></div><div class="form-group" style="margin:0;flex:1;min-width:220px"><label class="form-label"><i class="bi bi-slash-circle me-1"></i>Excluir vias (separe por vírgula)</label><input type="text" name="excludeStreet" class="form-input" value="{{ excludeStreet }}" placeholder="ex: BR-040, Av. Central" list="streetList"></div><datalist id="streetList">{% for s in streets %}<option value="{{ s }}">{% endfor %}</datalist></div>
        <div class="btn-row"><button type="submit" class="btn btn-primary">Filtrar</button><a href="{{ path('alert_index') }}" class="btn btn-ghost">Limpar</a><span class="form-hint" style="margin-left:auto">Datas e horários consideram o fuso de Brasília.</span></div>
      </form>
    </div>
  </div>

  {% if alerts is empty %}<div class="card"><div class="empty-state-inline">Nenhum alerta encontrado para os filtros atuais.</div></div>{% else %}
  <div class="grid-2"><div class="card" style="margin-bottom:0"><div class="card-header"><span class="card-title">Por subtipo</span></div><div class="card-body"><div class="chart-wrap"><canvas id="chart-subtype"></canvas></div></div></div><div class="card" style="margin-bottom:0"><div class="card-header"><span class="card-title">Ao longo do tempo</span></div><div class="card-body"><div class="chart-wrap"><canvas id="chart-trend"></canvas></div></div></div></div>
  <div class="grid-3"><div class="card" style="margin-bottom:0"><div class="card-header"><span class="card-title">Por hora do dia</span></div><div class="card-body"><div class="chart-wrap sm"><canvas id="chart-hour"></canvas></div></div></div><div class="card" style="margin-bottom:0"><div class="card-header"><span class="card-title">Por dia da semana</span></div><div class="card-body"><div class="chart-wrap sm"><canvas id="chart-weekday"></canvas></div></div></div><div class="card" style="margin-bottom:0"><div class="card-header"><span class="card-title">Confiança dos alertas</span></div><div class="card-body"><div class="chart-wrap sm"><canvas id="chart-confidence"></canvas></div></div></div></div>
  <div class="card" id="map-card"><div class="card-header"><span class="card-title">Mapa de alertas</span><span style="font-size:var(--text-xs);color:var(--color-text-muted)">{{ mapAlerts|length }} ponto(s) exibido(s){% if mapAlerts|length >= 500 %} (limite atingido — refine o filtro para ver todos){% endif %}</span></div><div id="alert-map"></div></div>
  <div class="grid-2"><div class="card" style="margin-bottom:0"><div class="card-header"><span class="card-title"><i class="bi bi-geo-alt me-1"></i>Hotspots (correlação por coordenadas)</span></div><div class="card-body"><p class="form-hint" style="margin-top:0">Pontos onde vários alertas caem na mesma área (~110m), mesmo com nomes de via diferentes ou ausentes.</p>{% for h in hotspots %}<div class="hotspot-item"><div class="hotspot-badge">{{ h.total }}×</div><div style="min-width:0;flex:1"><div style="font-weight:600;font-size:var(--text-sm)" class="text-truncate">{{ h.street ?? 'Via não identificada' }}</div><div style="font-size:var(--text-xs);color:var(--color-text-muted)">{{ h.city ?? '—' }}</div></div><a class="btn btn-ghost btn-sm" target="_blank" rel="noopener" href="https://www.google.com/maps?q={{ h.lat }},{{ h.lng }}"><i class="bi bi-box-arrow-up-right"></i></a></div>{% else %}<p class="text-muted mb-0">Nenhum ponto com 3+ ocorrências próximas no filtro atual.</p>{% endfor %}</div></div><div class="card" style="margin-bottom:0"><div class="card-header"><span class="card-title">Principais vias (texto)</span></div><div class="card-body">{% for s in topStreets %}<div class="street-rank-item"><div style="display:flex;align-items:center;gap:10px;min-width:0"><div class="street-rank-pos">{{ loop.index }}</div><div style="min-width:0"><div style="font-weight:600;font-size:var(--text-sm)" class="text-truncate">{{ s.street ?? 'Sem nome' }}</div><div style="font-size:var(--text-xs);color:var(--color-text-muted)">{{ s.city ?? '—' }}</div></div></div><div style="display:flex;align-items:center;gap:6px;flex-shrink:0"><span class="badge badge-gray">{{ s.total }}</span><a class="btn btn-ghost btn-sm" title="Focar nesta via" href="?{{ app.request.query.all|merge({street: s.street, page: null})|url_encode }}"><i class="bi bi-funnel"></i></a><a class="btn btn-ghost btn-sm" title="Excluir esta via" href="?{{ app.request.query.all|merge({excludeStreet: (excludeStreet ? excludeStreet ~ ', ' ~ s.street : s.street), page: null})|url_encode }}"><i class="bi bi-slash-circle"></i></a></div></div>{% endfor %}</div></div></div>
  <div class="card"><div class="card-header"><span class="card-title">Lista de alertas</span><span style="font-size:var(--text-xs);color:var(--color-text-muted)">Página {{ page }} de {{ pages }}</span></div><div style="overflow-x:auto"><table><thead><tr><th>Tipo</th><th>Subtipo</th><th>Via</th><th>Cidade</th><th style="text-align:center">Conf.</th><th style="text-align:center">👍</th><th>Publicado</th><th></th></tr></thead><tbody>{% for a in alerts %}<tr><td><span class="badge badge-{{ a.type == 'ACCIDENT' ? 'red' : (a.type == 'JAM' ? 'orange' : (a.type == 'HAZARD' or a.type == 'WEATHERHAZARD' ? 'yellow' : 'gray')) }}">{{ typesMap[a.type] ?? a.type }}</span></td><td style="font-size:var(--text-xs);color:var(--color-text-muted)">{{ a.subtype ? (subtypesMap[a.type ~ '|' ~ a.subtype] ?? a.subtype) : '—' }}</td><td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ a.street ?? '—' }}</td><td style="font-size:var(--text-xs)">{{ a.city ?? '—' }}</td><td style="text-align:center;font-size:var(--text-xs)">{% if a.confidence is not null %}{% set c = a.confidence %}<span class="badge {{ c >= 7 ? 'badge-green' : (c >= 4 ? 'badge-orange' : 'badge-red') }}">{{ c }}</span>{% else %}—{% endif %}</td><td style="text-align:center;font-size:var(--text-xs);color:var(--color-text-muted)">{{ a.nThumbsUp ?? 0 }}</td><td style="font-size:var(--text-xs);color:var(--color-text-muted);white-space:nowrap">{{ a.pubDate|date('d/m H:i') }}</td><td><a href="{{ path('alert_show', {id: a.id}) }}" class="btn btn-ghost btn-sm"><i class="bi bi-eye"></i> Ver</a></td></tr>{% endfor %}</tbody></table></div>{% if pages > 1 %}<div style="padding:var(--space-4) var(--space-5);border-top:1px solid var(--color-divider)"><div class="pagination">{% if page > 1 %}<a href="?{{ app.request.query.all|merge({page: page - 1})|url_encode }}">&#8249;</a>{% endif %}{% for p in max(1, page-2)..min(pages, page+2) %}{% if p == page %}<span class="current">{{ p }}</span>{% else %}<a href="?{{ app.request.query.all|merge({page: p})|url_encode }}">{{ p }}</a>{% endif %}{% endfor %}{% if page < pages %}<a href="?{{ app.request.query.all|merge({page: page + 1})|url_encode }}">&#8250;</a>{% endif %}</div></div>{% endif %}</div>
  {% endif %}
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
  <script>
  (function () {
    var TYPE_LABEL = {{ typesMap|json_encode|raw }};
    var SUBTYPE_LABEL = {{ subtypesMap|json_encode|raw }};
    var TYPE_COLOR = { ACCIDENT:'#a12c7b', HAZARD:'#d19900', WEATHERHAZARD:'#006494', JAM:'#da7101', ROAD_CLOSED:'#7a7974', CONSTRUCTION:'#437a22', POLICE:'#01696f', MISC:'#7a39bb' };
    var css = getComputedStyle(document.documentElement);
    var textColor = css.getPropertyValue('--color-text').trim() || '#172033';
    var mutedColor = css.getPropertyValue('--color-text-muted').trim() || '#64748b';
    var borderColor = css.getPropertyValue('--color-border').trim() || '#dbe3ef';
    Chart.defaults.color = mutedColor; Chart.defaults.borderColor = borderColor;
    var animation = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? false : { duration: 700, easing: 'easeOutQuart' };
    function chart(id, config) { var el = document.getElementById(id); if (!el) return; config.options = config.options || {}; config.options.responsive = true; config.options.maintainAspectRatio = false; config.options.animation = animation; config.options.plugins = config.options.plugins || {}; config.options.plugins.legend = config.options.plugins.legend || { display:false }; new Chart(el, config); }
    var bySubtype = {{ bySubtype|json_encode|raw }}; chart('chart-subtype', { type:'bar', data:{ labels:bySubtype.map(function(d){return d.label;}), datasets:[{ data:bySubtype.map(function(d){return Number(d.total||0);}), backgroundColor:'#2563eb', borderRadius:7, borderSkipped:false }] }, options:{ indexAxis:'y', scales:{ x:{beginAtZero:true, grid:{color:borderColor}, ticks:{precision:0}}, y:{grid:{display:false}} }, plugins:{tooltip:{callbacks:{label:function(c){return ' '+c.parsed.x.toLocaleString('pt-BR')+' alertas';}}}} } });
    var byDay = {{ byDay|json_encode|raw }}; chart('chart-trend', { type:'line', data:{ labels:byDay.map(function(d){var p=d.day.split('-');return p[2]+'/'+p[1];}), datasets:[{ data:byDay.map(function(d){return parseInt(d.total,10);}), borderColor:'#2563eb', backgroundColor:'rgba(37,99,235,.14)', fill:true, tension:.35, pointRadius:byDay.length>40?0:3, pointBackgroundColor:'#2563eb' }] }, options:{ scales:{y:{beginAtZero:true,grid:{color:borderColor},ticks:{precision:0}},x:{grid:{display:false}}} } });
    var byHour = {{ byHour|json_encode|raw }}; chart('chart-hour', { type:'bar', data:{ labels:byHour.map(function(_,h){return h+'h';}), datasets:[{data:byHour,backgroundColor:'#8b5cf6',borderRadius:5,borderSkipped:false}] }, options:{ scales:{x:{grid:{display:false},ticks:{autoSkip:true,maxTicksLimit:12}},y:{beginAtZero:true,grid:{color:borderColor},ticks:{precision:0}}} } });
    var byWeekday = {{ byWeekday|json_encode|raw }}; var WD={1:'Dom',2:'Seg',3:'Ter',4:'Qua',5:'Qui',6:'Sex',7:'Sáb'}; chart('chart-weekday', { type:'bar', data:{labels:[1,2,3,4,5,6,7].map(function(k){return WD[k];}),datasets:[{data:[1,2,3,4,5,6,7].map(function(k){return byWeekday[k]||0;}),backgroundColor:'#0ea5e9',borderRadius:5,borderSkipped:false}]}, options:{scales:{x:{grid:{display:false}},y:{beginAtZero:true,grid:{color:borderColor},ticks:{precision:0}}}} });
    var byConfidence = {{ byConfidence|json_encode|raw }}; var confKeys=Object.keys(byConfidence); chart('chart-confidence', { type:'doughnut', data:{labels:confKeys,datasets:[{data:confKeys.map(function(k){return byConfidence[k];}),backgroundColor:['#ef4444','#f97316','#22c55e','#94a3b8'],borderColor:'transparent',borderWidth:2,hoverOffset:6}]}, options:{cutout:'60%',plugins:{legend:{position:'bottom',labels:{color:mutedColor,boxWidth:11,usePointStyle:true,padding:12}}}} });
    var mapAlerts = {{ mapAlerts|map(a => {id:a.id,lat:a.latitude,lng:a.longitude,type:a.type,subtype:a.subtype,street:a.street,city:a.city,conf:a.confidence,thumbs:a.nThumbsUp})|json_encode|raw }};
    var mapEl=document.getElementById('alert-map'); if(mapEl && typeof L!=='undefined'){ var map=L.map(mapEl,{zoomControl:true}).setView([-20.6603,-43.7862],13); L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap',maxZoom:19}).addTo(map); var cluster=L.markerClusterGroup({maxClusterRadius:45,showCoverageOnHover:false}); var bounds=[]; function esc(v){var e=document.createElement('div');e.textContent=String(v??'');return e.innerHTML;} mapAlerts.forEach(function(a){var lat=parseFloat(a.lat),lng=parseFloat(a.lng);if(!Number.isFinite(lat)||!Number.isFinite(lng)||(lat===0&&lng===0))return;bounds.push([lat,lng]);var color=TYPE_COLOR[a.type]||'#7a7974';var icon=L.divIcon({className:'',iconSize:[16,16],iconAnchor:[8,8],html:'<div style="width:16px;height:16px;border-radius:50%;background:'+color+';border:2px solid #fff;box-shadow:0 1px 5px rgba(0,0,0,.35)"></div>'});var popup='<div class="popup-inner"><div class="popup-type">'+esc(TYPE_LABEL[a.type]||a.type)+'</div>'+(a.subtype?'<div class="popup-sub">'+esc(SUBTYPE_LABEL[a.type+'|'+a.subtype]||a.subtype)+'</div>':'')+(a.street?'<div class="popup-street">'+esc(a.street)+'</div>':'')+(a.city?'<div class="popup-city">'+esc(a.city)+'</div>':'')+'<div class="popup-meta">'+(a.conf!==null?'<span>Conf: '+esc(a.conf)+'</span>':'')+(a.thumbs!==null?'<span>👍 '+esc(a.thumbs)+'</span>':'')+'</div><a href="/alertas/'+encodeURIComponent(a.id)+'" class="alert-detail-link">Ver detalhes →</a></div>'; L.marker([lat,lng],{icon:icon}).bindPopup(popup).addTo(cluster);}); map.addLayer(cluster); if(bounds.length)map.fitBounds(bounds,{padding:[30,30],maxZoom:16,animate:!window.matchMedia('(prefers-reduced-motion: reduce)').matches});else map.setView([-15.7801,-47.9292],4); window.setTimeout(function(){map.invalidateSize();},150); }
  }());
  </script>
{% endblock %}
