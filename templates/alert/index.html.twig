{% extends 'base.html.twig' %}

{% block title %}Alertas{% endblock %}

{% block page_stylesheets %}
<style>
    .alerts-list { list-style: none; padding: 0; margin: 0; }
    .alert-item { background: #fff; border: 1px solid #e0e0e0; border-radius: 8px; padding: 16px; margin-bottom: 12px; }
    .alert-item h3 { margin: 0 0 8px 0; font-size: 1rem; }
    .alert-meta { font-size: 0.85rem; color: #666; }
</style>
{% endblock %}

{% block body_class %}dashboard-page{% endblock %}

{% block body %}
<div class="dashboard-layout">
    {% include 'partials/sidebar.html.twig' %}
    <main class="dashboard-content">
        {% include 'partials/topbar.html.twig' %}
        <div class="dashboard-content-inner">
            <h1>Alertas</h1>
            {% if alerts is empty %}
                <p>Nenhum alerta encontrado.</p>
            {% else %}
                <ul class="alerts-list">
                    {% for alert in alerts %}
                        <li class="alert-item">
                            <h3>Alert #{{ alert.id }} - {{ alert.type }}</h3>
                            <p class="alert-meta">{{ alert.reportTime|date('d/m/Y H:i') }}</p>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </main>
</div>
{% endblock %}
