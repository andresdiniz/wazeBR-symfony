{% extends 'base.html.twig' %}
{% block title %}Alertas ao vivo — {{ partner.name }}{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css">
    <style>
        .live-page { max-width:1440px; margin:0 auto; padding:24px; }.live-header { display:flex; justify-content:space-between; align-items:center; gap:16px; margin-bottom:20px; }.live-header h1 { margin:0; }.live-status { display:inline-flex; gap:8px; align-items:center; color:#16a34a; font-weight:600; }.live-status::before { content:""; width:9px; height:9px; border-radius:50%; background:currentColor; box-shadow:0 0 0 5px rgba(22,163,74,.12); }.live-grid { display:grid; grid-template-columns:minmax(0,1.6fr) minmax(280px,.8fr); gap:20px; }.live-map-card,.live-list-card { background:var(--surface); border:1px solid var(--border-color); border-radius:14px; overflow:hidden; }.live-map { height:580px; min-height:360px; background:var(--surface-2); }.live-list { max-height:580px; overflow:auto; }.live-item { display:block; padding:14px 16px; border-bottom:1px solid var(--border-color); color:var(--text-primary); text-decoration:none; }.live-item:hover { background:var(--sidebar-hover-bg); }.live-type { font-weight:700; }.live-meta { color:var(--text-secondary); font-size:.8rem; margin-top:4px; }.live-empty { padding:64px 20px; text-align:center; color:var(--text-secondary); }.live-empty i { display:block; margin-bottom:12px; font-size:2rem; color:var(--text-muted); } .live-map .leaflet-container { width:100%; height:100%; }
        @media(max-width:900px){.live-page{padding:16px}.live-grid{grid-template-columns:1fr}.live-map{height:420px}}
    </style>
{% endblock %}
{% block body %}
<div class="live-page">
    <div class="live-header"><div><h1>Alertas ao vivo</h1><p class="text-muted mb-0">Somente alertas atualizados nos últimos 10 minutos.</p></div><div class="live-status">{{ total }} ativo(s)</div></div>
    <div class="live-grid">
        <section class="live-map-card"><div class="live-map" id="alert-live-map"></div></section>
        <section class="live-list-card"><div class="live-list">{% for alert in alerts %}<a class="live-item" href="{{ path('alert_show', {id: alert.id}) }}"><div class="live-type">{{ typesMap[alert.type] ?? alert.type }}</div><div class="live-meta">{{ alert.street ?? 'Via não informada' }} · {{ alert.city ?? 'Sem cidade' }}</div></a>{% else %}<div class="live-empty"><i class="bi bi-check2-circle"></i>Nenhum alerta ativo no momento.</div>{% endfor %}</div></section>
    </div>
</div>
{% endblock %}
{% block javascripts %}
{{ parent() }}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
<script>
(function(){
    var data = {{ alerts|map(a => {id:a.id,lat:a.latitude,lng:a.longitude,type:a.type,street:a.street,city:a.city})|json_encode|raw }};
    var el = document.getElementById('alert-live-map');
    if (!el || typeof L === 'undefined') return;
    var map = L.map(el).setView([-20.6603,-43.7862],13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'© OpenStreetMap contributors'}).addTo(map);
    var layer = typeof L.markerClusterGroup === 'function' ? L.markerClusterGroup({maxClusterRadius:45}) : L.layerGroup();
    var bounds = [];
    data.forEach(function(a){var lat=Number(a.lat),lng=Number(a.lng);if(!Number.isFinite(lat)||!Number.isFinite(lng)||(lat===0&&lng===0))return;bounds.push([lat,lng]);L.marker([lat,lng]).bindPopup('<strong>'+String(a.type||'Alerta')+'</strong><br>'+String(a.street||'Via não informada')+'<br>'+String(a.city||'Sem cidade')+'<br><a href="/alertas/'+encodeURIComponent(a.id)+'">Ver detalhes</a>').addTo(layer);});
    layer.addTo(map); if(bounds.length) map.fitBounds(bounds,{padding:[30,30],maxZoom:16}); window.setTimeout(function(){map.invalidateSize();},150);
})();
</script>
{% endblock %}
