{% extends 'base.html.twig' %}

{% block title %}Painel de Comando — WazeBR{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h3 mb-1">Painel de Comando</h1>
            <p class="text-muted mb-0">Situação operacional consolidada{% if partner %} — {{ partner.name }}{% else %} — visão global{% endif %}</p>
        </div>
        <a href="{{ path('dashboard') }}" class="btn btn-primary">Dashboard completa</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3"><div class="card h-100 shadow-sm"><div class="card-body"><div class="text-muted small mb-1">Índice de saúde</div><div class="h3 mb-0">{{ health_score ?? '—' }}</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="card h-100 shadow-sm"><div class="card-body"><div class="text-muted small mb-1">Congestionamentos</div><div class="h3 mb-0">{{ totals.jams|default(0) }}</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="card h-100 shadow-sm"><div class="card-body"><div class="text-muted small mb-1">Alertas ativos</div><div class="h3 mb-0">{{ totals.alerts|default(0) }}</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="card h-100 shadow-sm"><div class="card-body"><div class="text-muted small mb-1">Risco hidrológico</div><div class="h3 mb-0">{{ hydro|length }}</div></div></div></div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center"><strong>Mapa operacional</strong><span class="badge text-bg-secondary">{{ map_payload|length }} eventos</span></div>
                <div class="card-body">
                    {% if map_payload|length %}
                        <div id="home-command-map" data-map-payload="{{ map_payload|json_encode|e('html_attr') }}" style="height: 420px; border-radius: .5rem;"></div>
                    {% else %}
                        <div class="text-center text-muted py-5">Nenhum evento no período selecionado.</div>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header"><strong>Prioridades operacionais</strong></div>
                <div class="card-body p-0">
                    {% if recent|length %}
                        <div class="list-group list-group-flush">
                            {% for item in recent|slice(0, 8) %}
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between"><strong>{{ item.type|default('Evento') }}</strong><small class="text-muted">{{ item.createdAt|default(item.date|default('')) }}</small></div>
                                    <div class="small text-muted">{{ item.street|default(item.location|default(item.title|default('Local não informado'))) }}</div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center text-muted py-5">Sem ocorrências recentes.</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header"><strong>Chuva e clima</strong></div>
                <div class="card-body">
                    {% if pluvio|length %}
                        <ul class="list-unstyled mb-0">
                            {% for item in pluvio|slice(0, 6) %}
                                <li class="d-flex justify-content-between border-bottom py-2"><span>{{ item.name|default(item.location|default('Estação')) }}</span><strong>{{ item.value|default(item.rain|default(0)) }} mm</strong></li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-muted mb-0">Sem dados pluviométricos recentes.</p>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header"><strong>Status da coleta</strong></div>
                <div class="card-body">
                    {% if fetch_status|length %}
                        <ul class="list-unstyled mb-0">
                            {% for source, status in fetch_status %}
                                <li class="d-flex justify-content-between border-bottom py-2"><span>{{ source }}</span><span class="badge text-bg-secondary">{{ status|default('—') }}</span></li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-muted mb-0">Nenhum status de coleta disponível.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
