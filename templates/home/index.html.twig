<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>WazeBR Monitor | Inteligência para mobilidade urbana</title>
    <meta name="description" content="Monitore trânsito, alertas, rotas e ocorrências em uma plataforma completa para mobilidade urbana.">
    <style>
        :root{--ink:#102033;--muted:#607084;--brand:#159bb2;--brand-dark:#08768b;--accent:#8bd34f;--bg:#f7fbfc;--card:#fff;--line:#dfecef;--radius:24px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);background:var(--bg);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.landing{overflow:hidden}.container{width:min(1160px,calc(100% - 32px));margin:auto}.topbar{display:flex;align-items:center;justify-content:space-between;padding:18px 0}.brand{display:flex;align-items:center;gap:10px;color:var(--ink);font-weight:850;letter-spacing:-.04em;text-decoration:none}.brand-mark{display:grid;width:40px;height:40px;place-items:center;color:#fff;background:linear-gradient(145deg,var(--brand),#50c0cb);border-radius:13px;box-shadow:0 9px 22px #159bb240;font-size:1.35rem}.brand small{display:block;margin-top:2px;color:var(--brand);font-size:.65rem;letter-spacing:.12em;text-transform:uppercase}.nav-actions{display:flex;gap:10px;align-items:center}.btn{display:inline-flex;min-height:46px;align-items:center;justify-content:center;gap:8px;padding:0 18px;border:1px solid transparent;border-radius:13px;font:inherit;font-size:.9rem;font-weight:750;text-decoration:none;transition:.22s ease}.btn:hover{transform:translateY(-2px)}.btn-primary{color:#fff;background:var(--brand);box-shadow:0 12px 24px #159bb233}.btn-primary:hover{background:var(--brand-dark)}.btn-light{color:var(--ink);border-color:var(--line);background:#ffffffb8}.hero{padding:48px 0 80px}.hero-grid{display:grid;gap:38px;align-items:center}.eyebrow{display:inline-flex;align-items:center;gap:8px;margin:0 0 18px;color:var(--brand);font-size:.75rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase}.eyebrow:before{width:26px;height:2px;background:var(--accent);content:""}.hero h1{max-width:700px;margin:0;font-size:clamp(2.6rem,11vw,5.8rem);line-height:.95;letter-spacing:-.075em}.hero h1 em{color:var(--brand);font-style:normal}.hero p{max-width:600px;margin:22px 0 28px;color:var(--muted);font-size:1.05rem;line-height:1.7}.hero-actions{display:flex;flex-wrap:wrap;gap:10px}.proof{display:flex;flex-wrap:wrap;gap:18px;margin-top:24px;color:var(--muted);font-size:.82rem}.proof span{display:flex;align-items:center;gap:6px}.proof b{color:#42a83f}.preview{position:relative;padding:18px;border-radius:30px;background:linear-gradient(145deg,#102c3c,#075e73);box-shadow:0 28px 70px #0b526333;transform:rotate(1deg)}.preview-window{min-height:335px;padding:16px;border:1px solid #ffffff2e;border-radius:20px;background:#082331}.window-bar{display:flex;gap:6px;margin-bottom:20px}.window-bar i{width:8px;height:8px;border-radius:50%;background:#ef8354}.window-bar i:nth-child(2){background:#f6c453}.window-bar i:nth-child(3){background:#72c85a}.map{position:relative;display:grid;min-height:250px;place-items:center;overflow:hidden;border-radius:14px;background:linear-gradient(135deg,#14546c,#093144)}.map:before,.map:after{position:absolute;width:160%;height:2px;background:#ffffff20;content:"";transform:rotate(25deg)}.map:after{transform:rotate(-28deg)}.pin{z-index:1;display:grid;width:58px;height:58px;place-items:center;color:#fff;background:linear-gradient(145deg,#55ccd3,var(--brand));border:6px solid #ffffff42;border-radius:50% 50% 50% 8px;box-shadow:0 0 0 14px #45d4d21f;transform:rotate(-45deg);animation:float 3.3s ease-in-out infinite}.pin span{transform:rotate(45deg);font-size:1.3rem}.floating{position:absolute;z-index:2;padding:11px 13px;color:#fff;border:1px solid #ffffff26;border-radius:14px;background:#09202dcc;backdrop-filter:blur(10px);font-size:.72rem}.floating strong{display:block;font-size:1rem}.f-one{top:26px;left:4px}.f-two{right:4px;bottom:26px}@keyframes float{50%{transform:translateY(-9px) rotate(-45deg)}}section{padding:76px 0}.section-head{max-width:650px;margin-bottom:28px}.kicker{margin:0 0 10px;color:var(--brand);font-size:.75rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase}.section-head h2{margin:0;font-size:clamp(1.9rem,6vw,3.25rem);line-height:1;letter-spacing:-.06em}.section-head p{margin:13px 0 0;color:var(--muted);line-height:1.65}.cards{display:grid;gap:14px}.card{padding:25px;border:1px solid var(--line);border-radius:var(--radius);background:var(--card);box-shadow:0 10px 30px #10203308;transition:.24s ease}.card:hover{transform:translateY(-5px);box-shadow:0 18px 38px #10203316}.icon{display:grid;width:48px;height:48px;margin-bottom:20px;place-items:center;color:var(--brand);background:#e8f7f8;border-radius:15px;font-size:1.3rem}.card h3{margin:0 0 8px;font-size:1.08rem}.card p{margin:0;color:var(--muted);font-size:.92rem;line-height:1.65}.band{color:#fff;background:#102d3d}.band .section-head p{color:#b6ced6}.stats{display:grid;gap:14px}.stat{padding:22px;border:1px solid #ffffff20;border-radius:18px;background:#ffffff0b}.stat strong{display:block;color:var(--accent);font-size:2rem;letter-spacing:-.05em}.stat span{color:#c3d8dd;font-size:.86rem}.cta{display:grid;gap:22px;align-items:center;padding:30px;color:#fff;border-radius:var(--radius);background:linear-gradient(115deg,var(--brand-dark),#14718e);box-shadow:0 22px 46px #08768b33}.cta h2{margin:0;font-size:clamp(1.7rem,6vw,2.8rem);letter-spacing:-.05em}.cta p{margin:9px 0 0;color:#d1eef1;line-height:1.55}.cta .btn{color:var(--brand-dark);background:#fff}.footer{padding:28px 0;color:var(--muted);border-top:1px solid var(--line);font-size:.8rem}.reveal{opacity:0;transform:translateY(18px);transition:opacity .7s ease,transform .7s ease}.reveal.visible{opacity:1;transform:none}@media(min-width:720px){.container{width:min(1160px,calc(100% - 64px))}.hero{padding:90px 0 110px}.hero-grid{grid-template-columns:1.08fr .92fr}.cards{grid-template-columns:repeat(3,1fr)}.stats{grid-template-columns:repeat(3,1fr)}.cta{grid-template-columns:1fr auto;padding:40px 44px}}@media(max-width:480px){.nav-actions .btn-light{display:none}.hero h1{font-size:3rem}.preview-window{min-height:290px}.map{min-height:210px}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;animation:none!important;transition:none!important}.reveal{opacity:1;transform:none}}
    </style>
</head>
<body>
<div class="landing">
    <header class="container topbar">
        <a class="brand" href="/" aria-label="WazeBR Monitor início"><span class="brand-mark" aria-hidden="true">⌁</span><span>WazeBR<small>Monitor</small></span></a>
        <nav class="nav-actions" aria-label="Navegação pública"><a class="btn btn-light" href="#recursos">Recursos</a><a class="btn btn-primary" href="/login">Entrar <span aria-hidden="true">→</span></a></nav>
    </header>
    <main>
        <section class="container hero"><div class="hero-grid"><div class="reveal"><p class="eyebrow">Plataforma para mobilidade urbana</p><h1>Transforme dados de trânsito em <em>decisões melhores.</em></h1><p>Tenha uma visão completa de alertas, congestionamentos, rotas e condições das vias em um único ambiente, criado para equipes que precisam agir rápido.</p><div class="hero-actions"><a class="btn btn-primary" href="/login">Conhecer o painel <span aria-hidden="true">→</span></a><a class="btn btn-light" href="#recursos">Ver recursos</a></div><div class="proof"><span><b>✓</b> Visão centralizada</span><span><b>✓</b> Operação mais ágil</span></div></div><div class="preview reveal" aria-label="Prévia do monitoramento de mobilidade"><div class="floating f-one"><strong>Ao vivo</strong>Monitoramento ativo</div><div class="preview-window"><div class="window-bar"><i></i><i></i><i></i></div><div class="map"><div class="pin"><span aria-hidden="true">⌖</span></div></div></div><div class="floating f-two"><strong>+24%</strong>visibilidade operacional</div></div></div></section>
        <section id="recursos" class="container"><div class="section-head reveal"><p class="kicker">Recursos para sua operação</p><h2>Uma visão clara do que está acontecendo.</h2><p>Informação organizada para reduzir o tempo entre identificar um problema e tomar uma decisão.</p></div><div class="cards"><article class="card reveal"><div class="icon" aria-hidden="true">⌖</div><h3>Monitoramento em tempo real</h3><p>Acompanhe as condições das vias e os pontos críticos com uma visão atualizada.</p></article><article class="card reveal"><div class="icon" aria-hidden="true">◇</div><h3>Alertas e ocorrências</h3><p>Centralize eventos importantes e encontre rapidamente o que exige atenção.</p></article><article class="card reveal"><div class="icon" aria-hidden="true">↗</div><h3>Rotas e indicadores</h3><p>Compare cenários e use dados para planejar ações com mais segurança.</p></article></div></section>
        <section class="band"><div class="container"><div class="section-head reveal"><p class="kicker">Mais controle, menos ruído</p><h2>Feito para quem precisa enxergar o cenário inteiro.</h2><p>Uma experiência simples para transformar dados dispersos em informação útil para sua equipe.</p></div><div class="stats"><div class="stat reveal"><strong>01</strong><span>Ambiente centralizado</span></div><div class="stat reveal"><strong>24h</strong><span>Informação disponível</span></div><div class="stat reveal"><strong>∞</strong><span>Possibilidades de análise</span></div></div></div></section>
        <section class="container"><div class="cta reveal"><div><h2>Quer tomar decisões com mais confiança?</h2><p>Acesse o WazeBR Monitor e descubra uma nova forma de acompanhar a mobilidade.</p></div><a class="btn" href="/login">Acessar agora <span aria-hidden="true">→</span></a></div></section>
    </main>
    <footer class="container footer">© {{ 'now'|date('Y') }} WazeBR Monitor. Inteligência para uma mobilidade mais eficiente.</footer>
</div>
<script>(()=>{const els=document.querySelectorAll('.reveal');if(!('IntersectionObserver' in window)){els.forEach(e=>e.classList.add('visible'));return}const o=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');o.unobserve(e.target)}}),{threshold:.12});els.forEach(e=>o.observe(e))})()</script>
</body>
</html>