{% extends 'base.html.twig' %}

{% block title %}WazePortalBR | Inteligência para mobilidade urbana{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --wp-ink: #101828;
            --wp-muted: #667085;
            --wp-primary: #2563eb;
            --wp-primary-dark: #1d4ed8;
            --wp-surface: #ffffff;
            --wp-soft: #eff6ff;
            --wp-border: #e4e7ec;
            --wp-radius: 24px;
        }

        .wp-home { overflow: hidden; color: var(--wp-ink); background: #f8fafc; }
        .wp-home * { box-sizing: border-box; }
        .wp-container { width: min(1120px, calc(100% - 32px)); margin-inline: auto; }
        .wp-nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 0; }
        .wp-brand { display: inline-flex; align-items: center; gap: 10px; color: inherit; font-size: 1rem; font-weight: 800; letter-spacing: -.02em; text-decoration: none; }
        .wp-brand-mark { display: grid; width: 38px; height: 38px; place-items: center; color: #fff; background: linear-gradient(135deg, #2563eb, #06b6d4); border-radius: 12px; box-shadow: 0 10px 22px rgba(37, 99, 235, .24); }
        .wp-nav-actions { display: flex; align-items: center; gap: 10px; }
        .wp-btn { display: inline-flex; min-height: 44px; align-items: center; justify-content: center; gap: 8px; padding: 0 17px; border: 1px solid transparent; border-radius: 12px; font: inherit; font-size: .92rem; font-weight: 700; text-decoration: none; cursor: pointer; transition: transform .2s ease, box-shadow .2s ease, background .2s ease; }
        .wp-btn:hover { transform: translateY(-2px); }
        .wp-btn-primary { color: #fff; background: var(--wp-primary); box-shadow: 0 10px 20px rgba(37, 99, 235, .2); }
        .wp-btn-primary:hover { background: var(--wp-primary-dark); box-shadow: 0 14px 26px rgba(37, 99, 235, .28); }
        .wp-btn-ghost { color: var(--wp-ink); border-color: var(--wp-border); background: rgba(255,255,255,.75); }
        .wp-hero { position: relative; padding: 42px 0 70px; }
        .wp-hero-grid { display: grid; gap: 34px; align-items: center; }
        .wp-eyebrow { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 18px; color: var(--wp-primary); font-size: .76rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
        .wp-eyebrow::before { width: 28px; height: 2px; background: #06b6d4; content: ''; }
        .wp-title { max-width: 680px; margin: 0; font-size: clamp(2.35rem, 10vw, 5.2rem); line-height: .98; letter-spacing: -.07em; }
        .wp-title span { color: var(--wp-primary); }
        .wp-lead { max-width: 590px; margin: 22px 0 28px; color: var(--wp-muted); font-size: 1.05rem; line-height: 1.7; }
        .wp-hero-actions { display: flex; flex-wrap: wrap; gap: 10px; }
        .wp-trust { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 24px; color: var(--wp-muted); font-size: .82rem; }
        .wp-trust span { display: inline-flex; align-items: center; gap: 6px; }
        .wp-trust i { color: #16a34a; font-style: normal; }
        .wp-visual { position: relative; min-height: 300px; padding: 20px; background: radial-gradient(circle at 20% 10%, rgba(56,189,248,.35), transparent 34%), linear-gradient(145deg, #0f172a, #172554); border-radius: 30px; box-shadow: 0 26px 70px rgba(15,23,42,.18); transform: rotate(1deg); }
        .wp-visual::after { position: absolute; inset: 12% -10% auto auto; width: 150px; height: 150px; border: 1px solid rgba(255,255,255,.12); border-radius: 50%; content: ''; }
        .wp-map { position: relative; display: grid; min-height: 260px; place-items: center; overflow: hidden; border: 1px solid rgba(255,255,255,.12); border-radius: 20px; background: linear-gradient(135deg, rgba(30,64,175,.8), rgba(8,47,73,.9)); }
        .wp-map::before, .wp-map::after { position: absolute; width: 150%; height: 2px; background: rgba(255,255,255,.13); content: ''; transform: rotate(-25deg); }
        .wp-map::after { transform: rotate(28deg); }
        .wp-pin { z-index: 1; display: grid; width: 68px; height: 68px; place-items: center; color: #fff; background: linear-gradient(135deg, #06b6d4, #2563eb); border: 7px solid rgba(255,255,255,.25); border-radius: 50% 50% 50% 8px; box-shadow: 0 0 0 14px rgba(34,211,238,.12), 0 12px 28px rgba(0,0,0,.26); transform: rotate(-45deg); animation: wp-float 3.4s ease-in-out infinite; }
        .wp-pin svg { transform: rotate(45deg); }
        .wp-badge { position: absolute; z-index: 2; display: flex; align-items: center; gap: 8px; padding: 11px 13px; color: #fff; border: 1px solid rgba(255,255,255,.14); border-radius: 14px; background: rgba(15,23,42,.78); backdrop-filter: blur(10px); font-size: .78rem; font-weight: 700; animation: wp-float 4s ease-in-out infinite reverse; }
        .wp-badge strong { display: block; font-size: 1rem; }
        .wp-badge-one { top: 18px; left: 18px; }
        .wp-badge-two { right: 18px; bottom: 18px; }
        .wp-section { padding: 76px 0; }
        .wp-section-heading { max-width: 650px; margin-bottom: 28px; }
        .wp-kicker { margin: 0 0 10px; color: var(--wp-primary); font-size: .78rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
        .wp-heading { margin: 0; font-size: clamp(1.8rem, 5vw, 3rem); letter-spacing: -.05em; }
        .wp-subheading { margin: 12px 0 0; color: var(--wp-muted); line-height: 1.65; }
        .wp-cards { display: grid; gap: 14px; }
        .wp-card { padding: 24px; border: 1px solid var(--wp-border); border-radius: var(--wp-radius); background: var(--wp-surface); box-shadow: 0 8px 30px rgba(16,24,40,.04); transition: transform .25s ease, box-shadow .25s ease; }
        .wp-card:hover { transform: translateY(-5px); box-shadow: 0 18px 40px rgba(16,24,40,.1); }
        .wp-icon { display: grid; width: 46px; height: 46px; margin-bottom: 20px; place-items: center; color: var(--wp-primary); background: var(--wp-soft); border-radius: 14px; }
        .wp-card h3 { margin: 0 0 8px; font-size: 1.05rem; }
        .wp-card p { margin: 0; color: var(--wp-muted); font-size: .92rem; line-height: 1.65; }
        .wp-cta { display: grid; gap: 22px; align-items: center; padding: 28px; color: #fff; border-radius: var(--wp-radius); background: linear-gradient(115deg, #1d4ed8, #0891b2); box-shadow: 0 20px 45px rgba(29,78,216,.2); }
        .wp-cta h2 { margin: 0; font-size: clamp(1.55rem, 5vw, 2.4rem); letter-spacing: -.04em; }
        .wp-cta p { margin: 8px 0 0; color: rgba(255,255,255,.8); line-height: 1.55; }
        .wp-cta .wp-btn { color: var(--wp-primary-dark); background: #fff; }
        .wp-footer { padding: 28px 0; color: var(--wp-muted); border-top: 1px solid var(--wp-border); font-size: .82rem; }
        .wp-reveal { opacity: 0; transform: translateY(18px); transition: opacity .7s ease, transform .7s ease; }
        .wp-reveal.is-visible { opacity: 1; transform: none; }
        @keyframes wp-float { 0%,100% { transform: translateY(0) rotate(-45deg); } 50% { transform: translateY(-10px) rotate(-45deg); } }
        @media (min-width: 700px) { .wp-container { width: min(1120px, calc(100% - 64px)); } .wp-hero { padding: 76px 0 100px; } .wp-hero-grid { grid-template-columns: 1.05fr .95fr; } .wp-cards { grid-template-columns: repeat(3, 1fr); } .wp-cta { grid-template-columns: 1fr auto; padding: 38px 42px; } }
        @media (max-width: 480px) { .wp-nav-actions .wp-btn-ghost { display: none; } .wp-title { font-size: 2.7rem; } .wp-visual { min-height: 270px; } }
        @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } .wp-reveal { opacity: 1; transform: none; } }
    </style>
{% endblock %}

{% block body %}
<div class="wp-home">
    <header class="wp-container wp-nav">
        <a class="wp-brand" href="{{ path('app_home')|default('/') }}" aria-label="WazePortalBR início">
            <span class="wp-brand-mark" aria-hidden="true">⌁</span>
            <span>WazePortalBR</span>
        </a>
        <nav class="wp-nav-actions" aria-label="Navegação principal">
            <a class="wp-btn wp-btn-ghost" href="#recursos">Recursos</a>
            <a class="wp-btn wp-btn-primary" href="/login">Entrar <span aria-hidden="true">→</span></a>
        </nav>
    </header>

    <main>
        <section class="wp-container wp-hero">
            <div class="wp-hero-grid">
                <div class="wp-reveal">
                    <p class="wp-eyebrow">Mobilidade orientada por dados</p>
                    <h1 class="wp-title">Mais clareza para cada <span>trajeto.</span></h1>
                    <p class="wp-lead">Monitore ocorrências, rotas e condições de trânsito em uma plataforma feita para transformar dados do Waze em decisões mais rápidas.</p>
                    <div class="wp-hero-actions">
                        <a class="wp-btn wp-btn-primary" href="/login">Acessar painel <span aria-hidden="true">→</span></a>
                        <a class="wp-btn wp-btn-ghost" href="#recursos">Conhecer recursos</a>
                    </div>
                    <div class="wp-trust" aria-label="Benefícios">
                        <span><i aria-hidden="true">✓</i> Dados centralizados</span>
                        <span><i aria-hidden="true">✓</i> Visão em tempo real</span>
                    </div>
                </div>
                <div class="wp-visual wp-reveal" aria-label="Ilustração de mapa e monitoramento">
                    <div class="wp-badge wp-badge-one"><span aria-hidden="true">●</span><span><strong>Ao vivo</strong>Monitoramento ativo</span></div>
                    <div class="wp-map"><div class="wp-pin" aria-hidden="true"><svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg></div></div>
                    <div class="wp-badge wp-badge-two"><span aria-hidden="true">↗</span><span><strong>+24%</strong>visibilidade</span></div>
                </div>
            </div>
        </section>

        <section id="recursos" class="wp-container wp-section">
            <div class="wp-section-heading wp-reveal"><p class="wp-kicker">Uma visão mais inteligente</p><h2 class="wp-heading">Tudo o que você precisa em um só lugar.</h2><p class="wp-subheading">Acompanhe os principais dados de mobilidade com uma experiência simples, rápida e preparada para qualquer tela.</p></div>
            <div class="wp-cards">
                <article class="wp-card wp-reveal"><div class="wp-icon" aria-hidden="true">⌖</div><h3>Rotas monitoradas</h3><p>Visualize os corredores e pontos mais importantes para sua operação.</p></article>
                <article class="wp-card wp-reveal"><div class="wp-icon" aria-hidden="true">◈</div><h3>Ocorrências organizadas</h3><p>Encontre alertas e eventos com filtros que ajudam na resposta rápida.</p></article>
                <article class="wp-card wp-reveal"><div class="wp-icon" aria-hidden="true">↗</div><h3>Dados para decidir</h3><p>Transforme informações de trânsito em uma visão prática do cenário.</p></article>
            </div>
        </section>

        <section class="wp-container wp-section">
            <div class="wp-cta wp-reveal"><div><h2>Pronto para enxergar a mobilidade de outro jeito?</h2><p>Entre no painel e tenha uma visão mais clara das suas rotas.</p></div><a class="wp-btn" href="/login">Entrar no painel <span aria-hidden="true">→</span></a></div>
        </section>
    </main>

    <footer class="wp-container wp-footer">© {{ 'now'|date('Y') }} WazePortalBR. Dados para uma mobilidade mais inteligente.</footer>
</div>
<script>
    (() => { const items = document.querySelectorAll('.wp-reveal'); if (!('IntersectionObserver' in window)) { items.forEach(item => item.classList.add('is-visible')); return; } const observer = new IntersectionObserver(entries => entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { threshold: .12 }); items.forEach(item => observer.observe(item)); })();
</script>
{% endblock %}