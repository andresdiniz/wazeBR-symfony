                <br>
                A solução completa para gestão urbana e mobilidade.
            </p>
            <div class="home-cta">
                <a href="{{ path('app_login') }}" class="home-cta-btn primary">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    Entrar
                </a>
                <a href="{{ path('partner_register') }}" class="home-cta-btn secondary">
                    <i class="bi bi-person-plus me-2"></i>
                    Criar Conta
                </a>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="home-features">
        <div class="home-features-grid">
            <div class="home-feature-card">
                <div class="home-feature-icon">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <h3 class="home-feature-title">Alertas em Tempo Real</h3>
                <p class="home-feature-text">
                    Monitoramento contí££uo de incidentes e ocorrê££ncias nas vias monitoradas.
                </p>
            </div>

            <div class="home-feature-card">
                <div class="home-feature-icon">
                    <i class="bi bi-sign-merge-right"></i>
                </div>
                <h3 class="home-feature-title">Trâ££ego Inteligente</h3>
                <p class="home-feature-text">
                    Análise de congestionamentos e fluxo de veí££ulos com dados em tempo real.
                </p>
            </div>

            <div class="home-feature-card">
                <div class="home-feature-icon">
                    <i class="bi bi-droplet"></i>
                </div>
                <h3 class="home-feature-title">Monitoramento Hidro</h3>
                <p class="home-feature-text">
                    Acompanhamento de níveis de rios e estaçµµ pluviomê¡£icas integrado.
                </p>
            </div>

            <div class="home-feature-card">
                <div class="home-feature-icon">
                    <i class="bi bi-graph-up"></i>
                </div>
                <h3 class="home-feature-title">Dashboards</h3>
                <p class="home-feature-text">
                    Visualizaçª£o completa com gráficos, mapas e métricas de desempenho.
                </p>
            </div>
        </div>
    </section>
    {% endblock %}

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Public Pages JS -->
    <script type="module">
        import initPublicPages from '{{ asset('js/public-pages.js') }}';
        initPublicPages();
    </script>

    {% block javascripts %}{% endblock %}
</body>
</html>
