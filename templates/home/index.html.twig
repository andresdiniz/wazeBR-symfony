{% extends 'base.html.twig' %}

{% block title %}Bem-vindo{% endblock %}

{% block body %}
<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-8 text-center">
            <h1 class="display-4">Bem-vindo ao WazeBR</h1>
            <p class="lead">Sistema de monitoramento de trâº£nsito em tempo real</p>
            {% if not app.user %}
                <div class="mt-4">
