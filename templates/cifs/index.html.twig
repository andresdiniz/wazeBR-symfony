{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Eventos CIFS{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
    <link rel="stylesheet" href="{{ asset('css/cifs.css') }}">
{% endblock %}

{% block body %}
<div class="dashboard-wrapper">

    {# ── Sidebar ─────────────────────────────────────────────────────── #}
    <aside class="dashboard-sidebar" id="dashboard-sidebar">
        <div class="dashboard-sidebar-header">
            <a href="{{ path('dashboard') }}" class="dashboard-brand">
                <span class="dashboard-brand-icon"><i class="fas fa-road"></i></span>
                <span class="dashboard-brand-text">waze<span>BR</span></span>
            </a>
            <button class="dashboard-sidebar-close" data-dashboard-sidebar-close aria-label="Fechar menu">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <nav class="dashboard-nav" aria-label="Navegação principal">
            <p class="dashboard-nav-label">Principal</p>
            <ul class="dashboard-nav-list">
                <li>
                    <a href="{{ path('dashboard') }}" class="dashboard-nav-link">
                        <i class="fas fa-gauge-high"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="{{ path('cifs_index') }}" class="dashboard-nav-link is-active" aria-current="page">
                        <i class="fas fa-triangle-exclamation"></i>
                        <span>Eventos CIFS</span>
                    </a>
                </li>
            </ul>

            <p class="dashboard-nav-label">Sistema</p>
            <ul class="dashboard-nav-list">
                <li>
                    <a href="{{ path('app_logout') }}" class="dashboard-nav-link">
                        <i class="fas fa-right-from-bracket"></i>
                        <span>Sair</span>
                    </a>
                </li>
            </ul>
        </nav>

        <div class="dashboard-sidebar-footer">
            <div class="dashboard-user-summary">
                <div class="dashboard-user-avatar"><i class="fas fa-user"></i></div>
                <div class="dashboard-user-data">
                    <strong>{{ app.user.name ?? app.user.email }}</strong>
                    <small>{{ app.user.roles|first|replace({'ROLE_': ''})|capitalize }}</small>
                </div>
            </div>
        </div>
    </aside>

    {# ── Shell principal ──────────────────────────────────────────────── #}
    <div class="dashboard-shell">

        {# Topbar #}
        <header class="dashboard-topbar">
            <div class="dashboard-topbar-start">
                <button class="dashboard-sidebar-toggle" data-dashboard-sidebar-toggle aria-label="Abrir menu" aria-expanded="false">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="dashboard-page-heading">
                    <p class="dashboard-page-eyebrow">Waze CIFS</p>
                    <h1>Eventos de Tráfego</h1>
                </div>
            </div>
            <div class="dashboard-topbar-end">
                <div class="dashboard-account-menu">
                    <button class="dashboard-account-trigger" id="accountMenuTrigger" aria-haspopup="true" aria-expanded="false">
                        <div class="dashboard-user-avatar dashboard-user-avatar-large"><i class="fas fa-user"></i></div>
                        <span class="dashboard-account-name">{{ app.user.name ?? app.user.email }}</span>
                        <i class="fas fa-chevron-down"></i>
                    </button>
                    <div class="dashboard-account-dropdown" id="accountDropdown" hidden>
                        <div class="dashboard-account-dropdown-user">
                            <div class="dashboard-user-avatar"><i class="fas fa-user"></i></div>
                            <div>
                                <strong>{{ app.user.name ?? app.user.email }}</strong>
                                <span>{{ app.user.email }}</span>
                            </div>
                        </div>
                        <div class="dashboard-account-dropdown-divider"></div>
                        <a href="{{ path('app_logout') }}" class="is-danger">
                            <i class="fas fa-right-from-bracket"></i> Sair
                        </a>
                    </div>
                </div>
            </div>
        </header>

        {# Conteúdo #}
        <main class="dashboard-main" id="cifs-main">

            {# Flash messages #}
            {% for type, messages in app.session.flashBag.all %}
                {% for message in messages %}
                    <div class="cifs-flash cifs-flash--{{ type }}" role="alert">
                        <i class="fas fa-{{ type == 'success' ? 'check-circle' : (type == 'danger' ? 'circle-xmark' : 'info-circle') }}"></i>
                        {{ message }}
                        <button type="button" class="cifs-flash__close" aria-label="Fechar"><i class="fas fa-times"></i></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {# ── Layout de duas colunas ─────────────────────────────── #}
            <div class="cifs-layout">

                {# Painel esquerdo: mapa + lista de eventos #}
                <div class="cifs-left">

                    {# Mapa #}
                    <div class="cifs-card">
                        <div class="cifs-card__header">
                            <h2 class="cifs-card__title">
                                <i class="fas fa-map-location-dot"></i>
                                Mapa — clique para desenhar o segmento
                            </h2>
                            <div class="cifs-map-toolbar">
                                <button id="btn-draw" class="cifs-btn cifs-btn--primary" type="button">
                                    <i class="fas fa-draw-polygon"></i> Desenhar
                                </button>
                                <button id="btn-clear-map" class="cifs-btn cifs-btn--ghost" type="button">
                                    <i class="fas fa-trash"></i> Limpar
                                </button>
                                <span id="map-hint" class="cifs-map-hint">Clique em "Desenhar" e marque pontos no mapa</span>
                            </div>
                        </div>
                        <div id="cifs-map" class="cifs-map" aria-label="Mapa interativo para marcação de evento CIFS"></div>
                    </div>

                    {# Lista de eventos #}
                    <div class="cifs-card cifs-card--events">
                        <div class="cifs-card__header">
                            <h2 class="cifs-card__title">
                                <i class="fas fa-list-ul"></i>
                                Eventos recentes
                                <span class="cifs-badge">{{ events|length }}</span>
                            </h2>
                            <div class="cifs-filter-bar">
                                <input type="search" id="filter-events" placeholder="Filtrar por via ou tipo…"
                                       class="cifs-search" aria-label="Filtrar eventos">
                                <label class="cifs-check-label">
                                    <input type="checkbox" id="filter-active" checked>
                                    Apenas ativos
                                </label>
                            </div>
                        </div>

                        {% if events is empty %}
                            <div class="cifs-empty">
                                <i class="fas fa-road"></i>
                                <p>Nenhum evento cadastrado ainda.</p>
                                <p class="cifs-empty__sub">Use o formulário ao lado para criar o primeiro evento.</p>
                            </div>
                        {% else %}
                            <ul class="cifs-event-list" id="event-list">
                                {% for event in events %}
                                    <li class="cifs-event-item {% if not event.active %}cifs-event-item--inactive{% endif %}"
                                        data-active="{{ event.active ? '1' : '0' }}"
                                        data-type="{{ event.type.value }}"
                                        data-street="{{ event.street|lower }}">

                                        <div class="cifs-event-icon cifs-event-icon--{{ event.type.value|lower }}">
                                            {% if event.type.value == 'ROAD_CLOSED' %}
                                                <i class="fas fa-road-barrier"></i>
                                            {% elseif event.type.value starts with 'HAZARD' %}
                                                <i class="fas fa-triangle-exclamation"></i>
                                            {% else %}
                                                <i class="fas fa-car-burst"></i>
                                            {% endif %}
                                        </div>

                                        <div class="cifs-event-body">
                                            <strong class="cifs-event-street">{{ event.street }}</strong>
                                            <span class="cifs-event-meta">
                                                {{ typesMap[event.type.value] ?? event.type.value }}
                                                {% if event.subtype %}· {{ subtypesMap[event.subtype] ?? event.subtype }}{% endif %}
                                            </span>
                                            {% if event.description %}
                                                <span class="cifs-event-desc">{{ event.description }}</span>
                                            {% endif %}
                                            <span class="cifs-event-time">
                                                <i class="fas fa-clock"></i>
                                                {{ event.startTime|date('d/m H:i') }}
                                                {% if event.endTime %}→ {{ event.endTime|date('d/m H:i') }}{% endif %}
                                            </span>
                                        </div>

                                        <div class="cifs-event-actions">
                                            {% if event.active %}
                                                <span class="cifs-status cifs-status--active">Ativo</span>
                                                <button type="button"
                                                        class="cifs-btn cifs-btn--danger cifs-btn--sm btn-deactivate"
                                                        data-id="{{ event.id }}"
                                                        title="Desativar evento">
                                                    <i class="fas fa-stop"></i>
                                                </button>
                                            {% else %}
                                                <span class="cifs-status cifs-status--inactive">Inativo</span>
                                            {% endif %}
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </div>

                {# Painel direito: formulário #}
                <div class="cifs-right">
                    <div class="cifs-card cifs-card--form">
                        <div class="cifs-card__header">
                            <h2 class="cifs-card__title">
                                <i class="fas fa-plus-circle"></i>
                                Novo Evento CIFS
                            </h2>
                        </div>

                        <form id="cifs-form" class="cifs-form" novalidate>

                            {# Tipo #}
                            <div class="cifs-field">
                                <label for="f-type" class="cifs-label">Tipo <span class="cifs-required">*</span></label>
                                <select id="f-type" name="type" class="cifs-select" required>
                                    <option value="">Selecione o tipo…</option>
                                    {% for type, subtypes in grouped %}
                                        <optgroup label="{{ typesMap[type] ?? type }}">
                                            <option value="{{ type }}">{{ typesMap[type] ?? type }} (genérico)</option>
                                            {% for subtype in subtypes %}
                                                <option value="{{ subtype.type }}" data-subtype="{{ subtype.subtype }}">
                                                    {{ subtype.label }}
                                                </option>
                                            {% endfor %}
                                        </optgroup>
                                    {% endfor %}
                                </select>
                                <input type="hidden" id="f-subtype" name="subtype">
                            </div>

                            {# Sentido #}
                            <div class="cifs-field">
                                <label for="f-direction" class="cifs-label">Sentido</label>
                                <select id="f-direction" name="direction" class="cifs-select">
                                    <option value="">Não especificado</option>
                                    {% for dir in directions %}
                                        <option value="{{ dir.value }}">
                                            {% if dir.value == 'ONE_DIRECTION' %}Um sentido
                                            {% elseif dir.value == 'BOTH_DIRECTIONS' %}Ambos os sentidos
                                            {% else %}{{ dir.value }}{% endif %}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            {# Via #}
                            <div class="cifs-field">
                                <label for="f-street" class="cifs-label">Nome da via <span class="cifs-required">*</span></label>
                                <div class="cifs-input-wrap">
                                    <input type="text" id="f-street" name="street" class="cifs-input"
                                           placeholder="Ex.: Av. Brasil" required maxlength="150"
                                           autocomplete="off">
                                    <button type="button" id="btn-geocode" class="cifs-input-addon" title="Sugerir via pelo ponto no mapa">
                                        <i class="fas fa-location-crosshairs"></i>
                                    </button>
                                </div>
                                <ul id="street-suggestions" class="cifs-suggestions" hidden></ul>
                            </div>

                            {# Descrição #}
                            <div class="cifs-field">
                                <label for="f-description" class="cifs-label">Descrição <span class="cifs-hint">(máx. 40 chars)</span></label>
                                <input type="text" id="f-description" name="description" class="cifs-input"
                                       placeholder="Obra, acidente…" maxlength="40">
                                <span class="cifs-charcount"><span id="desc-count">0</span>/40</span>
                            </div>

                            {# Início #}
                            <div class="cifs-field-row">
                                <div class="cifs-field">
                                    <label for="f-start" class="cifs-label">Início <span class="cifs-required">*</span></label>
                                    <input type="datetime-local" id="f-start" name="starttime" class="cifs-input" required>
                                </div>
                                <div class="cifs-field">
                                    <label for="f-end" class="cifs-label">Fim <span class="cifs-hint">(opcional)</span></label>
                                    <input type="datetime-local" id="f-end" name="endtime" class="cifs-input">
                                </div>
                            </div>

                            {# Lane impact (condicional) #}
                            <div class="cifs-field" id="lane-impact-section" hidden>
                                <label class="cifs-label">Faixas fechadas</label>
                                <div class="cifs-field-row">
                                    <div class="cifs-field">
                                        <input type="number" id="f-lanes" name="lane_impact[total_closed_lanes]"
                                               class="cifs-input" min="1" max="10" placeholder="Qtd. faixas">
                                    </div>
                                    <div class="cifs-field">
                                        <select id="f-roadside" name="lane_impact[roadside]" class="cifs-select">
                                            <option value="">Lado</option>
                                            {% for rs in roadsides %}
                                                <option value="{{ rs.value }}">{{ rs.value }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            </div>

                            {# Agendamento semanal #}
                            <details class="cifs-details">
                                <summary class="cifs-details__trigger">
                                    <i class="fas fa-calendar-week"></i>
                                    Agendamento semanal <span class="cifs-hint">(opcional)</span>
                                </summary>
                                <div class="cifs-schedule-grid">
                                    {% for key, label in weekdays %}
                                        <div class="cifs-schedule-row">
                                            <label class="cifs-check-label">
                                                <input type="checkbox" name="schedule_days[]" value="{{ key }}"
                                                       class="schedule-day-cb"> {{ label }}
                                            </label>
                                            <input type="text" name="schedule[{{ key }}]"
                                                   class="cifs-input cifs-input--schedule schedule-hours"
                                                   placeholder="09:00-12:00" disabled>
                                        </div>
                                    {% endfor %}
                                </div>
                            </details>

                            {# Polilinha (hidden) #}
                            <input type="hidden" id="f-polyline" name="polyline">

                            {# Preview do segmento #}
                            <div id="polyline-preview" class="cifs-polyline-preview" hidden>
                                <i class="fas fa-route"></i>
                                <span id="polyline-preview-text"></span>
                                <button type="button" id="btn-clear-polyline" class="cifs-btn cifs-btn--ghost cifs-btn--sm">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>

                            {# Mensagem de erro da API #}
                            <div id="form-error" class="cifs-form-error" hidden role="alert"></div>

                            {# Submit #}
                            <button type="submit" id="btn-submit" class="cifs-btn cifs-btn--primary cifs-btn--full">
                                <i class="fas fa-floppy-disk"></i>
                                <span>Criar Evento</span>
                            </button>
                        </form>
                    </div>

                    {# Feeds de exportação #}
                    <div class="cifs-card cifs-card--feeds">
                        <div class="cifs-card__header">
                            <h2 class="cifs-card__title">
                                <i class="fas fa-rss"></i>
                                Feeds de exportação
                            </h2>
                        </div>
                        <div class="cifs-feed-links">
                            <a href="{{ path('cifs_feed_json') }}" class="cifs-feed-link cifs-feed-link--json" target="_blank" rel="noopener">
                                <i class="fas fa-code"></i>
                                <div>
                                    <strong>JSON Feed</strong>
                                    <span>Formato nativo Waze CIFS</span>
                                </div>
                                <i class="fas fa-arrow-up-right-from-square cifs-feed-link__arrow"></i>
                            </a>
                            <a href="{{ path('cifs_feed_xml') }}" class="cifs-feed-link cifs-feed-link--xml" target="_blank" rel="noopener">
                                <i class="fas fa-file-code"></i>
                                <div>
                                    <strong>XML Feed</strong>
                                    <span>Formato legado compatível</span>
                                </div>
                                <i class="fas fa-arrow-up-right-from-square cifs-feed-link__arrow"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <footer class="dashboard-footer">
            <div class="dashboard-footer-content">
                <span>TrafikHub &copy; {{ "now"|date("Y") }}</span>
                <div class="dashboard-footer-links">
                    <a href="{{ path('cifs_feed_json') }}" target="_blank">JSON Feed</a>
                    <a href="{{ path('cifs_feed_xml') }}" target="_blank">XML Feed</a>
                </div>
            </div>
        </footer>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV/XN/WPaU=" crossorigin=""></script>
    <script>
        window.CIFS_ROUTES = {
            apiSave:           "{{ path('cifs_api_save') }}",
            apiDeactivate:     "{{ path('cifs_api_deactivate', {id: '__ID__'}) }}",
            apiGeocodeReverse: "{{ path('cifs_api_geocode_reverse') }}",
            apiTypes:          "{{ path('cifs_api_types') }}"
        };
    </script>
    <script src="{{ asset('js/cifs.js') }}"></script>
{% endblock %}
