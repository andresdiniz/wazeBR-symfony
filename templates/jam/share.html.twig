<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ jam.street|default('Congestionamento') }} — WazeBR</title>
<style>
body { margin:0; font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif; background:#0f172a; color:#e2e8f0; display:flex; align-items:center; justify-content:center; min-height:100vh; padding:24px; }
.share-card { background:#1e293b; border:1px solid #334155; border-radius:16px; padding:32px; max-width:560px; width:100%; box-shadow:0 20px 50px rgba(0,0,0,.35); }
.kicker { font-size:12px; letter-spacing:.08em; text-transform:uppercase; color:#94a3b8; }
h1 { margin:12px 0 4px; font-size:26px; color:#f8fafc; }
.meta { margin:0 0 20px; color:#94a3b8; }
.badges { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:20px; }
.badges span { background:#0f172a; border:1px solid #334155; border-radius:999px; padding:6px 12px; font-size:13px; }
.updated { color:#94a3b8; font-size:13px; margin:0 0 16px; }
.note { color:#64748b; font-size:12px; border-top:1px solid #334155; padding-top:16px; margin:0; }
</style>
</head>
<body>
<div class="share-card">
<span class="kicker">Congestionamento compartilhado</span>
<h1>{{ jam.street|default('Via não informada') }}</h1>
<p class="meta">{{ jam.city|default('—') }}{% if jam.country %} · {{ jam.country }}{% endif %}</p>
<div class="badges">
<span>Nível {{ jam.level|default(0) }} · {{ jams_label('level.' ~ jam.level|default(0)) }}</span>
<span>{{ jam.delayMin is not null ? jam.delayMin ~ ' min de atraso' : 'Sem atraso informado' }}</span>
<span>{{ jam.speed|default(0)|number_format(0, ',', '.') }} km/h</span>
<span>{{ jam.lengthKm|default(0) }} km</span>
</div>
<p class="updated">Coletado em {{ jams_date(jam.when, true) }}{% if jam.lastSeen %} · visto por último em {{ jams_date(jam.lastSeen, true) }}{% endif %}</p>
<p class="note">Este é um link público temporário. Os dados podem mudar após a visualização.</p>
</div>
</body>
</html>
