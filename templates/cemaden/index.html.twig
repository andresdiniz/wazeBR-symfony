{% extends 'base.html.twig' %}

{% block title %}CEMADEN - Dados Pluviométricos e Hidrológicos{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.cemaden-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: var(--space-4);
}
.page-header {
  margin-bottom: var(--space-5);
}
.page-header h1 {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: 700;
  letter-spacing: -.02em;
}
.section-title {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-lg);
  font-weight: 600;
  margin-bottom: var(--space-3);
}
.section-title i {
  color: var(--color-primary);
}
.table-wrapper {
  overflow-x: auto;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-sm);
  margin-bottom: var(--space-6);
}
.table-wrapper table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--text-sm);
}
.table-wrapper table th {
  background: var(--color-surface-offset);
  padding: var(--space-3) var(--space-4);
  text-align: left;
  font-weight: 600;
  color: var(--color-text-muted);
  border-bottom: 2px solid var(--color-border);
  white-space: nowrap;
}
.table-wrapper table td {
  padding: var(--space-3) var(--space-4);
  border-bottom: 1px solid var(--color-border);
  vertical-align: middle;
}
.table-wrapper table tbody tr:hover td {
  background: var(--color-surface-offset);
}
.empty-cell {
  text-align: center;
  padding: var(--space-8) !important;
  color: var(--color-text-muted);
}
.badge-offline {
  background: var(--color-text-faint);
  color: var(--color-text-inverse);
  padding: 0.15rem 0.5rem;
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: 600;
}
.badge-ativo {
  background: var(--color-blue);
  color: #fff;
  padding: 0.15rem 0.5rem;
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: 600;
}
.badge-verde   { background: var(--color-success); color: #fff; }
.badge-amarelo { background: var(--color-gold); color: #fff; }
.badge-laranja { background: var(--color-orange); color: #fff; }
.badge-vermelho{ background: var(--color-error); color: #fff; }
</style>
{% endblock %}

{% block body %}
<div class="cemaden-container">
  <div class="page-header">
    <h1>🌧️ Dados CEMADEN</h1>
    <p class="text-muted">Monitoramento pluviométrico e hidrológico para o parceiro <strong>{{ partner.name }}</strong></p>
  </div>

  {# ─── Dados HIDROLÓGICOS (Nível dos Rios) ─── #}
  {% if hydro_data is defined and hydro_data|length > 0 %}
  <div class="section-title">
    <i data-lucide="waves"></i> Nível dos Rios
    <span class="badge bg-secondary ms-2">{{ hydro_data|length }} estações</span>
  </div>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Estação</th>
          <th>Município</th>
          <th>UF</th>
          <th>Nível (m)</th>
          <th>Sensor (m)</th>
          <th>Status</th>
          <th>Medido em</th>
        </tr>
      </thead>
      <tbody>
        {% for h in hydro_data %}
        <tr>
          <td>
            <span style="font-weight:500">{{ h.nome }}</span><br>
            <span style="font-size:var(--text-xs);color:var(--color-text-muted)">{{ h.cod_estacao }}</span>
          </td>
          <td>{{ h.municipio }}</td>
          <td>{{ h.uf }}</td>
          <td>
            {% if h.is_offline %}
              <span style="color:var(--color-text-muted)">Offline</span>
            {% elseif h.river_level is not null %}
              <strong style="font-size:var(--text-lg)">{{ h.river_level|number_format(2, ',', '.') }}</strong>
              <span style="color:var(--color-text-muted);font-size:var(--text-xs)"> m</span>
            {% else %}
              —
            {% endif %}
          </td>
          <td>
            {% if h.sensor_value is not null %}
              {{ h.sensor_value|number_format(3, ',', '.') }} m
            {% else %}
              —
            {% endif %}
          </td>
          <td>
            {% if h.is_offline %}
              <span class="badge-offline">OFFLINE</span>
            {% else %}
              <span class="badge-ativo">ATIVO</span>
            {% endif %}
          </td>
          <td>
            <time data-utc="{{ h.measured_at }}" data-fmt="datetime">{{ h.measured_at|date('d/m/Y H:i') }}</time>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  {# ─── Dados PLUVIOMÉTRICOS (Chuva) ─── #}
  <div class="section-title">
    <i data-lucide="cloud-rain"></i> Dados Pluviométricos
    <span class="badge bg-secondary ms-2">{{ data|length }} registros</span>
  </div>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Estação</th>
          <th>Município</th>
          <th>UF</th>
          <th>Chuva Acumulada (mm)</th>
          <th>Nível</th>
          <th>Medido em</th>
        </tr>
      </thead>
      <tbody>
        {% for item in data %}
        <tr>
          <td>{{ item.stationCode ?? '—' }}</td>
          <td>{{ item.municipality ?? '—' }}</td>
          <td>{{ item.state ?? '—' }}</td>
          <td>{{ item.accumulatedRain is not null ? item.accumulatedRain|number_format(1,',','.') : '—' }}</td>
          <td>
            {% set lvl = item.alertLevel ?? '' %}
            {% if lvl == 'VERMELHO' %}
              <span class="badge-vermelho">VERMELHO</span>
            {% elseif lvl == 'LARANJA' %}
              <span class="badge-laranja">LARANJA</span>
            {% elseif lvl == 'AMARELO' %}
              <span class="badge-amarelo">AMARELO</span>
            {% elseif lvl == 'VERDE' %}
              <span class="badge-verde">VERDE</span>
            {% else %}
              <span style="color:var(--color-text-muted)">{{ lvl ?: '—' }}</span>
            {% endif %}
          </td>
          <td>
            <time data-utc="{{ item.measuredAt|date('c') }}" data-fmt="datetime">{{ item.measuredAt|date('d/m/Y H:i') }}</time>
          </td>
        </tr>
        {% else %}
        <tr><td colspan="6" class="empty-cell">Nenhum dado pluviométrico encontrado.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
  if (typeof lucide !== 'undefined' && typeof lucide.createIcons === 'function') {
    lucide.createIcons();
  }
});
</script>
{% endblock %}

