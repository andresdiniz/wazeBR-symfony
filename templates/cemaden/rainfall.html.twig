{% extends 'base.html.twig' %}

{% block title %}Quantidade de Chuva{% endblock %}

{% block header_title %}
    <i class="bi bi-droplet"></i> Quantidade de Chuva
{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-primary mb-1">
                <i class="bi bi-cloud-rain"></i>
                Monitoramento Pluviométrico
            </h2>
            <p class="text-muted mb-0">
                Acompanhamento da chuva acumulada nas estações pluviométricas.
            </p>
        </div>
    </div>

    <div class="row g-4">
        {% for card in stationCards %}
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-primary text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="bi bi-droplet"></i>
                                {{ card.station.nome }}
                            </h5>

                            <span class="badge bg-light text-primary">
                                {{ card.station.codEstacao }}
                            </span>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="mb-4">
                            <small class="text-muted d-block mb-1">
                                CHUVA ACUMULADA
                            </small>

                            {% if card.lastRainfall is not null %}
                                <div class="fs-3 fw-bold text-primary">
                                    {{ card.lastRainfall|number_format(2, ',', '.') }} mm
                                </div>
                            {% else %}
                                <div class="fs-4 fw-bold text-muted">
                                    Sem dados
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            <small class="text-muted d-block mb-1">
                                MUNICÍPIO
                            </small>
                            <div>
                                <i class="bi bi-geo-alt"></i>
                                {{ card.station.municipio }} - {{ card.station.uf }}
                            </div>
                        </div>

                        <div>
                            <small class="text-muted d-block mb-1">
                                ÚLTIMA MEDIÇÃO
                            </small>

                            {% if card.lastRainfallAt is not null %}
                                <div>
                                    <i class="bi bi-clock"></i>
                                    {{ card.lastRainfallAt|date('d/m/Y H:i') }}
                                </div>
                            {% else %}
                                <div class="text-muted">—</div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="card-footer bg-transparent">
                        <a
                            href="{{ path('app_cemaden_station_show', {id: card.station.id}) }}"
                            class="btn btn-outline-primary btn-sm w-100"
                        >
                            <i class="bi bi-eye"></i>
                            Ver detalhes
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle"></i>
                    Nenhuma estação pluviométrica ativa foi encontrada.
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
