{% extends 'layouts/dashboard.html.twig' %}

{% block title %}{{ light.name }} — {{ partner.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"
          integrity="sha512-h9FcoyWjHcOcmEVkxOfTLnmZFWIH0iZhZT1H2TbOq55xssQGEJHEaIm+PgoUaZbRvQTNTluNOEfb1ZRy6D3BOw=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="{{ asset('css/pages/traffic-light.css') }}">
    <link rel="stylesheet" href="{{ asset('css/pages/traffic-light-show.css') }}">
{% endblock %}

{% block content %}
{% set state      = latest and latest.state ? latest.state : null %}
{% set phases     = state and state.phases is defined ? state.phases : [] %}
{% set firstPhase = phases|length > 0 ? phases[0] : null %}
{% set currentColor = firstPhase and firstPhase.color is defined ? firstPhase.color : 'OFF' %}
{% set currentMode  = state and state.mode is defined ? state.mode : 'UNKNOWN' %}
{% set isFlashing   = currentMode == 'FLASH' %}
{% set isDark       = currentColor == 'OFF' %}

{% set colorLabel = {
    'RED':    '🔴 Vermelho',
    'YELLOW': '🟡 Amarelo',
    'GREEN':  '🟢 Verde',
    'OFF':    '⚫ Apagado',
}[currentColor] ?? '⚪ Desconhecido' %}

<div class="pf-form tl-show"
     data-tl-live-url="{{ path('traffic_light_read', {id: light.id}) }}"
     data-tl-live-interval="1000">

    <a href="{{ path('traffic_light_list') }}" class="pf-form__breadcrumb">
        ← Voltar para lista
    </a>

    {# ── Hero com fixture do semáforo ─────────────────────────── #}
    <div class="tl-show__hero">
        <div id="tl-fixture"
             class="tl-fixture tl-fixture--lg{% if isFlashing %} is-flashing{% endif %}{% if isDark %} is-dark{% endif %}"
             data-current-color="{{ currentColor }}"
             data-current-mode="{{ currentMode }}">
            <div class="tl-bulb tl-bulb--red    {% if currentColor == 'RED'    %}is-on{% endif %}" data-phase="1"></div>
            <div class="tl-bulb tl-bulb--yellow {% if currentColor == 'YELLOW' %}is-on{% endif %}" data-phase="1"></div>
            <div class="tl-bulb tl-bulb--green  {% if currentColor == 'GREEN'  %}is-on{% endif %}" data-phase="1"></div>
        </div>

        <div class="tl-show__hero-info">
            <h1 class="tl-show__hero-title">{{ light.name }}</h1>
            <div class="tl-show__hero-sub">
                <span><code>{{ light.code }}</code></span>
                <span>Protocolo: <strong>{{ light.protocol }}</strong></span>
                <span>Endpoint: <code>{{ light.endpoint }}</code></span>
            </div>

            <div class="tl-show__hero-meta">
                <span>
                    {% if light.lastReadStatus == 'OK' %}
                        <span class="tl-badge tl-badge--ok"><span class="tl-status-dot tl-status-dot--ok"></span> OK</span>
                    {% elseif light.lastReadStatus == 'ERROR' %}
                        <span class="tl-badge tl-badge--error"><span class="tl-status-dot tl-status-dot--error"></span> ERRO</span>
                    {% else %}
                        <span class="tl-badge tl-badge--neutral">—</span>
                    {% endif %}
                </span>
                <span class="tl-badge tl-badge--info" id="tl-current-color-badge">
                    Cor atual: <strong>{{ colorLabel }}</strong>
                </span>
                <span id="tl-last-read-label">
                    {{ light.lastReadAt ? light.lastReadAt|date('d/m/Y H:i:s') : 'Nunca lido' }}
                </span>
            </div>

            <div class="tl-show__header-actions">
                <button type="button" id="tl-live-toggle" class="pf-btn pf-btn--live" aria-pressed="false">
                    <span class="tl-live-dot" aria-hidden="true"></span>
                    <span class="tl-live-text">Live</span>
                </button>

                <button type="button" id="tl-read-btn" class="pf-btn pf-btn--primary"
                        data-url="{{ path('traffic_light_read', {id: light.id}) }}">
                    🔄 Ler agora
                </button>

                <a href="{{ path('traffic_light_control', {id: light.id}) }}" class="pf-btn pf-btn--primary">
                    🎛 Controlar semáforo
                </a>

                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('traffic_light_edit', {id: light.id}) }}" class="pf-btn pf-btn--secondary">
                        Editar
                    </a>
                {% endif %}
            </div>
        </div>
    </div>

    {# ── KPIs ─────────────────────────────────────────────────── #}
    <div class="tl-show__kpis">
        <div class="tl-show__kpi">
            <span class="tl-show__kpi-label">Fase atual</span>
            <span class="tl-show__kpi-value" id="tl-kpi-phase">{{ firstPhase ? firstPhase.number : '—' }}</span>
        </div>
        <div class="tl-show__kpi">
            <span class="tl-show__kpi-label">Cor atual</span>
            <span class="tl-show__kpi-value" id="tl-kpi-color" style="text-transform:capitalize;">
                {{ currentColor|lower }}
            </span>
        </div>
        <div class="tl-show__kpi">
            <span class="tl-show__kpi-label">Modo</span>
            <span class="tl-show__kpi-value" id="tl-kpi-mode">{{ currentMode }}</span>
        </div>
        <div class="tl-show__kpi">
            <span class="tl-show__kpi-label">Falhas</span>
            <span class="tl-show__kpi-value" id="tl-kpi-faults">{{ state and state.faults is defined ? state.faults|length : 0 }}</span>
        </div>
    </div>

    {# ── Estado bruto + Localização ───────────────────────────── #}
    <div class="tl-grid-2" style="margin-top:1rem;">
        <div class="tl-card">
            <h2 class="tl-card__title">Estado completo <small>JSON</small></h2>
            <pre id="tl-state" class="tl-show__state-json">{{ state ? state|json_encode(constant('JSON_PRETTY_PRINT')) : '{"ok": false, "message": "Sem leitura ainda."}' }}</pre>
        </div>

        <div class="tl-card">
            <h2 class="tl-card__title">Localização</h2>
            {% if light.latitude and light.longitude %}
                <div id="tl-map" class="tl-show__map"
                     data-lat="{{ light.latitude }}" data-lng="{{ light.longitude }}"></div>
            {% else %}
                <div class="tl-empty">
                    <span class="tl-empty__icon">📍</span>
                    Coordenadas não cadastradas.
                </div>
            {% endif %}

            {% if state and state.faults is defined and state.faults|length > 0 %}
                <h2 class="tl-card__title" style="margin-top:1rem;">Falhas ativas</h2>
                <div class="tl-show__faults">
                    {% for f in state.faults %}
                        <div class="tl-show__fault tl-show__fault--{{ f.severity|lower }}">
                            <strong>{{ f.code }}</strong> · {{ f.message }}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    {# ── Histórico ────────────────────────────────────────────── #}
    <div class="tl-card" style="margin-top:1rem;">
        <h2 class="tl-card__title">Histórico <small>últimos 50 snapshots</small></h2>
        <table class="tl-show__history">
            <thead>
                <tr>
                    <th>Quando</th>
                    <th>Resultado</th>
                    <th>Cor</th>
                    <th>Fase</th>
                    <th>Falhas</th>
                    <th>Duração</th>
                    <th>Erro</th>
                </tr>
            </thead>
            <tbody>
            {% for s in history %}
                {% set sPhases = s.state and s.state.phases is defined ? s.state.phases : [] %}
                {% set sColor  = sPhases|length > 0 and sPhases[0].color is defined ? sPhases[0].color : null %}
                <tr>
                    <td>{{ s.readAt|date('d/m/Y H:i:s') }}</td>
                    <td>
                        {% if s.success %}<span class="tl-badge tl-badge--ok">OK</span>
                        {% else %}<span class="tl-badge tl-badge--error">FALHA</span>{% endif %}
                    </td>
                    <td>
                        {% if sColor == 'RED'    %}<span class="tl-badge tl-badge--error">🔴 Vermelho</span>
                        {% elseif sColor == 'GREEN'  %}<span class="tl-badge tl-badge--ok">🟢 Verde</span>
                        {% elseif sColor == 'YELLOW' %}<span class="tl-badge tl-badge--warn">🟡 Amarelo</span>
                        {% elseif sColor == 'OFF'    %}<span class="tl-badge tl-badge--neutral">⚫ Apagado</span>
                        {% else %}<span style="color:var(--tl-text-muted)">—</span>{% endif %}
                    </td>
                    <td>{{ s.currentPhase ?? '—' }}</td>
                    <td>{{ s.faultCount }}</td>
                    <td>{{ s.durationMs ?? '—' }} ms</td>
                    <td><small>{{ s.errorMessage ?? '' }}</small></td>
                </tr>
            {% else %}
                <tr><td colspan="7" style="text-align:center;color:var(--tl-text-muted);padding:1.5rem">Sem histórico.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if light.latitude and light.longitude %}
        <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"
                integrity="sha512-BwHfrr4c9kmRkLw6iXFdzcdWV/PGkVgiIyIWLLlTSXzWQzxuSg4DiQUCpauz/EWjgk5TYQqX/kvn9pG1NpYfqg=="
                crossorigin="anonymous" referrerpolicy="no-referrer"></script>
        <script>
        window.addEventListener('load', function () {
            var el = document.getElementById('tl-map');
            if (!el) return;
            var map = L.map(el).setView([parseFloat(el.dataset.lat), parseFloat(el.dataset.lng)], 16);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap', maxZoom: 19
            }).addTo(map);
            L.marker([parseFloat(el.dataset.lat), parseFloat(el.dataset.lng)]).addTo(map);
        });
        </script>
    {% endif %}
    <script type="module">
        import init from '{{ asset('js/pages/traffic-light-show.js') }}';
        init(document);
    </script>
{% endblock %}
