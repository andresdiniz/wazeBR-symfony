{% extends 'base.html.twig' %}

{% block title %}Verifique seu Email — WazeBR{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
{% endblock %}

{% block body %}
<div class="auth-page">

    {# ── Lado esquerdo — confirmação ──────────────────────────── #}
    <div class="auth-left">
        <div class="auth-container">

            <a href="{{ path('home') }}" class="auth-brand">
                <div class="auth-brand-mark">
                    <i class="bi bi-signpost-2-fill"></i>
                </div>
                <span class="auth-brand-name">Waze<em>BR</em></span>
            </a>

            <div class="auth-success-section">
                <div class="auth-success-icon">
                    <i class="bi bi-envelope-check-fill"></i>
                </div>
                <h1>Email enviado!</h1>
                <p>Enviamos as instruções de recuperação para o seu email. Verifique sua caixa de entrada.</p>
            </div>

            <div class="auth-instructions">
                <h3>O que fazer agora?</h3>
                <ol class="auth-instruction-list">
                    <li>
                        <span class="auth-instruction-icon"><i class="bi bi-inbox-fill"></i></span>
                        <span>Verifique sua caixa de entrada</span>
                    </li>
                    <li>
                        <span class="auth-instruction-icon"><i class="bi bi-search"></i></span>
                        <span>Procure por "Recuperação de Senha WazeBR"</span>
                    </li>
                    <li>
                        <span class="auth-instruction-icon"><i class="bi bi-link-45deg"></i></span>
                        <span>Clique no link seguro do email</span>
                    </li>
                    <li>
                        <span class="auth-instruction-icon"><i class="bi bi-key-fill"></i></span>
                        <span>Crie sua nova senha</span>
                    </li>
                </ol>
            </div>

            <div class="auth-alert auth-alert-info" role="alert">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    <strong>Não recebeu o email?</strong>
                    <p>Verifique sua caixa de spam ou aguarde alguns minutos.</p>
                </div>
            </div>

            <div class="auth-resend">
                <p>O email não chegou?</p>
                <a href="{{ path('app_reset_password_request') }}" class="auth-btn auth-btn-outline">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>Reenviar instruções</span>
                </a>
            </div>

            <div class="auth-footer-link">
                <a href="{{ path('auth_login') }}">
                    <i class="bi bi-arrow-left"></i>
                    Voltar ao login
                </a>
            </div>

        </div>
    </div>

    {# ── Lado direito — visual ────────────────────────────────── #}
    <div class="auth-right">
        <div class="auth-visual">

            <div class="auth-right-orb auth-right-orb-1" aria-hidden="true"></div>
            <div class="auth-right-orb auth-right-orb-2" aria-hidden="true"></div>

            <div class="auth-visual-content">
                <div class="auth-visual-logo">
                    <i class="bi bi-envelope-paper-fill"></i>
                </div>
                <h2>Segurança garantida</h2>
                <p>Seu link de recuperação é válido por apenas 1 hora e pode ser usado somente uma vez.</p>

                <div class="auth-security-items">
                    <div class="auth-security-item">
                        <i class="bi bi-lock-fill"></i>
                        <span>Link criptografado</span>
                    </div>
                    <div class="auth-security-item">
                        <i class="bi bi-clock-fill"></i>
                        <span>Válido por 1 hora</span>
                    </div>
                    <div class="auth-security-item">
                        <i class="bi bi-arrow-repeat"></i>
                        <span>Uso único</span>
                    </div>
                </div>

                <div class="auth-visual-stats">
                    <div class="auth-stat">
                        <strong>100%</strong>
                        <span>Seguro</span>
                    </div>
                    <div class="auth-stat">
                        <strong>1h</strong>
                        <span>Validade</span>
                    </div>
                    <div class="auth-stat">
                        <strong>SSL</strong>
                        <span>Criptografado</span>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>
{% endblock %}
