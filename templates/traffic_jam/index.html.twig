{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Engarrafamentos{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-3">Engarrafamentos</h1>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            {% if jams|length > 0 %}
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Níº¡vel</th>
                            <th>Velocidade</th>
                            <th>Comprimento</th>
                            <th>Rua</th>
                            <th>Cidade</th>
                            <th>Data</th>
                            <th>Aç°µes</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for jam in jams %}
                            <tr>
                                <td><span class="badge bg-{{ jam.level >= 4 ? 'danger' : (jam.level >= 2 ? 'warning' : 'success') }}">{{ jam.level }}</span></td>
                                <td>{{ jam.speed }} km/h</td>
                                <td>{{ jam.length }} m</td>
                                <td>{{ jam.street }}</td>
                                <td>{{ jam.city }}</td>
                                <td>{{ jam.lastSeenAt|date('d/m/Y H:i') }}</td>
                                <td>
                                    <a href="{{ path('traffic_jam_show', {id: jam.id}) }}" class="btn btn-sm btn-primary">Ver</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p class="text-muted mb-0">Nenhum engarrafamento encontrado</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
