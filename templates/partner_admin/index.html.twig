{% extends 'base.html.twig' %}

{% block title %}Administra çã££o de Parceiros{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-handshake"></i> Administra çã££o de Parceiros</h1>
        
        {# Bot ão de criar - apenas para ROLE_PARTNER e ROLE_ADMIN #}
        {% if can_edit is defined and can_edit %}
            <a href="{{ path('app_partner_admin_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Novo Parceiro
            </a>
        {% endif %}
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Email</th>
                            <th>Status</th>
                            
                            {# Colunas extras - apenas para ROLE_PARTNER e ROLE_ADMIN #}
                            {% if can_edit is defined and can_edit %}
                                <th>API Key</th>
                                <th>Webhook</th>
                                <th class="text-end">A çõ£££es</th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for partner in partners %}
                            <tr>
                                <td>{{ partner.id }}</td>
                                <td>
                                    <a href="{{ path('app_partner_admin_show', {id: partner.id}) }}">
                                        <strong>{{ partner.name }}</strong>
                                    </a>
                                </td>
                                <td>{{ partner.email }}</td>
                                <td>
                                    {% if partner.active %}
                                        <span class="badge bg-success"><i class="fas fa-check"></i> Ativo</span>
                                    {% else %}
                                        <span class="badge bg-secondary"><i class="fas fa-times"></i> Inativo</span>
                                    {% endif %}
                                </td>
                                
                                {# Dados completos - apenas para ROLE_PARTNER e ROLE_ADMIN #}
                                {% if can_edit is defined and can_edit %}
                                    <td>
                                        <code class="text-muted">{{ partner.apiKey|slice(0, 8) }}...</code>
                                    </td>
                                    <td>
                                        {% if partner.webhookUrl %}
                                            <a href="{{ partner.webhookUrl }}" target="_blank" class="text-truncate d-inline-block" style="max-width: 200px;">
                                                {{ partner.webhookUrl|replace({'https://': '', 'http://': ''}) }}
                                            </a>
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a href="{{ path('app_partner_admin_edit', {id: partner.id}) }}" 
                                               class="btn btn-warning" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a href="{{ path('app_partner_admin_show', {id: partner.id}) }}" 
                                               class="btn btn-info" title="Ver">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                {% endif %}
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="{{ (can_edit is defined and can_edit) ? 8 : 4 }}" class="text-center text-muted py-4">
                                    <i class="fas fa-inbox" style="font-size: 2rem;"></i>
                                    <p class="mb-0 mt-2">Nenhum parceiro encontrado.</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <div class="mt-3">
        <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Voltar
        </a>
    </div>
</div>
{% endblock %}
