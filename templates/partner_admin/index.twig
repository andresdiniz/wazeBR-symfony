{% extends 'base.html.twig' %}

{% block title %}Parceiros — Administração{% endblock %}

{% block content %}
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Parceiros</h1>
            <p class="text-muted mb-0">
                Gerencie órgãos públicos e concessionárias cadastrados na plataforma.
            </p>
        </div>

        <a href="{{ path('admin_partner_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Novo parceiro
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Nome</th>
                            <th>Slug</th>
                            <th>E-mail</th>
                            <th class="text-center">Usuários</th>
                            <th>Status</th>
                            <th>Criado em</th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for item in partners %}
                            {% set partner = item.partner %}

                            <tr>
                                <td class="ps-4">
                                    <a
                                        href="{{ path('admin_partner_show', {id: partner.id}) }}"
                                        class="text-decoration-none fw-semibold"
                                    >
                                        {{ partner.name }}
                                    </a>
                                </td>

                                <td>
                                    <code>{{ partner.slug }}</code>
                                </td>

                                <td>
                                    {% if partner.email %}
                                        <a href="mailto:{{ partner.email }}" class="text-decoration-none">
                                            {{ partner.email }}
                                        </a>
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>

                                <td class="text-center">
                                    <span class="badge text-bg-secondary rounded-pill">
                                        {{ item.userCount }}
                                    </span>
                                </td>

                                <td>
                                    {% if partner.isActive %}
                                        <span class="badge text-bg-success">Ativo</span>
                                    {% else %}
                                        <span class="badge text-bg-secondary">Inativo</span>
                                    {% endif %}
                                </td>

                                <td>
                                    {% if partner.createdAt %}
                                        {{ partner.createdAt|date('d/m/Y H:i') }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>

                                <td class="text-end pe-4 text-nowrap">
                                    <a
                                        href="{{ path('admin_partner_show', {id: partner.id}) }}"
                                        class="btn btn-sm btn-outline-primary"
                                        title="Visualizar parceiro"
                                    >
                                        <i class="bi bi-eye"></i>
                                        <span class="visually-hidden">Visualizar</span>
                                    </a>

                                    <a
                                        href="{{ path('admin_partner_edit', {id: partner.id}) }}"
                                        class="btn btn-sm btn-outline-secondary"
                                        title="Editar parceiro"
                                    >
                                        <i class="bi bi-pencil"></i>
                                        <span class="visually-hidden">Editar</span>
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="mb-3 text-muted">
                                        <i class="bi bi-buildings fs-1"></i>
                                    </div>

                                    <h2 class="h5">Nenhum parceiro cadastrado</h2>

                                    <p class="text-muted mb-3">
                                        Cadastre o primeiro órgão público ou concessionária para começar.
                                    </p>

                                    <a href="{{ path('admin_partner_new') }}" class="btn btn-primary">
                                        <i class="bi bi-plus-lg me-1"></i>
                                        Criar primeiro parceiro
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
