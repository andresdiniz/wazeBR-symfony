{% extends 'base.html.twig' %}

{% block title %}{{ partner.name }} - Detalhes{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-handshake"></i> {{ partner.name }}</h1>
        
        {% if can_edit is defined and can_edit %}
            <div class="btn-group" role="group">
                <a href="{{ path('app_partner_admin_edit', {id: partner.id}) }}" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Editar
                </a>
                <a href="{{ path('app_partner_admin_index') }}" class="btn btn-outline-secondary">
                    <i class="fas fa-list"></i> Voltar à Lista
                </a>
            </div>
        {% else %}
            <a href="{{ path('app_partner_admin_index') }}" class="btn btn-outline-secondary">
                <i class="fas fa-list"></i> Voltar à Lista
            </a>
        {% endif %}
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> Informaçµ£es Básicas</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <th style="width: 200px;">ID:</th>
                                <td>{{ partner.id }}</td>
                            </tr>
                            <tr>
                                <th>Nome:</th>
                                <td><strong>{{ partner.name }}</strong></td>
                            </tr>
                            <tr>
                                <th>Email:</th>
                                <td><a href="mailto:{{ partner.email }}">{{ partner.email }}</a></td>
                            </tr>
                            <tr>
                                <th>Status:</th>
                                <td>
                                    {% if partner.active %}
                                        <span class="badge bg-success"><i class="fas fa-check"></i> Ativo</span>
                                    {% else %}
                                        <span class="badge bg-secondary"><i class="fas fa-times"></i> Inativo</span>
                                    {% endif %}
                                </td>
                            </tr>
                            
                            {# Dados completos - apenas para ROLE_PARTNER e ROLE_ADMIN #}
                            {% if can_view_full is defined and can_view_full %}
                                <tr>
                                    <th>API Key:</th>
                                    <td>
                                        <code class="bg-light p-2">{{ partner.apiKey }}</code>
                                        <button class="btn btn-sm btn-outline-secondary ms-2" 
                                                onclick="navigator.clipboard.writeText('{{ partner.apiKey }}')">
                                            <i class="fas fa-copy"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Webhook URL:</th>
                                    <td>
                                        {% if partner.webhookUrl %}
                                            <a href="{{ partner.webhookUrl }}" target="_blank">
                                                {{ partner.webhookUrl }}
                                            </a>
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>Settings:</th>
                                    <td>
                                        {% if partner.settings %}
                                            <pre class="bg-light p-2 rounded">{{ partner.settings|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>Criado em:</th>
                                    <td>{{ partner.createdAt|date('d/m/Y H:i:s') }}</td>
                                </tr>
                                <tr>
                                    <th>Atualizado em:</th>
                                    <td>{{ partner.updatedAt|date('d/m/Y H:i:s') }}</td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-shield-alt"></i> Permissõ£££es</h5>
                </div>
                <div class="card-body">
                    {% if can_edit is defined and can_edit %}
                        <div class="alert alert-success">
                            <i class="fas fa-check-circle"></i>
                            <strong>Voc ê tem acesso completo</strong>
                            <p class="mb-0 small">Pode editar e remover este parceiro</p>
                        </div>
                    {% else %}
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            <strong>Visualiza çã££o apenas</strong>
                            <p class="mb-0 small">Seu usu á rio pode apenas visualizar dados básicos</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
