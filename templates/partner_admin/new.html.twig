{% extends 'base.html.twig' %}

{% block title %}Novo Parceiro{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1><i class="fas fa-plus-circle"></i> Novo Parceiro</h1>
                <a href="{{ path('app_partner_admin_index') }}" class="btn btn-outline-secondary">
                    <i class="fas fa-times"></i> Cancelar
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Preencha os dados do novo parceiro</h5>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        
                        <div class="mb-3">
                            {{ form_label(form.name) }}
                            {{ form_widget(form.name, {'attr': {'class': 'form-control', 'placeholder': 'Nome do parceiro'}}) }}
                            {{ form_errors(form.name) }}
                        </div>
                        
                        <div class="mb-3">
                            {{ form_label(form.email) }}
                            {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'email@exemplo.com'}}) }}
                            {{ form_errors(form.email) }}
                        </div>
                        
                        <div class="mb-3">
                            {{ form_label(form.active) }}
                            {{ form_widget(form.active, {'attr': {'class': 'form-check-input'}}) }}
                            {{ form_errors(form.active) }}
                        </div>
                        
                        <div class="mb-3">
                            {{ form_label(form.apiKey) }}
                            {{ form_widget(form.apiKey, {'attr': {'class': 'form-control', 'placeholder': 'Chave de API'}}) }}
                            {{ form_errors(form.apiKey) }}
                            <small class="form-text text-muted">Chave ú nica para autentica çã££o da API</small>
                        </div>
                        
                        <div class="mb-3">
                            {{ form_label(form.webhookUrl) }}
                            {{ form_widget(form.webhookUrl, {'attr': {'class': 'form-control', 'placeholder': 'https://exemplo.com/webhook'}}) }}
                            {{ form_errors(form.webhookUrl) }}
                            <small class="form-text text-muted">URL para recebimento de notifica çõ£££es</small>
                        </div>
                        
                        <div class="mb-3">
                            {{ form_label(form.settings) }}
                            {{ form_widget(form.settings, {'attr': {'class': 'form-control', 'rows': 5}}) }}
                            {{ form_errors(form.settings) }}
                            <small class="form-text text-muted">Configura çõ£££es em formato JSON</small>
                        </div>
                        
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="{{ path('app_partner_admin_index') }}" class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Criar Parceiro
                            </button>
                        </div>
                    
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
