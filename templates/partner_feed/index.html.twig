{% extends 'base.html.twig' %}

{% block title %}Partner Feed{% endblock %}

{% block body %}
<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="fas fa-broadcast-tower me-2 text-primary"></i>Partner Feed
        </h1>
    </div>

    {% for type, messages in app.flashes %}
        {% for msg in messages %}
            <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show">
                {{ msg }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row g-3">
        {% for partner in partners %}
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-1">{{ partner.name }}</h5>
                    <p class="text-muted small mb-1">
                        Código: <code>{{ partner.code }}</code>
                    </p>
                    <p class="text-muted small mb-0">
                        {{ partner.city }}{% if partner.state %}/{{ partner.state }}{% endif %}
                    </p>
                </div>
                <div class="card-footer bg-transparent d-flex gap-2 flex-wrap">
                    <a href="{{ path('partner_feed_show', {code: partner.code}) }}"
                       class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-eye me-1"></i>Feed
                    </a>
                    <a href="{{ path('partner_event_list', {code: partner.code}) }}"
                       class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-list me-1"></i>Eventos
                    </a>
                    <a href="{{ url('partner_feed_json', {code: partner.code}) }}"
                       target="_blank" class="btn btn-sm btn-outline-success">
                        <i class="fas fa-code me-1"></i>feed.json
                    </a>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12">
            <div class="alert alert-info">Nenhum parceiro ativo cadastrado.</div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
