{# WazeCount — Comparativo Semana #}
<div class="row g-3">
    <div class="col-6">
        <div class="text-muted small">Esta semana</div>
        <div class="display-6 fw-bold">{{ current ?? '—' }}</div>
    </div>
    <div class="col-6">
        <div class="text-muted small">Semana passada</div>
        <div class="display-6 fw-bold">{{ lastWeek ?? '—' }}</div>
    </div>
</div>

{% if peak %}
<div class="row g-2 mt-3">
    <div class="col-12">
        <div class="text-muted small mb-2">Picos por nível de jam</div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="card border-0 bg-secondary bg-opacity-10">
            <div class="card-body py-2 px-3 text-center">
                <div class="text-muted small">Nivel 0</div>
                <div class="fw-bold">{{ peak.max_level0 ?? '—' }}</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="card border-0 bg-secondary bg-opacity-10">
            <div class="card-body py-2 px-3 text-center">
                <div class="text-muted small">Nivel 1</div>
                <div class="fw-bold">{{ peak.max_level1 ?? '—' }}</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="card border-0 bg-secondary bg-opacity-10">
            <div class="card-body py-2 px-3 text-center">
                <div class="text-muted small">Nivel 2</div>
                <div class="fw-bold">{{ peak.max_level2 ?? '—' }}</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="card border-0 bg-secondary bg-opacity-10">
            <div class="card-body py-2 px-3 text-center">
                <div class="text-muted small">Nivel 3</div>
                <div class="fw-bold">{{ peak.max_level3 ?? '—' }}</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="card border-0 bg-secondary bg-opacity-10">
            <div class="card-body py-2 px-3 text-center">
                <div class="text-muted small">Nivel 4</div>
                <div class="fw-bold">{{ peak.max_level4 ?? '—' }}</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="card border-0 bg-success bg-opacity-10">
            <div class="card-body py-2 px-3 text-center">
                <div class="text-muted small">Total (max)</div>
                <div class="fw-bold">{{ peak.max_total ?? '—' }}</div>
            </div>
        </div>
    </div>
</div>
{% endif %}
