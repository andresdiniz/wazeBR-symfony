{% block active_dashboard %}active{% endblock %}
{% block header_title %}Painel Executivo WazeBR — {{ partnerLabel }}{% endblock %}
{% block title %}Dashboard Histórico - {{ partnerLabel }}{% endblock %}

{% block body %}
<style>
    :root {
        --bg-main: #0b0f19;
        --bg-card: rgba(30, 41, 59, 0.7);
        --border-glass: rgba(255, 255, 255, 0.08);
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
        --accent-blue: #38bdf8;
        --accent-purple: #a855f7;
    }

    body {
        background-color: var(--bg-main) !important;
        color: var(--text-main) !important;
    }

    .executive-header {
        background: linear-gradient(135deg, rgba(30, 41, 59, 0.9) 0%, rgba(15, 23, 42, 0.95) 100%);
        border: 1px solid var(--border-glass);
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 24px;
        backdrop-filter: blur(12px);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
    }

    .nav-tabs {
        border-bottom: 1px solid var(--border-glass);
        gap: 8px;
    }

    .nav-tabs .nav-link {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid var(--border-glass);
        color: var(--text-muted);
        border-radius: 10px 10px 0 0;
        font-weight: 500;
        padding: 12px 20px;
        transition: all 0.2s ease;
    }

    .nav-tabs .nav-link:hover {
        color: var(--text-main);
        background: rgba(30, 41, 59, 0.8);
        border-color: rgba(56, 189, 248, 0.3);
    }

    .nav-tabs .nav-link.active {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        color: #ffffff;
        border-color: #2563eb;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 28px;
    }

    .kpi-card {
        background: var(--bg-card);
        border: 1px solid var(--border-glass);
        border-radius: 14px;
        padding: 22px;
        backdrop-filter: blur(12px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        position: relative;
        overflow: hidden;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .kpi-card:hover {
        transform: translateY(-3px);
        border-color: rgba(56, 189, 248, 0.4);
    }

    .kpi-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; width: 4px; height: 100%;
    }
    .kpi-card.primary::before { background: #38bdf8; }
    .kpi-card.success::before { background: #22c55e; }
    .kpi-card.warning::before { background: #f59e0b; }
    .kpi-card.danger::before { background: #ef4444; }

    .kpi-value {
        font-size: 2.2rem;
        font-weight: 700;
        margin: 10px 0 4px 0;
        color: #fff;
    }

    .kpi-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        font-weight: 600;
    }

    .kpi-sub {
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    .chart-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
        gap: 24px;
        margin-bottom: 24px;
    }

    .chart-wrapper {
        background: var(--bg-card);
        border: 1px solid var(--border-glass);
        border-radius: 14px;
        padding: 24px;
        backdrop-filter: blur(12px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    }

    .chart-wrapper h5 {
        font-size: 1.05rem;
        font-weight: 600;
        color: #f1f5f9;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    #map {
        height: 500px;
        border-radius: 14px;
        border: 1px solid var(--border-glass);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

    .map-legend {
        background: rgba(15, 23, 42, 0.85);
        border: 1px solid var(--border-glass);
        padding: 12px 16px;
        border-radius: 10px;
        font-size: 0.85rem;
        color: var(--text-main);
        backdrop-filter: blur(8px);
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 6px 0;
    }

    .legend-color {
        width: 14px;
        height: 14px;
        border-radius: 4px;
    }

    .exec-table {
        width: 100%;
        color: var(--text-main);
        font-size: 0.9rem;
    }

    .exec-table th {
        background: rgba(15, 23, 42, 0.8);
        color: var(--text-muted);
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        padding: 12px;
        border-bottom: 1px solid var(--border-glass);
    }

    .exec-table td {
        padding: 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .exec-table tr:hover {
        background: rgba(255, 255, 255, 0.02);
    }

    .badge-level {
        padding: 4px 8px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.75rem;
    }
</style>

<div class="executive-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h2 class="mb-1 text-white fw-bold">Painel Executivo & Histórico</h2>
        <p class="text-muted mb-0">Monitoramento inteligente de tráfego, alertas e infraestrutura viária para <strong>{{ partnerLabel }}</strong>.</p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-primary px-3 py-2 rounded-pill font-monospace">Atualizado: {{ "now"|date("d/m/Y H:i") }}</span>
    </div>
</div>

<!-- Abas Modulares -->
<ul class="nav nav-tabs mb-4" id="executiveTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab"><i class="fas fa-chart-pie me-2"></i>Visão Geral & KPIs</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="alerts-tab" data-bs-toggle="tab" data-bs-target="#alerts" type="button" role="tab"><i class="fas fa-exclamation-triangle me-2"></i>Alertas & Incidentes</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="jams-tab" data-bs-toggle="tab" data-bs-target="#jams" type="button" role="tab"><i class="fas fa-traffic-light me-2"></i>Congestionamentos & Irregularidades</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="civil-tab" data-bs-toggle="tab" data-bs-target="#civil" type="button" role="tab"><i class="fas fa-shield-alt me-2"></i>Infraestrutura & Rotas</button>
    </li>
</ul>

<div class="tab-content" id="executiveTabsContent">
    <!-- ABA 1: VISÃO GERAL & KPIS -->
    <div class="tab-pane fade show active" id="overview" role="tabpanel">
        <div class="stats-grid">
            <div class="kpi-card primary">
                <div class="kpi-label">Alertas (Última 1h)</div>
                <div class="kpi-value">{{ kpis.alerts1h }}</div>
                <div class="kpi-sub">Total 24h: {{ kpis.alerts24h }} &middot; 7d: {{ kpis.alerts7d }}</div>
            </div>
            <div class="kpi-card warning">
                <div class="kpi-label">Congestionamentos 24h</div>
                <div class="kpi-value">{{ kpis.jams24h }}</div>
                <div class="kpi-sub">Total acumulado: {{ kpis.jams }}</div>
            </div>
            <div class="kpi-card success">
                <div class="kpi-label">Confiabilidade Média</div>
                <div class="kpi-value">{{ kpis.avgReliability|number_format(1) }}%</div>
                <div class="kpi-sub">Confiança: {{ kpis.avgConfidence|number_format(1) }}%</div>
            </div>
            <div class="kpi-card danger">
                <div class="kpi-label">Irregularidades Ativas</div>
                <div class="kpi-value">{{ kpis.irregularities }}</div>
                <div class="kpi-sub">Rotas monitoradas: {{ kpis.routes }}</div>
            </div>
        </div>

        <div class="chart-row">
            <div class="chart-wrapper">
                <h5><i class="fas fa-chart-line text-info"></i> Alertas por Hora (Últimas 24h)</h5>
                <canvas id="alerts-per-hour-chart" height="180"></canvas>
            </div>
            <div class="chart-wrapper">
                <h5><i class="fas fa-chart-area text-warning"></i> Jams por Hora (Últimas 24h)</h5>
                <canvas id="jams-per-hour-chart" height="180"></canvas>
            </div>
        </div>

        <!-- WazeCount & Picos de Jam -->
        <div class="chart-row">
            <div class="chart-wrapper">
                <h5><i class="fas fa-users text-primary"></i> WazeCount — Comparativo Semanal</h5>
                <div class="row text-center my-4">
                    <div class="col-6 border-end border-secondary">
                        <div class="text-muted small uppercase">Esta Semana</div>
                        <div class="h3 fw-bold text-white mt-1">{{ kpis.wazeCount is not null ? kpis.wazeCount : 'Dado indisponível' }}</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small uppercase">Semana Passada</div>
                        <div class="h3 fw-bold text-white mt-1">{{ kpis.wazeCountLastWeek is not null ? kpis.wazeCountLastWeek : 'Dado indisponível' }}</div>
                    </div>
                </div>
                <h6 class="text-muted small text-uppercase mt-4 mb-3">Picos de Wazers por Nível (Hoje)</h6>
                <div class="d-flex justify-content-between text-center bg-dark p-3 rounded border border-secondary">
                    <div><span class="d-block text-muted small">Nível 0</span><strong class="text-white">{{ kpis.wazeCountPeak.max_level0 ?? 0 }}</strong></div>
                    <div><span class="d-block text-muted small">Nível 1</span><strong class="text-white">{{ kpis.wazeCountPeak.max_level1 ?? 0 }}</strong></div>
                    <div><span class="d-block text-muted small">Nível 2</span><strong class="text-white">{{ kpis.wazeCountPeak.max_level2 ?? 0 }}</strong></div>
                    <div><span class="d-block text-muted small">Nível 3</span><strong class="text-white">{{ kpis.wazeCountPeak.max_level3 ?? 0 }}</strong></div>
                    <div><span class="d-block text-muted small">Nível 4</span><strong class="text-white">{{ kpis.wazeCountPeak.max_level4 ?? 0 }}</strong></div>
                    <div><span class="d-block text-info small">Total Máx</span><strong class="text-info">{{ kpis.wazeCountPeak.max_total ?? 0 }}</strong></div>
                </div>
            </div>
            <div class="chart-wrapper">
                <h5><i class="fas fa-map-marked-alt text-success"></i> Mapa Geral de Alertas e Jams</h5>
                <div id="map"></div>
                <div class="mt-3 map-legend d-flex flex-wrap gap-3 align-items-center justify-content-between">
                    <strong>Níveis de Jam:</strong>
                    <div class="legend-item"><span class="legend-color" style="background:#94a3b8"></span> N0</div>
                    <div class="legend-item"><span class="legend-color" style="background:#22c55e"></span> N1</div>
                    <div class="legend-item"><span class="legend-color" style="background:#eab308"></span> N2</div>
                    <div class="legend-item"><span class="legend-color" style="background:#f97316"></span> N3</div>
                    <div class="legend-item"><span class="legend-color" style="background:#ef4444"></span> N4</div>
                    <div class="legend-item"><span class="legend-color" style="background:#7f1d1d"></span> N5</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ABA 2: ALERTAS & INCIDENTES -->
    <div class="tab-pane fade" id="alerts" role="tabpanel">
        <div class="chart-row">
            <div class="chart-wrapper">
                <h5><i class="fas fa-chart-bar text-danger"></i> Distribuição de Alertas por Tipo & Subtipo (24h)</h5>
                <canvas id="alerts-by-type-chart" height="220"></canvas>
            </div>
            <div class="chart-wrapper">
                <h5><i class="fas fa-list-alt text-primary"></i> Alertas Recentes (Histórico Detalhado)</h5>
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="exec-table">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Subtipo</th>
                                <th>Local / Rua</th>
                                <th>Horário</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for alert in recentAlerts %}
                            <tr>
                                <td><span class="badge bg-secondary">{{ alert.type }}</span></td>
                                <td class="text-white">{{ alert.subtype ?? '—' }}</td>
                                <td class="text-muted">{{ alert.city ?? '' }} — {{ alert.street ?? 'Via não informada' }}</td>
                                <td class="font-monospace small">{{ alert.pubMillis / 1000 | date('d/m H:i') }}</td>
                            </tr>
                            {% else %}
                            <tr><td colspan="4" class="text-center text-muted">Nenhum alerta recente registrado.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ABA 3: CONGESTIONAMENTOS & IRREGULARIDADES -->
    <div class="tab-pane fade" id="jams" role="tabpanel">
        <div class="chart-row">
            <div class="chart-wrapper">
                <h5><i class="fas fa-road text-warning"></i> Congestionamentos por Nível (24h)</h5>
                <canvas id="jams-by-level-chart" height="200"></canvas>
            </div>
            <div class="chart-wrapper">
                <h5><i class="fas fa-tachometer-alt text-danger"></i> Maior Perda de Velocidade (24h)</h5>
                {% if irregSpeedLoss|length > 0 %}
                <canvas id="speed-loss-chart" height="200"></canvas>
                {% else %}
                <p class="text-muted text-center py-5">Sem dados suficientes de perda de velocidade nas últimas 24h.</p>
                {% endif %}
            </div>
        </div>

        <div class="chart-row">
            <div class="chart-wrapper">
                <h5><i class="fas fa-clock text-info"></i> Atraso Acumulado por Via (24h)</h5>
                <p class="text-muted small mb-3">Linha tracejada indica a média de atraso acumulado no período (<strong>{{ avgAccumulatedDelay }} min</strong>).</p>
                {% if irregDelayByStreet|length > 0 %}
                <canvas id="delay-street-chart" height="200"></canvas>
                {% else %}
                <p class="text-muted text-center py-5">Sem dados de atraso acumulado.</p>
                {% endif %}
            </div>
            <div class="chart-wrapper">
                <h5><i class="fas fa-exclamation-circle text-warning"></i> Jams Recentes com Traçado</h5>
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="exec-table">
                        <thead>
                            <tr>
                                <th>Nível</th>
                                <th>Local / Rua</th>
                                <th>Horário</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for jam in recentJams %}
                            <tr>
                                <td><span class="badge-level bg-danger text-white">N{{ jam.level }}</span></td>
                                <td class="text-muted">{{ jam.city ?? '' }} — {{ jam.street ?? 'Via sem nome' }}</td>
                                <td class="font-monospace small">{{ jam.pubMillis / 1000 | date('d/m H:i') }}</td>
                            </tr>
                            {% else %}
                            <tr><td colspan="3" class="text-center text-muted">Nenhum jam recente registrado.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ABA 4: INFRAESTRUTURA & ROTAS -->
    <div class="tab-pane fade" id="civil" role="tabpanel">
        <div class="chart-row">
            <div class="chart-wrapper">
                <h5><i class="fas fa-route text-primary"></i> Rotas Monitoradas (TVT)</h5>
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="exec-table">
                        <thead>
                            <tr>
                                <th>Nome da Rota</th>
                                <th>Extensão</th>
                                <th>Nível Jam</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for route in routes %}
                            <tr>
                                <td class="text-white fw-bold">{{ route.name }}</td>
                                <td class="text-muted">{{ route.length }} m</td>
                                <td><span class="badge bg-secondary">N{{ route.jamLevel ?? 0 }}</span></td>
                            </tr>
                            {% else %}
                            <tr><td colspan="3" class="text-center text-muted">Nenhuma rota cadastrada.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="chart-wrapper">
                <h5><i class="fas fa-link text-success"></i> Links Externos Monitorados</h5>
                <ul class="list-unstyled">
                    {% for link in links %}
                    <li class="p-2 mb-2 bg-dark rounded border border-secondary text-truncate">
                        <a href="{{ link.url }}" target="_blank" class="text-info text-decoration-none"><i class="fas fa-external-link-alt me-2"></i>{{ link.url }}</a>
                    </li>
                    {% else %}
                    <li class="text-muted">Nenhum link externo cadastrado.</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function() {
    const jamLevelColors = {0:'#94a3b8', 1:'#22c55e', 2:'#eab308', 3:'#f97316', 4:'#ef4444', 5:'#7f1d1d'};
    const alertTypeColors = {'ACCIDENT':'#ef4444','HAZARD':'#f59e0b','JAM':'#3b82f6','WEATHERHAZARD':'#10b981','ROAD_CLOSED':'#8b5cf6','CONSTRUCTION':'#6b7280','MISC':'#64748b'};

    // Global Chart.js defaults for Dark Mode
    Chart.defaults.color = '#94a3b8';
    Chart.defaults.borderColor = 'rgba(255, 255, 255, 0.08)';

    // Alertas por hora (24h reais)
    const ctxAlertsHour = document.getElementById('alerts-per-hour-chart');
    if (ctxAlertsHour) {
        new Chart(ctxAlertsHour, {
            type: 'line',
            data: {
                labels: {{ alertsPerHourLabels|json_encode|raw }},
                datasets: [{
                    label: 'Alertas',
                    data: {{ alertsPerHourData|json_encode|raw }},
                    borderColor: '#38bdf8',
                    backgroundColor: 'rgba(56, 189, 248, 0.15)',
                    tension: 0.3,
                    fill: true,
                    pointRadius: 3,
                    pointBackgroundColor: '#38bdf8'
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, ticks: { precision: 0 } }
                }
            }
        });
    }

    // Jams por hora (24h reais)
    const ctxJamsHour = document.getElementById('jams-per-hour-chart');
    if (ctxJamsHour) {
        new Chart(ctxJamsHour, {
            type: 'line',
            data: {
                labels: {{ jamsPerHourLabels|json_encode|raw }},
                datasets: [{
                    label: 'Jams',
                    data: {{ jamsPerHourData|json_encode|raw }},
                    borderColor: '#f59e0b',
                    backgroundColor: 'rgba(245, 158, 11, 0.15)',
                    tension: 0.3,
                    fill: true,
                    pointRadius: 3,
                    pointBackgroundColor: '#f59e0b'
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, ticks: { precision: 0 } }
                }
            }
        });
    }

    // Alertas por tipo
    const ctxAlertType = document.getElementById('alerts-by-type-chart');
    if (ctxAlertType) {
        const raw = {{ alertsByType|json_encode|raw }};
        const typesMap = {{ typesMap|json_encode|raw }};
        const subtypesMap = {{ subtypesMap|json_encode|raw }};
        const labels = raw.map(r => subtypesMap[r.subtype] ?? typesMap[r.type] ?? r.type);
        const data = raw.map(r => r.total);
        const bgColors = raw.map(r => alertTypeColors[r.type] ?? '#64748b');
        new Chart(ctxAlertType, {
            type: 'bar',
            data: { labels, datasets: [{ label: 'Alertas', data, backgroundColor: bgColors, borderWidth: 0, borderRadius: 6 }] },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { x: { grid: { display: false } }, y: { beginAtZero: true } }
            }
        });
    }

    // Jams por nível
    const ctxJamLevel = document.getElementById('jams-by-level-chart');
    if (ctxJamLevel) {
        const raw = {{ jamsByLevel|json_encode|raw }};
        const labels = raw.map(r => 'Nível ' + r.level);
        const data = raw.map(r => r.total);
        const bgColors = raw.map(r => jamLevelColors[r.level] ?? '#ef4444');
        new Chart(ctxJamLevel, {
            type: 'bar',
            data: { labels, datasets: [{ label: 'Jams', data, backgroundColor: bgColors, borderWidth: 0, borderRadius: 6 }] },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { x: { grid: { display: false } }, y: { beginAtZero: true } }
            }
        });
    }

    // Perda de velocidade
    const ctxSpeedLoss = document.getElementById('speed-loss-chart');
    if (ctxSpeedLoss) {
        const raw = {{ irregSpeedLoss|json_encode|raw }};
        const labels = raw.map(r => (r.street || 'Via') + ' (' + (r.city || '') + ')');
        const data = raw.map(r => r.loss);
        new Chart(ctxSpeedLoss, {
            type: 'bar',
            data: { labels, datasets: [{ label: 'Perda km/h', data, backgroundColor: '#ef4444', borderWidth: 0, borderRadius: 6 }] },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { x: { beginAtZero: true }, y: { grid: { display: false } } }
            }
        });
    }

    // Atraso acumulado por via com linha de média
    const ctxDelayStreet = document.getElementById('delay-street-chart');
    if (ctxDelayStreet) {
        const raw = {{ irregDelayByStreet|json_encode|raw }};
        const labels = raw.map(r => (r.street || 'Via') + ' (' + (r.city || '') + ')');
        const data = raw.map(r => r.delay);
        const avgVal = {{ avgAccumulatedDelay }};
        const avgLineData = new Array(labels.length).fill(avgVal);

        new Chart(ctxDelayStreet, {
            type: 'bar',
            data: {
                labels,
                datasets: [
                    { label: 'Atraso (min)', data, backgroundColor: '#38bdf8', borderWidth: 0, borderRadius: 6, order: 2 },
                    { label: 'Média de Atraso', data: avgLineData, type: 'line', borderColor: '#f59e0b', borderWidth: 2, pointRadius: 0, order: 1 }
                ]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: { legend: { display: true, position: 'bottom' } },
                scales: { x: { beginAtZero: true }, y: { grid: { display: false } } }
            }
        });
    }

    // Leaflet Map Initialization
    const mapEl = document.getElementById('map');
    if (mapEl && typeof L !== 'undefined') {
        const map = L.map('map').setView([-19.92, -43.93], 12);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; OpenStreetMap &copy; CARTO',
            maxZoom: 19
        }).addTo(map);

        const recentJams = {{ recentJams|json_encode|raw }};
        let bounds = [];

        recentJams.forEach(jam => {
            if (jam.line && jam.line.length > 0) {
                const latlngs = jam.line.map(pt => [pt.y || pt[1], pt.x || pt[0]]);
                const color = jamLevelColors[jam.level] || '#ef4444';
                const polyline = L.polyline(latlngs, {color: color, weight: 5, opacity: 0.85}).addTo(map);
                polyline.bindPopup(`<b>Jam Nível ${jam.level}</b><br>${jam.street || ''} (${jam.city || ''})`);
                latlngs.forEach(ll => bounds.push(ll));
            }
        });

        if (bounds.length > 0) {
            map.fitBounds(bounds, {padding: [30, 30]});
        }
    }
});
</script>
{% endblock %}
