{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Dashboard | WazeBR{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/pages/dashboard.css') }}">
{% endblock %}

{% block content %}
<div class="dashboard-wrapper" data-dashboard>
    <header class="dashboard-header dashboard-reveal">
        <div>
            <span class="dashboard-eyebrow">Centro operacional</span>
            <h1>Visão geral da mobilidade</h1>
            <p class="dashboard-subtitle">Acompanhe trânsito, alertas, clima e operação em um único painel.</p>
        </div>
        <div class="dashboard-actions">
            <span class="dashboard-clock" data-dashboard-clock></span>
            <button type="button" class="dashboard-refresh" data-action="refresh-dashboard">Atualizar</button>
        </div>
    </header>

    <section class="stats-grid" aria-label="Indicadores principais">
        {% set cards = [
            ['stat-alerts', '⚠️', 'Alertas', stats.total_alerts|default(0)],
            ['stat-jams', '🚗', 'Congestionamentos', stats.total_jams|default(0)],
            ['stat-weather', '☁️', 'Observações climáticas', stats.total_weather|default(0)],
            ['stat-partners', '🤝', 'Parceiros', stats.total_partners|default(0)],
            ['stat-users', '👥', 'Usuários', stats.total_users|default(0)]
        ] %}
        {% for card in cards %}
            <article class="stat-card {{ card[0] }} dashboard-reveal">
                <span class="stat-icon" aria-hidden="true">{{ card[1] }}</span>
                <strong class="stat-value" data-count-value="{{ card[3] }}">{{ card[3] }}</strong>
                <span class="stat-label">{{ card[2] }}</span>
            </article>
        {% endfor %}
    </section>

    <div class="dashboard-grid">
        <section class="dashboard-card dashboard-reveal">
            <div class="card-heading"><div><span class="card-kicker">Alertas</span><h2>Alertas recentes</h2></div></div>
            <div class="table-responsive">
                <table class="data-table">
                    <thead><tr><th>ID</th><th>Tipo</th><th>Data</th></tr></thead>
                    <tbody>
                    {% for alert in stats.recent_alerts|default([]) %}
                        <tr>
                            <td>#{{ alert.id }}</td>
                            <td><span class="badge badge-alert">{{ alert.type|default('Alerta') }}</span></td>
                            <td>{% if alert.pubDateTime %}{{ alert.pubDateTime|date('d/m/Y H:i') }}{% else %}—{% endif %}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="3" class="empty-state">Nenhum alerta encontrado.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="dashboard-card dashboard-reveal">
            <div class="card-heading"><div><span class="card-kicker">Trânsito</span><h2>Congestionamentos recentes</h2></div></div>
            <div class="table-responsive">
                <table class="data-table">
                    <thead><tr><th>ID</th><th>Local</th><th>Velocidade</th><th>Nível</th><th>Data</th></tr></thead>
                    <tbody>
                    {% for jam in stats.recent_jams|default([]) %}
                        <tr>
                            <td>#{{ jam.id }}</td>
                            <td>{{ jam.street|default('Rua não informada') }}{% if jam.city %}<small class="text-muted"> — {{ jam.city }}</small>{% endif %}</td>
                            <td>{{ jam.speedKmh|default(0) }} km/h</td>
                            <td>{{ jam.levelLabel|default('—') }}</td>
                            <td>{% if jam.pubDateTime %}{{ jam.pubDateTime|date('d/m/Y H:i') }}{% else %}—{% endif %}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="empty-state">Nenhum congestionamento encontrado.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="dashboard-card dashboard-reveal">
            <div class="card-heading"><div><span class="card-kicker">Distribuição</span><h2>Alertas por tipo</h2></div></div>
            <div class="chart-wrap"><canvas data-dashboard-chart="alerts" data-chart-values='{{ stats.alerts_by_type|default({})|json_encode|e('html_attr') }}'></canvas></div>
        </section>

        <section class="dashboard-card dashboard-reveal">
            <div class="card-heading"><div><span class="card-kicker">Monitoramento</span><h2>Mapa operacional</h2></div></div>
            <div class="dashboard-map" data-dashboard-map data-points='{{ stats.map_points|default([])|json_encode|e('html_attr') }}'></div>
        </section>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module" src="{{ asset('js/dashboard.js') }}"></script>
{% endblock %}
