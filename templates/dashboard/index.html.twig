{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block dashboard_content %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Dashboard</h1>
            <p class="text-muted mb-0">Resumo operacional do seu partner</p>
        </div>
        <span class="badge text-bg-success">Atualizado agora</span>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted">Alertas hoje</div>
                <div class="display-6 fw-semibold">{{ alerts_count|default(0) }}</div>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted">Congestionamentos hoje</div>
                <div class="display-6 fw-semibold">{{ jams_count|default(0) }}</div>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted">Rotas TVT</div>
                <div class="display-6 fw-semibold">{{ routes_count|default(0) }}</div>
            </div></div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-4"><div class="card h-100 shadow-sm">
            <div class="card-header">Alertas ativos</div>
            <div class="card-body p-0">
                {% if alerts|default([])|length %}
                    <ul class="list-group list-group-flush">
                    {% for alert in alerts|slice(0, 10) %}
                        <li class="list-group-item d-flex justify-content-between">
                            <span>{{ alert.type|default('Alerta') }}</span>
                            <small class="text-muted">{{ alert.lastSeenAt is defined and alert.lastSeenAt ? alert.lastSeenAt|date('H:i') : '' }}</small>
                        </li>
                    {% endfor %}
                    </ul>
                {% else %}<p class="text-muted p-3 mb-0">Nenhum alerta ativo.</p>{% endif %}
            </div>
        </div></div>
        <div class="col-lg-4"><div class="card h-100 shadow-sm">
            <div class="card-header">Congestionamentos ativos</div>
            <div class="card-body p-0">
                {% if jams|default([])|length %}
                    <ul class="list-group list-group-flush">
                    {% for jam in jams|slice(0, 10) %}
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Nível {{ jam.level|default('-') }}</span>
                            <small class="text-muted">{{ jam.lastSeenAt is defined and jam.lastSeenAt ? jam.lastSeenAt|date('H:i') : '' }}</small>
                        </li>
                    {% endfor %}
                    </ul>
                {% else %}<p class="text-muted p-3 mb-0">Nenhum congestionamento ativo.</p>{% endif %}
            </div>
        </div></div>
        <div class="col-lg-4"><div class="card h-100 shadow-sm">
            <div class="card-header">Rotas ativas</div>
            <div class="card-body p-0">
                {% if routes|default([])|length %}
                    <ul class="list-group list-group-flush">
                    {% for route in routes|slice(0, 10) %}
                        <li class="list-group-item">{{ route.name|default('Rota') }}</li>
                    {% endfor %}
                    </ul>
                {% else %}<p class="text-muted p-3 mb-0">Nenhuma rota ativa.</p>{% endif %}
            </div>
        </div></div>
    </div>
</div>
{% endblock %}
