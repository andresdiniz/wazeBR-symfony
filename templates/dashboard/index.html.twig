{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Dashboard | WazeBR{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" ...>
    <link rel="stylesheet" href="{{ asset('css/pages/dashboard.css') }}">
{% endblock %}


{% block content %}
{% set totals = stats.totals|default({}) %}
{% set kpis   = stats.kpis|default({}) %}
{% set health = kpis.health_score|default(100) %}
{% set hydro  = stats.hydro|default({}) %}
{% set hydroStats  = hydro.stats|default({}) %}
{% set hydroList   = hydro.stations_list|default([]) %}
{% set pluvio      = stats.pluvio|default({}) %}
{% set pluvioStats = pluvio.stats|default({}) %}
{% set fetch       = stats.fetch_status|default({}) %}

{% macro riskClass(risk) %}
{%- if risk == 'overflow' -%}hydro-station-btn--overflow
{%- elseif risk == 'alert' -%}hydro-station-btn--alert
{%- elseif risk == 'attention' -%}hydro-station-btn--attention
{%- elseif risk == 'normal' -%}hydro-station-btn--normal
{%- else -%}hydro-station-btn--unknown
{%- endif -%}
{% endmacro %}

<div class="dashboard-page"
     data-dashboard
     data-api-endpoint="{{ path('dashboard_api_data') }}"
     data-partner-id="{{ partner ? partner.id : '' }}">

    <div class="dashboard-container">

        {# ── Cabeçalho ─────────────────────────────────────────────── #}
        <header class="dashboard-page-header">
            <div>
                <span class="dashboard-eyebrow"><i></i> Centro operacional</span>
                <h1>Visão geral da mobilidade</h1>
                <p>
                    Trânsito, alertas, rotas, clima, rios, chuvas e câmeras em um só lugar.
                    {% if partner %} — <strong>{{ partner.name }}</strong>{% endif %}
                </p>
            </div>
            <div class="dashboard-header-tools">
                <span class="dashboard-last-update">
                    <i></i> Atualizado em
                    <time data-dashboard-clock>{{ stats.updated_at|date('d/m H:i') }}</time>
                </span>
                <button type="button" class="dashboard-button" data-action="refresh-dashboard" aria-label="Recarregar dados">
                    <span>↻</span> Atualizar
                </button>
            </div>
        </header>

        {# ── Filtros ────────────────────────────────────────────────── #}
        <section class="dashboard-filter-panel" aria-label="Filtros do dashboard">
            <div class="dashboard-filter-heading">
                <div>
                    <span class="dashboard-panel-kicker">Explorar dados</span>
                    <h2>Filtros e navegação</h2>
                </div>
                <button type="button" class="dashboard-button is-link" data-action="clear-filters">Limpar filtros</button>
            </div>

            <form class="dashboard-filter-form" data-filter-form>
                <label class="dashboard-filter-field">
                    <span>Período</span>
                    <select name="period" data-filter="period">
                        <option value="all"   {{ filters.period == 'all'   ? 'selected' }}>Todos os registros</option>
                        <option value="today" {{ filters.period == 'today' ? 'selected' }}>Hoje</option>
                        <option value="week"  {{ filters.period == 'week'  ? 'selected' }}>Últimos 7 dias</option>
                        <option value="month" {{ filters.period == 'month' ? 'selected' }}>Últimos 30 dias</option>
                        <option value="year"  {{ filters.period == 'year'  ? 'selected' }}>Últimos 12 meses</option>
                    </select>
                </label>

                <label class="dashboard-filter-field">
                    <span>Tipo</span>
                    <select name="type" data-filter="type">
                        <option value="all"     {{ filters.type == 'all'     ? 'selected' }}>Todos</option>
                        <option value="alerts"  {{ filters.type == 'alerts'  ? 'selected' }}>Alertas</option>
                        <option value="jams"    {{ filters.type == 'jams'    ? 'selected' }}>Congestionamentos</option>
                        <option value="weather" {{ filters.type == 'weather' ? 'selected' }}>Clima</option>
                        <option value="routes"  {{ filters.type == 'routes'  ? 'selected' }}>Rotas</option>
                        <option value="hydro"   {{ filters.type == 'hydro'   ? 'selected' }}>Hidrologia</option>
                        <option value="pluvio"  {{ filters.type == 'pluvio'  ? 'selected' }}>Pluviometria</option>
                    </select>
                </label>

                <label class="dashboard-filter-field dashboard-filter-field--grow">
                    <span>Buscar</span>
                    <input type="search" name="query" data-filter="query"
                           value="{{ filters.query }}"
                           placeholder="Tipo, rua, cidade, uuid..." autocomplete="off">
                </label>

                <label class="dashboard-filter-field">
                    <span>Cidade</span>
                    <input type="text" name="city" data-filter="city"
                           value="{{ filters.city }}"
                           placeholder="Ex.: Conselheiro Lafaiete" autocomplete="off">
                </label>

                <label class="dashboard-filter-field dashboard-filter-field--grow">
                    <span>Excluir vias (regex, uma por linha)</span>
                    <textarea name="exclude_streets" data-filter="exclude_streets"
                              rows="2"
                              placeholder="Ex.: ^BR-|^MG-|anel viário">{{ filters.exclude_streets }}</textarea>
                </label>

                <div class="dashboard-filter-actions">
                    <button type="submit" class="dashboard-button is-primary" data-action="apply-filters">Aplicar</button>
                    <button type="button" class="dashboard-button" data-action="clear-filters">Limpar</button>
                </div>
            </form>

            <p class="dashboard-filter-feedback" data-filter-feedback aria-live="polite"></p>
        </section>

        {# ── KPIs ───────────────────────────────────────────────────── #}
        <section class="dashboard-kpi-grid" aria-label="Indicadores principais">
            <article class="dashboard-kpi-card kpi-blue">
                <div class="dashboard-kpi-top">
                    <span class="dashboard-kpi-icon" aria-hidden="true">⚠</span>
                    <span class="dashboard-kpi-trend" data-kpi-trend="alerts_active">{{ totals.alerts_active|default(0) }} ativos</span>
                </div>
                <strong class="dashboard-kpi-value" data-count-value="{{ kpis.alerts|default(0) }}">{{ kpis.alerts|default(0) }}</strong>
                <span class="dashboard-kpi-label">Alertas registrados</span>
                <div class="dashboard-kpi-footer"><span>Waze Partner Feed</span><span aria-hidden="true">→</span></div>
            </article>

            <article class="dashboard-kpi-card kpi-orange">
                <div class="dashboard-kpi-top">
                    <span class="dashboard-kpi-icon" aria-hidden="true">≋</span>
                    <span class="dashboard-kpi-trend {{ totals.jams_active|default(0) > 10 ? 'is-warning' }}"
                          data-kpi-trend="jams_active">{{ totals.jams_active|default(0) }} ativos</span>
                </div>
                <strong class="dashboard-kpi-value" data-count-value="{{ kpis.jams|default(0) }}">{{ kpis.jams|default(0) }}</strong>
                <span class="dashboard-kpi-label">Congestionamentos</span>
                <div class="dashboard-kpi-footer"><span>Atraso médio {{ totals.jams_avg_delay|default(0)|round(0) }}s</span><span aria-hidden="true">→</span></div>
            </article>

            <article class="dashboard-kpi-card kpi-gold">
                <div class="dashboard-kpi-top">
                    <span class="dashboard-kpi-icon" aria-hidden="true">⇉</span>
                    <span class="dashboard-kpi-trend {{ kpis.routes_delayed|default(0) > 0 ? 'is-warning' }}"
                          data-kpi-trend="routes_delayed">{{ kpis.routes_delayed|default(0) }} atrasadas</span>
                </div>
                <strong class="dashboard-kpi-value" data-count-value="{{ kpis.routes_total|default(0) }}">{{ kpis.routes_total|default(0) }}</strong>
                <span class="dashboard-kpi-label">Rotas TVT monitoradas</span>
                <div class="dashboard-kpi-footer">
                    <span>{{ kpis.routes_severe|default(0) }} críticas/altas</span>
                    <span aria-hidden="true">→</span>
                </div>
            </article>

            <article class="dashboard-kpi-card kpi-green">
                <div class="dashboard-kpi-top">
                    <span class="dashboard-kpi-icon" aria-hidden="true">☁</span>
                    <span class="dashboard-kpi-trend is-positive">Monitorado</span>
                </div>
                <strong class="dashboard-kpi-value" data-count-value="{{ kpis.weather|default(0) }}">{{ kpis.weather|default(0) }}</strong>
                <span class="dashboard-kpi-label">Observações climáticas</span>
                <div class="dashboard-kpi-footer"><span>Open-Meteo</span><span aria-hidden="true">→</span></div>
            </article>

            <article class="dashboard-kpi-card kpi-purple">
                <div class="dashboard-kpi-top">
                    <span class="dashboard-kpi-icon" aria-hidden="true">◎</span>
                    <span class="dashboard-kpi-trend is-positive">Conectado</span>
                </div>
                <strong class="dashboard-kpi-value" data-count-value="{{ kpis.cameras|default(0) }}">{{ kpis.cameras|default(0) }}</strong>
                <span class="dashboard-kpi-label">Câmeras parceiras</span>
                <div class="dashboard-kpi-footer"><span>{{ kpis.partners|default(0) }} parceiros · {{ kpis.users|default(0) }} usuários</span><span aria-hidden="true">→</span></div>
            </article>

            <article class="dashboard-kpi-card kpi-cyan">
                <div class="dashboard-kpi-top">
                    <span class="dashboard-kpi-icon" aria-hidden="true">≈</span>
                    <span class="dashboard-kpi-trend {{ kpis.hydro_at_risk|default(0) > 0 ? 'is-warning' }}"
                          data-kpi-trend="hydro_at_risk">{{ kpis.hydro_at_risk|default(0) }} em atenção</span>
                </div>
                <strong class="dashboard-kpi-value" data-count-value="{{ kpis.hydro_stations|default(0) }}">{{ kpis.hydro_stations|default(0) }}</strong>
                <span class="dashboard-kpi-label">Rios monitorados</span>
                <div class="dashboard-kpi-footer"><span>CEMADEN Hidro</span><span aria-hidden="true">→</span></div>
            </article>

            <article class="dashboard-kpi-card kpi-rain">
                <div class="dashboard-kpi-top">
                    <span class="dashboard-kpi-icon" aria-hidden="true">☔</span>
                    <span class="dashboard-kpi-trend {{ kpis.pluvio_rain_24h|default(0) > 0 ? 'is-positive' }}"
                          data-kpi-trend="pluvio_rain_24h">{{ kpis.pluvio_rain_24h|default(0)|number_format(1, ',', '.') }} mm · 24h</span>
                </div>
                <strong class="dashboard-kpi-value" data-count-value="{{ kpis.pluvio_stations|default(0) }}">{{ kpis.pluvio_stations|default(0) }}</strong>
                <span class="dashboard-kpi-label">Pontos de chuva</span>
                <div class="dashboard-kpi-footer">
                    <span>Pico {{ kpis.pluvio_peak_24h|default(0)|number_format(1, ',', '.') }} mm/h</span>
                    <span aria-hidden="true">→</span>
                </div>
            </article>
        </section>

        {# ── Linha 1: atividade + tipos ────────────────────────────── #}
        <div class="dashboard-main-grid">
            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div>
                        <span class="dashboard-panel-kicker">Indicadores</span>
                        <h2>Atividade por hora</h2>
                    </div>
                    <span class="dashboard-panel-period">0h – 23h</span>
                </header>
                <div class="dashboard-chart-wrap">
                    <canvas data-chart="hourly-activity"
                            data-chart-data='{{ stats.charts.hourly_activity|json_encode|e('html_attr') }}'></canvas>
                </div>
            </section>

            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div>
                        <span class="dashboard-panel-kicker">Composição</span>
                        <h2>Alertas por tipo</h2>
                    </div>
                </header>
                <div class="dashboard-chart-wrap">
                    <canvas data-chart="alerts-by-type"
                            data-chart-data='{{ stats.charts.alerts_by_type|json_encode|e('html_attr') }}'></canvas>
                </div>
            </section>
        </div>

        {# ── Linha 2: top ruas + jams + clima ──────────────────────── #}
        <div class="dashboard-main-grid">
            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div>
                        <span class="dashboard-panel-kicker">Top ruas</span>
                        <h2>Concentração de alertas</h2>
                    </div>
                </header>
                <div class="dashboard-chart-wrap dashboard-chart-wrap--tall">
                    <canvas data-chart="alerts-by-street"
                            data-chart-data='{{ stats.charts.alerts_by_street|json_encode|e('html_attr') }}'></canvas>
                </div>
            </section>

            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div>
                        <span class="dashboard-panel-kicker">Congestionamentos</span>
                        <h2>Distribuição por nível</h2>
                    </div>
                </header>
                <div class="dashboard-chart-wrap dashboard-chart-wrap--tall">
                    <canvas data-chart="jams-by-level"
                            data-chart-data='{{ stats.charts.jams_by_level|json_encode|e('html_attr') }}'></canvas>
                </div>
            </section>

            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div>
                        <span class="dashboard-panel-kicker">Clima</span>
                        <h2>Tendência meteorológica</h2>
                    </div>
                </header>
                <div class="dashboard-chart-wrap dashboard-chart-wrap--tall">
                    <canvas data-chart="weather-trend"
                            data-chart-data='{{ stats.charts.weather_trend|json_encode|e('html_attr') }}'></canvas>
                </div>
            </section>
        </div>

        {# ── Monitoramento hidrológico ────────────────────────────── #}
        <section class="dashboard-panel dashboard-hydro-panel"
                 data-hydro-panel
                 data-hydro-trend-all='{{ hydro.trend|default([])|json_encode|e('html_attr') }}'
                 data-hydro-trend-by-station='{{ hydro.trend_by_station|default({})|json_encode|e('html_attr') }}'>
            <header class="dashboard-panel-header">
                <div>
                    <span class="dashboard-panel-kicker">Recursos hídricos</span>
                    <h2>Nível dos rios</h2>
                </div>
                <span class="dashboard-panel-period">
                    {% if hydroStats.last_fetch %}
                        Última coleta {{ hydroStats.last_fetch|date('d/m H:i') }}
                    {% else %}
                        Sem coletas ainda
                    {% endif %}
                </span>
            </header>

            <div class="dashboard-hydro-strip">
                <div class="hydro-stat">
                    <span class="hydro-stat-label">Estações</span>
                    <strong data-hydro-stat="stations">{{ hydroStats.stations|default(0) }}</strong>
                </div>
                <div class="hydro-stat {{ (hydroStats.risk.overflow|default(0) + hydroStats.risk.alert|default(0)) > 0 ? 'is-danger' }}">
                    <span class="hydro-stat-label">Alerta / transbordo</span>
                    <strong data-hydro-stat="alert">{{ hydroStats.risk.overflow|default(0) + hydroStats.risk.alert|default(0) }}</strong>
                </div>
                <div class="hydro-stat {{ hydroStats.risk.attention|default(0) > 0 ? 'is-warning' }}">
                    <span class="hydro-stat-label">Em atenção</span>
                    <strong data-hydro-stat="attention">{{ hydroStats.risk.attention|default(0) }}</strong>
                </div>
                <div class="hydro-stat is-normal">
                    <span class="hydro-stat-label">Normal</span>
                    <strong data-hydro-stat="normal">{{ hydroStats.risk.normal|default(0) }}</strong>
                </div>
            </div>

            <div class="dashboard-hydro-layout" data-hydro-layout>
                <div class="dashboard-hydro-chart dashboard-hydro-chart--full">
                    <canvas data-chart="hydro-trend"
                            data-chart-data='{{ hydro.trend|default([])|json_encode|e('html_attr') }}'></canvas>
                </div>

                {% if hydroList|length > 1 %}
                    <aside class="dashboard-station-picker" data-hydro-picker>
                        <div class="dashboard-station-picker-head">
                            <strong>Rios monitorados</strong>
                            <small>{{ hydroList|length }} estações</small>
                        </div>
                        <button type="button"
                                class="hydro-station-btn is-active hydro-station-btn--all"
                                data-hydro-select="all">
                            <span class="hydro-station-btn-name">Todas as estações</span>
                            <small>Média agregada</small>
                        </button>
                        {% for st in hydroList %}
                            <button type="button"
                                    class="hydro-station-btn {{ _self.riskClass(st.risk) }}"
                                    data-hydro-select="{{ st.id }}"
                                    data-station-level="{{ st.level is not null ? st.level : '' }}"
                                    data-station-risk="{{ st.risk }}">
                                <span class="hydro-station-btn-name">{{ st.name }}</span>
                                <small>{{ st.city|default('—') }}{% if st.state %}/{{ st.state }}{% endif %}</small>
                                <span class="hydro-station-btn-level">
                                    {% if st.level is not null %}
                                        {{ st.level|number_format(2, ',', '.') }} m
                                    {% else %}
                                        —
                                    {% endif %}
                                </span>
                            </button>
                        {% endfor %}
                    </aside>
                {% endif %}
            </div>
        </section>

        {# ── Pluviometria ─────────────────────────────────────────── #}
        <section class="dashboard-panel dashboard-pluvio-panel"
                 data-pluvio-panel
                 data-pluvio-hourly-all='{{ pluvio.hourly|default([])|json_encode|e('html_attr') }}'
                 data-pluvio-hourly-by-station='{{ pluvio.hourly_by_station|default({})|json_encode|e('html_attr') }}'>
            <header class="dashboard-panel-header">
                <div>
                    <span class="dashboard-panel-kicker">Precipitação</span>
                    <h2>Chuva por hora e por estação</h2>
                </div>
                <span class="dashboard-panel-period">
                    {% if pluvioStats.last_reading %}
                        Última leitura {{ pluvioStats.last_reading|date('d/m H:i') }}
                    {% else %}
                        Sem leituras
                    {% endif %}
                </span>
            </header>

            <div class="dashboard-hydro-strip">
                <div class="hydro-stat">
                    <span class="hydro-stat-label">Pontos de medição</span>
                    <strong data-pluvio-stat="stations">{{ pluvioStats.stations|default(0) }}</strong>
                </div>
                <div class="hydro-stat {{ pluvioStats.rain_1h|default(0) > 0 ? 'is-warning' }}">
                    <span class="hydro-stat-label">Última hora</span>
                    <strong data-pluvio-stat="rain_1h">{{ pluvioStats.rain_1h|default(0)|number_format(1, ',', '.') }}<small style="font-size:11px;font-weight:600;color:var(--dash-muted);margin-left:4px">mm</small></strong>
                </div>
                <div class="hydro-stat {{ pluvioStats.rain_24h|default(0) > 0 ? 'is-normal' : '' }}">
                    <span class="hydro-stat-label">Últimas 24h</span>
                    <strong data-pluvio-stat="rain_24h">{{ pluvioStats.rain_24h|default(0)|number_format(1, ',', '.') }}<small style="font-size:11px;font-weight:600;color:var(--dash-muted);margin-left:4px">mm</small></strong>
                </div>
                <div class="hydro-stat">
                    <span class="hydro-stat-label">Pico / 24h</span>
                    <strong data-pluvio-stat="peak_24h">{{ pluvioStats.peak_24h|default(0)|number_format(1, ',', '.') }}<small style="font-size:11px;font-weight:600;color:var(--dash-muted);margin-left:4px">mm/h</small></strong>
                </div>
            </div>

            <div class="dashboard-hydro-layout">
                <div class="dashboard-hydro-chart">
                    <canvas data-chart="pluvio-hourly"
                            data-chart-data='{{ pluvio.hourly|default([])|json_encode|e('html_attr') }}'></canvas>
                </div>

                <aside class="dashboard-station-picker" data-pluvio-picker>
                    <div class="dashboard-station-picker-head">
                        <strong>Chuva por estação · 24h</strong>
                        <small>{{ pluvio.stations|default([])|length }} pontos</small>
                    </div>
                    <button type="button"
                            class="hydro-station-btn is-active hydro-station-btn--all"
                            data-pluvio-select="all">
                        <span class="hydro-station-btn-name">Todas as estações</span>
                        <small>Média agregada</small>
                    </button>
                    {% for s in pluvio.stations|default([]) %}
                        {% set pct = pluvioStats.peak_24h > 0
                            ? min(100, (s.rain24h / pluvioStats.peak_24h) * 100)
                            : 0 %}
                        <button type="button"
                                class="hydro-station-btn pluvio-station-btn pluvio-station-btn--{{ s.source }}"
                                data-pluvio-select="{{ s.stationId }}"
                                data-pluvio-rain24h="{{ s.rain24h }}"
                                style="--pct:{{ pct }}">
                            <span class="hydro-station-btn-name">
                                {{ s.stationName }}
                                <span class="pluvio-source-badge pluvio-source-badge--{{ s.source }}">
                                    {{ s.source == 'hydro' ? 'Hidro' : 'Auto' }}
                                </span>
                            </span>
                            <small>
                                {{ s.city|default('—') }}{% if s.state %}/{{ s.state }}{% endif %}
                                {% if s.lastReading %} · {{ s.lastReading|date('d/m H:i') }}{% endif %}
                            </small>
                            <span class="hydro-station-btn-level">
                                {{ s.rain24h|number_format(1, ',', '.') }} mm
                            </span>
                        </button>
                    {% else %}
                        <div class="dashboard-empty">
                            <span aria-hidden="true">✓</span>
                            <strong>Sem leituras de chuva</strong>
                            <small>Cadastre um pluviômetro ou estação hidro com dados de chuva.</small>
                        </div>
                    {% endfor %}
                </aside>
            </div>
        </section>

        {# ── Mapa ───────────────────────────────────────────────────── #}
        <section class="dashboard-panel dashboard-map-panel">
            <header class="dashboard-panel-header">
                <div>
                    <span class="dashboard-panel-kicker">Geolocalização</span>
                    <h2>Mapa operacional</h2>
                </div>
                <div class="dashboard-map-legend" aria-label="Legenda do mapa">
                    <button type="button" class="dashboard-map-toggle is-active" data-layer-toggle="alerts">⚠ Alertas</button>
                    <button type="button" class="dashboard-map-toggle is-active" data-layer-toggle="jams">≋ Jams</button>
                    <button type="button" class="dashboard-map-toggle is-active" data-layer-toggle="cameras">◎ Câmeras</button>
                    <button type="button" class="dashboard-map-toggle is-active" data-layer-toggle="weather">☁ Clima</button>
                    <button type="button" class="dashboard-map-toggle is-active" data-layer-toggle="stations">☔ Chuva</button>
                </div>
            </header>
            <div class="dashboard-map"
                 data-dashboard-map
                 data-map-center='{{ stats.map.center|json_encode|e('html_attr') }}'
                 data-map-alerts='{{ stats.map.alerts|json_encode|e('html_attr') }}'
                 data-map-jams='{{ stats.map.jams|json_encode|e('html_attr') }}'
                 data-map-cameras='{{ stats.map.cameras|json_encode|e('html_attr') }}'
                 data-map-weather='{{ stats.map.weather|json_encode|e('html_attr') }}'
                 data-map-stations='{{ stats.map.stations|json_encode|e('html_attr') }}'></div>
        </section>

        {# ── Listas de dados ────────────────────────────────────────── #}
        <div class="dashboard-content-grid">
            <section class="dashboard-panel data-section" data-section="alerts">
                <header class="dashboard-panel-header">
                    <div><span class="dashboard-panel-kicker">Tempo real</span><h2>Alertas recentes</h2></div>
                    <span class="dashboard-panel-count {{ stats.recent.alerts|length > 0 ? 'is-orange' }}"
                          data-count="recent-alerts">{{ stats.recent.alerts|length }}</span>
                </header>
                <div class="dashboard-data-list" data-list="alerts">
                    {% for alert in stats.recent.alerts %}
                        <div class="dashboard-data-row">
                            <span class="dashboard-row-icon row-orange" aria-hidden="true">⚠</span>
                            <div>
                                <strong>{{ alert.typeLabel }}</strong>
                                <small>#{{ alert.id }} · {{ alert.subtype|default('—') }} · {{ alert.city|default('Local não informado') }}{% if alert.street %} · {{ alert.street }}{% endif %}</small>
                            </div>
                            <time datetime="{{ alert.pubDateTime }}">{{ alert.pubDateTime ? alert.pubDateTime|date('d/m H:i') : '—' }}</time>
                            <span class="dashboard-severity">Confiança {{ alert.confidence }}</span>
                        </div>
                    {% else %}
                        <div class="dashboard-empty"><span aria-hidden="true">✓</span><strong>Nenhum alerta recente</strong><small>Ajuste os filtros ou verifique as fontes.</small></div>
                    {% endfor %}
                </div>
            </section>

            <section class="dashboard-panel data-section" data-section="jams">
                <header class="dashboard-panel-header">
                    <div><span class="dashboard-panel-kicker">Trânsito</span><h2>Congestionamentos</h2></div>
                    <span class="dashboard-panel-count {{ stats.recent.jams|length > 0 ? 'is-orange' }}"
                          data-count="recent-jams">{{ stats.recent.jams|length }}</span>
                </header>
                <div class="dashboard-data-list" data-list="jams">
                    {% for jam in stats.recent.jams %}
                        <div class="dashboard-data-row">
                            <span class="dashboard-row-icon row-orange" aria-hidden="true">≋</span>
                            <div>
                                <strong>{{ jam.street|default('Via não informada') }}</strong>
                                <small>
                                    {{ jam.city|default('—') }}
                                    {% if jam.speedKmh is not null %} · {{ jam.speedKmh|round(1) }} km/h{% endif %}
                                    {% if jam.length %} · {{ (jam.length / 1000)|round(1) }} km{% endif %}
                                </small>
                            </div>
                            <span class="dashboard-severity dashboard-jam-level-{{ jam.level }}">Nível {{ jam.level }}</span>
                        </div>
                    {% else %}
                        <div class="dashboard-empty"><span aria-hidden="true">✓</span><strong>Nenhum congestionamento</strong><small>Não há ocorrências viárias no período.</small></div>
                    {% endfor %}
                </div>
            </section>

            <section class="dashboard-panel data-section" data-section="routes">
                <header class="dashboard-panel-header">
                    <div><span class="dashboard-panel-kicker">Rotas TVT</span><h2>Maior atraso por rota</h2></div>
                    <span class="dashboard-panel-count {{ stats.recent.routes|length > 0 ? 'is-orange' }}"
                          data-count="recent-routes">{{ stats.recent.routes|length }}</span>
                </header>
                <div class="dashboard-data-list" data-list="routes">
                    {% for route in stats.recent.routes %}
                        <div class="dashboard-data-row">
                            <span class="dashboard-row-icon {{ route.delay_level.level in ['severe','heavy'] ? 'row-orange' : (route.delay_level.level == 'none' ? 'row-green' : 'row-blue') }}" aria-hidden="true">→</span>
                            <div>
                                <strong>{{ route.name }}</strong>
                                <small>
                                    {% if route.from_name and route.to_name %}{{ route.from_name }} → {{ route.to_name }} · {% endif %}
                                    Atual {{ route.time|default('—') }}s · Hist. {{ route.historic_time|default('—') }}s
                                </small>
                            </div>
                            <span class="dashboard-severity delay-badge delay-badge--{{ route.delay_level.level }}">
                                {% if route.delay_seconds is not null and route.delay_seconds > 0 %}
                                    +{{ route.delay_seconds }}s
                                    <small>({{ (route.delay_ratio * 100)|round(0) }}%)</small>
                                {% elseif route.jam_level is not null %}
                                    Nível {{ route.jam_level }}
                                {% else %}
                                    No prazo
                                {% endif %}
                            </span>
                        </div>
                    {% else %}
                        <div class="dashboard-empty"><span aria-hidden="true">✓</span><strong>Nenhuma rota encontrada</strong><small>Sem snapshots vinculados às rotas.</small></div>
                    {% endfor %}
                </div>
            </section>
        </div>

        {# ── Rodapé ─────────────────────────────────────────────────── #}
        <div class="dashboard-bottom-grid">
            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div><span class="dashboard-panel-kicker">Status</span><h2>Saúde da operação</h2></div>
                    <span class="dashboard-health-badge"><i></i> Online</span>
                </header>
                <div class="dashboard-health-score">
                    <div class="dashboard-health-ring" style="--health-score:{{ health }}"
                         role="meter" aria-valuenow="{{ health }}" aria-valuemin="0" aria-valuemax="100">
                        <span>{{ health }}<small>%</small></span>
                    </div>
                    <div>
                        <strong>
                            {% if health >= 80 %}Operação estável
                            {% elseif health >= 60 %}Atenção recomendada
                            {% else %}Operação crítica{% endif %}
                        </strong>
                        <p>
                            {% if health >= 80 %}Fontes de dados disponíveis e monitoradas.
                            {% elseif health >= 60 %}Algumas rotas com atraso ou volume elevado.
                            {% else %}Alto volume de alertas, congestionamentos ou rios em alerta.{% endif %}
                        </p>
                    </div>
                </div>
                <div class="dashboard-health-list">
                    <div><span><i class="health-green"></i> Alertas ativos</span><strong>{{ totals.alerts_active|default(0) }}</strong></div>
                    <div><span><i class="health-{{ totals.jams_active|default(0) > 10 ? 'orange' : 'blue' }}"></i> Jams ativos</span><strong>{{ totals.jams_active|default(0) }}</strong></div>
                    <div><span><i class="health-gray"></i> Rotas com snapshot</span><strong>{{ stats.recent.routes|length }}</strong></div>
                    <div><span><i class="health-{{ hydroStats.at_risk|default(0) > 0 ? 'orange' : 'gray' }}"></i> Rios em atenção</span><strong>{{ hydroStats.at_risk|default(0) }}</strong></div>
                </div>
            </section>

            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div><span class="dashboard-panel-kicker">Coletas</span><h2>Última execução por fonte</h2></div>
                </header>
                <div class="dashboard-fetch-list" data-fetch-list>
                    <div>
                        <span>Waze Alerts</span>
                        <strong data-fetch="waze_alerts">{{ fetch.waze_alerts ? fetch.waze_alerts|date('d/m/Y H:i') : '—' }}</strong>
                    </div>
                    <div>
                        <span>Waze Jams</span>
                        <strong data-fetch="waze_jams">{{ fetch.waze_jams ? fetch.waze_jams|date('d/m/Y H:i') : '—' }}</strong>
                    </div>
                    <div>
                        <span>Waze TVT (rotas)</span>
                        <strong data-fetch="waze_tvt">{{ fetch.waze_tvt ? fetch.waze_tvt|date('d/m/Y H:i') : '—' }}</strong>
                    </div>
                    <div>
                        <span>Clima (Open-Meteo)</span>
                        <strong data-fetch="weather">{{ fetch.weather ? fetch.weather|date('d/m/Y H:i') : '—' }}</strong>
                    </div>
                    <div>
                        <span>CEMADEN Hidro</span>
                        <strong data-fetch="cemaden_hydro">{{ fetch.cemaden_hydro ? fetch.cemaden_hydro|date('d/m/Y H:i') : '—' }}</strong>
                    </div>
                    <div>
                        <span>CEMADEN Chuva</span>
                        <strong data-fetch="cemaden_pluvio">{{ fetch.cemaden_pluvio ? fetch.cemaden_pluvio|date('d/m/Y H:i') : '—' }}</strong>
                    </div>
                    <div>
                        <span>Câmeras parceiras</span>
                        <strong data-fetch="cameras">{{ fetch.cameras ? fetch.cameras|date('d/m/Y H:i') : '—' }}</strong>
                    </div>
                </div>
            </section>

            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div><span class="dashboard-panel-kicker">Clima</span><h2>Leituras recentes</h2></div>
                </header>
                <div class="dashboard-data-list" data-list="weather">
                    {% for obs in stats.recent.weather %}
                        <div class="dashboard-data-row">
                            <span class="dashboard-row-icon row-green" aria-hidden="true">☁</span>
                            <div>
                                <strong>{{ obs.locationName|default('Estação') }}</strong>
                                <small>{{ obs.city|default('—') }} · {{ obs.observedAt ? obs.observedAt|date('d/m H:i') : '' }}</small>
                            </div>
                            <span class="dashboard-severity">
                                {% if obs.temperature is not null %}{{ obs.temperature|round(1) }}°C{% endif %}
                                {% if obs.humidity is not null %} · {{ obs.humidity }}%{% endif %}
                            </span>
                        </div>
                    {% else %}
                        <div class="dashboard-empty"><span aria-hidden="true">✓</span><strong>Sem leituras climáticas</strong><small>Cadastre uma localização meteorológica.</small></div>
                    {% endfor %}
                </div>
            </section>
        </div>

        <section class="dashboard-panel">
            <header class="dashboard-panel-header">
                <div><span class="dashboard-panel-kicker">Integrações</span><h2>Fontes de dados</h2></div>
            </header>
            <div class="dashboard-source-list">
                <div><span>Waze Alerts</span><strong class="dashboard-status {{ totals.alerts > 0 ? 'is-active' }}">{{ totals.alerts > 0 ? 'Ativo' : 'Sem dados' }}</strong></div>
                <div><span>Waze Jams</span><strong class="dashboard-status {{ totals.jams > 0 ? 'is-active' }}">{{ totals.jams > 0 ? 'Ativo' : 'Sem dados' }}</strong></div>
                <div><span>Clima (Open-Meteo)</span><strong class="dashboard-status {{ totals.weather > 0 ? 'is-active' }}">{{ totals.weather > 0 ? 'Ativo' : 'Sem dados' }}</strong></div>
                <div><span>CEMADEN Hidro</span><strong class="dashboard-status {{ kpis.hydro_stations|default(0) > 0 ? 'is-active' }}">{{ kpis.hydro_stations|default(0) > 0 ? 'Ativo' : 'Sem dados' }}</strong></div>
                <div><span>CEMADEN Chuva</span><strong class="dashboard-status {{ kpis.pluvio_stations|default(0) > 0 ? 'is-active' }}">{{ kpis.pluvio_stations|default(0) > 0 ? 'Ativo' : 'Sem dados' }}</strong></div>
                <div><span>Câmeras parceiras</span><strong class="dashboard-status {{ totals.cameras > 0 ? 'is-active' }}">{{ totals.cameras > 0 ? 'Ativo' : 'Sem dados' }}</strong></div>
            </div>
        </section>

    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    {# sem <script type="module"> aqui — o app.js carrega o dashboard.js sozinho #}
{% endblock %}
