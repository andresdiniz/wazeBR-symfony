{% extends 'layouts/dashboard.html.twig' %}

{% block title %}{{ 'Dashboard '|trans({}, 'dashboard_ui') }}| WazeBR{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous" />
    <link rel="stylesheet" href="{{ asset('css/pages/dashboard.css') }}">
{% endblock %}

{% macro riskClass(risk) %}
{%- if risk == 'overflow' -%}hydro-station-btn--overflow
{%- elseif risk == 'alert' -%}hydro-station-btn--alert
{%- elseif risk == 'attention' -%}hydro-station-btn--attention
{%- elseif risk == 'normal' -%}hydro-station-btn--normal
{%- else -%}hydro-station-btn--unknown
{%- endif -%}
{% endmacro %}

{% block content %}
{% set totals = stats.totals|default({}) %}
{% set kpis   = stats.kpis|default({}) %}
{% set health = kpis.health_score|default(100) %}
{% set hydro  = stats.hydro|default({}) %}
{% set hydroStats  = hydro.stats|default({}) %}
{% set hydroList   = hydro.stations_list|default([]) %}
{% set pluvio      = stats.pluvio|default({}) %}
{% set pluvioStats = pluvio.stats|default({}) %}
{% set fetch       = stats.fetch_status|default({}) %}

<div class="dashboard-page"
     data-dashboard
     data-dashboard-i18n="{{ dashboard_i18n()|json_encode|e('html_attr') }}"
     data-api-endpoint="{{ path('dashboard_api_data') }}"
     data-partner-id="{{ partner ? partner.id : '' }}">

    <div class="dashboard-container">

        {# ── Cabeçalho ─────────────────────────────────────────────── #}
        <header class="dashboard-commandbar">
    <div class="dashboard-commandbar-inner">
<header class="dashboard-page-header">
            <div>
                <span class="dashboard-eyebrow"><i></i> {{ 'Centro operacional'|trans({}, 'dashboard_ui') }}</span>
                <h1>{{ 'Visão geral da mobilidade'|trans({}, 'dashboard_ui') }}</h1>
                <p>
                    {{ 'Trânsito, alertas, rotas, clima, rios, chuvas e câmeras em um só lugar.'|trans({}, 'dashboard_ui') }}
                    {% if partner %} — <strong>{{ partner.name }}</strong>{% endif %}
                </p>
            </div>
            <div class="dashboard-header-tools">
                <span class="dashboard-last-update">
                    <i></i> {{ 'Atualizado'|trans({}, 'dashboard_ui') }}
                    <time data-dashboard-clock>{{ dashboard_date(stats.updated_at) }}</time>
                    <span aria-hidden="true">·</span>
                    <span>{{ 'Autoatualização'|trans({}, 'dashboard_ui') }}: <time data-auto-refresh-ts>—</time></span>
                </span>
                <button type="button" class="dashboard-button" data-action="refresh-dashboard" aria-label="{{ 'Recarregar dados'|trans({}, 'dashboard_ui') }}">
                    <span>↻</span> {{ 'Atualizar'|trans({}, 'dashboard_ui') }}
                </button>
            </div>
        </header>

        {# ── Filtros ────────────────────────────────────────────────── #}
        <section class="dashboard-filter-panel" aria-label="{{ 'Filtros do dashboard'|trans({}, 'dashboard_ui') }}">
            <div class="dashboard-filter-heading">
                <div>
                    <span class="dashboard-panel-kicker">{{ 'Explorar dados'|trans({}, 'dashboard_ui') }}</span>
                    <h2>{{ 'Filtros e navegação'|trans({}, 'dashboard_ui') }}</h2>
                </div>
                <button type="button" class="dashboard-button is-link" data-action="clear-filters">{{ 'Limpar filtros'|trans({}, 'dashboard_ui') }}</button>
            </div>

            <form class="dashboard-filter-form" data-filter-form>
                <label class="dashboard-filter-field">
                    <span>{{ 'Período'|trans({}, 'dashboard_ui') }}</span>
                    <select name="period" data-filter="period">
                        <option value="all"   {{ filters.period == 'all'   ? 'selected' }}>{{ 'Todos os registros'|trans({}, 'dashboard_ui') }}</option>
                        <option value="today" {{ filters.period == 'today' ? 'selected' }}>{{ 'Hoje'|trans({}, 'dashboard_ui') }}</option>
                        <option value="week"  {{ filters.period == 'week'  ? 'selected' }}>{{ 'Últimos 7 dias'|trans({}, 'dashboard_ui') }}</option>
                        <option value="month" {{ filters.period == 'month' ? 'selected' }}>{{ 'Últimos 30 dias'|trans({}, 'dashboard_ui') }}</option>
                        <option value="year"  {{ filters.period == 'year'  ? 'selected' }}>{{ 'Últimos 12 meses'|trans({}, 'dashboard_ui') }}</option>
                    </select>
                </label>

                <label class="dashboard-filter-field">
                    <span>{{ 'Tipo'|trans({}, 'dashboard_ui') }}</span>
                    <select name="type" data-filter="type">
                        <option value="all"     {{ filters.type == 'all'     ? 'selected' }}>{{ 'Todos'|trans({}, 'dashboard_ui') }}</option>
                        <option value="alerts"  {{ filters.type == 'alerts'  ? 'selected' }}>{{ 'Alertas'|trans({}, 'dashboard_ui') }}</option>
                        <option value="jams"    {{ filters.type == 'jams'    ? 'selected' }}>{{ 'Congestionamentos'|trans({}, 'dashboard_ui') }}</option>
                        <option value="weather" {{ filters.type == 'weather' ? 'selected' }}>{{ 'Clima'|trans({}, 'dashboard_ui') }}</option>
                        <option value="routes"  {{ filters.type == 'routes'  ? 'selected' }}>{{ 'Rotas'|trans({}, 'dashboard_ui') }}</option>
                        <option value="hydro"   {{ filters.type == 'hydro'   ? 'selected' }}>{{ 'Hidrologia'|trans({}, 'dashboard_ui') }}</option>
                        <option value="pluvio"  {{ filters.type == 'pluvio'  ? 'selected' }}>{{ 'Pluviometria'|trans({}, 'dashboard_ui') }}</option>
                    </select>
                </label>

                <label class="dashboard-filter-field dashboard-filter-field--grow">
                    <span>{{ 'Buscar'|trans({}, 'dashboard_ui') }}</span>
                    <input type="search" name="query" data-filter="query"
                           value="{{ filters.query }}"
                           placeholder="{{ 'Tipo, rua, cidade, uuid...'|trans({}, 'dashboard_ui') }}" autocomplete="off">
                </label>

                <label class="dashboard-filter-field">
                    <span>{{ 'Cidade'|trans({}, 'dashboard_ui') }}</span>
                    <input type="text" name="city" data-filter="city"
                           value="{{ filters.city }}"
                           placeholder="{{ 'Ex.: Conselheiro Lafaiete'|trans({}, 'dashboard_ui') }}" autocomplete="off">
                </label>

                <label class="dashboard-filter-field dashboard-filter-field--grow">
                    <span>{{ 'Excluir vias (regex, uma por linha)'|trans({}, 'dashboard_ui') }}</span>
                    <textarea name="exclude_streets" data-filter="exclude_streets"
                              rows="2"
                              placeholder="Ex.: ^BR-|^MG-">{{ filters.exclude_streets }}</textarea>
                </label>

                <div class="dashboard-filter-actions">
                    <button type="submit" class="dashboard-button is-primary" data-action="apply-filters">{{ 'Aplicar'|trans({}, 'dashboard_ui') }}</button>
                    <button type="button" class="dashboard-button" data-action="clear-filters">{{ 'Limpar'|trans({}, 'dashboard_ui') }}</button>
                </div>
            </form>

            <p class="dashboard-filter-feedback" data-filter-feedback aria-live="polite"></p>
        </section>
    </div>
</header>

        {# ── KPIs ───────────────────────────────────────────────────── #}
        <section class="dashboard-kpi-grid" aria-label="{{ 'Indicadores principais'|trans({}, 'dashboard_ui') }}">
            <article class="dashboard-kpi-card kpi-blue">
                <div class="dashboard-kpi-top">
                    <span class="dashboard-kpi-icon" aria-hidden="true">⚠</span>
                    <span class="dashboard-kpi-trend" data-kpi-trend="alerts_active">{{ totals.alerts_active|default(0) }} {{ 'ativos'|trans({}, 'dashboard_ui') }}</span>
                </div>
                <strong class="dashboard-kpi-value"
        data-count-value="{{ kpis.alerts|default(0) }}"
        aria-live="polite"
        aria-atomic="true">{{ kpis.alerts|default(0) }}</strong>
                <span class="dashboard-kpi-label">{{ 'Alertas registrados'|trans({}, 'dashboard_ui') }}</span>
                <div class="dashboard-kpi-footer"><span>Waze Partner Feed</span><span aria-hidden="true">→</span></div>
            </article>

            <article class="dashboard-kpi-card kpi-orange">
                <div class="dashboard-kpi-top">
                    <span class="dashboard-kpi-icon" aria-hidden="true">≋</span>
                    <span class="dashboard-kpi-trend {{ totals.jams_active|default(0) > 10 ? 'is-warning' }}"
                          data-kpi-trend="jams_active">{{ totals.jams_active|default(0) }} {{ 'ativos'|trans({}, 'dashboard_ui') }}</span>
                </div>
                <strong class="dashboard-kpi-value" data-count-value="{{ kpis.jams|default(0) }}">{{ kpis.jams|default(0) }}</strong>
                <span class="dashboard-kpi-label">{{ 'Congestionamentos'|trans({}, 'dashboard_ui') }}</span>
                <div class="dashboard-kpi-footer"><span>{{ 'Atraso médio'|trans({}, 'dashboard_ui') }} {{ totals.jams_avg_delay|default(0)|round(0) }}s</span><span aria-hidden="true">→</span></div>
            </article>

            <article class="dashboard-kpi-card kpi-gold">
                <div class="dashboard-kpi-top">
                    <span class="dashboard-kpi-icon" aria-hidden="true">⇉</span>
                    <span class="dashboard-kpi-trend {{ kpis.routes_delayed|default(0) > 0 ? 'is-warning' }}"
                          data-kpi-trend="routes_delayed">{{ kpis.routes_delayed|default(0) }} {{ 'atrasadas'|trans({}, 'dashboard_ui') }}</span>
                </div>
                <strong class="dashboard-kpi-value" data-count-value="{{ kpis.routes_total|default(0) }}">{{ kpis.routes_total|default(0) }}</strong>
                <span class="dashboard-kpi-label">{{ 'Rotas TVT monitoradas'|trans({}, 'dashboard_ui') }}</span>
                <div class="dashboard-kpi-footer">
                    <span>{{ kpis.routes_severe|default(0) }} {{ 'críticas/altas'|trans({}, 'dashboard_ui') }}</span>
                    <span aria-hidden="true">→</span>
                </div>
            </article>

            <article class="dashboard-kpi-card kpi-green">
                <div class="dashboard-kpi-top">
                    <span class="dashboard-kpi-icon" aria-hidden="true">☁</span>
                    <span class="dashboard-kpi-trend is-positive">{{ 'Monitorado'|trans({}, 'dashboard_ui') }}</span>
                </div>
                <strong class="dashboard-kpi-value" data-count-value="{{ kpis.weather|default(0) }}">{{ kpis.weather|default(0) }}</strong>
                <span class="dashboard-kpi-label">{{ 'Observações climáticas'|trans({}, 'dashboard_ui') }}</span>
                <div class="dashboard-kpi-footer"><span>Open-Meteo</span><span aria-hidden="true">→</span></div>
            </article>

            <article class="dashboard-kpi-card kpi-purple">
                <div class="dashboard-kpi-top">
                    <span class="dashboard-kpi-icon" aria-hidden="true">◎</span>
                    <span class="dashboard-kpi-trend is-positive">{{ 'Conectado'|trans({}, 'dashboard_ui') }}</span>
                </div>
                <strong class="dashboard-kpi-value" data-count-value="{{ kpis.cameras|default(0) }}">{{ kpis.cameras|default(0) }}</strong>
                <span class="dashboard-kpi-label">{{ 'Câmeras parceiras'|trans({}, 'dashboard_ui') }}</span>
                <div class="dashboard-kpi-footer"><span>{{ kpis.partners|default(0) }} {{ 'parceiros'|trans({}, 'dashboard_ui') }} · {{ kpis.users|default(0) }} {{ 'usuários'|trans({}, 'dashboard_ui') }}</span><span aria-hidden="true">→</span></div>
            </article>

            <article class="dashboard-kpi-card kpi-cyan">
                <div class="dashboard-kpi-top">
                    <span class="dashboard-kpi-icon" aria-hidden="true">≈</span>
                    <span class="dashboard-kpi-trend {{ kpis.hydro_at_risk|default(0) > 0 ? 'is-warning' }}"
                          data-kpi-trend="hydro_at_risk">{{ kpis.hydro_at_risk|default(0) }} {{ 'em atenção'|trans({}, 'dashboard_ui') }}</span>
                </div>
                <strong class="dashboard-kpi-value" data-count-value="{{ kpis.hydro_stations|default(0) }}">{{ kpis.hydro_stations|default(0) }}</strong>
                <span class="dashboard-kpi-label">{{ 'Rios monitorados'|trans({}, 'dashboard_ui') }}</span>
                <div class="dashboard-kpi-footer"><span>CEMADEN {{ 'Hidro'|trans({}, 'dashboard_ui') }}</span><span aria-hidden="true">→</span></div>
            </article>

            <article class="dashboard-kpi-card kpi-rain">
                <div class="dashboard-kpi-top">
                    <span class="dashboard-kpi-icon" aria-hidden="true">☔</span>
                    <span class="dashboard-kpi-trend {{ kpis.pluvio_rain_24h|default(0) > 0 ? 'is-positive' }}"
                          data-kpi-trend="pluvio_rain_24h">{{ kpis.pluvio_rain_24h|default(0)|number_format(1, app.request.locale == 'en' ? '.' : ',', app.request.locale == 'en' ? ',' : '.') }} mm · 24h</span>
                </div>
                <strong class="dashboard-kpi-value" data-count-value="{{ kpis.pluvio_stations|default(0) }}">{{ kpis.pluvio_stations|default(0) }}</strong>
                <span class="dashboard-kpi-label">{{ 'Pontos de chuva'|trans({}, 'dashboard_ui') }}</span>
                <div class="dashboard-kpi-footer">
                    <span>{{ 'Pico'|trans({}, 'dashboard_ui') }} {{ kpis.pluvio_peak_24h|default(0)|number_format(1, app.request.locale == 'en' ? '.' : ',', app.request.locale == 'en' ? ',' : '.') }} mm/h</span>
                    <span aria-hidden="true">→</span>
                </div>
            </article>
        </section>
{# ── Operação: mapa + contexto ─────────────────────────────── #}
<div class="dashboard-operations-grid">
{# ── Mapa ───────────────────────────────────────────────────── #}
        <section class="dashboard-panel dashboard-map-panel">
            <header class="dashboard-panel-header">
                <div>
                    <span class="dashboard-panel-kicker">{{ 'Geolocalização'|trans({}, 'dashboard_ui') }}</span>
                    <h2>{{ 'Mapa operacional'|trans({}, 'dashboard_ui') }}</h2>
                </div>
                <div class="dashboard-map-legend" aria-label="{{ 'Legenda do mapa'|trans({}, 'dashboard_ui') }}">
                    <button type="button" class="dashboard-map-toggle is-active" data-layer-toggle="alerts">⚠ {{ 'Alertas'|trans({}, 'dashboard_ui') }}</button>
                    <button type="button" class="dashboard-map-toggle is-active" data-layer-toggle="jams">≋ {{ 'Jams'|trans({}, 'dashboard_ui') }}</button>
                    <button type="button" class="dashboard-map-toggle is-active" data-layer-toggle="cameras">◎ {{ 'Câmeras'|trans({}, 'dashboard_ui') }}</button>
                    <button type="button" class="dashboard-map-toggle is-active" data-layer-toggle="weather">☁ {{ 'Clima'|trans({}, 'dashboard_ui') }}</button>
                    <button type="button" class="dashboard-map-toggle is-active" data-layer-toggle="stations">☔ {{ 'Chuva'|trans({}, 'dashboard_ui') }}</button>
                </div>
            </header>
            <div class="dashboard-map"
                 data-dashboard-map
                 data-map-center='{{ stats.map.center|json_encode|e('html_attr') }}'
                 data-map-alerts='{{ stats.map.alerts|json_encode|e('html_attr') }}'
                 data-map-jams='{{ stats.map.jams|json_encode|e('html_attr') }}'
                 data-map-cameras='{{ stats.map.cameras|json_encode|e('html_attr') }}'
                 data-map-weather='{{ stats.map.weather|json_encode|e('html_attr') }}'
                 data-map-stations='{{ stats.map.stations|json_encode|e('html_attr') }}'></div>
        </section>
    <aside class="dashboard-context-rail">
        <section class="dashboard-panel dashboard-context-panel">
            <header class="dashboard-panel-header">
                <div><span class="dashboard-panel-kicker">{{ 'Riscos'|trans({}, 'dashboard_ui') }}</span><h2>{{ 'Situação agora'|trans({}, 'dashboard_ui') }}</h2></div>
            </header>
            <div class="dashboard-context-list">
                <div class="dashboard-context-item {{ (hydroStats.risk.overflow|default(0) + hydroStats.risk.alert|default(0)) > 0 ? 'is-danger' }}">
                    <span>{{ 'Rios em alerta/transbordo'|trans({}, 'dashboard_ui') }}</span>
                    <strong>{{ hydroStats.risk.overflow|default(0) + hydroStats.risk.alert|default(0) }}</strong>
                </div>
                <div class="dashboard-context-item {{ hydroStats.risk.attention|default(0) > 0 ? 'is-warning' }}">
                    <span>{{ 'Rios em atenção'|trans({}, 'dashboard_ui') }}</span>
                    <strong>{{ hydroStats.risk.attention|default(0) }}</strong>
                </div>
                <div class="dashboard-context-item {{ kpis.pluvio_rain_24h|default(0) > 0 ? 'is-info' }}">
                    <span>{{ 'Chuva acumulada 24h'|trans({}, 'dashboard_ui') }}</span>
                    <strong>{{ kpis.pluvio_rain_24h|default(0)|number_format(1, app.request.locale == 'en' ? '.' : ',', app.request.locale == 'en' ? ',' : '.') }} mm</strong>
                </div>
                <div class="dashboard-context-item {{ kpis.routes_delayed|default(0) > 0 ? 'is-warning' }}">
                    <span>{{ 'Rotas atrasadas'|trans({}, 'dashboard_ui') }}</span>
                    <strong>{{ kpis.routes_delayed|default(0) }}</strong>
                </div>
            </div>
        </section>

        <section class="dashboard-panel dashboard-context-panel">
            <header class="dashboard-panel-header">
                <div><span class="dashboard-panel-kicker">{{ 'Coletas'|trans({}, 'dashboard_ui') }}</span><h2>{{ 'Última execução'|trans({}, 'dashboard_ui') }}</h2></div>
            </header>
            <div class="dashboard-context-list">
                {% for label, key in {
                    'Waze Alerts': 'waze_alerts',
                    'Waze Jams': 'waze_jams',
                    'Waze TVT': 'waze_tvt',
                    'Clima': 'weather',
                    'CEMADEN Hidro': 'cemaden_hydro',
                    'CEMADEN Chuva': 'cemaden_pluvio',
                    'Câmeras': 'cameras'
                } %}
                    <div class="dashboard-context-item">
                        <span>{{ label|trans({}, 'dashboard_ui') }}</span>
                        <strong>{{ fetch[key] ? dashboard_date(fetch[key]) : '—' }}</strong>
                    </div>
                {% endfor %}
            </div>
        </section>
    </aside>
</div>


        {# ── Linha 1: atividade + tipos ────────────────────────────── #}
        <div class="dashboard-main-grid">
            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div>
                        <span class="dashboard-panel-kicker">{{ 'Indicadores'|trans({}, 'dashboard_ui') }}</span>
                        <h2>{{ 'Atividade por hora'|trans({}, 'dashboard_ui') }}</h2>
                    </div>
                    <span class="dashboard-panel-period">0h – 23h</span>
                </header>
                <div class="dashboard-chart-wrap">
                    <canvas data-chart="hourly-activity"
                            data-chart-data='{{ stats.charts.hourly_activity|json_encode|e('html_attr') }}'></canvas>
                </div>
            </section>

            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div>
                        <span class="dashboard-panel-kicker">{{ 'Composição'|trans({}, 'dashboard_ui') }}</span>
                        <h2>{{ 'Alertas por tipo'|trans({}, 'dashboard_ui') }}</h2>
                    </div>
                </header>
                <div class="dashboard-chart-wrap">
                    <canvas data-chart="alerts-by-type"
                            data-chart-data='{{ stats.charts.alerts_by_type|json_encode|e('html_attr') }}'></canvas>
                </div>
            </section>
        </div>

        {# ── Linha 2: top ruas + jams + clima ──────────────────────── #}
        <div class="dashboard-main-grid">
            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div>
                        <span class="dashboard-panel-kicker">{{ 'Top ruas'|trans({}, 'dashboard_ui') }}</span>
                        <h2>{{ 'Concentração de alertas'|trans({}, 'dashboard_ui') }}</h2>
                    </div>
                </header>
                <div class="dashboard-chart-wrap dashboard-chart-wrap--tall">
                    <canvas data-chart="alerts-by-street"
                            data-chart-data='{{ stats.charts.alerts_by_street|json_encode|e('html_attr') }}'></canvas>
                </div>
            </section>

            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div>
                        <span class="dashboard-panel-kicker">{{ 'Congestionamentos'|trans({}, 'dashboard_ui') }}</span>
                        <h2>{{ 'Distribuição por nível'|trans({}, 'dashboard_ui') }}</h2>
                    </div>
                </header>
                <div class="dashboard-chart-wrap dashboard-chart-wrap--tall">
                    <canvas data-chart="jams-by-level"
                            data-chart-data='{{ stats.charts.jams_by_level|json_encode|e('html_attr') }}'></canvas>
                </div>
            </section>

            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div>
                        <span class="dashboard-panel-kicker">{{ 'Clima'|trans({}, 'dashboard_ui') }}</span>
                        <h2>{{ 'Tendência meteorológica'|trans({}, 'dashboard_ui') }}</h2>
                    </div>
                </header>
                <div class="dashboard-chart-wrap dashboard-chart-wrap--tall">
                    <canvas data-chart="weather-trend"
                            data-chart-data='{{ stats.charts.weather_trend|json_encode|e('html_attr') }}'></canvas>
                </div>
            </section>
        </div>

        {# ── Monitoramento hidrológico ────────────────────────────── #}
        <section class="dashboard-panel dashboard-hydro-panel"
                 data-hydro-panel
                 data-hydro-trend-all='{{ hydro.trend|default([])|json_encode|e('html_attr') }}'
                 data-hydro-trend-by-station='{{ hydro.trend_by_station|default({})|json_encode|e('html_attr') }}'>
            <header class="dashboard-panel-header">
                <div>
                    <span class="dashboard-panel-kicker">{{ 'Recursos hídricos'|trans({}, 'dashboard_ui') }}</span>
                    <h2>{{ 'Nível dos rios'|trans({}, 'dashboard_ui') }}</h2>
                </div>
                <span class="dashboard-panel-period">
                    {% if hydroStats.last_fetch %}
                        {{ 'Última coleta'|trans({}, 'dashboard_ui') }} {{ dashboard_date(hydroStats.last_fetch) }}
                    {% else %}
                        {{ 'Sem coletas ainda'|trans({}, 'dashboard_ui') }}
                    {% endif %}
                </span>
            </header>

            <div class="dashboard-hydro-strip">
                <div class="hydro-stat">
                    <span class="hydro-stat-label">{{ 'Estações'|trans({}, 'dashboard_ui') }}</span>
                    <strong data-hydro-stat="stations">{{ hydroStats.stations|default(0) }}</strong>
                </div>
                <div class="hydro-stat {{ (hydroStats.risk.overflow|default(0) + hydroStats.risk.alert|default(0)) > 0 ? 'is-danger' }}">
                    <span class="hydro-stat-label">{{ 'Alerta / transbordo'|trans({}, 'dashboard_ui') }}</span>
                    <strong data-hydro-stat="alert">{{ hydroStats.risk.overflow|default(0) + hydroStats.risk.alert|default(0) }}</strong>
                </div>
                <div class="hydro-stat {{ hydroStats.risk.attention|default(0) > 0 ? 'is-warning' }}">
                    <span class="hydro-stat-label">{{ 'Em atenção'|trans({}, 'dashboard_ui') }}</span>
                    <strong data-hydro-stat="attention">{{ hydroStats.risk.attention|default(0) }}</strong>
                </div>
                <div class="hydro-stat is-normal">
                    <span class="hydro-stat-label">{{ 'Normal'|trans({}, 'dashboard_ui') }}</span>
                    <strong data-hydro-stat="normal">{{ hydroStats.risk.normal|default(0) }}</strong>
                </div>
            </div>

            <div class="dashboard-hydro-layout" data-hydro-layout>
                <div class="dashboard-hydro-chart dashboard-hydro-chart--full">
                    <canvas data-chart="hydro-trend"
                            data-chart-data='{{ hydro.trend|default([])|json_encode|e('html_attr') }}'></canvas>
                </div>

                {% if hydroList|length > 1 %}
                    <aside class="dashboard-station-picker" data-hydro-picker>
                        <div class="dashboard-station-picker-head">
                            <strong>{{ 'Rios monitorados'|trans({}, 'dashboard_ui') }}</strong>
                            <small>{{ hydroList|length }} {{ 'estações'|trans({}, 'dashboard_ui') }}</small>
                        </div>
                        <button type="button"
                                class="hydro-station-btn is-active hydro-station-btn--all"
                                data-hydro-select="all">
                            <span class="hydro-station-btn-name">{{ 'Todas as estações'|trans({}, 'dashboard_ui') }}</span>
                            <small>{{ 'Média agregada'|trans({}, 'dashboard_ui') }}</small>
                        </button>
                        {% for st in hydroList %}
                            <button type="button"
                                    class="hydro-station-btn {{ _self.riskClass(st.risk) }}"
                                    data-hydro-select="{{ st.id }}"
                                    data-station-level="{{ st.level is not null ? st.level : '' }}"
                                    data-station-risk="{{ st.risk }}" title="{{ dashboard_label(st.risk) }}">
                                <span class="hydro-station-btn-name">{{ st.name }}</span>
                                <small>{{ st.city|default('—') }}{% if st.state %}/{{ st.state }}{% endif %}</small>
                                <span class="hydro-station-btn-level">
                                    {% if st.level is not null %}
                                        {{ st.level|number_format(2, app.request.locale == 'en' ? '.' : ',', app.request.locale == 'en' ? ',' : '.') }} m
                                    {% else %}
                                        —
                                    {% endif %}
                                </span>
                            </button>
                        {% endfor %}
                    </aside>
                {% endif %}
            </div>
        </section>

        {# ── Pluviometria ─────────────────────────────────────────── #}
        <section class="dashboard-panel dashboard-pluvio-panel"
                 data-pluvio-panel
                 data-pluvio-hourly-all='{{ pluvio.hourly|default([])|json_encode|e('html_attr') }}'
                 data-pluvio-hourly-by-station='{{ pluvio.hourly_by_station|default({})|json_encode|e('html_attr') }}'>
            <header class="dashboard-panel-header">
                <div>
                    <span class="dashboard-panel-kicker">{{ 'Precipitação'|trans({}, 'dashboard_ui') }}</span>
                    <h2>{{ 'Chuva por hora e por estação'|trans({}, 'dashboard_ui') }}</h2>
                </div>
                <span class="dashboard-panel-period">
                    {% if pluvioStats.last_reading %}
                        {{ 'Última leitura'|trans({}, 'dashboard_ui') }} {{ dashboard_date(pluvioStats.last_reading) }}
                    {% else %}
                        {{ 'Sem leituras'|trans({}, 'dashboard_ui') }}
                    {% endif %}
                </span>
            </header>

            <div class="dashboard-hydro-strip">
                <div class="hydro-stat">
                    <span class="hydro-stat-label">{{ 'Pontos de medição'|trans({}, 'dashboard_ui') }}</span>
                    <strong data-pluvio-stat="stations">{{ pluvioStats.stations|default(0) }}</strong>
                </div>
                <div class="hydro-stat {{ pluvioStats.rain_1h|default(0) > 0 ? 'is-warning' }}">
                    <span class="hydro-stat-label">{{ 'Última hora'|trans({}, 'dashboard_ui') }}</span>
                    <strong data-pluvio-stat="rain_1h">{{ pluvioStats.rain_1h|default(0)|number_format(1, app.request.locale == 'en' ? '.' : ',', app.request.locale == 'en' ? ',' : '.') }}<small style="font-size:11px;font-weight:600;color:var(--dash-muted);margin-left:4px">mm</small></strong>
                </div>
                <div class="hydro-stat {{ pluvioStats.rain_24h|default(0) > 0 ? 'is-normal' : '' }}">
                    <span class="hydro-stat-label">{{ 'Últimas 24h'|trans({}, 'dashboard_ui') }}</span>
                    <strong data-pluvio-stat="rain_24h">{{ pluvioStats.rain_24h|default(0)|number_format(1, app.request.locale == 'en' ? '.' : ',', app.request.locale == 'en' ? ',' : '.') }}<small style="font-size:11px;font-weight:600;color:var(--dash-muted);margin-left:4px">mm</small></strong>
                </div>
                <div class="hydro-stat">
                    <span class="hydro-stat-label">{{ 'Pico / 24h'|trans({}, 'dashboard_ui') }}</span>
                    <strong data-pluvio-stat="peak_24h">{{ pluvioStats.peak_24h|default(0)|number_format(1, app.request.locale == 'en' ? '.' : ',', app.request.locale == 'en' ? ',' : '.') }}<small style="font-size:11px;font-weight:600;color:var(--dash-muted);margin-left:4px">mm/h</small></strong>
                </div>
            </div>

            <div class="dashboard-hydro-layout">
                <div class="dashboard-hydro-chart">
                    <canvas data-chart="pluvio-hourly"
                            data-chart-data='{{ pluvio.hourly|default([])|json_encode|e('html_attr') }}'></canvas>
                </div>

                <aside class="dashboard-station-picker" data-pluvio-picker>
                    <div class="dashboard-station-picker-head">
                        <strong>{{ 'Chuva por estação · 24h'|trans({}, 'dashboard_ui') }}</strong>
                        <small>{{ pluvio.stations|default([])|length }} {{ 'pontos'|trans({}, 'dashboard_ui') }}</small>
                    </div>
                    <button type="button"
                            class="hydro-station-btn is-active hydro-station-btn--all"
                            data-pluvio-select="all">
                        <span class="hydro-station-btn-name">{{ 'Todas as estações'|trans({}, 'dashboard_ui') }}</span>
                        <small>{{ 'Média agregada'|trans({}, 'dashboard_ui') }}</small>
                    </button>
                    {% for s in pluvio.stations|default([]) %}
                        {% set pct = pluvioStats.peak_24h > 0
                            ? min(100, (s.rain24h / pluvioStats.peak_24h) * 100)
                            : 0 %}
                        <button type="button"
                                class="hydro-station-btn pluvio-station-btn pluvio-station-btn--{{ s.source }}"
                                data-pluvio-select="{{ s.stationId }}"
                                data-pluvio-rain24h="{{ s.rain24h }}"
                                style="--pct:{{ pct }}">
                            <span class="hydro-station-btn-name">
                                {{ s.stationName }}
                                <span class="pluvio-source-badge pluvio-source-badge--{{ s.source }}">
                                    {{ s.source == 'hydro' ? ('Hidro'|trans({}, 'dashboard_ui')) : ('Auto'|trans({}, 'dashboard_ui')) }}
                                </span>
                            </span>
                            <small>
                                {{ s.city|default('—') }}{% if s.state %}/{{ s.state }}{% endif %}
                                {% if s.lastReading %} · {{ dashboard_date(s.lastReading) }}{% endif %}
                            </small>
                            <span class="hydro-station-btn-level">
                                {{ s.rain24h|number_format(1, app.request.locale == 'en' ? '.' : ',', app.request.locale == 'en' ? ',' : '.') }} mm
                            </span>
                        </button>
                    {% else %}
                        <div class="dashboard-empty">
                            <span aria-hidden="true">✓</span>
                            <strong>{{ 'Sem leituras de chuva'|trans({}, 'dashboard_ui') }}</strong>
                            <small>{{ 'Cadastre um pluviômetro ou estação hidro com dados de chuva.'|trans({}, 'dashboard_ui') }}</small>
                        </div>
                    {% endfor %}
                </aside>
            </div>
        </section>



        {# ── Listas de dados ────────────────────────────────────────── #}
        <div class="dashboard-content-grid">
            <section class="dashboard-panel data-section" data-section="alerts">
                <header class="dashboard-panel-header">
                    <div><span class="dashboard-panel-kicker">{{ 'Tempo real'|trans({}, 'dashboard_ui') }}</span><h2>{{ 'Alertas recentes'|trans({}, 'dashboard_ui') }}</h2></div>
                    <span class="dashboard-panel-count {{ stats.recent.alerts|length > 0 ? 'is-orange' }}"
                          data-count="recent-alerts">{{ stats.recent.alerts|length }}</span>
                </header>
                <div class="dashboard-data-list" data-list="alerts">
                    {% for alert in stats.recent.alerts %}
                        <div class="dashboard-data-row">
                            <span class="dashboard-row-icon row-orange" aria-hidden="true">⚠</span>
                            <div>
                                <strong>{{ dashboard_label(alert.type|default(alert.typeLabel)) }}</strong>
                                <small>#{{ alert.id }} · {{ dashboard_label(alert.subtype|default('—')) }} · {{ alert.city|default(('Local não informado'|trans({}, 'dashboard_ui'))) }}{% if alert.street %} · {{ alert.street }}{% endif %}</small>
                            </div>
                            <time datetime="{{ alert.pubDateTime }}">{{ alert.pubDateTime ? dashboard_date(alert.pubDateTime) : '—' }}</time>
                            <span class="dashboard-severity">{{ 'Confiança'|trans({}, 'dashboard_ui') }} {{ alert.confidence }}</span>
                        </div>
                    {% else %}
                        <div class="dashboard-empty"><span aria-hidden="true">✓</span><strong>{{ 'Nenhum alerta recente'|trans({}, 'dashboard_ui') }}</strong><small>{{ 'Ajuste os filtros ou verifique as fontes.'|trans({}, 'dashboard_ui') }}</small></div>
                    {% endfor %}
                </div>
            </section>

            <section class="dashboard-panel data-section" data-section="jams">
                <header class="dashboard-panel-header">
                    <div><span class="dashboard-panel-kicker">{{ 'Trânsito'|trans({}, 'dashboard_ui') }}</span><h2>{{ 'Congestionamentos'|trans({}, 'dashboard_ui') }}</h2></div>
                    <span class="dashboard-panel-count {{ stats.recent.jams|length > 0 ? 'is-orange' }}"
                          data-count="recent-jams">{{ stats.recent.jams|length }}</span>
                </header>
                <div class="dashboard-data-list" data-list="jams">
                    {% for jam in stats.recent.jams %}
                        <div class="dashboard-data-row">
                            <span class="dashboard-row-icon row-orange" aria-hidden="true">≋</span>
                            <div>
                                <strong>{{ jam.street|default(('Via não informada'|trans({}, 'dashboard_ui'))) }}</strong>
                                <small>
                                    {{ jam.city|default('—') }}
                                    {% if jam.speedKmh is not null %} · {{ jam.speedKmh|round(1) }} km/h{% endif %}
                                    {% if jam.length %} · {{ (jam.length / 1000)|round(1) }} km{% endif %}
                                </small>
                            </div>
                            <span class="dashboard-severity dashboard-jam-level-{{ jam.level }}">{{ 'Nível'|trans({}, 'dashboard_ui') }} {{ jam.level }} · {{ dashboard_label('jam_' ~ jam.level) }}</span>
                        </div>
                    {% else %}
                        <div class="dashboard-empty"><span aria-hidden="true">✓</span><strong>{{ 'Nenhum congestionamento'|trans({}, 'dashboard_ui') }}</strong><small>{{ 'Não há ocorrências viárias no período.'|trans({}, 'dashboard_ui') }}</small></div>
                    {% endfor %}
                </div>
            </section>

            <section class="dashboard-panel data-section" data-section="routes">
                <header class="dashboard-panel-header">
                    <div><span class="dashboard-panel-kicker">{{ 'Rotas TVT'|trans({}, 'dashboard_ui') }}</span><h2>{{ 'Maior atraso por rota'|trans({}, 'dashboard_ui') }}</h2></div>
                    <span class="dashboard-panel-count {{ stats.recent.routes|length > 0 ? 'is-orange' }}"
                          data-count="recent-routes">{{ stats.recent.routes|length }}</span>
                </header>
                <div class="dashboard-data-list" data-list="routes">
                    {% for route in stats.recent.routes %}
                        <div class="dashboard-data-row">
                            <span class="dashboard-row-icon {{ route.delay_level.level in ['severe','heavy'] ? 'row-orange' : (route.delay_level.level == 'none' ? 'row-green' : 'row-blue') }}" aria-hidden="true">→</span>
                            <div>
                                <strong>{{ route.name }}</strong>
                                <small>
                                    {% if route.from_name and route.to_name %}{{ route.from_name }} → {{ route.to_name }} · {% endif %}
                                    {{ 'Atual'|trans({}, 'dashboard_ui') }} {{ route.time|default('—') }}s · {{ 'Hist.'|trans({}, 'dashboard_ui') }} {{ route.historic_time|default('—') }}s
                                </small>
                            </div>
                            <span class="dashboard-severity delay-badge delay-badge--{{ route.delay_level.level }}">
                                {% if route.delay_seconds is not null and route.delay_seconds > 0 %}
                                    +{{ route.delay_seconds }}s
                                    <small>({{ (route.delay_ratio * 100)|round(0) }}%)</small>
                                {% elseif route.jam_level is not null %}
                                    {{ 'Nível'|trans({}, 'dashboard_ui') }} {{ route.jam_level }}
                                {% else %}
                                    {{ 'No prazo'|trans({}, 'dashboard_ui') }}
                                {% endif %}
                            </span>
                        </div>
                    {% else %}
                        <div class="dashboard-empty"><span aria-hidden="true">✓</span><strong>{{ 'Nenhuma rota encontrada'|trans({}, 'dashboard_ui') }}</strong><small>{{ 'Sem snapshots vinculados às rotas.'|trans({}, 'dashboard_ui') }}</small></div>
                    {% endfor %}
                </div>
            </section>
        </div>

        {# ── Rodapé ─────────────────────────────────────────────────── #}
        <div class="dashboard-bottom-grid">
            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div><span class="dashboard-panel-kicker">{{ 'Status'|trans({}, 'dashboard_ui') }}</span><h2>{{ 'Saúde da operação'|trans({}, 'dashboard_ui') }}</h2></div>
                    <span class="dashboard-health-badge"><i></i> {{ 'Online'|trans({}, 'dashboard_ui') }}</span>
                </header>
                <div class="dashboard-health-score">
                    <div class="dashboard-health-ring" style="--health-score:{{ health }}"
                         role="meter" aria-valuenow="{{ health }}" aria-valuemin="0" aria-valuemax="100">
                        <span>{{ health }}<small>%</small></span>
                    </div>
                    <div>
                        <strong>
                            {% if health >= 80 %}{{ 'Operação estável'|trans({}, 'dashboard_ui') }}
                            {% elseif health >= 60 %}{{ 'Atenção recomendada'|trans({}, 'dashboard_ui') }}
                            {% else %}{{ 'Operação crítica'|trans({}, 'dashboard_ui') }}{% endif %}
                        </strong>
                        <p>
                            {% if health >= 80 %}{{ 'Fontes de dados disponíveis e monitoradas.'|trans({}, 'dashboard_ui') }}
                            {% elseif health >= 60 %}{{ 'Algumas rotas com atraso ou volume elevado.'|trans({}, 'dashboard_ui') }}
                            {% else %}{{ 'Alto volume de alertas, congestionamentos ou rios em alerta.'|trans({}, 'dashboard_ui') }}{% endif %}
                        </p>
                    </div>
                </div>
                <div class="dashboard-health-list">
                    <div><span><i class="health-green"></i> {{ 'Alertas ativos'|trans({}, 'dashboard_ui') }}</span><strong>{{ totals.alerts_active|default(0) }}</strong></div>
                    <div><span><i class="health-{{ totals.jams_active|default(0) > 10 ? 'orange' : 'blue' }}"></i> {{ 'Jams ativos'|trans({}, 'dashboard_ui') }}</span><strong>{{ totals.jams_active|default(0) }}</strong></div>
                    <div><span><i class="health-gray"></i> {{ 'Rotas com snapshot'|trans({}, 'dashboard_ui') }}</span><strong>{{ stats.recent.routes|length }}</strong></div>
                    <div><span><i class="health-{{ hydroStats.at_risk|default(0) > 0 ? 'orange' : 'gray' }}"></i> {{ 'Rios em atenção'|trans({}, 'dashboard_ui') }}</span><strong>{{ hydroStats.at_risk|default(0) }}</strong></div>
                </div>
            </section>

            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div><span class="dashboard-panel-kicker">{{ 'Coletas'|trans({}, 'dashboard_ui') }}</span><h2>{{ 'Última execução por fonte'|trans({}, 'dashboard_ui') }}</h2></div>
                </header>
                <div class="dashboard-fetch-list" data-fetch-list>
                    <div>
                        <span>{{ 'Waze Alerts'|trans({}, 'dashboard_ui') }}</span>
                        <strong data-fetch="waze_alerts">{{ fetch.waze_alerts ? dashboard_date(fetch.waze_alerts, true) : '—' }}</strong>
                    </div>
                    <div>
                        <span>{{ 'Waze Jams'|trans({}, 'dashboard_ui') }}</span>
                        <strong data-fetch="waze_jams">{{ fetch.waze_jams ? dashboard_date(fetch.waze_jams, true) : '—' }}</strong>
                    </div>
                    <div>
                        <span>{{ 'Waze TVT (rotas)'|trans({}, 'dashboard_ui') }}</span>
                        <strong data-fetch="waze_tvt">{{ fetch.waze_tvt ? dashboard_date(fetch.waze_tvt, true) : '—' }}</strong>
                    </div>
                    <div>
                        <span>{{ 'Clima (Open-Meteo)'|trans({}, 'dashboard_ui') }}</span>
                        <strong data-fetch="weather">{{ fetch.weather ? dashboard_date(fetch.weather, true) : '—' }}</strong>
                    </div>
                    <div>
                        <span>CEMADEN {{ 'Hidro'|trans({}, 'dashboard_ui') }}</span>
                        <strong data-fetch="cemaden_hydro">{{ fetch.cemaden_hydro ? dashboard_date(fetch.cemaden_hydro, true) : '—' }}</strong>
                    </div>
                    <div>
                        <span>{{ 'CEMADEN Chuva'|trans({}, 'dashboard_ui') }}</span>
                        <strong data-fetch="cemaden_pluvio">{{ fetch.cemaden_pluvio ? dashboard_date(fetch.cemaden_pluvio, true) : '—' }}</strong>
                    </div>
                    <div>
                        <span>{{ 'Câmeras parceiras'|trans({}, 'dashboard_ui') }}</span>
                        <strong data-fetch="cameras">{{ fetch.cameras ? dashboard_date(fetch.cameras, true) : '—' }}</strong>
                    </div>
                </div>
            </section>

            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div><span class="dashboard-panel-kicker">{{ 'Clima'|trans({}, 'dashboard_ui') }}</span><h2>{{ 'Leituras recentes'|trans({}, 'dashboard_ui') }}</h2></div>
                </header>
                <div class="dashboard-data-list" data-list="weather">
                    {% for obs in stats.recent.weather %}
                        <div class="dashboard-data-row">
                            <span class="dashboard-row-icon row-green" aria-hidden="true">☁</span>
                            <div>
                                <strong>{{ obs.locationName|default(('Estação'|trans({}, 'dashboard_ui'))) }}</strong>
                                <small>{{ obs.city|default('—') }} · {{ obs.observedAt ? dashboard_date(obs.observedAt) : '' }}</small>
                            </div>
                            <span class="dashboard-severity">
                                {% if obs.weatherCode|default(obs.weather_code|default(null)) is not null %}{{ dashboard_label('weather_' ~ obs.weatherCode|default(obs.weather_code|default(''))) }} · {% endif %}
                                {% if obs.temperature is not null %}{{ obs.temperature|round(1) }}°C{% endif %}
                                {% if obs.humidity is not null %} · {{ obs.humidity }}%{% endif %}
                            </span>
                        </div>
                    {% else %}
                        <div class="dashboard-empty"><span aria-hidden="true">✓</span><strong>{{ 'Sem leituras climáticas'|trans({}, 'dashboard_ui') }}</strong><small>{{ 'Cadastre uma localização meteorológica.'|trans({}, 'dashboard_ui') }}</small></div>
                    {% endfor %}
                </div>
            </section>
        </div>

        <section class="dashboard-panel">
            <header class="dashboard-panel-header">
                <div><span class="dashboard-panel-kicker">{{ 'Integrações'|trans({}, 'dashboard_ui') }}</span><h2>{{ 'Fontes de dados'|trans({}, 'dashboard_ui') }}</h2></div>
            </header>
            <div class="dashboard-source-list">
                <div><span>{{ 'Waze Alerts'|trans({}, 'dashboard_ui') }}</span><strong class="dashboard-status {{ totals.alerts > 0 ? 'is-active' }}">{{ totals.alerts > 0 ? ('Ativo'|trans({}, 'dashboard_ui')) : ('Sem dados'|trans({}, 'dashboard_ui')) }}</strong></div>
                <div><span>{{ 'Waze Jams'|trans({}, 'dashboard_ui') }}</span><strong class="dashboard-status {{ totals.jams > 0 ? 'is-active' }}">{{ totals.jams > 0 ? ('Ativo'|trans({}, 'dashboard_ui')) : ('Sem dados'|trans({}, 'dashboard_ui')) }}</strong></div>
                <div><span>{{ 'Clima (Open-Meteo)'|trans({}, 'dashboard_ui') }}</span><strong class="dashboard-status {{ totals.weather > 0 ? 'is-active' }}">{{ totals.weather > 0 ? ('Ativo'|trans({}, 'dashboard_ui')) : ('Sem dados'|trans({}, 'dashboard_ui')) }}</strong></div>
                <div><span>CEMADEN {{ 'Hidro'|trans({}, 'dashboard_ui') }}</span><strong class="dashboard-status {{ kpis.hydro_stations|default(0) > 0 ? 'is-active' }}">{{ kpis.hydro_stations|default(0) > 0 ? ('Ativo'|trans({}, 'dashboard_ui')) : ('Sem dados'|trans({}, 'dashboard_ui')) }}</strong></div>
                <div><span>{{ 'CEMADEN Chuva'|trans({}, 'dashboard_ui') }}</span><strong class="dashboard-status {{ kpis.pluvio_stations|default(0) > 0 ? 'is-active' }}">{{ kpis.pluvio_stations|default(0) > 0 ? ('Ativo'|trans({}, 'dashboard_ui')) : ('Sem dados'|trans({}, 'dashboard_ui')) }}</strong></div>
                <div><span>{{ 'Câmeras parceiras'|trans({}, 'dashboard_ui') }}</span><strong class="dashboard-status {{ totals.cameras > 0 ? 'is-active' }}">{{ totals.cameras > 0 ? ('Ativo'|trans({}, 'dashboard_ui')) : ('Sem dados'|trans({}, 'dashboard_ui')) }}</strong></div>
            </div>
        </section>


<footer class="dashboard-statusbar">
    <div class="dashboard-statusbar-item"><span>{{ 'Saúde'|trans({}, 'dashboard_ui') }}</span><strong>{{ health }}%</strong></div>
    <div class="dashboard-statusbar-item"><span>{{ 'Alertas ativos'|trans({}, 'dashboard_ui') }}</span><strong>{{ totals.alerts_active|default(0) }}</strong></div>
    <div class="dashboard-statusbar-item"><span>{{ 'Jams ativos'|trans({}, 'dashboard_ui') }}</span><strong>{{ totals.jams_active|default(0) }}</strong></div>
    <div class="dashboard-statusbar-item"><span>{{ 'Atualizado'|trans({}, 'dashboard_ui') }}</span><strong>{{ stats.updated_at|app_date('H:i') }}</strong></div>
</footer>

    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.1/chart.umd.min.js" integrity="sha512-WoViKhKD4qI2WruSZqv9+kvM4WfFhUMQCLN4QlDTt5aU56fLQy2gYoxWIqlEnXqJy/+Ac5q/hk1oWfqnMDhwMA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    {# sem <script type="module"> aqui — o app.js carrega o dashboard.js sozinho #}
{% endblock %}
