{% extends 'base.html.twig' %}

{% block title %}Dashboard — ToolboxWaze{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/dashboard.css') }}">
{% endblock %}

{% block body %}
<div class="dashboard-container">
    {# Cabeçalho #}
    <header class="dashboard-header">
        <div class="header-content">
            <div class="header-title">
                <i class="bi bi-speedometer2"></i>
                <h1>Dashboard</h1>
            </div>
            <p class="header-subtitle">Visão geral do WazeToolbox</p>
        </div>
        <div class="header-actions">
            <button id="refresh-dashboard" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-clockwise"></i>
                Atualizar
            </button>
            {% if showRadar|default(false) %}
                <a href="{{ path('radar_index') }}" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-broadcast"></i> Radares
                </a>
            {% endif %}
            {% if showPosto|default(false) %}
                <a href="{{ path('posto_index') }}" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-fuel-pump"></i> Postos
                </a>
            {% endif %}
            {% if showEscola|default(false) %}
                <a href="{{ path('escola_inep_index') }}" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-building"></i> Escolas
                </a>
            {% endif %}
            {% if showSolicitacao|default(false) %}
                <a href="{{ path('solicitacao_hub') }}" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-inbox"></i> Solicitações
                </a>
            {% endif %}
            {% if isAdmin|default(false) %}
                <a href="{{ path('admin_users_index') }}" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-people"></i> Usuários
                </a>
            {% endif %}
        </div>
    </header>

    {# Cards de alerta #}
    {% if showRadar|default(false) or showSolicitacao|default(false) %}
    <section class="alerts-section">
        <div class="alerts-grid">
            {% if showRadar|default(false) %}
            <div class="alert-card alert-danger">
                <div class="alert-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <div class="alert-content">
                    <span class="alert-label">Radares Vencidos</span>
                    <span class="alert-value count-up" data-key="radaresvencidos" data-target="{{ radarKpis.vencidos ?? 0 }}">0</span>
                </div>
            </div>

            <div class="alert-card alert-warning">
                <div class="alert-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div class="alert-content">
                    <span class="alert-label">Radares a Vencer</span>
                    <span class="alert-value count-up" data-key="radaresvencendo" data-target="{{ radarKpis.vencendo ?? 0 }}">0</span>
                </div>
            </div>
            {% endif %}

            {% if showSolicitacao|default(false) %}
            <div class="alert-card alert-warning">
                <div class="alert-icon">
                    <i class="bi bi-inbox-fill"></i>
                </div>
                <div class="alert-content">
                    <span class="alert-label">Solicitações Pendentes</span>
                    <span class="alert-value count-up" data-key="solicpendentes" data-target="{{ solicKpis.geral.pendentes ?? 0 }}">0</span>
                </div>
            </div>
            {% endif %}

            {% if showRadar|default(false) %}
            <div class="alert-card alert-success">
                <div class="alert-icon">
                    <i class="bi bi-broadcast"></i>
                </div>
                <div class="alert-content">
                    <span class="alert-label">Cobertura Waze</span>
                    <span class="alert-value">{{ radarKpis.pctWaze|default(0)|round(1) }}%</span>
                </div>
            </div>
            {% endif %}
        </div>
    </section>
    {% endif %}

    {# KPIs principais #}
    <section class="kpi-section">
        <div class="kpi-grid">
            {% if showRadar|default(false) %}
            <div class="kpi-card kpi-primary">
                <div class="kpi-icon">
                    <i class="bi bi-broadcast"></i>
                </div>
                <div class="kpi-content">
                    <span class="kpi-label">Radares</span>
                    <span class="kpi-value count-up" data-key="radarestotal" data-target="{{ radarKpis.total ?? 0 }}">0</span>
                    <span class="kpi-subtitle">{{ radarKpis.reprovados ?? 0 }} reprovados</span>
                </div>
            </div>
            {% endif %}

            {% if showPosto|default(false) %}
            <div class="kpi-card kpi-warning">
                <div class="kpi-icon">
                    <i class="bi bi-fuel-pump"></i>
                </div>
                <div class="kpi-content">
                    <span class="kpi-label">Postos</span>
                    <span class="kpi-value count-up" data-key="postostotal" data-target="{{ postoKpis.total ?? 0 }}">0</span>
                    <span class="kpi-subtitle">{{ postoKpis.comWaze ?? 0 }} com Waze</span>
                </div>
            </div>
            {% endif %}

            {% if showEscola|default(false) %}
            <div class="kpi-card kpi-info">
                <div class="kpi-icon">
                    <i class="bi bi-building"></i>
                </div>
                <div class="kpi-content">
                    <span class="kpi-label">Escolas</span>
                    <span class="kpi-value count-up" data-key="escolastotal" data-target="{{ escolaKpis.total ?? 0 }}">0</span>
                    <span class="kpi-subtitle">{{ escolaKpis.estados ?? 0 }} estados</span>
                </div>
            </div>
            {% endif %}

            {% if showSolicitacao|default(false) %}
            <div class="kpi-card kpi-secondary">
                <div class="kpi-icon">
                    <i class="bi bi-inbox"></i>
                </div>
                <div class="kpi-content">
                    <span class="kpi-label">Solicitações</span>
                    <span class="kpi-value count-up" data-key="solictotal" data-target="{{ solicKpis.geral.total ?? 0 }}">0</span>
                    <span class="kpi-subtitle">{{ solicKpis.geral.hoje ?? 0 }} hoje</span>
                </div>
            </div>
            {% endif %}

            {% if isAdmin|default(false) %}
            <div class="kpi-card kpi-dark">
                <div class="kpi-icon">
                    <i class="bi bi-people"></i>
                </div>
                <div class="kpi-content">
                    <span class="kpi-label">Usuários</span>
                    <span class="kpi-value count-up" data-key="usuariostotal" data-target="{{ usuarioKpis.total ?? 0 }}">0</span>
                    <span class="kpi-subtitle">{{ usuarioKpis.pendentes ?? 0 }} pendentes</span>
                </div>
            </div>
            {% endif %}
        </div>
    </section>

    {# Gráficos de Radares #}
    {% if showRadar|default(false) %}
    <section class="charts-section">
        <div class="chart-grid">
            <div class="chart-card chart-large">
                <div class="chart-header">
                    <span><i class="bi bi-bar-chart-fill"></i> Radares por Estados</span>
                    <a href="{{ path('radar_index') }}" class="btn btn-sm btn-outline-secondary">Ver todos</a>
                </div>
                <div class="chart-body">
                    <canvas id="chartRadarUf"></canvas>
                </div>
            </div>

            <div class="chart-card">
                <div class="chart-header">
                    <span><i class="bi bi-pie-chart-fill"></i> Resultado Geral</span>
                </div>
                <div class="chart-body">
                    <canvas id="chartRadarResultado"></canvas>
                </div>
            </div>

            <div class="chart-card">
                <div class="chart-header">
                    <span><i class="bi bi-graph-up"></i> Verificações Mensais</span>
                </div>
                <div class="chart-body">
                    <canvas id="chartVerifMensais"></canvas>
                </div>
            </div>

            <div class="chart-card">
                <div class="chart-header">
                    <span><i class="bi bi-broadcast"></i> Cobertura Waze por Estados</span>
                    <a href="{{ path('cobertura_radar') }}" class="btn btn-sm btn-outline-danger">Relatório</a>
                </div>
                <div class="chart-body">
                    <canvas id="chartCoberturaUf"></canvas>
                </div>
            </div>
        </div>
    </section>
    {% endif %}

    {# Postos e Escolas #}
    {% if showPosto|default(false) or showEscola|default(false) %}
    <section class="modules-section">
        <div class="modules-grid">
            {% if showPosto|default(false) %}
            <div class="module-card">
                <div class="module-header">
                    <span><i class="bi bi-fuel-pump"></i> Postos de Combustível</span>
                    <div class="module-actions">
                        <a href="{{ path('posto_index') }}" class="btn btn-sm btn-outline-secondary">Ver lista</a>
                        <a href="{{ path('cobertura_posto') }}" class="btn btn-sm btn-outline-warning">Cobertura</a>
                    </div>
                </div>
                <div class="module-body">
                    <div class="stats-grid">
                        <div class="stat-item">
                            <span class="stat-label">Total</span>
                            <span class="stat-value count-up" data-key="postostotal" data-target="{{ postoKpis.total ?? 0 }}">0</span>
                        </div>
                        <div class="stat-item stat-success">
                            <span class="stat-label">Com Waze</span>
                            <span class="stat-value count-up" data-key="postoscomwaze" data-target="{{ postoKpis.comWaze ?? 0 }}">0</span>
                        </div>
                        <div class="stat-item stat-danger">
                            <span class="stat-label">Sem Waze</span>
                            <span class="stat-value count-up" data-key="postossemwaze" data-target="{{ postoKpis.semWaze ?? 0 }}">0</span>
                        </div>
                        <div class="stat-item stat-info">
                            <span class="stat-label">Cobertura</span>
                            <span class="stat-value">{{ postoKpis.pct ?? 0 }}%</span>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: {{ postoKpis.pct ?? 0 }}%;"></div>
                            </div>
                        </div>
                    </div>
                    <div class="chart-mini">
                        <canvas id="chartPostoAtividade"></canvas>
                    </div>
                </div>
            </div>
            {% endif %}

            {% if showEscola|default(false) %}
            <div class="module-card">
                <div class="module-header">
                    <span><i class="bi bi-building"></i> Escolas INEP</span>
                    <a href="{{ path('escola_inep_index') }}" class="btn btn-sm btn-outline-secondary">Ver lista</a>
                </div>
                <div class="module-body">
                    <div class="stats-grid">
                        <div class="stat-item">
                            <span class="stat-label">Total</span>
                            <span class="stat-value count-up" data-key="escolastotal" data-target="{{ escolaKpis.total ?? 0 }}">0</span>
                        </div>
                        <div class="stat-item stat-primary">
                            <span class="stat-label">Estados</span>
                            <span class="stat-value count-up" data-key="escolasestados" data-target="{{ escolaKpis.estados ?? 0 }}">0</span>
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </section>
    {% endif %}

    {# Solicitações #}
    {% if showSolicitacao|default(false) %}
    <section class="solic-section">
        <div class="solic-grid">
            <div class="solic-card">
                <div class="solic-header">
                    <span><i class="bi bi-inbox"></i> Solicitações por Tipos</span>
                    <a href="{{ path('solicitacao_hub') }}" class="btn btn-sm btn-outline-secondary">Ver todas</a>
                </div>
                <div class="solic-body">
                    {% if solicKpis.geral.total is defined %}
                    <div class="solic-summary">
                        <span>Total: <strong class="count-up" data-key="solictotal" data-target="{{ solicKpis.geral.total }}">0</strong></span>
                        <span class="text-success">Atendidas: <strong class="count-up" data-key="solicatendidas" data-target="{{ solicKpis.geral.atendidas ?? 0 }}">0</strong></span>
                        <span class="text-warning">Pendentes: <strong class="count-up" data-key="solicpendentes" data-target="{{ solicKpis.geral.pendentes ?? 0 }}">0</strong></span>
                        {% if (solicKpis.geral.atrasadas ?? 0) > 0 %}
                        <span class="text-danger">Atrasadas: <strong class="count-up" data-key="solicatrasadas" data-target="{{ solicKpis.geral.atrasadas ?? 0 }}">0</strong></span>
                        {% endif %}
                        <span class="text-danger">Recusadas: <strong class="count-up" data-key="solicrecusadas" data-target="{{ solicKpis.geral.recusadas ?? 0 }}">0</strong></span>
                    </div>
                    {% endif %}

                    <table class="solic-table">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th class="text-end">Total</th>
                                <th class="text-end">Atend.</th>
                                <th>Taxa</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for t in solicKpis.totais ?? [] %}
                            {% set taxa = t.total > 0 ? (t.atendidas / t.total * 100)|round(0) : 0 %}
                            <tr>
                                <td><span class="badge">{{ t.tipo }}</span></td>
                                <td class="text-end fw-semibold">{{ t.total }}</td>
                                <td class="text-end">{{ t.atendidas ?? 0 }}</td>
                                <td>
                                    <div class="rate-bar">
                                        <div class="rate-fill rate-{{ taxa >= 75 ? 'success' : (taxa >= 40 ? 'warning' : 'danger') }}" style="width: {{ taxa }}%;"></div>
                                    </div>
                                    <small>{{ taxa }}%</small>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center">Nenhuma solicitação.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="chart-card">
                <div class="chart-header">
                    <span><i class="bi bi-graph-up-arrow"></i> Solicitações Diárias (30 dias)</span>
                </div>
                <div class="chart-body">
                    <canvas id="chartSolicDiarias"></canvas>
                </div>
            </div>
        </div>
    </section>
    {% endif %}

    {# Radares sem Waze + Usuários #}
    {% if showRadar|default(false) %}
    <section class="radar-extra-section">
        <div class="radar-extra-grid">
            <div class="radar-table-card">
                <div class="table-header">
                    <span><i class="bi bi-exclamation-triangle-fill"></i> Radares APROVADOS sem Link Waze</span>
                    <a href="{{ path('cobertura_radar') }}" class="btn btn-sm btn-outline-warning">Ver todos</a>
                </div>
                <div class="table-body">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>UF</th>
                                <th>Município</th>
                                <th>Logradouro</th>
                                <th class="text-end">Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for r in radarSemWaze ?? [] %}
                        <tr>
                            <td><span class="badge">{{ r.sigla_uf }}</span></td>
                            <td>{{ r.municipio }}</td>
                            <td class="text-truncate" title="{{ r.logradouro ?? '' }}">{{ r.logradouro ?? '' }}</td>
                            <td class="text-end">
                                <a href="{{ path('radar_show', { id: r.id }) }}" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-link-45deg"></i>
                                </a>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-success">
                                <i class="bi bi-check-circle-fill"></i>
                                Todos vinculados!
                            </td>
                        </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            {% if isAdmin|default(false) and usuarioKpis.total is defined %}
            <div class="users-card">
                <div class="module-header">
                    <span><i class="bi bi-people"></i> Usuários</span>
                    <a href="{{ path('admin_users_index') }}" class="btn btn-sm btn-outline-secondary">Gerenciar</a>
                </div>
                <div class="module-body">
                    <div class="stats-grid">
                        {% for u in [
                            { label: 'Total',     val: usuarioKpis.total ?? 0,      color: 'secondary', key: 'usuariostotal' },
                            { label: 'Ativos',    val: usuarioKpis.ativos ?? 0,     color: 'success',   key: 'usuariosativos' },
                            { label: 'Aprovados', val: usuarioKpis.aprovados ?? 0,  color: 'primary',   key: 'usuariosaprovados' },
                            { label: 'Pendentes', val: usuarioKpis.pendentes ?? 0,  color: 'warning',   key: 'usuariospendentes' }
                        ] %}
                        <div class="stat-item stat-{{ u.color }}">
                            <span class="stat-label">{{ u.label }}</span>
                            <span class="stat-value count-up" data-key="{{ u.key }}" data-target="{{ u.val }}">0</span>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </section>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        window.radarUf        = {{ radarPorUf is defined and radarPorUf is iterable ? radarPorUf|json_encode|raw : '[]' }};
        window.radarResultado = {{ radarResultado is defined and radarResultado is iterable ? radarResultado|json_encode|raw : '[]' }};
        window.radarMensais   = {{ radarMensais is defined and radarMensais is iterable ? radarMensais|json_encode|raw : '[]' }};
        window.radarCobertura = {{ radarCobertura is defined and radarCobertura is iterable ? radarCobertura|json_encode|raw : '[]' }};
        window.postoAtividade = {{ postoAtividade is defined and postoAtividade is iterable ? postoAtividade|json_encode|raw : '[]' }};
        window.solicDiarias   = {{ solicDiarias is defined and solicDiarias is iterable ? solicDiarias|json_encode|raw : '[]' }};
    </script>
    <script src="{{ asset('js/dashboard.js') }}" defer></script>
{% endblock %}
