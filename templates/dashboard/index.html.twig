{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block page_name %}dashboard{% endblock %}

{% block content %}
<div class="dashboard">
    <!-- Dashboard Header -->
    <div class="dashboard-header">
        <div class="page-title-wrapper">
            <div>
                <h1 class="page-title">Dashboard</h1>
                <p class="page-subtitle">Visã££o geral do monitoramento em tempo real</p>
            </div>
            <div class="dashboard-actions">
                <button class="btn btn-outline-secondary" id="refreshDashboard">
                    <i class="bi bi-arrow-clockwise"></i>
                    Atualizar
                </button>
                <div class="btn-group">
                    <button class="btn btn-primary" data-bs-toggle="dropdown">
                        <i class="bi bi-plus-lg"></i>
                        Novo
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="{{ path('alert_index') }}"><i class="bi bi-exclamation-triangle me-2"></i>Alerta</a></li>
                        <li><a class="dropdown-item" href="{{ path('jam_index') }}"><i class="bi bi-sign-merge-right me-2"></i>Congestionamento</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_cemaden_index') }}"><i class="bi bi-cloud-rain me-2"></i>CEMADEN</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Stats Grid -->
    <div class="stats-grid">
        <!-- Alerts Card -->
        <div class="widget stats-card">
            <div class="stats-card-icon danger">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div class="stats-card-content">
                <div class="stats-card-label">Alertas Ativos</div>
                <div class="stats-card-value">{{ alertCount|default(0) }}</div>
                <div class="stats-card-change {% if hero.alertsLast24h|default(0) >= 0 %}positive{% else %}negative{% endif %}">
                    <i class="bi bi-arrow-{{ hero.alertsLast24h|default(0) >= 0 ? 'up' : 'down' }}"></i>
                    {{ hero.alertsLast24h|default(0) }} nas últimas 24h
                </div>
            </div>
        </div>
        
        <!-- Traffic Jams Card -->
        <div class="widget stats-card">
            <div class="stats-card-icon warning">
                <i class="bi bi-sign-merge-right-fill"></i>
            </div>
            <div class="stats-card-content">
                <div class="stats-card-label">Congestionamentos</div>
                <div class="stats-card-value">{{ trafficJamCount|default(0) }}</div>
                <div class="stats-card-change {% if hero.jamsLast24h|default(0) >= 0 %}positive{% else %}negative{% endif %}">
                    <i class="bi bi-arrow-{{ hero.jamsLast24h|default(0) >= 0 ? 'up' : 'down' }}"></i>
                    {{ hero.jamsLast24h|default(0) }} nas últimas 24h
                </div>
            </div>
        </div>
        
        <!-- Hydro Stations Card -->
        <div class="widget stats-card">
            <div class="stats-card-icon info">
                <i class="bi bi-droplet-fill"></i>
            </div>
            <div class="stats-card-content">
                <div class="stats-card-label">Estaçµµ Hidro</div>
                <div class="stats-card-value">{{ hero.cemadenReadings|default(0) }}</div>
                <div class="stats-card-change positive">
                    <i class="bi bi-check-lg"></i>
                    {{ partnerStats.cemadenReadings|default(0) }} leituras
                </div>
            </div>
        </div>
        
        <!-- CEMADEN Card -->
        <div class="widget stats-card">
            <div class="stats-card-icon primary">
                <i class="bi bi-cloud-rain-fill"></i>
            </div>
            <div class="stats-card-content">
                <div class="stats-card-label">Estaçµµ CEMADEN</div>
                <div class="stats-card-value">{{ hero.cemadenCities|default(0) }}</div>
                <div class="stats-card-change positive">
                    <i class="bi bi-cloud-check"></i>
                    {{ hero.cemadenCities|default(0) }} cidades
                </div>
            </div>
        </div>
    </div>
    
    <!-- Dashboard Grid -->
    <div class="dashboard-grid">
        <!-- Map Widget -->
        <div class="widget dashboard-col-8">
            <div class="widget-header">
                <h3 class="widget-title">
                    <i class="bi bi-map widget-title-icon"></i>
                    Mapa de Monitoramento
                </h3>
                <div class="widget-actions">
                    <button class="btn btn-sm btn-outline-secondary" id="mapFullscreen">
                        <i class="bi bi-arrows-fullscreen"></i>
                    </button>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown">
                            <i class="bi bi-layers"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#" data-layer="alerts"><i class="bi bi-exclamation-triangle me-2"></i>Alertas</a></li>
                            <li><a class="dropdown-item" href="#" data-layer="traffic"><i class="bi bi-sign-merge-right me-2"></i>Trâ££ego</a></li>
                            <li><a class="dropdown-item" href="#" data-layer="hydro"><i class="bi bi-droplet me-2"></i>Hidro</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#" data-layer="all"><i class="bi bi-check-all me-2"></i>Todos</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="widget-body p-0">
                <div id="dashboard-map" class="map-widget" style="min-height: 450px;"></div>
            </div>
        </div>
        
        <!-- Recent Alerts -->
        <div class="widget dashboard-col-4">
            <div class="widget-header">
                <h3 class="widget-title">
                    <i class="bi bi-bell"></i>
                    Alertas Recentes
                </h3>
                <a href="{{ path('alert_index') }}" class="btn btn-sm btn-link">
                    Ver todos
                </a>
            </div>
            <div class="widget-body alerts-widget">
                {% for alert in recentAlerts|default([]) %}
                <div class="alert-item">
                    <div class="alert-item-icon {{ alert.subtype|default('warning') }}">
                        <i class="bi bi-{{ alert.icon|default('exclamation-triangle') }}"></i>
                    </div>
                    <div class="alert-item-content">
                        <div class="alert-item-title">{{ alert.title|default('Alerta')|truncate(40) }}</div>
                        <div class="alert-item-location">
                            <i class="bi bi-geo-alt"></i>
                            {{ alert.street|default('Local desconhecido')|truncate(30) }}
                        </div>
                        <div class="alert-item-time">
                            <i class="bi bi-clock"></i>
                            {{ alert.createdAt|date('H:i') }}
                        </div>
                    </div>
                </div>
                {% else %}
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-check-circle" style="font-size: 3rem;"></i>
                    <p class="mt-3 mb-0">Nenhum alerta recente</p>
                </div>
                {% endfor %}
            </div>
        </div>
        
        <!-- Recent Traffic Jams -->
        <div class="widget dashboard-col-6">
            <div class="widget-header">
                <h3 class="widget-title">
                    <i class="bi bi-sign-merge-right"></i>
                    Congestionamentos Recentes
                </h3>
                <a href="{{ path('jam_index') }}" class="btn btn-sm btn-link">
                    Ver todos
                </a>
            </div>
            <div class="widget-body">
                {% for jam in recentJams|default([]) %}
                <div class="d-flex align-items-start gap-3 pb-3 mb-3 border-bottom">
                    <div class="rounded-circle bg-{{ jam.level == 5 ? 'danger' : (jam.level >= 3 ? 'warning' : 'success') }} text-white d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <small class="fw-bold">{{ jam.level }}</small>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-medium">{{ jam.street|default('Via desconhecida')|truncate(50) }}</div>
                        <div class="text-muted small">
                            <i class="bi bi-geo-alt"></i> {{ jam.city|default('N/A') }}
                            <span class="ms-2">
                                <i class="bi bi-clock"></i> {{ jam.createdAt|date('H:i') }}
                            </span>
                        </div>
                    </div>
                </div>
                {% else %}
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-check-circle" style="font-size: 3rem;"></i>
                    <p class="mt-3 mb-0">Nenhum congestionamento recente</p>
                </div>
                {% endfor %}
            </div>
        </div>
        
        <!-- Activity Feed -->
        <div class="widget dashboard-col-6">
            <div class="widget-header">
                <h3 class="widget-title">
                    <i class="bi bi-activity"></i>
                    Atividade Recente
                </h3>
            </div>
            <div class="widget-body">
                <div class="activity-feed">
                    {% if partnerStats.executions > 0 %}
                    <div class="activity-item">
                        <div class="activity-item-time">{{ "now"|date('H:i') }}</div>
                        <div class="activity-item-title">{{ partnerStats.executions }} execuçµµ de rotas</div>
                        <div class="activity-item-text">
                            <i class="bi bi-map"></i>
                            Rotas monitoradas ativas
                        </div>
                    </div>
                    {% endif %}
                    
                    {% if partnerStats.cifsEvents > 0 %}
                    <div class="activity-item">
                        <div class="activity-item-time">{{ "now"|date('H:i') }}</div>
                        <div class="activity-item-title">{{ partnerStats.cifsEvents }} eventos CIFs</div>
                        <div class="activity-item-text">
                            <i class="bi bi-calendar-event"></i>
                            Eventos registrados
                        </div>
                    </div>
                    {% endif %}
                    
                    {% if partnerStats.monitoredLinks > 0 %}
                    <div class="activity-item">
                        <div class="activity-item-time">{{ "now"|date('H:i') }}</div>
                        <div class="activity-item-title">{{ partnerStats.monitoredLinks }} links monitorados</div>
                        <div class="activity-item-text">
                            <i class="bi bi-link-45deg"></i>
                            Links ativos no sistema
                        </div>
                    </div>
                    {% endif %}
                    
                    {% if partnerStats.jams > 0 or partnerStats.alerts > 0 %}
                    <div class="activity-item">
                        <div class="activity-item-time">{{ "now"|date('H:i') }}</div>
                        <div class="activity-item-title">
                            {{ partnerStats.jams }} congestionamentos, {{ partnerStats.alerts }} alertas
                        </div>
                        <div class="activity-item-text">
                            <i class="bi bi-bar-chart"></i>
                            Total no perí££odo
                        </div>
                    </div>
                    {% endif %}
                    
                    {% if partnerStats.executions == 0 and partnerStats.cifsEvents == 0 and partnerStats.monitoredLinks == 0 %}
                    <div class="text-center py-4 text-muted">
                        <p class="mb-0">Nenhuma atividade recente</p>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script type="module">
// Dashboard initialization
import { config } from '../../js/core/config.js';

// Initialize map
const mapElement = document.getElementById('dashboard-map');
if (mapElement) {
  const map = L.map('dashboard-map', {
    center: [config.map.defaultLat, config.map.defaultLng],
    zoom: config.map.defaultZoom,
    minZoom: config.map.minZoom,
    maxZoom: config.map.maxZoom,
  });
  
  L.tileLayer(config.map.tileProvider, {
    attribution: config.map.attribution,
  }).addTo(map);
  
  console.log('[wazeBR] Dashboard map initialized');
}

// Refresh button
document.getElementById('refreshDashboard')?.addEventListener('click', () => {
  window.location.reload();
});

// Map fullscreen
document.getElementById('mapFullscreen')?.addEventListener('click', () => {
  const mapWidget = document.getElementById('dashboard-map')?.closest('.widget');
  if (mapWidget) {
    mapWidget.classList.toggle('widget-fullscreen');
    setTimeout(() => map?.invalidateSize(), 300);
  }
});
</script>
{% endblock %}
