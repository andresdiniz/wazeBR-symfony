{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Dashboard | wazeBR{% endblock %}

{% block page_body_class %}dashboard-index-page{% endblock %}

{% block dashboard_page_title %}
    {{ hero.title|default('Dashboard') }}
{% endblock %}

{% block page_content %}
    <div class="dashboard-content">
        <section class="dashboard-hero">
            <div>
                <p class="dashboard-hero-kicker">Visão geral</p>
                <h2>{{ hero.title|default('Dashboard') }}</h2>
                <p>{{ hero.subtitle|default('Visão geral da plataforma') }}</p>
            </div>

            <div class="dashboard-period-filter">
                <label for="dashboard-period">Período</label>

                <select id="dashboard-period" class="form-control">
                    {% for key, period in periods|default({}) %}
                        <option value="{{ key }}" {% if key == periodKey|default('today') %}selected{% endif %}>
                            {{ period.label }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </section>

        <section class="stats-grid" aria-label="Indicadores do dashboard">
            <article class="stat-card">
                <div class="stat-icon blue">
                    <i class="fa-solid fa-car" aria-hidden="true"></i>
                </div>

                <div class="stat-info">
                    <span>Congestionamentos</span>
                    <strong>{{ hero.jamsTotal|default(0) }}</strong>
                    <small>{{ hero.jamsLast24h|default(0) }} nas últimas 24 horas</small>
                </div>
            </article>

            <article class="stat-card">
                <div class="stat-icon orange">
                    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                </div>

                <div class="stat-info">
                    <span>Alertas</span>
                    <strong>{{ hero.alertsTotal|default(0) }}</strong>
                    <small>{{ hero.alertsLast24h|default(0) }} nas últimas 24 horas</small>
                </div>
            </article>

            <article class="stat-card">
                <div class="stat-icon green">
                    <i class="fa-solid fa-route" aria-hidden="true"></i>
                </div>

                <div class="stat-info">
                    <span>Rotas monitoradas</span>
                    <strong>{{ hero.routesMonitored|default(0) }}</strong>
                    <small>{{ hero.monitoredLinks|default(0) }} links ativos</small>
                </div>
            </article>

            <article class="stat-card">
                <div class="stat-icon purple">
                    <i class="fa-solid fa-city" aria-hidden="true"></i>
                </div>

                <div class="stat-info">
                    <span>Cidades monitoradas</span>
                    <strong>{{ hero.monitoredCities|default(0) }}</strong>
                    <small>{{ hero.cemadenCities|default(0) }} cidades com dados</small>
                </div>
            </article>
        </section>

        <section class="dashboard-grid">
            <article class="card dashboard-card dashboard-card-wide">
                <header class="card-header">
                    <div>
                        <h3>Congestionamentos recentes</h3>
                        <p>Ocorrências registradas no período selecionado.</p>
                    </div>

                    <a href="#" class="btn btn-ghost btn-sm">
                        Ver todos
                        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </header>

                <div class="card-body">
                    {% if recentJams is not empty %}
                        <ul class="dashboard-list">
                            {% for jam in recentJams|slice(0, 5) %}
                                <li class="dashboard-list-item">
                                    <span class="dashboard-list-icon is-warning">
                                        <i class="fa-solid fa-car" aria-hidden="true"></i>
                                    </span>

                                    <div class="dashboard-list-content">
                                        <strong>{{ jam.street|default('Via não informada') }}</strong>
                                        <span>{{ jam.city|default('Cidade não informada') }}</span>
                                    </div>

                                    <div class="dashboard-list-meta">
                                        <span>{{ jam.speed|default(0)|number_format(0, ',', '.') }} km/h</span>
                                        <time>{{ jam.timestamp|default('now')|date('H:i') }}</time>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <div class="empty-state">
                            <span class="empty-state-icon">
                                <i class="fa-solid fa-car" aria-hidden="true"></i>
                            </span>

                            <h3>Nenhum congestionamento registrado</h3>
                            <p>Não há ocorrências para o período selecionado.</p>
                        </div>
                    {% endif %}
                </div>
            </article>

            <article class="card dashboard-card">
                <header class="card-header">
                    <div>
                        <h3>Alertas recentes</h3>
                        <p>Últimas notificações registradas.</p>
                    </div>

                    <a href="#" class="btn btn-ghost btn-sm">
                        Ver todos
                    </a>
                </header>

                <div class="card-body">
                    {% if recentAlerts is not empty %}
                        <ul class="dashboard-list">
                            {% for alert in recentAlerts|slice(0, 5) %}
                                <li class="dashboard-list-item">
                                    <span class="dashboard-list-icon is-danger">
                                        <i class="fa-solid fa-bell" aria-hidden="true"></i>
                                    </span>

                                    <div class="dashboard-list-content">
                                        <strong>{{ alert.type|default('Alerta') }}</strong>
                                        <span>{{ alert.city|default('Local não informado') }}</span>
                                    </div>

                                    <div class="dashboard-list-meta">
                                        <time>{{ alert.timestamp|default('now')|date('H:i') }}</time>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <div class="empty-state">
                            <span class="empty-state-icon">
                                <i class="fa-regular fa-bell" aria-hidden="true"></i>
                            </span>

                            <h3>Nenhum alerta recente</h3>
                            <p>Não há alertas no período selecionado.</p>
                        </div>
                    {% endif %}
                </div>
            </article>
        </section>

        {% if partner %}
            <section class="card dashboard-card partner-summary-card">
                <header class="card-header">
                    <div>
                        <h3>{{ partnerLabel|default('Parceiro') }}</h3>
                        <p>Resumo de dados do parceiro atual.</p>
                    </div>
                </header>

                <div class="card-body">
                    <div class="partner-stats">
                        <div>
                            <strong>{{ partnerStats.jams|default(0) }}</strong>
                            <span>Congestionamentos</span>
                        </div>

                        <div>
                            <strong>{{ partnerStats.alerts|default(0) }}</strong>
                            <span>Alertas</span>
                        </div>

                        <div>
                            <strong>{{ partnerStats.routes|default(0) }}</strong>
                            <span>Rotas</span>
                        </div>

                        <div>
                            <strong>{{ partnerStats.monitoredLinks|default(0) }}</strong>
                            <span>Links monitorados</span>
                        </div>
                    </div>
                </div>
            </section>
        {% endif %}
    </div>
{% endblock %}
