{% extends 'base.html.twig' %}

{% block title %}Dashboard - {{ partnerLabel }}{% endblock %}
{% block header_title %}Dashboard{% endblock %}
{% block header_subtitle %}{{ partnerLabel }} · Visão geral{% endblock %}

{% block body %}
<div class="dashboard-grid">
    <section class="dashboard-intro" aria-labelledby="dashboard-overview-title">
        <div>
            <p class="dashboard-kicker">Monitoramento em tempo real</p>
            <h2 id="dashboard-overview-title">Visão geral da operação</h2>
            <p>Acompanhe os principais indicadores da sua região nas últimas 24 horas.</p>
        </div>
        <span class="dashboard-status"><span aria-hidden="true"></span>Dados atualizados</span>
    </section>

    <section class="stats-grid" aria-label="Indicadores das últimas 24 horas">
        <article class="stat-card stat-card--jams">
            <div class="stat-icon" aria-hidden="true">🚦</div>
            <div class="stat-content">
                <div class="stat-value">{{ trafficJamCount|default(0) }}</div>
                <div class="stat-label">Congestionamentos</div>
                <div class="stat-caption">Registrados nas últimas 24h</div>
            </div>
        </article>
        <article class="stat-card stat-card--alerts">
            <div class="stat-icon" aria-hidden="true">⚠️</div>
            <div class="stat-content">
                <div class="stat-value">{{ alertCount|default(0) }}</div>
                <div class="stat-label">Alertas</div>
                <div class="stat-caption">Registrados nas últimas 24h</div>
            </div>
        </article>
        <article class="stat-card stat-card--routes">
            <div class="stat-icon" aria-hidden="true">🛣️</div>
            <div class="stat-content">
                <div class="stat-value">{{ partnerStats.routes|default(0) }}</div>
                <div class="stat-label">Rotas monitoradas</div>
                <div class="stat-caption">Rotas vinculadas à operação</div>
            </div>
        </article>
        <article class="stat-card stat-card--hydro">
            <div class="stat-icon" aria-hidden="true">💧</div>
            <div class="stat-content">
                <div class="stat-value">{{ partnerStats.hydroData|default(0) }}</div>
                <div class="stat-label">Dados hídricos</div>
                <div class="stat-caption">Leituras disponíveis</div>
            </div>
        </article>
    </section>

    <section class="dashboard-panels" aria-label="Atividades recentes">
        <article class="content-card">
            <div class="content-card-header">
                <div>
                    <p class="card-eyebrow">Ocorrências</p>
                    <h2>Alertas recentes</h2>
                </div>
                <span class="card-count">{{ recentAlerts|length }}</span>
            </div>
            {% if recentAlerts|length > 0 %}
                <div class="list">
                    {% for alert in recentAlerts %}
                        <div class="list-item">
                            <span class="list-icon list-icon--alert" aria-hidden="true">⚠</span>
                            <div class="list-content">
                                <div class="list-title">{{ alert.subtype|default('Alerta') }}</div>
                                <div class="list-meta">{{ alert.streetName|default('Sem local informado') }} · {{ alert.reportedAt|date('d/m/Y · H:i') }}</div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <span class="empty-state-icon" aria-hidden="true">✓</span>
                    <div>
                        <strong>Nenhum alerta recente</strong>
                        <p>Não há ocorrências registradas no momento.</p>
                    </div>
                </div>
            {% endif %}
        </article>

        <article class="content-card">
            <div class="content-card-header">
                <div>
                    <p class="card-eyebrow">Trânsito</p>
                    <h2>Congestionamentos recentes</h2>
                </div>
                <span class="card-count">{{ recentTrafficJams|length }}</span>
            </div>
            {% if recentTrafficJams|length > 0 %}
                <div class="list">
                    {% for jam in recentTrafficJams %}
                        <div class="list-item">
                            <span class="list-icon list-icon--jam" aria-hidden="true">🚦</span>
                            <div class="list-content">
                                <div class="list-title">Nível {{ jam.level|default(0) }}</div>
                                <div class="list-meta">{{ jam.streetName|default('Sem local informado') }} · {{ jam.createdAt|date('d/m/Y · H:i') }}</div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <span class="empty-state-icon" aria-hidden="true">✓</span>
                    <div>
                        <strong>Nenhum congestionamento recente</strong>
                        <p>O fluxo de trânsito está sem registros recentes.</p>
                    </div>
                </div>
            {% endif %}
        </article>
    </section>
</div>

<style>
.dashboard-grid { display: grid; gap: 1.5rem; }
.dashboard-intro { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.5rem; border: 1px solid #cceff5; border-radius: 0.875rem; background: linear-gradient(120deg, #ecfeff 0%, #f8fafc 65%); }
.dashboard-kicker, .card-eyebrow { margin: 0 0 0.25rem; color: #0e7490; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase; }
.dashboard-intro h2 { margin: 0; color: #0f172a; font-size: 1.35rem; line-height: 1.25; }
.dashboard-intro p:not(.dashboard-kicker) { margin: 0.4rem 0 0; color: #64748b; font-size: 0.9rem; }
.dashboard-status { display: inline-flex; align-items: center; gap: 0.5rem; flex: 0 0 auto; padding: 0.5rem 0.75rem; border-radius: 999px; background: #ffffff; box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08); color: #0f766e; font-size: 0.75rem; font-weight: 700; }
.dashboard-status span { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #10b981; box-shadow: 0 0 0 4px #d1fae5; }
.stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
.stat-card { position: relative; display: flex; min-height: 132px; align-items: center; gap: 1rem; overflow: hidden; padding: 1.25rem; border: 1px solid #e2e8f0; border-radius: 0.875rem; background: #ffffff; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04); }
.stat-card::after { position: absolute; right: -1.25rem; bottom: -2.25rem; width: 6rem; height: 6rem; border-radius: 50%; content: ''; opacity: 0.75; }
.stat-card--jams::after { background: #fee2e2; }.stat-card--alerts::after { background: #fef3c7; }.stat-card--routes::after { background: #dbeafe; }.stat-card--hydro::after { background: #cffafe; }
.stat-icon { position: relative; z-index: 1; display: grid; width: 3.25rem; height: 3.25rem; flex: 0 0 auto; place-items: center; border-radius: 0.875rem; background: #f8fafc; font-size: 1.65rem; }
.stat-content { position: relative; z-index: 1; min-width: 0; }.stat-value { color: #0f172a; font-size: 1.65rem; font-weight: 800; line-height: 1.1; }.stat-label { margin-top: 0.25rem; color: #334155; font-size: 0.88rem; font-weight: 700; }.stat-caption { margin-top: 0.18rem; color: #94a3b8; font-size: 0.72rem; }
.dashboard-panels { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }.content-card { padding: 1.35rem; border: 1px solid #e2e8f0; border-radius: 0.875rem; background: #ffffff; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04); }.content-card-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.2rem; }.content-card h2 { margin: 0; color: #0f172a; font-size: 1.05rem; }.card-count { display: grid; min-width: 1.7rem; height: 1.7rem; place-items: center; border-radius: 999px; background: #ecfeff; color: #0e7490; font-size: 0.72rem; font-weight: 800; }
.list { display: flex; flex-direction: column; gap: 0.65rem; }.list-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem; border: 1px solid #f1f5f9; border-radius: 0.75rem; background: #f8fafc; }.list-icon { display: grid; width: 2.25rem; height: 2.25rem; flex: 0 0 auto; place-items: center; border-radius: 0.625rem; font-size: 1.1rem; }.list-icon--alert { background: #fff7ed; color: #c2410c; }.list-icon--jam { background: #eff6ff; }.list-content { min-width: 0; flex: 1; }.list-title { overflow: hidden; color: #334155; font-size: 0.86rem; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.list-meta { overflow: hidden; margin-top: 0.18rem; color: #64748b; font-size: 0.73rem; text-overflow: ellipsis; white-space: nowrap; }
.empty-state { display: flex; min-height: 150px; align-items: center; justify-content: center; gap: 0.75rem; padding: 1.5rem; border: 1px dashed #cbd5e1; border-radius: 0.75rem; background: #f8fafc; color: #64748b; text-align: left; }.empty-state-icon { display: grid; width: 2rem; height: 2rem; flex: 0 0 auto; place-items: center; border-radius: 50%; background: #d1fae5; color: #047857; font-size: 0.9rem; font-weight: 800; }.empty-state strong { display: block; color: #334155; font-size: 0.85rem; }.empty-state p { margin: 0.2rem 0 0; font-size: 0.76rem; }
@media (max-width: 1100px) { .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .dashboard-panels { grid-template-columns: 1fr; } }
@media (max-width: 640px) { .dashboard-intro { align-items: flex-start; flex-direction: column; padding: 1.15rem; }.dashboard-status { margin-top: 0.25rem; }.stats-grid { grid-template-columns: 1fr; }.dashboard-panels { gap: 1rem; }.content-card { padding: 1.1rem; }.list-meta { white-space: normal; } }
</style>
{% endblock %}
