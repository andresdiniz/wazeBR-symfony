{% extends 'base.html.twig' %}

{% block title %}Dashboard - WazeBR{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <h1 class="h4 mb-3 text-light">Dashboard (versão de teste)</h1>
    <p class="text-muted">Se você está vendo estes números e tabelas, o template está renderizando corretamente.</p>

    <div class="row mb-4">
        <div class="col-12 col-md-3">
            <div class="card bg-dark text-light mb-3">
                <div class="card-body">
                    <div class="text-muted small">Alertas (total)</div>
                    <div class="h3 mb-0">{{ kpis.alerts|default(0) }}</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card bg-dark text-light mb-3">
                <div class="card-body">
                    <div class="text-muted small">Jams (total)</div>
                    <div class="h3 mb-0">{{ kpis.jams|default(0) }}</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card bg-dark text-light mb-3">
                <div class="card-body">
                    <div class="text-muted small">Alertas 24h</div>
                    <div class="h3 mb-0">{{ kpis.alerts24h|default(0) }}</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card bg-dark text-light mb-3">
                <div class="card-body">
                    <div class="text-muted small">Jams 24h</div>
                    <div class="h3 mb-0">{{ kpis.jams24h|default(0) }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-6">
            <h2 class="h6 text-uppercase text-muted mb-2">Alertas por tipo</h2>
            {% if alertsByType is defined and alertsByType|length %}
                <table class="table table-dark table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th class="text-end">Qtd</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in alertsByType %}
                            <tr>
                                <td>{{ typesMap[row.type] ?? row.type }}</td>
                                <td class="text-end">{{ row.total }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p class="text-muted">Sem dados de alertsByType para este parceiro.</p>
            {% endif %}
        </div>

        <div class="col-12 col-lg-6">
            <h2 class="h6 text-uppercase text-muted mb-2">Jams por nível</h2>
            {% if jamsByLevel is defined and jamsByLevel|length %}
                <table class="table table-dark table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Nível</th>
                            <th class="text-end">Qtd</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in jamsByLevel %}
                            <tr>
                                <td>{{ row.level }}</td>
                                <td class="text-end">{{ row.total }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p class="text-muted">Sem dados de jamsByLevel para este parceiro.</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
