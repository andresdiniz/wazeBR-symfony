{% extends 'base.html.twig' %}

{% block active_dashboard %}active{% endblock %}

{% block header_title %}Dashboard{% endblock %}

{% block title %}Dashboard - {{ partnerLabel }}{% endblock %}

{% block body %}
<style>
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .kpi-card { border-radius: 12px; padding: 20px; color: #fff; box-shadow: 0 2px 8px rgba(15,23,42,0.15); }
    .kpi-card.primary { background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); }
    .kpi-card.success { background: linear-gradient(135deg, #16a34a 0%, #15803d 100%); }
    .kpi-card.warning { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); }
    .kpi-card.danger { background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%); }
    .kpi-value { font-size: 2rem; font-weight: 700; margin: 8px 0; }
    .kpi-label { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.9; }
    .chart-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 24px; }
    .chart-row-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 24px; }
    .chart-wrapper { background: #fff; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(15,23,42,0.08); }
    #map { height: 450px; border-radius: 12px; box-shadow: 0 2px 8px rgba(15,23,42,0.08); }
</style>

<p class="text-muted mb-4">Visao geral dos dados monitorados para {{ partnerLabel }}.</p>

<div class="stats-grid">
    <div class="kpi-card primary">
        <div class="kpi-label">Alertas 1h</div>
        <div class="kpi-value">{{ kpis.alerts1h }}</div>
        <small>Jams ao vivo: {{ kpis.liveJams }}</small>
    </div>
    <div class="kpi-card success">
        <div class="kpi-label">CIFS ativos</div>
        <div class="kpi-value">{{ kpis.cifsActiveCount }}</div>
        <small>Seç©§es ativas</small>
    </div>
    <div class="kpi-card warning">
        <div class="kpi-label">Alertas (total)</div>
        <div class="kpi-value">{{ kpis.alerts }}</div>
        <small>24h {{ kpis.alerts24h }} · 7d {{ kpis.alerts7d }}</small>
    </div>
    <div class="kpi-card danger">
        <div class="kpi-label">Jams (total)</div>
        <div class="kpi-value">{{ kpis.jams }}</div>
        <small>24h {{ kpis.jams24h }} · 7d {{ kpis.jams7d }}</small>
    </div>
    <div class="kpi-card primary">
        <div class="kpi-label">Cidades</div>
        <div class="kpi-value">{{ (cities|length) ?: 0 }}</div>
        <small>Links {{ (links|length) ?: 0 }} · Rotas {{ (routes|length) ?: 0 }}</small>
    </div>
    <div class="kpi-card success">
        <div class="kpi-label">Irregularidades</div>
        <div class="kpi-value">{{ kpis.irregularities }}</div>
        <small>Seç©§es ativas</small>
    </div>
</div>

<div class="chart-row-3">
    <div class="chart-wrapper">
        <h5>Alertas por tipo (24h)</h5>
        <canvas id="alerts-by-type-chart" height="200"></canvas>
    </div>
    <div class="chart-wrapper">
        <h5>Jams por nível (24h)</h5>
        <canvas id="jams-by-level-chart" height="200"></canvas>
    </div>
    <div class="chart-wrapper">
        <h5>Qualidade dos alertas (24h)</h5>
        <div class="mt-3">
            <h6>Confiabilidade média (reliability)</h6>
            <div class="progress mb-3" style="height: 24px;">
                <div class="progress-bar bg-primary" style="width: {{ kpis.avgReliability }}%">{{ kpis.avgReliability|number_format(1) }}%</div>
            </div>
            <h6>Confianç©§a média (confidence)</h6>
            <div class="progress mb-3" style="height: 24px;">
                <div class="progress-bar bg-success" style="width: {{ kpis.avgConfidence }}%">{{ kpis.avgConfidence|number_format(1) }}%</div>
            </div>
        </div>
    </div>
</div>

<div class="chart-row">
    <div class="chart-wrapper">
        <h5>Mapa de Alertas e Jams (recentes)</h5>
        <div id="map"></div>
    </div>
</div>

<div class="chart-row">
    <div class="chart-wrapper">
        <h5>Alertas por hora (u\u00faltimas 24h)</h5>
        <canvas id="alerts-per-hour-chart" height="160"></canvas>
    </div>
    <div class="chart-wrapper">
        <h5>Jams por hora (u\u00faltimas 24h)</h5>
        <canvas id="jams-per-hour-chart" height="160"></canvas>
    </div>
</div>

<div class="card">
    <div class="card-header">WazeCount — Semana</div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6"><strong>Esta semana:</strong> {{ kpis.wazeCount ?? '—' }}</div>
            <div class="col-md-6"><strong>Semana passada:</strong> {{ kpis.wazeCountLastWeek ?? '—' }}</div>
        </div>
        <h6>Picos por nível de jam (max)</h6>
        <ul class="list-unstyled">
            <li>Nivel 0: {{ kpis.wazeCountPeak.max_level0 ?? 0 }}</li>
            <li>Nivel 1: {{ kpis.wazeCountPeak.max_level1 ?? 0 }}</li>
            <li>Nivel 2: {{ kpis.wazeCountPeak.max_level2 ?? 0 }}</li>
            <li>Nivel 3: {{ kpis.wazeCountPeak.max_level3 ?? 0 }}</li>
            <li>Nivel 4: {{ kpis.wazeCountPeak.max_level4 ?? 0 }}</li>
            <li><strong>Total (max): {{ kpis.wazeCountPeak.max_total ?? 0 }}</strong></li>
        </ul>
    </div>
</div>

<div class="card">
    <div class="card-header">Eventos de Via (CIFS)</div>
    <div class="card-body">
        {% if cifsActive|length > 0 %}
            <div class="alert alert-info">{{ cifsActive|length }} ativos</div>
        {% else %}
            <div class="alert alert-warning">Nenhum evento ativo.</div>
        {% endif %}
        <h6>Pró©§¬ximos 7 dias</h6>
        {% if cifsUpcoming|length > 0 %}
            <ul class="list-unstyled">
                {% for event in cifsUpcoming|slice(0,5) %}
                    <li>{{ event.title ?? 'Evento' }} - {{ event.start ?? '' }}</li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">Nenhum evento programado.</p>
        {% endif %}
    </div>
</div>

<div class="card">
    <div class="card-header">Irregularidades de Trá©§fego</div>
    <div class="card-body">
        {% if irregRecentList|length > 0 %}
            <div class="alert alert-success">{{ irregRecentList|length }} recentes</div>
        {% else %}
            <div class="alert alert-warning">Sem irregularidades recentes.</div>
        {% endif %}
        <h6>Maior Perda de Velocidade (24h)</h6>
        {% if irregSpeedLoss|length > 0 %}
            <ul class="list-unstyled">
                {% for item in irregSpeedLoss|slice(0,5) %}
                    <li>{{ item.street ?? 'Via' }} ({{ item.city ?? '' }}): {{ item.loss|number_format(1) }} km/h</li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">Sem dados de irregularidade.</p>
        {% endif %}
        <h6>Atraso Acumulado por Via (24h)</h6>
        {% if irregDelayByStreet|length > 0 %}
            <ul class="list-unstyled">
                {% for item in irregDelayByStreet|slice(0,5) %}
                    <li>{{ item.street ?? 'Via' }} ({{ item.city ?? '' }}): {{ item.delay }} min</li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">Sem dados de atraso.</p>
        {% endif %}
    </div>
</div>

<div class="card">
    <div class="card-header">Alertas recentes</div>
    <div class="card-body">
        {% if recentAlerts|length > 0 %}
            <ul class="list-unstyled">
                {% for alert in recentAlerts|slice(0,5) %}
                    <li>{{ alert.type }} - {{ alert.city ?? '' }} {{ alert.street ?? '' }}</li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">Sem alertas recentes.</p>
        {% endif %}
    </div>
</div>

<div class="card">
    <div class="card-header">Jams recentes</div>
    <div class="card-body">
        {% if recentJams|length > 0 %}
            <ul class="list-unstyled">
                {% for jam in recentJams|slice(0,5) %}
                    <li>Ní©§vel {{ jam.level }} - {{ jam.city ?? '' }} {{ jam.street ?? '' }}</li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">Sem jams recentes.</p>
        {% endif %}
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
(function() {
    // DEBUG: log de todos os dados importantes
    const debugData = {
        partnerLabel: {{ partnerLabel|json_encode|raw }},
        kpis: {{ kpis|json_encode|raw }},
        alertsByType: {{ alertsByType|json_encode|raw }},
        jamsByLevel: {{ jamsByLevel|json_encode|raw }},
        alertsPerHourLabels: {{ alertsPerHourLabels|json_encode|raw }},
        alertsPerHourData: {{ alertsPerHourData|json_encode|raw }},
        jamsPerHourLabels: {{ jamsPerHourLabels|json_encode|raw }},
        jamsPerHourData: {{ jamsPerHourData|json_encode|raw }},
        recentAlerts: {{ recentAlerts|json_encode|raw }},
        recentJams: {{ recentJams|json_encode|raw }},
        irregRecentList: {{ irregRecentList|json_encode|raw }},
        irregSpeedLoss: {{ irregSpeedLoss|json_encode|raw }},
        irregDelayByStreet: {{ irregDelayByStreet|json_encode|raw }},
    };

    console.log('=== DASHBOARD DEBUG DATA ===');
    console.log(debugData);

    // --- GRÁ©•FICOS ---

    // Alerts por tipo (barras)
    (function() {
        const ctx = document.getElementById('alerts-by-type-chart');
        if (!ctx) return;

        const raw = {{ alertsByType|json_encode|raw }};
        const typesMap = {{ typesMap|json_encode|raw }};

        const labels = raw.map(r => typesMap[r.type] ?? r.type);
        const data = raw.map(r => r.total);

        if (labels.length === 0) {
            console.warn('Sem dados para o grafico de alerts por tipo.');
            return;
        }

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Alertas',
                    data: data,
                    backgroundColor: [
                        'rgba(37, 99, 235, 0.7)',
                        'rgba(245, 158, 11, 0.7)',
                        'rgba(239, 68, 68, 0.7)',
                        'rgba(16, 185, 129, 0.7)',
                        'rgba(59, 130, 246, 0.7)',
                        'rgba(139, 92, 246, 0.7)',
                        'rgba(107, 114, 128, 0.7)',
                    ],
                    borderColor: [
                        '#2563eb',
                        '#f59e0b',
                        '#ef4444',
                        '#10b981',
                        '#3b82f6',
                        '#8b5cf6',
                        '#6b7280',
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, ticks: { stepSize: 1 } }
                }
            }
        });
    })();

    // Jams por nivel (barras)
    (function() {
        const ctx = document.getElementById('jams-by-level-chart');
        if (!ctx) return;

        const raw = {{ jamsByLevel|json_encode|raw }};

        const labels = raw.map(r => 'N' + r.level);
        const data = raw.map(r => r.total);

        if (labels.length === 0) {
            console.warn('Sem dados para o grafico de jams por nivel.');
            return;
        }

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Jams',
                    data: data,
                    backgroundColor: 'rgba(245, 158, 11, 0.7)',
                    borderColor: '#f59e0b',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, ticks: { stepSize: 1 } }
                }
            }
        });
    })();

    // Alerts por hora (u\u00faltimas 24h) - labels reais
    (function() {
        const ctx = document.getElementById('alerts-per-hour-chart');
        if (!ctx) return;

        const labels = {{ alertsPerHourLabels|json_encode|raw }};
        const data   = {{ alertsPerHourData|json_encode|raw }};

        if (!labels || labels.length === 0) {
            console.warn('Sem dados para o grafico de alerts por hora.');
            return;
        }

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Alertas por hora',
                    data: data,
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37, 99, 235, 0.15)',
                    tension: 0.3,
                    fill: true,
                    pointRadius: 3,
                    pointBackgroundColor: '#2563eb'
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, ticks: { stepSize: 1 } }
                }
            }
        });
    })();

    // Jams por hora (u\u00faltimas 24h) - labels reais
    (function() {
        const ctx = document.getElementById('jams-per-hour-chart');
        if (!ctx) return;

        const labels = {{ jamsPerHourLabels|json_encode|raw }};
        const data   = {{ jamsPerHourData|json_encode|raw }};

        if (!labels || labels.length === 0) {
            console.warn('Sem dados para o grafico de jams por hora.');
            return;
        }

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Jams por hora',
                    data: data,
                    borderColor: '#f59e0b',
                    backgroundColor: 'rgba(245, 158, 11, 0.15)',
                    tension: 0.3,
                    fill: true,
                    pointRadius: 3,
                    pointBackgroundColor: '#f59e0b'
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, ticks: { stepSize: 1 } }
                }
            }
        });
    })();

    // --- MAPA LEAFLET ---
    (function() {
        const mapEl = document.getElementById('map');
        if (!mapEl) return;

        const map = L.map('map').setView([-20.66, -43.81], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: 'OpenStreetMap'
        }).addTo(map);

        const recentAlerts = {{ recentAlerts|json_encode|raw }};
        const recentJams = {{ recentJams|json_encode|raw }};

        const alertColorMap = {
            'ACCIDENT': '#ef4444',
            'HAZARD': '#f59e0b',
            'JAM': '#3b82f6',
            'WEATHERHAZARD': '#10b981',
            'ROAD_CLOSED': '#8b5cf6',
            'CONSTRUCTION': '#6b7280',
            'MISC': '#64748b',
        };

        recentAlerts.forEach(a => {
            if (!a.latitude || !a.longitude) return;
            const color = alertColorMap[a.type] ?? '#333';
            const circle = L.circleMarker([a.latitude, a.longitude], {
                radius: 7,
                color: color,
                fillColor: color,
                fillOpacity: 0.7
            }).addTo(map);
            circle.bindPopup(`<strong>${a.type}</strong><br>${a.city ?? ''} ${a.street ?? ''}`);
        });

        const jamLevelColor = {
            0: '#94a3b8',
            1: '#22c55e',
            2: '#eab308',
            3: '#f97316',
            4: '#ef4444',
            5: '#7f1d1d',
        };

        recentJams.forEach(j => {
            if (j.line && Array.isArray(j.line) && j.line.length > 0) {
                const coords = j.line.map(p => [p[1], p[0]]);
                const color = jamLevelColor[j.level] ?? '#ef4444';
                L.polyline(coords, { color, weight: 4 }).addTo(map)
                 .bindPopup(`<strong>Jam N${j.level}</strong><br>${j.city ?? ''} ${j.street ?? ''}`);
            }
        });
    })();
})();
</script>
{% endblock %}
