{% extends 'base.html.twig' %}

{% block title %}Dashboard — {{ partnerLabel }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/dashboard.css') }}">
{% endblock %}

{% block body %}
<div class="dashboard-container">
    {# Cabeçalho #}
    <header class="dashboard-header">
        <div class="header-content">
            <div class="header-title">
                <i class="bi bi-speedometer2"></i>
                <h1>Dashboard</h1>
            </div>
            <p class="header-subtitle">Visão geral — {{ partnerLabel }}</p>
        </div>
        <div class="header-actions">
            <button id="refresh-dashboard" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-clockwise"></i>
                Atualizar
            </button>
        </div>
    </header>

    {# Stats do parceiro (total geral) #}
    <section class="stats-section">
        <div class="stats-grid">
            <div class="stat-card stat-primary">
                <div class="stat-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Alertas Totais</span>
                    <span class="stat-value">{{ partnerStats.alerts|number_format(0, ',', '.') }}</span>
                </div>
            </div>

            <div class="stat-card stat-warning">
                <div class="stat-icon">
                    <i class="bi bi-broadcast"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Congestionamentos</span>
                    <span class="stat-value">{{ partnerStats.jams|number_format(0, ',', '.') }}</span>
                </div>
            </div>

            <div class="stat-card stat-info">
                <div class="stat-icon">
                    <i class="bi bi-map"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Rotas TVT</span>
                    <span class="stat-value">{{ partnerStats.tvtRoutes|number_format(0, ',', '.') }}</span>
                </div>
            </div>

            <div class="stat-card stat-success">
                <div class="stat-icon">
                    <i class="bi bi-link-45deg"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Links Monitorados</span>
                    <span class="stat-value">{{ partnerStats.monitoredLinks|number_format(0, ',', '.') }}</span>
                </div>
            </div>

            <div class="stat-card stat-danger">
                <div class="stat-icon">
                    <i class="bi bi-exclamation-circle"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Irregularidades</span>
                    <span class="stat-value">{{ partnerStats.irregularities|number_format(0, ',', '.') }}</span>
                </div>
            </div>

            <div class="stat-card stat-dark">
                <div class="stat-icon">
                    <i class="bi bi-calendar-event"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Eventos CIFS</span>
                    <span class="stat-value">{{ partnerStats.cifsEvents|number_format(0, ',', '.') }}</span>
                </div>
            </div>
        </div>
    </section>

    {# Banda "ao vivo" (KPIs em destaque) #}
    <section class="hero-section">
        <h2 class="section-title">Ao Vivo</h2>
        <div class="hero-grid">
            <div class="hero-card hero-alert">
                <div class="hero-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <div class="hero-content">
                    <span class="hero-label">Alertas (24h)</span>
                    <span class="hero-value">{{ hero.alertsLast24h|number_format(0, ',', '.') }}</span>
                    <span class="hero-subtitle">Total: {{ hero.alertsTotal|number_format(0, ',', '.') }}</span>
                </div>
            </div>

            <div class="hero-card hero-jam">
                <div class="hero-icon">
                    <i class="bi bi-broadcast"></i>
                </div>
                <div class="hero-content">
                    <span class="hero-label">Jams (24h)</span>
                    <span class="hero-value">{{ hero.jamsLast24h|number_format(0, ',', '.') }}</span>
                    <span class="hero-subtitle">Total: {{ hero.jamsTotal|number_format(0, ',', '.') }}</span>
                </div>
            </div>

            <div class="hero-card hero-live">
                <div class="hero-icon">
                    <i class="bi bi-activity"></i>
                </div>
                <div class="hero-content">
                    <span class="hero-label">Jams Ativos (3h)</span>
                    <span class="hero-value">{{ hero.jamsLiveTotal|number_format(0, ',', '.') }}</span>
                    <span class="hero-subtitle">
                        {% if hero.jamsLiveMaxLevelLabel %}
                            Máx: {{ hero.jamsLiveMaxLevelLabel }} ({{ hero.jamsLiveMaxLevel }})
                        {% else %}
                            Sem jams ativos
                        {% endif %}
                    </span>
                </div>
            </div>

            <div class="hero-card hero-speed">
                <div class="hero-icon">
                    <i class="bi bi-speedometer"></i>
                </div>
                <div class="hero-content">
                    <span class="hero-label">Velocidade Média</span>
                    <span class="hero-value">{{ (hero.avgSpeedLive ?? 0)|round(1) }} km/h</span>
                    <span class="hero-subtitle">Histórico: {{ (hero.avgSpeedHist ?? 0)|round(1) }} km/h</span>
                </div>
            </div>

            <div class="hero-card hero-delay">
                <div class="hero-icon">
                    <i class="bi bi-clock"></i>
                </div>
                <div class="hero-content">
                    <span class="hero-label">Atraso Médio</span>
                    <span class="hero-value">{{ ((hero.avgDelayLive ?? 0) / 60)|round(1) }} min</span>
                    <span class="hero-subtitle">{{ (hero.avgDelayLive ?? 0)|number_format(0, ',', '.') }}s</span>
                </div>
            </div>

            <div class="hero-card hero-length">
                <div class="hero-icon">
                    <i class="bi bi-arrows-alt-h"></i>
                </div>
                <div class="hero-content">
                    <span class="hero-label">Extensão Congestionada</span>
                    <span class="hero-value">{{ (hero.lengthLiveKm ?? 0)|round(1) }} km</span>
                    <span class="hero-subtitle">Histórico: {{ (hero.lengthHistKm ?? 0)|round(1) }} km</span>
                </div>
            </div>

            <div class="hero-card hero-routes">
                <div class="hero-icon">
                    <i class="bi bi-map"></i>
                </div>
                <div class="hero-content">
                    <span class="hero-label">Rotas Monitoradas</span>
                    <span class="hero-value">{{ hero.routesMonitored|number_format(0, ',', '.') }}</span>
                    <span class="hero-subtitle">{{ hero.monitoredLinks }} links · {{ hero.monitoredCities }} cidades</span>
                </div>
            </div>

            <div class="hero-card hero-cemaden">
                <div class="hero-icon">
                    <i class="bi bi-cloud-rain"></i>
                </div>
                <div class="hero-content">
                    <span class="hero-label">CEMADEN</span>
                    <span class="hero-value">{{ hero.cemadenReadings|number_format(0, ',', '.') }}</span>
                    <span class="hero-subtitle">{{ hero.cemadenCities }} cidade(s)</span>
                </div>
            </div>
        </div>
    </section>

    {# Stats do período #}
    <section class="period-section">
        <h2 class="section-title">
            Período: {{ periods[periodKey].label }}
            <small class="period-range">({{ periodFrom|date('d/m/Y H:i') }} → {{ periodTo|date('d/m/Y H:i') }})</small>
        </h2>
        <div class="period-grid">
            <div class="period-card">
                <span class="period-value">{{ periodStats.alerts|number_format(0, ',', '.') }}</span>
                <span class="period-label">Alertas</span>
            </div>
            <div class="period-card">
                <span class="period-value">{{ periodStats.jams|number_format(0, ',', '.') }}</span>
                <span class="period-label">Congestionamentos</span>
            </div>
            <div class="period-card">
                <span class="period-value">{{ periodStats.tvtRoutes|number_format(0, ',', '.') }}</span>
                <span class="period-label">Rotas TVT</span>
            </div>
            <div class="period-card">
                <span class="period-value">{{ periodStats.irregularities|number_format(0, ',', '.') }}</span>
                <span class="period-label">Irregularidades</span>
            </div>
            <div class="period-card">
                <span class="period-value">{{ periodStats.cifsEvents|number_format(0, ',', '.') }}</span>
                <span class="period-label">Eventos CIFS</span>
            </div>
        </div>
    </section>

    {# Gráficos #}
    <section class="charts-section">
        <div class="chart-grid">
            <div class="chart-card">
                <div class="chart-header">
                    <span><i class="bi bi-bar-chart-fill"></i> Alertas por Subtipo</span>
                </div>
                <div class="chart-body">
                    {% if alertsBySubtype|length > 0 %}
                        <canvas id="chartAlertsBySubtype"></canvas>
                    {% else %}
                        <div class="chart-empty">Nenhum alerta no período.</div>
                    {% endif %}
                </div>
            </div>

            <div class="chart-card">
                <div class="chart-header">
                    <span><i class="bi bi-pie-chart-fill"></i> Congestionamentos por Nível</span>
                </div>
                <div class="chart-body">
                    <canvas id="chartJamsByLevel"></canvas>
                </div>
            </div>
        </div>
    </section>

    {# Ranking de ruas #}
    <section class="ranking-section">
        <h2 class="section-title">Principais Ruas com Congestionamento</h2>
        <div class="ranking-card">
            {% if topStreets|length > 0 %}
                <table class="ranking-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Rua</th>
                            <th>Cidade</th>
                            <th>Nível Médio</th>
                            <th>Ocorrências</th>
                            <th>Atraso Médio</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for street in topStreets %}
                        <tr>
                            <td><span class="rank-badge">{{ loop.index }}</span></td>
                            <td class="fw-semibold">{{ street.street ?? 'Sem nome' }}</td>
                            <td>{{ street.city ?? '—' }}</td>
                            <td>
                                <span class="badge badge-{{ street.avgLevel >= 4 ? 'danger' : (street.avgLevel >= 2 ? 'warning' : 'success') }}">
                                    {{ street.avgLevel }}
                                </span>
                            </td>
                            <td>{{ street.occurrences }}</td>
                            <td>{{ street.avgDelay ? (street.avgDelay / 60)|round(1) ~ ' min' : '—' }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div class="empty-state">Nenhum congestionamento no período.</div>
            {% endif %}
        </div>
    </section>

    {# Mapa #}
    <section class="map-section">
        <h2 class="section-title">Mapa — Congestionamentos e Alertas</h2>
        <div class="map-card">
            <div id="dashboard-map"></div>
            <p class="map-note">
                {{ mapJams|length }} congestionamento(s) e {{ mapAlerts|length }} alerta(s) exibidos
                {% if mapJamsTruncated or mapAlertsTruncated %}
                    (limite atingido — refine o período)
                {% endif %}
            </p>
        </div>
    </section>

    {# Alertas recentes #}
    <section class="recent-section">
        <h2 class="section-title">Alertas Recentes</h2>
        <div class="recent-card">
            {% if recentAlerts|length > 0 %}
                <table class="recent-table">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Subtipo</th>
                            <th>Local</th>
                            <th>Hora</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for alert in recentAlerts %}
                        <tr>
                            <td><span class="badge">{{ alert.type }}</span></td>
                            <td>{{ alert.subtype ?? '—' }}</td>
                            <td>{{ alert.city ?? '' }} — {{ alert.street ?? 'Via não informada' }}</td>
                            <td class="font-mono">{{ alert.pubAt ?? '—' }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div class="empty-state">Nenhum alerta no período.</div>
            {% endif %}
        </div>
    </section>

    {# Jams recentes #}
    <section class="recent-section">
        <h2 class="section-title">Lentidões Recentes</h2>
        <div class="recent-card">
            {% if recentJams|length > 0 %}
                <table class="recent-table">
                    <thead>
                        <tr>
                            <th>Via</th>
                            <th>Cidade</th>
                            <th>Nível</th>
                            <th>Hora</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for jam in recentJams %}
                        <tr>
                            <td>{{ jam.street ?? 'Sem nome' }}</td>
                            <td>{{ jam.city ?? '—' }}</td>
                            <td>
                                <span class="badge badge-{{ jam.level >= 4 ? 'danger' : (jam.level >= 2 ? 'warning' : 'success') }}">
                                    {{ jam.level }}
                                </span>
                            </td>
                            <td class="font-mono">{{ jam.pubAt ?? '—' }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div class="empty-state">Nenhuma lentidão no período.</div>
            {% endif %}
        </div>
    </section>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
    <script src="{{ asset('js/dashboard.js') }}" defer></script>
    <script>
        // Dados para os gráficos
        window.dashboardData = {
            alertsBySubtype: {{ alertsBySubtype|json_encode|raw }},
            jamsByLevel: {{ jamsByLevel|json_encode|raw }},
            topStreets: {{ topStreets|json_encode|raw }},
            mapJams: {{ mapJams|json_encode|raw }},
            mapAlerts: {{ mapAlerts|json_encode|raw }},
        };
    </script>
{% endblock %}
