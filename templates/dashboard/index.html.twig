{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Dashboard - wazeBR{% endblock %}

{% block page_stylesheets %}
<link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
{% endblock %}

{% block content %}
<div class="dashboard-wrapper">
    <header class="dashboard-header">
        <h1>Dashboard</h1>
        <p class="dashboard-subtitle">Visão geral do monitoramento</p>
    </header>

    <!-- Stats Cards -->
    <section class="stats-grid">
        <div class="stat-card stat-alerts">
            <div class="stat-icon">!</div>
            <div class="stat-value">{{ stats.total_alerts }}</div>
            <div class="stat-label">Alertas</div>
        </div>
        <div class="stat-card stat-jams">
            <div class="stat-icon">≈</div>
            <div class="stat-value">{{ stats.total_jams }}</div>
            <div class="stat-label">Congestionamentos</div>
        </div>
        <div class="stat-card stat-weather">
            <div class="stat-icon">⛅</div>
            <div class="stat-value">{{ stats.total_weather }}</div>
            <div class="stat-label">Observações Climáticas  </div>
        </div>
        <div class="stat-card stat-partners">
            <div class="stat-icon">◉</div>
            <div class="stat-value">{{ stats.total_partners }}</div>
            <div class="stat-label">Parceiros</div>
        </div>
        <div class="stat-card stat-users">
            <div class="stat-icon">☺</div>
            <div class="stat-value">{{ stats.total_users }}</div>
            <div class="stat-label">Usuários</div>
        </div>
    </section>

    <!-- Recent Items Grid -->
    <div class="dashboard-grid">
        <!-- Recent Alerts -->
        <section class="dashboard-card">
            <h2>Alertas Recentes</h2>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tipo</th>
                            <th>Data</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for alert in stats.recent_alerts %}
                        <tr>
                            <td>#{{ alert.id }}</td>
                            <td><span class="badge badge-alert">{{ alert.type }}</span></td>
                            <td>
    {% if alert.pubDateTime %}
        {{ alert.pubDateTime|date('d/m/Y H:i') }}
    {% else %}
        —
    {% endif %}
</td>
                        </tr>
                        {% else %}
                        <tr><td colspan="3">Nenhum alerta encontrado</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Recent Jams -->
        <section class="dashboard-card">
            <h2>Congestionamentos Recentes</h2>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Local</th>
                                <th>Velocidade</th>
                                <th>Nível</th>
                                <th>Data</th>
                            </tr>
                        </thead>
                    </thead>
                    <tbody>
                        {% for jam in stats.recent_jams %}
                            <tr>
                                <td>#{{ jam.id }}</td>

                                <td>
                                    {{ jam.street ?: 'Rua não informada' }}
                                    {% if jam.city %}
                                        <small class="text-muted">
                                            — {{ jam.city }}
                                        </small>
                                    {% endif %}
                                </td>

                                <td>
                                    {{ jam.speedKmh|default('0') }} km/h
                                </td>

                                <td>
                                    {{ jam.levelLabel }}
                                </td>

                                <td>
                                    {% if jam.pubDateTime %}
                                        {{ jam.pubDateTime|date('d/m/Y H:i') }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5">
                                    Nenhum congestionamento encontrado
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Recent Weather -->
        <section class="dashboard-card full-width">
            <h2>Últimas Observações Climáticas</h2>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Local</th>
                            <th>Temperatura</th>
                            <th>Umidade (%)</th>
                            <th>Data</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for weather in stats.recent_weather %}
                        <tr>
                            <td>#{{ weather.id }}</td>
                            <td>{{ weather.location }}</td>
                            <td>{{ weather.airTemperature }}</td>
                            <td>{{ weather.relativeHumidity }}</td>
                            <td>{{ weather.date|date('d/m/Y H:i') }}</td>
                        </tr>
                        {% else %}
                        <tr><td colspan="5">Nenhuma observação climática encontrada</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module" src="{{ asset('js/pages/dashboard.js') }}"></script>
{% endblock %}
