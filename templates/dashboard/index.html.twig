{% extends 'base.html.twig' %}

{% block title %}Dashboard - wazeBR{% endblock %}

{% block page_stylesheets %}
<style>
    .dashboard-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .stat-card { background: #fff; border: 1px solid #e0e0e0; border-radius: 8px; padding: 20px; text-align: center; }
    .stat-card h3 { margin: 0; font-size: 2rem; color: #1976d2; }
    .stat-card p { margin: 8px 0 0; color: #666; font-size: 0.9rem; }
    .dashboard-section { margin-bottom: 24px; }
    .dashboard-section h2 { font-size: 1.25rem; margin-bottom: 12px; color: #333; }
    .recent-list { list-style: none; padding: 0; margin: 0; }
    .recent-item { background: #f5f5f5; border-radius: 6px; padding: 12px 16px; margin-bottom: 8px; font-size: 0.9rem; }
</style>
{% endblock %}

{% block body_class %}dashboard-page{% endblock %}

{% block body %}
<div class="dashboard-layout">
    {% include 'partials/sidebar.html.twig' %}
    <main class="dashboard-content">
        {% include 'partials/header.html.twig' %}
        <div class="dashboard-content-inner">
            <h1>Dashboard</h1>
            
            <div class="dashboard-stats">
                <div class="stat-card">
                    <h3>{{ stats.total_alerts }}</h3>
                    <p>Alertas</p>
                </div>
                <div class="stat-card">
                    <h3>{{ stats.total_jams }}</h3>
                    <p>Congestionamentos</p>
                </div>
            </div>

            <div class="dashboard-section">
                <h2>Alertas Recentes</h2>
                {% if stats.recent_alerts is empty %}
                    <p>Nenhum alerta recente.</p>
                {% else %}
                    <ul class="recent-list">
                        {% for alert in stats.recent_alerts %}
                            <li class="recent-item">#{{ alert.id }} - {{ alert.type }} - {{ alert.reportTime|date('d/m/Y H:i') }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>

            <div class="dashboard-section">
                <h2>Congestionamentos Recentes</h2>
                {% if stats.recent_jams is empty %}
                    <p>Nenhum congestionamento recente.</p>
                {% else %}
                    <ul class="recent-list">
                        {% for jam in stats.recent_jams %}
                            <li class="recent-item">#{{ jam.id }} - Nos: {{ jam.line }} - {{ jam.reportTime|date('d/m/Y H:i') }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>
    </main>
</div>
{% endblock %}
