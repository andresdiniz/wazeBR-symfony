{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Dashboard | WazeBR{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/pages/dashboard.css') }}">
{% endblock %}

{% block content %}
{% set alerts  = stats.recent_alerts|default([]) %}
{% set jams    = stats.recent_jams|default([]) %}
{% set routes  = stats.recent_routes|default([]) %}
{% set cities  = stats.top_cities|default([]) %}
{% set hourly  = stats.hourly_activity|default([]) %}
{% set health  = stats.health_score|default(100) %}
{% set total_occurrences = (stats.total_alerts|default(0)) + (stats.total_jams|default(0)) %}

<div class="dashboard-page"
     data-dashboard
     data-total-alerts="{{ stats.total_alerts|default(0) }}"
     data-total-jams="{{ stats.total_jams|default(0) }}"
     data-hourly="{{ hourly|json_encode|e('html_attr') }}">

    <div class="dashboard-container">

        {# ── Cabeçalho ───────────────────────────────────────────────────── #}
        <header class="dashboard-page-header">
            <div>
                <span class="dashboard-eyebrow"><i></i> Centro operacional</span>
                <h1>Visão geral da mobilidade</h1>
                <p>Trânsito, alertas, rotas e condições operacionais em um só lugar.{% if partner is defined and partner %} — <strong>{{ partner.name }}</strong>{% endif %}</p>
            </div>
            <div class="dashboard-header-tools">
                <span class="dashboard-last-update"><i></i> Atualizado em <time data-dashboard-clock>{{ stats.updated_at|date('d/m H:i') }}</time></span>
                <button type="button" class="dashboard-button" data-action="refresh-dashboard" aria-label="Recarregar dados">
                    <span>↻</span> Atualizar
                </button>
            </div>
        </header>

        {# ── Filtros ─────────────────────────────────────────────────────── #}
        <section class="dashboard-filter-panel" aria-label="Filtros do dashboard">
            <div class="dashboard-filter-heading">
                <div><span class="dashboard-panel-kicker">Explorar dados</span><h2>Filtros e navegação</h2></div>
                <button type="button" class="dashboard-button is-link" data-action="clear-filters">Limpar filtros</button>
            </div>
            <div class="dashboard-filter-form">
                <label class="dashboard-filter-field">
                    <span>Período</span>
                    <select data-filter="period">
                        <option value="all">Todos os registros</option>
                        <option value="today">Hoje</option>
                        <option value="week">Últimos 7 dias</option>
                        <option value="month">Últimos 30 dias</option>
                    </select>
                </label>
                <label class="dashboard-filter-field">
                    <span>Buscar ocorrência</span>
                    <input type="search" data-filter="query" placeholder="Tipo, rua, cidade ou rota" autocomplete="off">
                </label>
                <label class="dashboard-filter-field">
                    <span>Seção</span>
                    <select data-filter="section">
                        <option value="all">Todas</option>
                        <option value="alerts">Alertas</option>
                        <option value="jams">Congestionamentos</option>
                        <option value="routes">Rotas</option>
                    </select>
                </label>
                <div class="dashboard-filter-actions">
                    <button type="button" class="dashboard-button is-primary" data-action="apply-filters">Aplicar</button>
                    <button type="button" class="dashboard-button" data-action="clear-filters">Limpar</button>
                </div>
            </div>
            <p class="dashboard-filter-feedback" data-filter-feedback aria-live="polite"></p>
        </section>

        {# ── KPIs ────────────────────────────────────────────────────────── #}
        <section class="dashboard-kpi-grid" aria-label="Indicadores principais">
            <article class="dashboard-kpi-card kpi-blue">
                <div class="dashboard-kpi-top">
                    <span class="dashboard-kpi-icon" aria-hidden="true">⚠</span>
                    <span class="dashboard-kpi-trend">Monitoramento</span>
                </div>
                <strong class="dashboard-kpi-value" data-count-value="{{ stats.total_alerts|default(0) }}">{{ stats.total_alerts|default(0) }}</strong>
                <span class="dashboard-kpi-label">Alertas registrados</span>
                <div class="dashboard-kpi-footer"><span>Base Waze</span><span aria-hidden="true">→</span></div>
            </article>

            <article class="dashboard-kpi-card kpi-orange">
                <div class="dashboard-kpi-top">
                    <span class="dashboard-kpi-icon" aria-hidden="true">≋</span>
                    <span class="dashboard-kpi-trend {% if stats.total_jams|default(0) > 10 %}is-warning{% endif %}">
                        {{ stats.total_jams|default(0) > 10 ? 'Atenção' : 'Normal' }}
                    </span>
                </div>
                <strong class="dashboard-kpi-value" data-count-value="{{ stats.total_jams|default(0) }}">{{ stats.total_jams|default(0) }}</strong>
                <span class="dashboard-kpi-label">Congestionamentos</span>
                <div class="dashboard-kpi-footer"><span>Ocorrências viárias</span><span aria-hidden="true">→</span></div>
            </article>

            <article class="dashboard-kpi-card kpi-green">
                <div class="dashboard-kpi-top">
                    <span class="dashboard-kpi-icon" aria-hidden="true">☁</span>
                    <span class="dashboard-kpi-trend is-positive">Ativo</span>
                </div>
                <strong class="dashboard-kpi-value" data-count-value="{{ stats.total_weather|default(0) }}">{{ stats.total_weather|default(0) }}</strong>
                <span class="dashboard-kpi-label">Observações climáticas</span>
                <div class="dashboard-kpi-footer"><span>Estações monitoradas</span><span aria-hidden="true">→</span></div>
            </article>

            <article class="dashboard-kpi-card kpi-purple">
                <div class="dashboard-kpi-top">
                    <span class="dashboard-kpi-icon" aria-hidden="true">◎</span>
                    <span class="dashboard-kpi-trend is-positive">Conectado</span>
                </div>
                <strong class="dashboard-kpi-value" data-count-value="{{ stats.total_partners|default(0) }}">{{ stats.total_partners|default(0) }}</strong>
                <span class="dashboard-kpi-label">Parceiros ativos</span>
                <div class="dashboard-kpi-footer"><span>Integrações disponíveis</span><span aria-hidden="true">→</span></div>
            </article>
        </section>

        {# ── Grid principal: chart + saúde ───────────────────────────────── #}
        <div class="dashboard-main-grid">

            {# Chart de atividade horária #}
            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div><span class="dashboard-panel-kicker">Indicadores</span><h2>Atividade nas últimas 8 horas</h2></div>
                    <span class="dashboard-panel-period">Por hora</span>
                </header>
                <div class="dashboard-chart" data-dashboard-line-chart>
                    <div class="dashboard-chart-y" aria-hidden="true">
                        <span>Alto</span><span></span><span>Méd</span><span></span><span>0</span>
                    </div>
                    <div class="dashboard-chart-area">
                        <div class="dashboard-chart-grid" aria-hidden="true"></div>
                        <svg viewBox="0 0 700 220" preserveAspectRatio="none" role="img" aria-label="Gráfico de atividade operacional por hora">
                            <title>Atividade operacional por hora</title>
                            <defs>
                                <linearGradient id="dashboardChartFill" x1="0" x2="0" y1="0" y2="1">
                                    <stop offset="0" stop-color="#2563eb" stop-opacity=".18"/>
                                    <stop offset="1" stop-color="#2563eb" stop-opacity="0"/>
                                </linearGradient>
                                <linearGradient id="dashboardChartFillJams" x1="0" x2="0" y1="0" y2="1">
                                    <stop offset="0" stop-color="#ea580c" stop-opacity=".14"/>
                                    <stop offset="1" stop-color="#ea580c" stop-opacity="0"/>
                                </linearGradient>
                            </defs>
                            <path class="dashboard-chart-fill" data-chart-fill></path>
                            <path class="dashboard-chart-fill dashboard-chart-fill--jams" data-chart-fill-jams></path>
                            <path class="dashboard-chart-line" data-chart-line></path>
                            <path class="dashboard-chart-line dashboard-chart-line--jams" data-chart-line-jams></path>
                        </svg>
                        <div class="dashboard-chart-x" aria-hidden="true">
                            {% for point in hourly %}
                                <span>{{ point.hour }}</span>
                            {% else %}
                                <span>—</span><span>—</span><span>—</span><span>—</span><span>—</span>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                <div class="dashboard-chart-legend">
                    <span><i class="legend-blue" aria-hidden="true"></i> Alertas — <strong data-count-value="{{ stats.total_alerts|default(0) }}">{{ stats.total_alerts|default(0) }}</strong></span>
                    <span><i class="legend-orange" aria-hidden="true"></i> Jams — <strong data-count-value="{{ stats.total_jams|default(0) }}">{{ stats.total_jams|default(0) }}</strong></span>
                    <span>Total: <strong>{{ total_occurrences }}</strong></span>
                </div>
            </section>

            {# Painel de saúde #}
            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div><span class="dashboard-panel-kicker">Status</span><h2>Saúde da operação</h2></div>
                    <span class="dashboard-health-badge"><i></i> Online</span>
                </header>
                <div class="dashboard-health-score">
                    <div class="dashboard-health-ring" style="--health-score:{{ health }}" role="meter" aria-valuenow="{{ health }}" aria-valuemin="0" aria-valuemax="100" aria-label="Score de saúde">
                        <span>{{ health }}<small>%</small></span>
                    </div>
                    <div>
                        <strong>
                            {% if health >= 80 %}Operação estável
                            {% elseif health >= 60 %}Atenção recomendada
                            {% else %}Operação crítica{% endif %}
                        </strong>
                        <p>
                            {% if health >= 80 %}Fontes de dados disponíveis e monitoradas.
                            {% elseif health >= 60 %}Algumas rotas com atraso ou volume elevado.
                            {% else %}Alto volume de alertas e congestionamentos ativos.{% endif %}
                        </p>
                    </div>
                </div>
                <div class="dashboard-health-list">
                    <div>
                        <span><i class="health-green" aria-hidden="true"></i> Waze Alerts</span>
                        <strong>{{ stats.total_alerts|default(0) }} registros</strong>
                    </div>
                    <div>
                        <span><i class="health-{% if stats.total_jams|default(0) > 10 %}orange{% else %}blue{% endif %}" aria-hidden="true"></i> Waze Jams</span>
                        <strong>{{ stats.total_jams|default(0) }} registros</strong>
                    </div>
                    <div>
                        <span><i class="health-gray" aria-hidden="true"></i> Rotas monitoradas</span>
                        <strong>{{ routes|length }} com snapshot</strong>
                    </div>
                    <div>
                        <span><i class="health-gray" aria-hidden="true"></i> Dados climáticos</span>
                        <strong>{{ stats.total_weather|default(0) }} observações</strong>
                    </div>
                </div>
            </section>
        </div>

        {# ── Seções de dados ─────────────────────────────────────────────── #}
        <div class="dashboard-content-grid">

            {# Alertas #}
            <section class="dashboard-panel data-section" data-section="alerts">
                <header class="dashboard-panel-header">
                    <div><span class="dashboard-panel-kicker">Tempo real</span><h2>Alertas recentes</h2></div>
                    <span class="dashboard-panel-count {% if alerts|length > 0 %}is-orange{% endif %}">{{ alerts|length }}</span>
                </header>
                <div class="dashboard-data-list" data-list="alerts">
                    {% for alert in alerts %}
                    <div class="dashboard-data-row"
                         data-search-text="{{ (alert.type|default('') ~ ' ' ~ alert.subtype|default('') ~ ' ' ~ alert.city|default(''))|lower }}"
                         data-date="{{ alert.pubDateTime ? alert.pubDateTime|date('Y-m-d') : '' }}">
                        <span class="dashboard-row-icon row-orange" aria-hidden="true">⚠</span>
                        <div>
                            <strong>{{ alert.type|default('Alerta de trânsito') }}</strong>
                            <small>#{{ alert.id }} · {{ alert.subtype|default('—') }} · {{ alert.city|default('Local não informado') }}</small>
                        </div>
                        <time datetime="{{ alert.pubDateTime ? alert.pubDateTime|date('c') : '' }}">
                            {{ alert.pubDateTime ? alert.pubDateTime|date('d/m H:i') : '—' }}
                        </time>
                        <span class="dashboard-severity">Atenção</span>
                    </div>
                    {% else %}
                    <div class="dashboard-empty">
                        <span aria-hidden="true">✓</span>
                        <strong>Nenhum alerta recente</strong>
                        <small>A operação está sem novos alertas.</small>
                    </div>
                    {% endfor %}
                </div>
                <div class="dashboard-pagination" data-pagination="alerts" role="navigation" aria-label="Páginas de alertas"></div>
                <button type="button" class="dashboard-button is-link dashboard-expand" data-expand="alerts">Ver todos →</button>
            </section>

            {# Congestionamentos #}
            <section class="dashboard-panel data-section" data-section="jams">
                <header class="dashboard-panel-header">
                    <div><span class="dashboard-panel-kicker">Trânsito</span><h2>Congestionamentos</h2></div>
                    <span class="dashboard-panel-count {% if jams|length > 0 %}is-orange{% endif %}">{{ jams|length }}</span>
                </header>
                <div class="dashboard-data-list" data-list="jams">
                    {% for jam in jams %}
                    <div class="dashboard-data-row"
                         data-search-text="{{ (jam.street|default('') ~ ' ' ~ jam.city|default(''))|lower }}"
                         data-date="">
                        <span class="dashboard-row-icon row-orange" aria-hidden="true">≋</span>
                        <div>
                            <strong>{{ jam.street|default('Via não informada') }}</strong>
                            <small>
                                {{ jam.city|default('—') }}
                                {% if jam.speedKmh is defined and jam.speedKmh is not null %} · {{ jam.speedKmh|round(1) }} km/h{% endif %}
                                {% if jam.length is defined and jam.length is not null %} · {{ (jam.length / 1000)|round(1) }} km{% endif %}
                            </small>
                        </div>
                        <span class="dashboard-severity dashboard-jam-level-{{ jam.level|default(0) }}">
                            Nível {{ jam.level|default(0) }}
                        </span>
                    </div>
                    {% else %}
                    <div class="dashboard-empty">
                        <span aria-hidden="true">✓</span>
                        <strong>Nenhum congestionamento</strong>
                        <small>Não há ocorrências viárias recentes.</small>
                    </div>
                    {% endfor %}
                </div>
                <div class="dashboard-pagination" data-pagination="jams" role="navigation" aria-label="Páginas de congestionamentos"></div>
                <button type="button" class="dashboard-button is-link dashboard-expand" data-expand="jams">Ver todos →</button>
            </section>

            {# Rotas #}
            <section class="dashboard-panel data-section" data-section="routes">
                <header class="dashboard-panel-header">
                    <div><span class="dashboard-panel-kicker">Rotas monitoradas</span><h2>Maior atraso por rota</h2></div>
                    <span class="dashboard-panel-count {% if routes|length > 0 %}is-orange{% endif %}">{{ routes|length }}</span>
                </header>
                <div class="dashboard-data-list" data-list="routes">
                    {% for route in routes %}
                    <div class="dashboard-data-row"
                         data-search-text="{{ (route.name|default('') ~ ' ' ~ route.from_name|default('') ~ ' ' ~ route.to_name|default('') ~ ' ' ~ route.waze_route_id|default(''))|lower }}"
                         data-date="">
                        <span class="dashboard-row-icon {% if route.delay_minutes is not null and route.delay_minutes > 5 %}row-orange{% else %}row-green{% endif %}" aria-hidden="true">→</span>
                        <div>
                            <strong>{{ route.name|default('Rota monitorada') }}</strong>
                            <small>
                                {% if route.from_name is not null and route.to_name is not null %}
                                    {{ route.from_name }} → {{ route.to_name }} ·
                                {% endif %}
                                Atual {{ route.time|default('—') }}s · Histórico {{ route.historic_time|default('—') }}s
                            </small>
                        </div>
                        <span class="dashboard-severity {% if route.delay_minutes is not null and route.delay_minutes <= 0 %}is-active{% endif %}">
                            {% if route.delay_minutes is not null %}
                                {% if route.delay_minutes > 0 %}+{{ route.delay_minutes }} min{% else %}No prazo{% endif %}
                            {% else %}
                                Nível {{ route.jam_level|default('—') }}
                            {% endif %}
                        </span>
                    </div>
                    {% else %}
                    <div class="dashboard-empty">
                        <span aria-hidden="true">✓</span>
                        <strong>Nenhuma rota encontrada</strong>
                        <small>Não há snapshots vinculados às rotas.</small>
                    </div>
                    {% endfor %}
                </div>
                <div class="dashboard-pagination" data-pagination="routes" role="navigation" aria-label="Páginas de rotas"></div>
                <button type="button" class="dashboard-button is-link dashboard-expand" data-expand="routes">Ver todas →</button>
            </section>
        </div>

        {# ── Rodapé do dashboard ─────────────────────────────────────────── #}
        <div class="dashboard-bottom-grid">

            {# Top cidades #}
            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div><span class="dashboard-panel-kicker">Cobertura</span><h2>Cidades com mais alertas</h2></div>
                    <span class="dashboard-panel-count is-green">{{ cities|length }}</span>
                </header>
                <div class="dashboard-city-grid">
                    {% for city in cities %}
                    <span>
                        <i aria-hidden="true"></i>
                        {{ city.city }} <strong>({{ city.total }})</strong>
                    </span>
                    {% else %}
                    <span><i aria-hidden="true"></i> Dados geográficos ainda não disponíveis</span>
                    {% endfor %}
                </div>
            </section>

            {# Fontes de dados #}
            <section class="dashboard-panel">
                <header class="dashboard-panel-header">
                    <div><span class="dashboard-panel-kicker">Integrações</span><h2>Fontes de dados</h2></div>
                </header>
                <div class="dashboard-source-list">
                    <div>
                        <span>Waze Partner Feed</span>
                        <strong class="dashboard-status {% if stats.total_alerts|default(0) > 0 %}is-active{% endif %}">
                            {{ stats.total_alerts|default(0) > 0 ? 'Ativo' : 'Sem dados' }}
                        </strong>
                    </div>
                    <div>
                        <span>Waze Jams</span>
                        <strong class="dashboard-status {% if stats.total_jams|default(0) > 0 %}is-active{% endif %}">
                            {{ stats.total_jams|default(0) > 0 ? 'Ativo' : 'Sem dados' }}
                        </strong>
                    </div>
                    <div>
                        <span>Estações meteorológicas</span>
                        <strong class="dashboard-status {% if stats.total_weather|default(0) > 0 %}is-active{% endif %}">
                            {{ stats.total_weather|default(0) > 0 ? 'Ativo' : 'Sem dados' }}
                        </strong>
                    </div>
                    <div>
                        <span>Usuários cadastrados</span>
                        <strong>{{ stats.total_users|default(0) }}</strong>
                    </div>
                </div>
            </section>
        </div>

    </div>{# /.dashboard-container #}
</div>{# /.dashboard-page #}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module" src="{{ asset('js/pages/dashboard.js') }}"></script>
{% endblock %}
