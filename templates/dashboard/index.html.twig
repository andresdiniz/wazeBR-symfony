{% extends 'base.html.twig' %}

{% block title %}📊 Dashboard{% endblock %}

{% block body_class %}dashboard-page{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/dashboard.css') }}">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('chart.js') }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
    <script src="{{ asset('js/dashboard.js') }}" defer></script>
{% endblock %}

{% block body %}
    {# Debug do dashboard (remova em produção) #}
    {% if debugData is defined and app.user.hasRole('ROLE_ADMIN') %}
        <details class="dashboard-debug" open>
            <summary>🔍 Debug do Dashboard</summary>
            <pre>{{ debugData|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        </details>
    {% endif %}

    <div class="dashboard-wrapper">
        {# Header do Dashboard #}
        <div class="dashboard-header">
            <div class="dashboard-header-content">
                <div>
                    <h1 class="dashboard-title">📊 Dashboard</h1>
                    <p class="dashboard-subtitle">
                        {{ partnerLabel }} · {{ periods[periodKey].label }}
                    </p>
                </div>

                {# Seletor de Período #}
                <div class="period-selector">
                    {% for key, period in periods %}
                        <a href="{{ path('dashboard_index', {period: key}) }}"
                           class="period-btn {{ key == periodKey ? 'active' : '' }}">
                            {{ period.label }}
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# Stats Cards #}
        <section class="stats-section" data-animate>
            <div class="stats-grid">
                <a href="{{ path('alert_index') }}" class="stat-card stat-card-clickable">
                    <div class="stat-icon stat-icon-alerts">🔔</div>
                    <div class="stat-content">
                        <div class="stat-value">{{ partnerStats.alerts|number_format(0, ',', '.') }}</div>
                        <div class="stat-label">Alertas</div>
                        <div class="stat-trend stat-trend-neutral">
                            <span class="trend-icon">📊</span>
                            <span class="trend-text">Total: {{ hero.alertsTotal }}</span>
                        </div>
                    </div>
                </a>

                <a href="{{ path('jam_index') }}" class="stat-card stat-card-clickable">
                    <div class="stat-icon stat-icon-jams">🚦</div>
                    <div class="stat-content">
                        <div class="stat-value">{{ partnerStats.jams|number_format(0, ',', '.') }}</div>
                        <div class="stat-label">Jams</div>
                        <div class="stat-trend stat-trend-neutral">
                            <span class="trend-icon">📊</span>
                            <span class="trend-text">Total: {{ hero.jamsTotal }}</span>
                        </div>
                    </div>
                </a>

                <a href="{{ path('admin_routes_index') }}" class="stat-card stat-card-clickable">
                    <div class="stat-icon stat-icon-routes">🛣️</div>
                    <div class="stat-content">
                        <div class="stat-value">{{ partnerStats.routes|number_format(0, ',', '.') }}</div>
                        <div class="stat-label">Rotas</div>
                        <div class="stat-trend stat-trend-neutral">
                            <span class="trend-icon">📊</span>
                            <span class="trend-text">Monitoradas</span>
                        </div>
                    </div>
                </a>

                <a href="{{ path('account_link_index') }}" class="stat-card stat-card-clickable">
                    <div class="stat-icon stat-icon-links">🔗</div>
                    <div class="stat-content">
                        <div class="stat-value">{{ partnerStats.monitoredLinks|number_format(0, ',', '.') }}</div>
                        <div class="stat-label">Links</div>
                        <div class="stat-trend stat-trend-neutral">
                            <span class="trend-icon">📊</span>
                            <span class="trend-text">Monitorados</span>
                        </div>
                    </div>
                </a>

                <div class="stat-card">
                    <div class="stat-icon stat-icon-irregularities">⚠️</div>
                    <div class="stat-content">
                        <div class="stat-value">{{ partnerStats.irregularities|number_format(0, ',', '.') }}</div>
                        <div class="stat-label">Irregularidades</div>
                        <div class="stat-trend stat-trend-neutral">
                            <span class="trend-icon">📊</span>
                            <span class="trend-text">No período</span>
                        </div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon stat-icon-cifs">📋</div>
                    <div class="stat-content">
                        <div class="stat-value">{{ partnerStats.cifsEvents|number_format(0, ',', '.') }}</div>
                        <div class="stat-label">Eventos CIFS</div>
                        <div class="stat-trend stat-trend-neutral">
                            <span class="trend-icon">📊</span>
                            <span class="trend-text">No período</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {# Ao Vivo #}
        <section class="live-section" data-animate>
            <div class="section-header">
                <h2 class="section-title">
                    <span class="title-icon">⚡</span>
                    Ao Vivo
                </h2>
                <span class="live-indicator">
                    <span class="live-dot"></span>
                    Atualizado agora
                </span>
            </div>

            <div class="live-grid">
                <div class="live-card">
                    <div class="live-header">
                        <span class="live-icon">🔔</span>
                        <h3>Alertas (24h)</h3>
                    </div>
                    <div class="live-value">{{ hero.alertsLast24h|number_format(0, ',', '.') }}</div>
                    <div class="live-subtext">Total: {{ hero.alertsTotal }}</div>
                </div>

                <div class="live-card">
                    <div class="live-header">
                        <span class="live-icon">🚦</span>
                        <h3>Jams (24h)</h3>
                    </div>
                    <div class="live-value">{{ hero.jamsLast24h|number_format(0, ',', '.') }}</div>
                    <div class="live-subtext">Total: {{ hero.jamsTotal }}</div>
                </div>

                <div class="live-card live-card-highlight">
                    <div class="live-header">
                        <span class="live-icon">🟢</span>
                        <h3>Jams Ativos (3h)</h3>
                    </div>
                    <div class="live-value">{{ hero.jamsLiveTotal|number_format(0, ',', '.') }}</div>
                    <div class="live-subtext">
                        {% if hero.jamsLiveMaxLevel > 0 %}
                            <span class="badge badge-danger">Nível máx: {{ hero.jamsLiveMaxLevel }}</span>
                        {% else %}
                            <span class="text-muted">Sem jams ativos</span>
                        {% endif %}
                    </div>
                </div>

                <div class="live-card">
                    <div class="live-header">
                        <span class="live-icon">🛣️</span>
                        <h3>Rotas</h3>
                    </div>
                    <div class="live-value">{{ hero.routesMonitored|number_format(0, ',', '.') }}</div>
                    <div class="live-subtext">
                        {{ hero.monitoredLinks }} links · {{ hero.monitoredCities }} cidades
                    </div>
                </div>

                <div class="live-card">
                    <div class="live-header">
                        <span class="live-icon">🌧️</span>
                        <h3>CEMADEN</h3>
                    </div>
                    <div class="live-value">{{ hero.cemadenReadings|number_format(0, ',', '.') }}</div>
                    <div class="live-subtext">{{ hero.cemadenCities }} cidade(s)</div>
                </div>

                <div class="live-card">
                    <div class="live-header">
                        <span class="live-icon">📈</span>
                        <h3>Execuções TVT</h3>
                    </div>
                    <div class="live-value">{{ partnerStats.executions|number_format(0, ',', '.') }}</div>
                    <div class="live-subtext">No período</div>
                </div>
            </div>
        </section>

        {# Gráficos #}
        <div class="charts-grid">
            {# Alertas por Subtipo #}
            <section class="chart-section" data-animate>
                <div class="section-header">
                    <h2 class="section-title">
                        <span class="title-icon">📊</span>
                        Alertas por Subtipo
                    </h2>
                    <span class="chart-total">Total: {{ totalAlertsInPeriod }}</span>
                </div>
                <div class="chart-container">
                    {% if alertsBySubtype|length > 0 %}
                        <canvas id="alertsChart" data-chart-type="doughnut" data-chart-data="{{ alertsBySubtype|json_encode }}"></canvas>
                    {% else %}
                        <div class="empty-state">
                            <span class="empty-icon">📊</span>
                            <p>Nenhum alerta no período</p>
                        </div>
                    {% endif %}
                </div>
            </section>

            {# Jams por Nível #}
            <section class="chart-section" data-animate>
                <div class="section-header">
                    <h2 class="section-title">
                        <span class="title-icon">🚦</span>
                        Jams por Nível
                    </h2>
                </div>
                <div class="chart-container">
                    {% if jamsByLevel|length > 0 %}
                        <canvas id="jamsChart" data-chart-type="bar" data-chart-data="{{ jamsByLevel|json_encode }}"></canvas>
                    {% else %}
                        <div class="empty-state">
                            <span class="empty-icon">🚦</span>
                            <p>Nenhum jam no período</p>
                        </div>
                    {% endif %}
                </div>
            </section>
        </div>

        {# Top Ruas #}
        <section class="top-section" data-animate>
            <div class="section-header">
                <h2 class="section-title">
                    <span class="title-icon">🏆</span>
                    Principais Ruas com Jams
                </h2>
            </div>
            <div class="top-list">
                {% if topStreets|length > 0 %}
                    <div class="top-grid">
                        {% for street in topStreets %}
                            <div class="top-item">
                                <div class="top-rank">#{{ loop.index }}</div>
                                <div class="top-content">
                                    <div class="top-name">{{ street.street }}</div>
                                    <div class="top-bar">
                                        <div class="top-bar-fill" style="width: {{ (loop.index0 / topStreets|length * 100)|round }}%"></div>
                                    </div>
                                </div>
                                <div class="top-count">{{ street.count }} jams</div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="empty-state">
                        <span class="empty-icon">🏆</span>
                        <p>Nenhum jam no período</p>
                    </div>
                {% endif %}
            </div>
        </section>

        {# Mapa #}
        <section class="map-section" data-animate>
            <div class="section-header">
                <h2 class="section-title">
                    <span class="title-icon">🗺️</span>
                    Mapa — Jams e Alertas
                </h2>
            </div>
            <div class="map-card">
                <div id="dashboard-map" class="map-container"></div>
                <div class="map-info">
                    <div class="map-stats">
                        <span class="map-stat">
                            <span class="stat-dot stat-dot-jam"></span>
                            {{ mapJams|length }} jams
                        </span>
                        <span class="map-stat">
                            <span class="stat-dot stat-dot-alert"></span>
                            {{ mapAlerts|length }} alertas
                        </span>
                    </div>
                    {% if mapJamsTruncated or mapAlertsTruncated %}
                        <span class="map-note text-warning">
                            ⚠️ Exibindo últimos 100 registros
                        </span>
                    {% endif %}
                </div>
            </div>
        </section>

        {# Alertas e Jams Recentes #}
        <div class="recent-grid">
            {# Alertas Recentes #}
            <section class="recent-section" data-animate>
                <div class="section-header">
                    <h2 class="section-title">
                        <span class="title-icon">🔔</span>
                        Alertas Recentes
                    </h2>
                    <a href="{{ path('alert_index') }}" class="view-all-link">
                        Ver todos
                        <svg class="icon-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>
                </div>
                <div class="recent-content">
                    {% if recentAlerts|length > 0 %}
                        <div class="recent-table-wrapper">
                            <table class="recent-table">
                                <thead>
                                    <tr>
                                        <th>Tipo</th>
                                        <th>Subtipo</th>
                                        <th>Local</th>
                                        <th>Hora</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for alert in recentAlerts %}
                                        <tr>
                                            <td>
                                                <span class="badge badge-primary">{{ alert.type }}</span>
                                            </td>
                                            <td>{{ alert.subtype|default('—') }}</td>
                                            <td class="text-truncate" title="{{ alert.street }}">{{ alert.street }}</td>
                                            <td>{{ alert.createdAt|date('d/m H:i') }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="empty-state">
                            <span class="empty-icon">🔔</span>
                            <p>Nenhum alerta recente</p>
                        </div>
                    {% endif %}
                </div>
            </section>

            {# Jams Recentes #}
            <section class="recent-section" data-animate>
                <div class="section-header">
                    <h2 class="section-title">
                        <span class="title-icon">🚦</span>
                        Lentidões Recentes
                    </h2>
                    <a href="{{ path('jam_index') }}" class="view-all-link">
                        Ver todos
                        <svg class="icon-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>
                </div>
                <div class="recent-content">
                    {% if recentJams|length > 0 %}
                        <div class="recent-table-wrapper">
                            <table class="recent-table">
                                <thead>
                                    <tr>
                                        <th>Via</th>
                                        <th>Cidade</th>
                                        <th>Nível</th>
                                        <th>Hora</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for jam in recentJams %}
                                        <tr>
                                            <td class="text-truncate" title="{{ jam.street }}">{{ jam.street }}</td>
                                            <td>{{ jam.city|default('—') }}</td>
                                            <td>
                                                <span class="jam-level level-{{ jam.level }}">
                                                    {% for i in 1..5 %}
                                                        <span class="level-dot {{ i <= jam.level ? 'active' : '' }}"></span>
                                                    {% endfor %}
                                                </span>
                                            </td>
                                            <td>{{ jam.createdAt|date('d/m H:i') }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="empty-state">
                            <span class="empty-icon">🚦</span>
                            <p>Nenhuma lentidão recente</p>
                        </div>
                    {% endif %}
                </div>
            </section>
        </div>
    </div>

    {# Dados para o JavaScript #}
    <script>
        window.dashboardData = {
            mapCenter: [-20.6597, -43.7817],
            mapZoom: 13,
            mapJams: {{ mapJams|json_encode|raw }},
            mapAlerts: {{ mapAlerts|json_encode|raw }},
            alertsBySubtype: {{ alertsBySubtype|json_encode|raw }},
            jamsByLevel: {{ jamsByLevel|json_encode|raw }},
            topStreets: {{ topStreets|json_encode|raw }},
        };
    </script>
{% endblock %}
