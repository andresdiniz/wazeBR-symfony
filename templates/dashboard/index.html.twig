{% extends 'base.html.twig' %}

{% block active_dashboard %}active{% endblock %}

{% block header_title %}{{ translations.dashboard_title ?? 'Dashboard' }}{% endblock %}

{% block title %}{{ translations.dashboard_title ?? 'Dashboard' }} - {{ partnerLabel }}{% endblock %}

{% block body %}
<style>
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .kpi-card { border-radius: 12px; padding: 20px; color: #fff; box-shadow: 0 2px 8px rgba(15,23,42,0.15); }
    .kpi-card.primary { background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); }
    .kpi-card.success { background: linear-gradient(135deg, #16a34a 0%, #15803d 100%); }
    .kpi-card.warning { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); }
    .kpi-card.danger { background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%); }
    .kpi-value { font-size: 2rem; font-weight: 700; margin: 8px 0; }
    .kpi-label { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.9; }
    .chart-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 24px; }
    .chart-row-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 24px; }
    .chart-wrapper { background: #fff; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(15,23,42,0.08); }
    #map { height: 450px; border-radius: 12px; box-shadow: 0 2px 8px rgba(15,23,42,0.08); }
    .map-legend { background: #fff; padding: 8px 12px; border-radius: 8px; box-shadow: 0 2px 8px rgba(15,23,42,0.15); font-size: 0.85rem; }
    .legend-item { display: flex; align-items: center; gap: 8px; margin: 4px 0; }
    .legend-color { width: 16px; height: 16px; border-radius: 3px; }
</style>

<p class="text-muted mb-4">{{ translations.visao_geral ?? 'Visao geral dos dados monitorados para' }} {{ partnerLabel }}.</p>

<div class="stats-grid">
    <div class="kpi-card primary">
        <div class="kpi-label">{{ translations.alertas_1h ?? 'Alertas 1h' }}</div>
        <div class="kpi-value">{{ kpis.alerts1h }}</div>
        <small>{{ translations.jams_ao_vivo ?? 'Jams ao vivo' }}: {{ kpis.liveJams }}</small>
    </div>
    <div class="kpi-card success">
        <div class="kpi-label">{{ translations.cifs_ativos ?? 'CIFS ativos' }}</div>
        <div class="kpi-value">{{ kpis.cifsActiveCount }}</div>
        <small>{{ translations.secoes_ativas ?? 'Seç©§es ativas' }}</small>
    </div>
    <div class="kpi-card warning">
        <div class="kpi-label">{{ translations.alertas_total ?? 'Alertas (total)' }}</div>
        <div class="kpi-value">{{ kpis.alerts }}</div>
        <small>24h {{ kpis.alerts24h }} · 7d {{ kpis.alerts7d }}</small>
    </div>
    <div class="kpi-card danger">
        <div class="kpi-label">{{ translations.jams_total ?? 'Jams (total)' }}</div>
        <div class="kpi-value">{{ kpis.jams }}</div>
        <small>24h {{ kpis.jams24h }} · 7d {{ kpis.jams7d }}</small>
    </div>
    <div class="kpi-card primary">
        <div class="kpi-label">{{ translations.cidades ?? 'Cidades' }}</div>
        <div class="kpi-value">{{ (cities|length) ?: 0 }}</div>
        <small>{{ translations.links ?? 'Links' }} {{ (links|length) ?: 0 }} · {{ translations.rotas ?? 'Rotas' }} {{ (routes|length) ?: 0 }}</small>
    </div>
    <div class="kpi-card success">
        <div class="kpi-label">{{ translations.irregularidades ?? 'Irregularidades' }}</div>
        <div class="kpi-value">{{ kpis.irregularities }}</div>
        <small>{{ translations.secoes_ativas ?? 'Seç©§es ativas' }}</small>
    </div>
</div>

<div class="chart-row-3">
    <div class="chart-wrapper">
        <h5>{{ translations.alertas_por_tipo ?? 'Alertas por tipo (24h)' }}</h5>
        <canvas id="alerts-by-type-chart" height="200"></canvas>
    </div>
    <div class="chart-wrapper">
        <h5>{{ translations.jams_por_nivel ?? 'Jams por n\u00edvel (24h)' }}</h5>
        <canvas id="jams-by-level-chart" height="200"></canvas>
    </div>
    <div class="chart-wrapper">
        <h5>{{ translations.qualidade_dos_alertas ?? 'Qualidade dos alertas (24h)' }}</h5>
        <div class="mt-3">
            <h6>{{ translations.confiabilidade_media ?? 'Confiabilidade m\u00e9dia (reliability)' }}</h6>
            <div class="progress mb-3" style="height: 24px;">
                <div class="progress-bar bg-primary" style="width: {{ kpis.avgReliability }}%">{{ kpis.avgReliability|number_format(1) }}%</div>
            </div>
            <h6>{{ translations.confianca_media ?? 'Confian\u00e7a m\u00e9dia (confidence)' }}</h6>
            <div class="progress mb-3" style="height: 24px;">
                <div class="progress-bar bg-success" style="width: {{ kpis.avgConfidence }}%">{{ kpis.avgConfidence|number_format(1) }}%</div>
            </div>
        </div>
    </div>
</div>

<div class="chart-row">
    <div class="chart-wrapper">
        <h5>{{ translations.mapa_alertas_jams ?? 'Mapa de Alertas e Jams (recentes)' }}</h5>
        <div id="map"></div>
        <div class="mt-2 map-legend">
            <strong>{{ translations.niveis_jam ?? 'N\u00edveis de Jam' }}:</strong>
            <div class="legend-item"><span class="legend-color" style="background:#94a3b8"></span> N0</div>
            <div class="legend-item"><span class="legend-color" style="background:#22c55e"></span> N1</div>
            <div class="legend-item"><span class="legend-color" style="background:#eab308"></span> N2</div>
            <div class="legend-item"><span class="legend-color" style="background:#f97316"></span> N3</div>
            <div class="legend-item"><span class="legend-color" style="background:#ef4444"></span> N4</div>
            <div class="legend-item"><span class="legend-color" style="background:#7f1d1d"></span> N5 (Interdi\u00e7\u00e3o)</div>
        </div>
    </div>
</div>

<div class="chart-row">
    <div class="chart-wrapper">
        <h5>{{ translations.alertas_por_hora ?? 'Alertas por hora (u\u00faltimas 24h)' }}</h5>
        <canvas id="alerts-per-hour-chart" height="160"></canvas>
    </div>
    <div class="chart-wrapper">
        <h5>{{ translations.jams_por_hora ?? 'Jams por hora (u\u00faltimas 24h)' }}</h5>
        <canvas id="jams-per-hour-chart" height="160"></canvas>
    </div>
</div>

<div class="card">
    <div class="card-header">{{ translations.wazecount_semana ?? 'WazeCount — Semana' }}</div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6"><strong>{{ translations.esta_semana ?? 'Esta semana' }}:</strong> {{ kpis.wazeCount ?? '—' }}</div>
            <div class="col-md-6"><strong>{{ translations.semana_passada ?? 'Semana passada' }}:</strong> {{ kpis.wazeCountLastWeek ?? '—' }}</div>
        </div>
        <h6>{{ translations.picos_por_nivel ?? 'Picos por n\u00edvel de jam (max)' }}</h6>
        <ul class="list-unstyled">
            <li>{{ translations.nivel_0 ?? 'Nivel 0' }}: {{ kpis.wazeCountPeak.max_level0 ?? 0 }}</li>
            <li>{{ translations.nivel_1 ?? 'Nivel 1' }}: {{ kpis.wazeCountPeak.max_level1 ?? 0 }}</li>
            <li>{{ translations.nivel_2 ?? 'Nivel 2' }}: {{ kpis.wazeCountPeak.max_level2 ?? 0 }}</li>
            <li>{{ translations.nivel_3 ?? 'Nivel 3' }}: {{ kpis.wazeCountPeak.max_level3 ?? 0 }}</li>
            <li>{{ translations.nivel_4 ?? 'Nivel 4' }}: {{ kpis.wazeCountPeak.max_level4 ?? 0 }}</li>
            <li><strong>{{ translations.total_max ?? 'Total (max)' }}: {{ kpis.wazeCountPeak.max_total ?? 0 }}</strong></li>
        </ul>
    </div>
</div>

<div class="card">
    <div class="card-header">{{ translations.eventos_via ?? 'Eventos de Via (CIFS)' }}</div>
    <div class="card-body">
        {% if cifsActive|length > 0 %}
            <div class="alert alert-info">{{ cifsActive|length }} {{ translations.ativos ?? 'ativos' }}</div>
        {% else %}
            <div class="alert alert-warning">{{ translations.nenhum_evento_ativo ?? 'Nenhum evento ativo.' }}</div>
        {% endif %}
        <h6>{{ translations.proximos_7_dias ?? 'Pr\u00f3ximos 7 dias' }}</h6>
        {% if cifsUpcoming|length > 0 %}
            <ul class="list-unstyled">
                {% for event in cifsUpcoming|slice(0,5) %}
                    <li>{{ event.title ?? 'Evento' }} - {{ event.start ?? '' }}</li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">{{ translations.nenhum_evento_programado ?? 'Nenhum evento programado.' }}</p>
        {% endif %}
    </div>
</div>

<div class="card">
    <div class="card-header">{{ translations.irregularidades_trafego ?? 'Irregularidades de Tr\u00e1fego' }}</div>
    <div class="card-body">
        {% if irregRecentList|length > 0 %}
            <div class="alert alert-success">{{ irregRecentList|length }} {{ translations.recentes ?? 'recentes' }}</div>
        {% else %}
            <div class="alert alert-warning">{{ translations.sem_irregularidades ?? 'Sem irregularidades recentes.' }}</div>
        {% endif %}

        <h6>{{ translations.maior_perda_velocidade ?? 'Maior Perda de Velocidade (24h)' }}</h6>
        {% if irregSpeedLoss|length > 0 %}
            <canvas id="speed-loss-chart" height="160"></canvas>
        {% else %}
            <p class="text-muted">{{ translations.sem_dados ?? 'Sem dados de irregularidade.' }}</p>
        {% endif %}

        <h6 class="mt-3">{{ translations.atraso_acumulado ?? 'Atraso Acumulado por Via (24h)' }}</h6>
        {% if irregDelayByStreet|length > 0 %}
            <canvas id="delay-street-chart" height="160"></canvas>
        {% else %}
            <p class="text-muted">{{ translations.sem_dados_atraso ?? 'Sem dados de atraso.' }}</p>
        {% endif %}
    </div>
</div>

<div class="card">
    <div class="card-header">{{ translations.alertas_recentes ?? 'Alertas recentes' }}</div>
    <div class="card-body">
        {% if recentAlerts|length > 0 %}
            <ul class="list-unstyled">
                {% for alert in recentAlerts|slice(0,5) %}
                    <li>{{ alert.type }} - {{ alert.city ?? '' }} {{ alert.street ?? '' }}</li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">{{ translations.sem_alertas ?? 'Sem alertas recentes.' }}</p>
        {% endif %}
    </div>
</div>

<div class="card">
    <div class="card-header">{{ translations.jams_recentes ?? 'Jams recentes' }}</div>
    <div class="card-body">
        {% if recentJams|length > 0 %}
            <ul class="list-unstyled">
                {% for jam in recentJams|slice(0,5) %}
                    <li>{{ translations.nivel ?? 'N\u00edvel' }} {{ jam.level }} - {{ jam.city ?? '' }} {{ jam.street ?? '' }}</li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-muted">{{ translations.sem_jams ?? 'Sem jams recentes.' }}</p>
        {% endif %}
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
(function() {
    const translations = {{ translations|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
    const locale = {{ locale|json_encode|raw }};

    // Cores Waze para niveis de jam
    const jamLevelColors = {
        0: '#94a3b8',
        1: '#22c55e',
        2: '#eab308',
        3: '#f97316',
        4: '#ef4444',
        5: '#7f1d1d',
    };

    // Cores para alertas por tipo (mesmas do grafico de barras)
    const alertTypeColors = {
        'ACCIDENT': '#ef4444',
        'HAZARD': '#f59e0b',
        'JAM': '#3b82f6',
        'WEATHERHAZARD': '#10b981',
        'ROAD_CLOSED': '#8b5cf6',
        'CONSTRUCTION': '#6b7280',
        'MISC': '#64748b',
    };

    // --- GRÁ¦FICOS ---

    // Alerts por tipo (barras)
    (function() {
        const ctx = document.getElementById('alerts-by-type-chart');
        if (!ctx) return;

        const raw = {{ alertsByType|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
        const typesMap = {{ typesMap|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};

        const labels = raw.map(r => typesMap[r.type] ?? r.type);
        const data = raw.map(r => r.total);
        const bgColors = raw.map(r => alertTypeColors[r.type] ?? '#6b7280');
        const borderColors = raw.map(r => alertTypeColors[r.type] ?? '#6b7280');

        if (labels.length === 0) return;

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: translations.alertas ?? 'Alertas',
                    data: data,
                    backgroundColor: bgColors,
                    borderColor: borderColors,
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, ticks: { stepSize: 1 } }
                }
            }
        });
    })();

    // Jams por n\u00edvel (barras, cores Waze)
    (function() {
        const ctx = document.getElementById('jams-by-level-chart');
        if (!ctx) return;

        const raw = {{ jamsByLevel|json_encode|raw }};
        const labels = raw.map(r => (translations.nivel ?? 'N') + r.level + (r.level === 5 ? ' (Interdi\u00e7\u00e3o)' : ''));
        const data = raw.map(r => r.total);
        const bgColors = raw.map(r => jamLevelColors[r.level] ?? '#ef4444');
        const borderColors = raw.map(r => jamLevelColors[r.level] ?? '#ef4444');

        if (labels.length === 0) return;

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: translations.jams ?? 'Jams',
                    data: data,
                    backgroundColor: bgColors,
                    borderColor: borderColors,
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, ticks: { stepSize: 1 } }
                }
            }
        });
    })();

    // Alerts por hora
    (function() {
        const ctx = document.getElementById('alerts-per-hour-chart');
        if (!ctx) return;

        const labels = {{ alertsPerHourLabels|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
        const data = {{ alertsPerHourData|json_encode|raw }};

        if (!labels || labels.length === 0) return;

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: translations.alertas_por_hora ?? 'Alertas por hora',
                    data: data,
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37, 99, 235, 0.15)',
                    tension: 0.3,
                    fill: true,
                    pointRadius: 3,
                    pointBackgroundColor: '#2563eb'
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, ticks: { stepSize: 1 } }
                }
            }
        });
    })();

    // Jams por hora
    (function() {
        const ctx = document.getElementById('jams-per-hour-chart');
        if (!ctx) return;

        const labels = {{ jamsPerHourLabels|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
        const data = {{ jamsPerHourData|json_encode|raw }};

        if (!labels || labels.length === 0) return;

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: translations.jams_por_hora ?? 'Jams por hora',
                    data: data,
                    borderColor: '#f59e0b',
                    backgroundColor: 'rgba(245, 158, 11, 0.15)',
                    tension: 0.3,
                    fill: true,
                    pointRadius: 3,
                    pointBackgroundColor: '#f59e0b'
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, ticks: { stepSize: 1 } }
                }
            }
        });
    })();

    // Perda de velocidade (barras)
    (function() {
        const ctx = document.getElementById('speed-loss-chart');
        if (!ctx) return;

        const raw = {{ irregSpeedLoss|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
        const labels = raw.map(r => (r.street ?? 'Via') + (r.city ? ' (' + r.city + ')' : ''));
        const data = raw.map(r => r.loss);

        if (labels.length === 0) return;

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: translations.perda_velocidade_kmh ?? 'Perda (km/h)',
                    data: data,
                    backgroundColor: 'rgba(239, 68, 68, 0.7)',
                    borderColor: '#ef4444',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true }
                }
            }
        });
    })();

    // Atraso acumulado por via (barras)
    (function() {
        const ctx = document.getElementById('delay-street-chart');
        if (!ctx) return;

        const raw = {{ irregDelayByStreet|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
        const labels = raw.map(r => (r.street ?? 'Via') + (r.city ? ' (' + r.city + ')' : ''));
        const data = raw.map(r => r.delay);

        if (labels.length === 0) return;

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: translations.atraso_min ?? 'Atraso (min)',
                    data: data,
                    backgroundColor: 'rgba(59, 130, 246, 0.7)',
                    borderColor: '#3b82f6',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true }
                }
            }
        });
    })();

    // --- MAPA LEAFLET ---
    (function() {
        const mapEl = document.getElementById('map');
        if (!mapEl) return;

        const map = L.map('map').setView([-20.66, -43.81], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: 'OpenStreetMap'
        }).addTo(map);

        const recentAlerts = {{ recentAlerts|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
        const recentJams = {{ recentJams|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};

        // Alertas: cores do grafico de barras
        recentAlerts.forEach(a => {
            if (!a.latitude || !a.longitude) return;
            const color = alertTypeColors[a.type] ?? '#6b7280';
            L.circleMarker([a.latitude, a.longitude], {
                radius: 7,
                color: color,
                fillColor: color,
                fillOpacity: 0.7
            }).addTo(map)
              .bindPopup(`<strong>${a.type}</strong><br>${a.city ?? ''} ${a.street ?? ''}`);
        });

        // Jams: polilines com todas as coordenadas, cores por nivel
        recentJams.forEach(j => {
            if (!j.line || !Array.isArray(j.line) || j.line.length === 0) return;

            // j.line eh [[lon,lat], [lon,lat], ...]
            const coords = j.line.map(p => [p[1], p[0]]);
            const color = jamLevelColors[j.level] ?? '#ef4444';

            L.polyline(coords, {
                color: color,
                weight: 5,
                opacity: 0.9
            }).addTo(map)
             .bindPopup(`<strong>${translations.jam ?? 'Jam'} N${j.level}${j.level === 5 ? ' (Interdi\u00e7\u00e3o)' : ''}</strong><br>${j.city ?? ''} ${j.street ?? ''}`);
        });
    })();
})();
</script>
{% endblock %}
