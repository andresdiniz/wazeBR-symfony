{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Dashboard | WazeBR{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/pages/dashboard.css') }}">
{% endblock %}

{% block content %}
{% set alerts = stats.recent_alerts|default([]) %}
{% set jams = stats.recent_jams|default([]) %}
{% set routes = stats.recent_routes|default([]) %}
<div class="dashboard-page" data-dashboard data-alerts='{{ alerts|json_encode|e('html_attr') }}' data-jams='{{ jams|json_encode|e('html_attr') }}'>
    <div class="dashboard-container">
        <header class="dashboard-page-header">
            <div><span class="dashboard-eyebrow"><i></i> Centro operacional</span><h1>Visão geral da mobilidade</h1><p>Trânsito, alertas, rotas e condições operacionais em um só lugar.</p></div>
            <div class="dashboard-header-tools"><span class="dashboard-last-update"><i></i> <time data-dashboard-clock>agora</time></span><button type="button" class="dashboard-button is-secondary" data-action="refresh-dashboard"><span>↻</span> Atualizar</button></div>
        </header>

        <section class="dashboard-filter-panel" aria-label="Filtros do dashboard">
            <div class="dashboard-filter-heading"><div><span class="dashboard-panel-kicker">Explorar dados</span><h2>Filtros e navegação</h2></div><button type="button" class="dashboard-button is-link" data-action="clear-filters">Limpar filtros</button></div>
            <div class="dashboard-filter-form">
                <label class="dashboard-filter-field"><span>Período</span><select data-filter="period"><option value="all">Todos os registros</option><option value="today">Hoje</option><option value="week">Últimos 7 dias</option><option value="month">Últimos 30 dias</option></select></label>
                <label class="dashboard-filter-field"><span>Buscar ocorrência</span><input type="search" data-filter="query" placeholder="Tipo, rua, cidade ou rota"></label>
                <label class="dashboard-filter-field"><span>Seção</span><select data-filter="section"><option value="all">Todas</option><option value="alerts">Alertas</option><option value="jams">Congestionamentos</option><option value="routes">Rotas</option></select></label>
                <div class="dashboard-filter-actions"><button type="button" class="dashboard-button is-primary" data-action="apply-filters">Aplicar filtros</button><button type="button" class="dashboard-button is-secondary" data-action="clear-filters">Limpar</button></div>
            </div>
            <p class="dashboard-filter-feedback" data-filter-feedback aria-live="polite"></p>
        </section>

        <section class="dashboard-kpi-grid" aria-label="Indicadores principais">
            <article class="dashboard-kpi-card kpi-blue"><div class="dashboard-kpi-top"><span class="dashboard-kpi-icon">⚠</span><span class="dashboard-kpi-trend">Monitoramento</span></div><strong class="dashboard-kpi-value" data-count-value="{{ stats.total_alerts|default(0) }}">{{ stats.total_alerts|default(0) }}</strong><span class="dashboard-kpi-label">Alertas registrados</span><div class="dashboard-kpi-footer"><span>Base Waze</span><span>→</span></div></article>
            <article class="dashboard-kpi-card kpi-orange"><div class="dashboard-kpi-top"><span class="dashboard-kpi-icon">≋</span><span class="dashboard-kpi-trend is-warning">Atenção</span></div><strong class="dashboard-kpi-value" data-count-value="{{ stats.total_jams|default(0) }}">{{ stats.total_jams|default(0) }}</strong><span class="dashboard-kpi-label">Congestionamentos</span><div class="dashboard-kpi-footer"><span>Ocorrências viárias</span><span>→</span></div></article>
            <article class="dashboard-kpi-card kpi-green"><div class="dashboard-kpi-top"><span class="dashboard-kpi-icon">✓</span><span class="dashboard-kpi-trend is-positive">Ativo</span></div><strong class="dashboard-kpi-value" data-count-value="{{ stats.total_weather|default(0) }}">{{ stats.total_weather|default(0) }}</strong><span class="dashboard-kpi-label">Observações climáticas</span><div class="dashboard-kpi-footer"><span>Estações monitoradas</span><span>→</span></div></article>
            <article class="dashboard-kpi-card kpi-purple"><div class="dashboard-kpi-top"><span class="dashboard-kpi-icon">◎</span><span class="dashboard-kpi-trend is-positive">Conectado</span></div><strong class="dashboard-kpi-value" data-count-value="{{ stats.total_partners|default(0) }}">{{ stats.total_partners|default(0) }}</strong><span class="dashboard-kpi-label">Parceiros ativos</span><div class="dashboard-kpi-footer"><span>Integrações disponíveis</span><span>→</span></div></article>
        </section>

        <div class="dashboard-main-grid">
            <section class="dashboard-panel"><header class="dashboard-panel-header"><div><span class="dashboard-panel-kicker">Indicadores</span><h2>Atividade operacional</h2></div><span class="dashboard-panel-period">Tempo real</span></header><div class="dashboard-chart" data-dashboard-line-chart><div class="dashboard-chart-y"><span>100</span><span>75</span><span>50</span><span>25</span><span>0</span></div><div class="dashboard-chart-area"><div class="dashboard-chart-grid"></div><svg viewBox="0 0 700 220" preserveAspectRatio="none" aria-label="Gráfico de atividade"><defs><linearGradient id="dashboardChartFill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#2563eb" stop-opacity=".2"/><stop offset="1" stop-color="#2563eb" stop-opacity="0"/></linearGradient></defs><path class="dashboard-chart-fill" data-chart-fill></path><path class="dashboard-chart-line" data-chart-line></path></svg><div class="dashboard-chart-x"><span>Início</span><span>25%</span><span>50%</span><span>75%</span><span>Atual</span></div></div></div><div class="dashboard-chart-legend"><span><i class="legend-blue"></i> Ocorrências registradas</span><strong>{{ (stats.total_alerts|default(0)) + (stats.total_jams|default(0)) }} no total</strong></div></section>
            <section class="dashboard-panel"><header class="dashboard-panel-header"><div><span class="dashboard-panel-kicker">Status</span><h2>Saúde da operação</h2></div><span class="dashboard-health-badge"><i></i> Online</span></header><div class="dashboard-health-score"><div class="dashboard-health-ring" style="--health-score:92"><span>92<small>%</small></span></div><div><strong>Operação estável</strong><p>Fontes de dados disponíveis e monitoradas.</p></div></div><div class="dashboard-health-list"><div><span><i class="health-green"></i> Waze Alerts</span><strong>Operacional</strong></div><div><span><i class="health-blue"></i> Waze Jams</span><strong>Operacional</strong></div><div><span><i class="health-gray"></i> Rotas e snapshots</span><strong>{{ routes|length }} rotas</strong></div></div></section>
        </div>

        <div class="dashboard-content-grid">
            <section class="dashboard-panel data-section" data-section="alerts"><header class="dashboard-panel-header"><div><span class="dashboard-panel-kicker">Tempo real</span><h2>Alertas recentes</h2></div><span class="dashboard-panel-count is-orange">{{ alerts|length }}</span></header><div class="dashboard-data-list" data-list="alerts">{% for alert in alerts %}<div class="dashboard-data-row" data-search-text="{{ (alert.type|default('') ~ ' ' ~ alert.subtype|default('') ~ ' ' ~ alert.city|default(''))|lower }}"><span class="dashboard-row-icon row-orange">⚠</span><div><strong>{{ alert.type|default('Alerta de trânsito') }}</strong><small>#{{ alert.id }} · {{ alert.subtype|default('Subtipo não informado') }} · {{ alert.city|default('Local não informado') }}</small></div><time>{{ alert.pubDateTime ? alert.pubDateTime|date('d/m H:i') : '—' }}</time><span class="dashboard-severity">Atenção</span></div>{% else %}<div class="dashboard-empty"><span>✓</span><strong>Nenhum alerta recente</strong><small>A operação está sem novos alertas.</small></div>{% endfor %}</div><div class="dashboard-pagination" data-pagination="alerts"></div><button type="button" class="dashboard-button is-link dashboard-expand" data-expand="alerts">Ver todos os alertas →</button></section>
            <section class="dashboard-panel data-section" data-section="jams"><header class="dashboard-panel-header"><div><span class="dashboard-panel-kicker">Trânsito</span><h2>Congestionamentos</h2></div><span class="dashboard-panel-count is-orange">{{ jams|length }}</span></header><div class="dashboard-data-list" data-list="jams">{% for jam in jams %}<div class="dashboard-data-row" data-search-text="{{ (jam.street|default('') ~ ' ' ~ jam.city|default(''))|lower }}"><span class="dashboard-row-icon row-orange">≋</span><div><strong>{{ jam.street|default('Via não informada') }}</strong><small>{{ jam.city|default('Local não informado') }} · {{ jam.speedKmh|default(0) }} km/h</small></div><span class="dashboard-severity">{{ jam.levelLabel|default('Atenção') }}</span></div>{% else %}<div class="dashboard-empty"><span>✓</span><strong>Nenhum congestionamento</strong><small>Não há ocorrências viárias recentes.</small></div>{% endfor %}</div><div class="dashboard-pagination" data-pagination="jams"></div><button type="button" class="dashboard-button is-link dashboard-expand" data-expand="jams">Ver todos os congestionamentos →</button></section>
            <section class="dashboard-panel data-section" data-section="routes"><header class="dashboard-panel-header"><div><span class="dashboard-panel-kicker">Rotas monitoradas</span><h2>Maior atraso por rota</h2></div><span class="dashboard-panel-count is-orange">{{ routes|length }}</span></header><div class="dashboard-data-list" data-list="routes">{% for route in routes %}<div class="dashboard-data-row" data-search-text="{{ (route.name|default('') ~ ' ' ~ route.city|default('') ~ ' ' ~ route.waze_route_id|default(''))|lower }}"><span class="dashboard-row-icon row-orange">→</span><div><strong>{{ route.name|default('Rota monitorada') }}</strong><small>{{ route.city|default('Local não informado') }}{% if route.state %}/{{ route.state }}{% endif %} · atual {{ route.time|default('—') }}s · histórico {{ route.historic_time|default('—') }}s</small></div><span class="dashboard-severity">{% if route.delay_minutes is not null %}+{{ route.delay_minutes }} min{% else %}{{ route.jam_level|default('Sem atraso') }}{% endif %}</span></div>{% else %}<div class="dashboard-empty"><span>✓</span><strong>Nenhuma rota encontrada</strong><small>Não há snapshots vinculados às rotas.</small></div>{% endfor %}</div><div class="dashboard-pagination" data-pagination="routes"></div><button type="button" class="dashboard-button is-link dashboard-expand" data-expand="routes">Ver todas as rotas →</button></section>
        </div>

        <div class="dashboard-bottom-grid"><section class="dashboard-panel"><header class="dashboard-panel-header"><div><span class="dashboard-panel-kicker">Cobertura</span><h2>Cidades monitoradas</h2></div><span class="dashboard-panel-count is-green">Ativo</span></header><div class="dashboard-city-grid"><span><i></i>Dados geográficos disponíveis no mapa</span></div></section><section class="dashboard-panel"><header class="dashboard-panel-header"><div><span class="dashboard-panel-kicker">Integrações</span><h2>Fontes de dados</h2></div></header><div class="dashboard-source-list"><div><span>Waze Partner Feed</span><strong class="dashboard-status is-active">Ativo</strong></div><div><span>Estações meteorológicas</span><strong class="dashboard-status is-active">Ativo</strong></div><div><span>Usuários cadastrados</span><strong>{{ stats.total_users|default(0) }}</strong></div></div></section></div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module" src="{{ asset('js/pages/dashboard.js') }}"></script>
{% endblock %}
