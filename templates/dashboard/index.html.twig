{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block page_name %}dashboard{% endblock %}

{% block content %}
<div class="dashboard">
    <!-- Dashboard Header -->
    <div class="dashboard-header">
        <div class="page-title-wrapper">
            <div>
                <h1 class="page-title">Dashboard</h1>
                <p class="page-subtitle">Visã££o geral do monitoramento em tempo real</p>
            </div>
            <div class="dashboard-actions">
                <button class="btn btn-outline-secondary" id="refreshDashboard">
                    <i class="bi bi-arrow-clockwise"></i>
                    Atualizar
                </button>
                <div class="btn-group">
                    <button class="btn btn-primary" data-bs-toggle="dropdown">
                        <i class="bi bi-plus-lg"></i>
                        Novo
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="{{ path('alert_new') }}"><i class="bi bi-exclamation-triangle me-2"></i>Alerta</a></li>
                        <li><a class="dropdown-item" href="{{ path('traffic_jam_new') }}"><i class="bi bi-sign-merge-right me-2"></i>Congestionamento</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('cemaden_index') }}"><i class="bi bi-cloud-rain me-2"></i>CEMADEN</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Stats Grid -->
    <div class="stats-grid">
        <!-- Alerts Card -->
        <div class="widget stats-card">
            <div class="stats-card-icon danger">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div class="stats-card-content">
                <div class="stats-card-label">Alertas Ativos</div>
                <div class="stats-card-value">{{ stats.alerts|default(0) }}</div>
                <div class="stats-card-change {% if stats.alerts_change|default(0) >= 0 %}negative{% else %}positive{% endif %}">
                    <i class="bi bi-arrow-{{ stats.alerts_change|default(0) >= 0 ? 'up' : 'down' }}"></i>
                    {{ stats.alerts_change|default(0)|abs }}%
                </div>
            </div>
        </div>
        
        <!-- Traffic Jams Card -->
        <div class="widget stats-card">
            <div class="stats-card-icon warning">
                <i class="bi bi-sign-merge-right-fill"></i>
            </div>
            <div class="stats-card-content">
                <div class="stats-card-label">Congestionamentos</div>
                <div class="stats-card-value">{{ stats.traffic_jams|default(0) }}</div>
                <div class="stats-card-change {% if stats.traffic_change|default(0) >= 0 %}negative{% else %}positive{% endif %}">
                    <i class="bi bi-arrow-{{ stats.traffic_change|default(0) >= 0 ? 'up' : 'down' }}"></i>
                    {{ stats.traffic_change|default(0)|abs }}%
                </div>
            </div>
        </div>
        
        <!-- Hydro Stations Card -->
        <div class="widget stats-card">
            <div class="stats-card-icon info">
                <i class="bi bi-droplet-fill"></i>
            </div>
            <div class="stats-card-content">
                <div class="stats-card-label">Estaçµµ Hidro</div>
                <div class="stats-card-value">{{ stats.hydro_stations|default(0) }}</div>
                <div class="stats-card-change positive">
                    <i class="bi bi-check-lg"></i>
                    {{ stats.hydro_active|default(0) }} ativas
                </div>
            </div>
        </div>
        
        <!-- CEMADEN Card -->
        <div class="widget stats-card">
            <div class="stats-card-icon primary">
                <i class="bi bi-cloud-rain-fill"></i>
            </div>
            <div class="stats-card-content">
                <div class="stats-card-label">Estaçµµ CEMADEN</div>
                <div class="stats-card-value">{{ stats.cemaden_stations|default(0) }}</div>
                <div class="stats-card-change positive">
                    <i class="bi bi-cloud-check"></i>
                    {{ stats.cemaden_online|default(0) }} online
                </div>
            </div>
        </div>
    </div>
    
    <!-- Dashboard Grid -->
    <div class="dashboard-grid">
        <!-- Map Widget -->
        <div class="widget dashboard-col-8">
            <div class="widget-header">
                <h3 class="widget-title">
                    <i class="bi bi-map widget-title-icon"></i>
                    Mapa de Monitoramento
                </h3>
                <div class="widget-actions">
                    <button class="btn btn-sm btn-outline-secondary" id="mapFullscreen">
                        <i class="bi bi-arrows-fullscreen"></i>
                    </button>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown">
                            <i class="bi bi-layers"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#" data-layer="alerts"><i class="bi bi-exclamation-triangle me-2"></i>Alertas</a></li>
                            <li><a class="dropdown-item" href="#" data-layer="traffic"><i class="bi bi-sign-merge-right me-2"></i>Trâ®®ego</a></li>
                            <li><a class="dropdown-item" href="#" data-layer="hydro"><i class="bi bi-droplet me-2"></i>Hidro</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#" data-layer="all"><i class="bi bi-check-all me-2"></i>Todos</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="widget-body p-0">
                <div id="dashboard-map" class="map-widget"></div>
            </div>
        </div>
        
        <!-- Recent Alerts -->
        <div class="widget dashboard-col-4">
            <div class="widget-header">
                <h3 class="widget-title">
                    <i class="bi bi-bell"></i>
                    Alertas Recentes
                </h3>
                <a href="{{ path('alert_index') }}" class="btn btn-sm btn-link">
                    Ver todos
                </a>
            </div>
            <div class="widget-body alerts-widget">
                {% for alert in recent_alerts|default([]) %}
                <div class="alert-item">
                    <div class="alert-item-icon {{ alert.type|default('warning') }}">
                        <i class="bi bi-{{ alert.icon|default('exclamation-triangle') }}"></i>
                    </div>
                    <div class="alert-item-content">
                        <div class="alert-item-title">{{ alert.title|truncate(40) }}</div>
                        <div class="alert-item-location">
                            <i class="bi bi-geo-alt"></i>
                            {{ alert.location|truncate(30) }}
                        </div>
                        <div class="alert-item-time">
                            <i class="bi bi-clock"></i>
                            {{ alert.createdAt|date('H:i') }}
                        </div>
                    </div>
                </div>
                {% else %}
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-check-circle" style="font-size: 3rem;"></i>
                    <p class="mt-3 mb-0">Nenhum alerta recente</p>
                </div>
                {% endfor %}
            </div>
        </div>
        
        <!-- Traffic Chart -->
        <div class="widget dashboard-col-6">
            <div class="widget-header">
                <h3 class="widget-title">
                    <i class="bi bi-graph-up"></i>
                    Evoluçª£o do Trâ®®ego
                </h3>
                <div class="widget-actions">
                    <div class="time-range">
                        <button class="time-range-btn active" data-range="24h">24h</button>
                        <button class="time-range-btn" data-range="7d">7d</button>
                        <button class="time-range-btn" data-range="30d">30d</button>
                    </div>
                </div>
            </div>
            <div class="widget-body">
                <div class="chart-container">
                    <canvas id="trafficChart"></canvas>
                </div>
            </div>
        </div>
        
        <!-- Activity Feed -->
        <div class="widget dashboard-col-6">
            <div class="widget-header">
                <h3 class="widget-title">
                    <i class="bi bi-activity"></i>
                    Atividade Recente
                </h3>
            </div>
            <div class="widget-body">
                <div class="activity-feed">
                    {% for activity in recent_activities|default([]) %}
                    <div class="activity-item">
                        <div class="activity-item-time">{{ activity.createdAt|date('H:i') }}</div>
                        <div class="activity-item-title">{{ activity.description|truncate(60) }}</div>
                        {% if activity.user %}
                        <div class="activity-item-text">
                            <i class="bi bi-person"></i>
                            {{ activity.user.username }}
                        </div>
                        {% endif %}
                    </div>
                    {% else %}
                    <div class="text-center py-4 text-muted">
                        <p class="mb-0">Nenhuma atividade recente</p>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
// Dashboard initialization
import { initDashboard } from '../../js/pages/dashboard.js';

document.addEventListener('DOMContentLoaded', () => {
  initDashboard({
    mapElement: 'dashboard-map',
    chartElement: 'trafficChart',
    endpoints: {
      alerts: '{{ path('api_alerts_list') }}',
      traffic: '{{ path('api_traffic_list') }}',
      hydro: '{{ path('api_hydro_list') }}',
    }
  });
});
</script>
{% endblock %}
