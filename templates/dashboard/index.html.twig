{% extends 'base.html.twig' %}

{% block title %}Dashboard - WazeBR{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --db-bg: rgba(14,13,24,0.92);
            --db-border: rgba(255,255,255,0.06);
            --db-shadow: 0 18px 40px rgba(0,0,0,0.45);
            --db-text: #f7f1e8;
            --db-muted: rgba(244,239,232,0.78);
            --db-accent: #7fd8e6;
            --db-accent-2: #59b4c7;
        }

        .db-page {
            padding: 24px;
            color: var(--db-text);
        }

        .db-topbar {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 16px;
            margin-bottom: 24px;
        }

        .db-topbar h1 {
            font-size: 24px;
            font-weight: 800;
            margin: 0;
            letter-spacing: -0.03em;
        }

        .db-topbar p {
            margin: 6px 0 0;
            color: var(--db-muted);
            font-size: 13px;
        }

        .db-badges {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: 8px;
        }

        .db-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: 11px;
            background: rgba(127,216,230,0.12);
            color: var(--db-accent);
            border: 1px solid rgba(127,216,230,0.18);
        }

        .db-grid {
            display: grid;
            grid-template-columns: repeat(12, minmax(0, 1fr));
            gap: 16px;
        }

        .db-card {
            background: var(--db-bg);
            border: 1px solid var(--db-border);
            border-radius: 16px;
            box-shadow: var(--db-shadow);
            overflow: hidden;
        }

        .db-card__head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 16px 0;
        }

        .db-card__title {
            font-size: 14px;
            font-weight: 700;
            letter-spacing: .02em;
            color: #f4ede0;
            margin: 0;
        }

        .db-card__body {
            padding: 14px 16px 16px;
        }

        .db-card--full { grid-column: span 12; }
        .db-card--half { grid-column: span 6; }
        .db-card--third { grid-column: span 4; }
        .db-card--quad { grid-column: span 3; }

        .db-kpis {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
        }

        .db-kpi {
            padding: 14px;
            border-radius: 14px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.05);
        }

        .db-kpi__label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .12em;
            color: rgba(244,239,232,0.68);
            margin-bottom: 8px;
        }

        .db-kpi__value {
            font-size: 26px;
            font-weight: 800;
            letter-spacing: -0.03em;
            color: #fff;
            line-height: 1;
        }

        .db-kpi__sub {
            margin-top: 8px;
            font-size: 11px;
            color: rgba(244,239,232,0.68);
        }

        .db-list {
            display: grid;
            gap: 10px;
        }

        .db-list__item {
            padding: 10px 12px;
            border-radius: 12px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.05);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .db-list__main {
            min-width: 0;
        }

        .db-list__title {
            margin: 0;
            font-size: 13px;
            font-weight: 700;
            color: #f7f1e8;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .db-list__meta {
            margin-top: 2px;
            font-size: 11px;
            color: rgba(244,239,232,0.66);
        }

        .db-empty {
            color: rgba(244,239,232,0.66);
            font-size: 13px;
            padding: 8px 0;
        }

        .db-split {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .db-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }

        .db-table th,
        .db-table td {
            padding: 8px 10px;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            text-align: left;
        }

        .db-table th {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .1em;
            color: rgba(244,239,232,0.68);
            font-weight: 700;
        }

        .db-table td {
            color: #f7f1e8;
        }

        .db-table tr:last-child td {
            border-bottom: none;
        }

        @media (max-width: 1100px) {
            .db-card--quad { grid-column: span 6; }
            .db-card--third { grid-column: span 6; }
            .db-card--half { grid-column: span 12; }
            .db-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }

        @media (max-width: 768px) {
            .db-page { padding: 16px; }
            .db-topbar { flex-direction: column; }
            .db-badges { justify-content: flex-start; }
            .db-card--full,
            .db-card--third,
            .db-card--quad,
            .db-card--half { grid-column: span 12; }
            .db-kpis { grid-template-columns: 1fr; }
            .db-split { grid-template-columns: 1fr; }
        }
    </style>
{% endblock %}

{% block body %}
<div class="db-page">
    <div class="db-topbar">
        <div>
            <h1>Dashboard WazeBR</h1>
            <p>Resumo operacional com alertas, congestionamentos, CEMADEN, CIFS e irregularidades.</p>
        </div>
        <div class="db-badges">
            {% if kpis.anomalyDetected %}
                <span class="db-pill">⚠ Anomalia detectada · {{ kpis.anomalyRatio }}×·a média</span>
            {% endif %}
            <span class="db-pill">🚨 {{ kpis.alerts1h|default(0) }} alertas/1h</span>
            <span class="db-pill">🚗 {{ kpis.liveJams|default(0) }} jams ao vivo</span>
            <span class="db-pill">🌧 {{ kpis.rainLastHour|default(0) }} mm/h</span>
        </div>
    </div>

    <div class="db-grid">
        {# KPIs principais #}
        <section class="db-card db-card--full">
            <div class="db-card__head"><h2 class="db-card__title">Indicadores principais</h2></div>
            <div class="db-card__body">
                <div class="db-kpis">
                    <div class="db-kpi">
                        <div class="db-kpi__label">Alertas</div>
                        <div class="db-kpi__value">{{ kpis.alerts|default(0) }}</div>
                        <div class="db-kpi__sub">24h: {{ kpis.alerts24h|default(0) }} · 7d: {{ kpis.alerts7d|default(0) }}</div>
                    </div>
                    <div class="db-kpi">
                        <div class="db-kpi__label">Congestionamentos</div>
                        <div class="db-kpi__value">{{ kpis.jams|default(0) }}</div>
                        <div class="db-kpi__sub">24h: {{ kpis.jams24h|default(0) }} · 7d: {{ kpis.jams7d|default(0) }}</div>
                    </div>
                    <div class="db-kpi">
                        <div class="db-kpi__label">Cidades</div>
                        <div class="db-kpi__value">{{ kpis.cities|default(0) }}</div>
                        <div class="db-kpi__sub">Links: {{ kpis.links|default(0) }} · Rotas: {{ kpis.routes|default(0) }}</div>
                    </div>
                    <div class="db-kpi">
                        <div class="db-kpi__label">Irregularidades</div>
                        <div class="db-kpi__value">{{ kpis.irregularities|default(0) }}</div>
                        <div class="db-kpi__sub">Top severidade por cidade</div>
                    </div>
                </div>
            </div>
        </section>

        {# Anomalia #}
        <section class="db-card db-card--full">
            <div class="db-card__head"><h2 class="db-card__title">Anomalia operacional</h2></div>
            <div class="db-card__body">
                {% include 'dashboard/_anomaly_banner.html.twig' with { kpis: kpis|default({}) } %}
                {% if not kpis.anomalyDetected %}
                    <div class="db-empty">Nenhuma anomalia forte detectada nas últimas horas.</div>
                {% endif %}
            </div>
        </section>

        {# Alertas por tipo / cidade #}
        <section class="db-card db-card--half">
            <div class="db-card__head"><h2 class="db-card__title">Alertas por tipo</h2></div>
            <div class="db-card__body">
                {% if alertsByType|default([])|length > 0 %}
                    <table class="db-table">
                        <thead>
                            <tr><th>Tipo</th><th>Quantidade</th></tr>
                        </thead>
                        <tbody>
                        {% for row in alertsByType %}
                            <tr>
                                <td>{{ row.type ?? row.typeLabel ?? '—' }}</td>
                                <td>{{ row.count ?? row.total ?? 0 }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <div class="db-empty">Sem dados de alertas por tipo.</div>
                {% endif %}
            </div>
        </section>

        <section class="db-card db-card--half">
            <div class="db-card__head"><h2 class="db-card__title">Alertas por cidade</h2></div>
            <div class="db-card__body">
                {% if alertsByCity|default([])|length > 0 %}
                    <table class="db-table">
                        <thead>
                            <tr><th>Cidade</th><th>Quantidade</th></tr>
                        </thead>
                        <tbody>
                        {% for row in alertsByCity %}
                            <tr>
                                <td>{{ row.city ?? '—' }}</td>
                                <td>{{ row.count ?? row.total ?? 0 }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <div class="db-empty">Sem dados de alertas por cidade.</div>
                {% endif %}
            </div>
        </section>

        {# Jams por nível #}
        <section class="db-card db-card--half">
            <div class="db-card__head"><h2 class="db-card__title">Congestionamentos por nível</h2></div>
            <div class="db-card__body">
                {% if jamsByLevel|default([])|length > 0 %}
                    <table class="db-table">
                        <thead>
                            <tr><th>Nivel</th><th>Quantidade</th></tr>
                        </thead>
                        <tbody>
                        {% for row in jamsByLevel %}
                            <tr>
                                <td>{{ row.level ?? '—' }}</td>
                                <td>{{ row.count ?? row.total ?? 0 }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <div class="db-empty">Sem dados de congestionamentos por nível.</div>
                {% endif %}
            </div>
        </section>

        <section class="db-card db-card--half">
            <div class="db-card__head"><h2 class="db-card__title">Qualidade dos alertas</h2></div>
            <div class="db-card__body">
                {% if alertQualityByType|default([])|length > 0 %}
                    <table class="db-table">
                        <thead>
                            <tr><th>Tipo</th><th>Qualidade média</th><th>Qtd</th></tr>
                        </thead>
                        <tbody>
                        {% for row in alertQualityByType %}
                            <tr>
                                <td>{{ row.typeLabel ?? row.type ?? '—' }}</td>
                                <td>{{ row.avgQuality ?? row.avg_quality ?? '—' }}</td>
                                <td>{{ row.total ?? row.count ?? 0 }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <div class="db-empty">Sem dados de qualidade de alertas.</div>
                {% endif %}
            </div>
        </section>

        {# CEMADEN / Hidro #}
        <section class="db-card db-card--half">
            <div class="db-card__head"><h2 class="db-card__title">CEMADEN / Hidrologia</h2></div>
            <div class="db-card__body">
                <div class="db-kpis" style="grid-template-columns:repeat(2,minmax(0,1fr));">
                    <div class="db-kpi">
                        <div class="db-kpi__label">Chuva 1h</div>
                        <div class="db-kpi__value">{{ kpis.rainLastHour|default(0) }}</div>
                        <div class="db-kpi__sub">mm/h</div>
                    </div>
                    <div class="db-kpi">
                        <div class="db-kpi__label">Estacoes CEMADEN</div>
                        <div class="db-kpi__value">{{ kpis.cemaden|default(0) }}</div>
                        <div class="db-kpi__sub">{{ cemadenData|length|default(0) }} registros</div>
                    </div>
                </div>
                {% if hydroKpis is defined and hydroKpis %}
                    <div class="db-empty mt-3">{{ hydroKpis|length }} KPIs hidroló···icos carregados.</div>
                {% endif %}
            </div>
        </section>

        <section class="db-card db-card--half">
            <div class="db-card__head"><h2 class="db-card__title">CIFS ativos</h2></div>
            <div class="db-card__body">
                {% if cifsActiveByType|default([])|length > 0 %}
                    <table class="db-table">
                        <thead>
                            <tr><th>Tipo</th><th>Ativos</th></tr>
                        </thead>
                        <tbody>
                        {% for row in cifsActiveByType %}
                            <tr>
                                <td>{{ row.type|replace({'_': ' '})|title ?? '—' }}</td>
                                <td>{{ row.total ?? 0 }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <div class="db-empty">Sem eventos CIFS ativos por tipo.</div>
                {% endif %}
                <div class="db-empty mt-3">Total: {{ kpis.cifsActiveCount|default(0) }} eventos ativos.</div>
            </div>
        </section>

        {# Irregularidades #}
        <section class="db-card db-card--full">
            <div class="db-card__head"><h2 class="db-card__title">Irregularidades (perda de velocidade)</h2></div>
            <div class="db-card__body">
                {% if irregSpeedLoss|default([])|length > 0 %}
                    <table class="db-table">
                        <thead>
                            <tr><th>Via</th><th>Perda %</th><th>Severidade</th></tr>
                        </thead>
                        <tbody>
                        {% for row in irregSpeedLoss %}
                            <tr>
                                <td>{{ row.street ?? '—' }}</td>
                                <td>{{ row.loss_pct ?? '—' }}%</td>
                                <td>{{ row.avg_severity ?? '—' }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <div class="db-empty">Sem dados de perda de velocidade por irregularidade.</div>
                {% endif %}
            </div>
        </section>

        <section class="db-card db-card--full">
            <div class="db-card__head"><h2 class="db-card__title">Irregularidades (atraso acumulado)</h2></div>
            <div class="db-card__body">
                {% if irregDelayByStreet|default([])|length > 0 %}
                    <table class="db-table">
                        <thead>
                            <tr><th>Via</th><th>Atraso (s)</th><th>Ocorr#</th></tr>
                        </thead>
                        <tbody>
                        {% for row in irregDelayByStreet %}
                            <tr>
                                <td>{{ row.street ?? '—' }}</td>
                                <td>{{ row.total_delay_s|default(0)|number_format(0, ',', '.') }}</td>
                                <td>{{ row.occurrences ?? 0 }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <div class="db-empty">Sem dados de atraso acumulado por irregularidade.</div>
                {% endif %}
            </div>
        </section>

        {# CIFS detalhes #}
        <section class="db-card db-card--half">
            <div class="db-card__head"><h2 class="db-card__title">Pró·½·imos eventos CIFS (7 dias)</h2></div>
            <div class="db-card__body">
                {% if cifsUpcoming|default([])|length > 0 %}
                    <div class="db-list">
                    {% for ev in cifsUpcoming|slice(0,6) %}
                        <div class="db-list__item">
                            <div class="db-list__main">
                                <p class="db-list__title">{{ ev.street ?? 'Via não informada' }}</p>
                                <div class="db-list__meta">
                                    {{ ev.startTime ? ev.startTime|date('d/m H:i') : '—' }}
                                    {% if ev.endTime %} até {{ ev.endTime|date('d/m H:i') }}{% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                    </div>
                {% else %}
                    <div class="db-empty">Nenhum evento CIFS programado para os próximos 7 dias.</div>
                {% endif %}
            </div>
        </section>

        <section class="db-card db-card--half">
            <div class="db-card__head"><h2 class="db-card__title">Vias mais afetadas por CIFS</h2></div>
            <div class="db-card__body">
                {% if cifsTopStreets|default([])|length > 0 %}
                    <div class="db-list">
                    {% for row in cifsTopStreets %}
                        <div class="db-list__item">
                            <div class="db-list__main">
                                <p class="db-list__title">{{ row.street ?? 'Via não informada' }}</p>
                                <div class="db-list__meta">Eventos ativos nesta via</div>
                            </div>
                            <div class="db-pill">{{ row.total ?? 0 }}</div>
                        </div>
                    {% endfor %}
                    </div>
                {% else %}
                    <div class="db-empty">Sem ranking de vias mais afetadas por CIFS.</div>
                {% endif %}
            </div>
        </section>

        {# Recentes #}
        <section class="db-card db-card--full">
            <div class="db-card__head"><h2 class="db-card__title">Recentes: alertas e jams</h2></div>
            <div class="db-card__body">
                <div class="db-split">
                    <div>
                        <div class="db-list">
                            {% if recentAlerts|default([])|length > 0 %}
                                {% for row in recentAlerts|slice(0,6) %}
                                    <div class="db-list__item">
                                        <div class="db-list__main">
                                            <p class="db-list__title">{{ row.title ?? row.name ?? 'Alerta' }}</p>
                                            <div class="db-list__meta">{{ row.city ?? row.street ?? '—' }}</div>
                                        </div>
                                        <div class="db-pill">{{ row.createdAt ? row.createdAt|date('d/m H:i') : '—' }}</div>
                                    </div>
                                {% endfor %}
                            {% else %}
                                <div class="db-empty">Sem alertas recentes.</div>
                            {% endif %}
                        </div>
                    </div>
                    <div>
                        <div class="db-list">
                            {% if recentJams|default([])|length > 0 %}
                                {% for row in recentJams|slice(0,6) %}
                                    <div class="db-list__item">
                                        <div class="db-list__main">
                                            <p class="db-list__title">{{ row.street ?? row.title ?? 'Congestionamento' }}</p>
                                            <div class="db-list__meta">Nivel: {{ row.level ?? '—' }} · {{ row.city ?? '—' }}</div>
                                        </div>
                                        <div class="db-pill">{{ row.updatedAt ? row.updatedAt|date('d/m H:i') : '—' }}</div>
                                    </div>
                                {% endfor %}
                            {% else %}
                                <div class="db-empty">Sem congestionamentos recentes.</div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
{% endblock %}
