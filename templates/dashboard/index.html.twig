{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-3">Dashboard</h1>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Alertas</h5>
                    <p class="display-4">{{ alerts_count }}</p>
                    <small class="text-muted">Hoje</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Engarrafamentos</h5>
                    <p class="display-4">{{ jams_count }}</p>
                    <small class="text-muted">Hoje</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Rotas TVT</h5>
                    <p class="display-4">{{ routes_count }}</p>
                    <small class="text-muted">Total</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Alertas Ativos</h5>
                </div>
                <div class="card-body">
                    {% if alerts|length > 0 %}
                        <ul class="list-group list-group-flush">
                            {% for alert in alerts|slice(0, 10) %}
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    {{ alert.type }}
                                    <span class="badge bg-primary rounded-pill">{{ alert.lastSeenAt|date('H:i') }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-muted mb-0">Nenhum alerta ativo</p>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Engarrafamentos Ativos</h5>
                </div>
                <div class="card-body">
                    {% if jams|length > 0 %}
                        <ul class="list-group list-group-flush">
                            {% for jam in jams|slice(0, 10) %}
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Nvl {{ jam.level }}
                                    <span class="badge bg-danger rounded-pill">{{ jam.lastSeenAt|date('H:i') }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-muted mb-0">Nenhum engarrafamento ativo</p>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Rotas TVT Ativas</h5>
                </div>
                <div class="card-body">
                    {% if routes|length > 0 %}
                        <ul class="list-group list-group-flush">
                            {% for route in routes|slice(0, 10) %}
                                <li class="list-group-item">
                                    {{ route.name }}
                                    <small class="text-muted d-block">{{ route.lastSeenAt|date('H:i') }}</small>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-muted mb-0">Nenhuma rota ativa</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
