{% extends 'base.html.twig' %}
{% block stylesheets %}
    {{ parent() }}
    {% if app.request.attributes.get('_route') == 'dashboard' %}
        <link rel="stylesheet" href="{{ asset('css/pages/dashboard-decisions.css') }}">
        <link rel="stylesheet" href="{{ asset('css/pages/dashboard-period-comparison.css') }}">
    {% endif %}
    {% if app.request.attributes.get('_route') == 'alert_index' %}
        {# Keep Leaflet layers positioned even when external styles are unavailable or overridden. #}
        <style>
            [data-alerts-map] .leaflet-pane,
            [data-alerts-map] .leaflet-tile,
            [data-alerts-map] .leaflet-marker-icon,
            [data-alerts-map] .leaflet-marker-shadow,
            [data-alerts-map] .leaflet-tile-container,
            [data-alerts-map] .leaflet-pane > svg,
            [data-alerts-map] .leaflet-pane > canvas,
            [data-alerts-map] .leaflet-zoom-box,
            [data-alerts-map] .leaflet-image-layer,
            [data-alerts-map] .leaflet-layer {
                position: absolute !important;
                left: 0;
                top: 0;
            }
        </style>
    {% endif %}
{% endblock %}
{% block body_class %}app-body dashboard-layout{% endblock %}
{% block body %}
    <div class="app-shell" data-layout="dashboard">
        {% include 'partials/header.html.twig' %}
        <div class="app-layout">
            {% include 'partials/sidebar.html.twig' %}
            <main id="main-content" class="app-content" data-main-content>
                {% if app.request.attributes.get('_route') == 'dashboard' %}
                    {% include 'dashboard/_decision_sections.html.twig' %}
                {% endif %}
                {% block content %}{% endblock %}
            </main>
        </div>
        {% include 'partials/footer.html.twig' %}
    </div>
    {% if app.request.attributes.get('_route') == 'dashboard' %}
        <script src="{{ asset('js/pages/dashboard-chart-semantics.js') }}" defer></script>
        <script src="{{ asset('js/pages/dashboard-decisions.js') }}" defer></script>
    {% endif %}
{% endblock %}
