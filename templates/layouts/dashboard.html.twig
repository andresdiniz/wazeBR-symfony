{% extends 'base.html.twig' %}
{% block stylesheets %}
    {{ parent() }}
    {% if app.request.attributes.get('_route') == 'dashboard' %}
        <link rel="stylesheet" href="{{ asset('css/pages/dashboard-decisions.css') }}">
    {% endif %}
{% endblock %}
{% block body_class %}app-body dashboard-layout{% endblock %}
{% block body %}
    <div class="app-shell" data-layout="dashboard">
        {% include 'partials/header.html.twig' %}
        <div class="app-layout">
            {% include 'partials/sidebar.html.twig' %}
            <main id="main-content" class="app-content" data-main-content>
                {% if app.request.attributes.get('_route') == 'dashboard' %}
                    {% include 'dashboard/_decision_sections.html.twig' %}
                {% endif %}
                {% block content %}{% endblock %}
            </main>
        </div>
        {% include 'partials/footer.html.twig' %}
    </div>
    {% if app.request.attributes.get('_route') == 'dashboard' %}
        <script src="{{ asset('js/pages/dashboard-decisions.js') }}" defer></script>
    {% endif %}
{% endblock %}
