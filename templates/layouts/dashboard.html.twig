{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body_class %}
    app-body dashboard-layout
{% endblock %}


{% block body %}
    <div
        class="app-shell"
        data-layout="dashboard"
    >

        {# ========================================================
           HEADER
           ======================================================== #}

        {% include 'partials/header.html.twig' %}


        {# ========================================================
           ÁREA PRINCIPAL
           ======================================================== #}

        <div class="app-layout">

            {# ----------------------------------------------------
               SIDEBAR
               ---------------------------------------------------- #}

            {% include 'partials/sidebar.html.twig' %}


            {# ----------------------------------------------------
               CONTEÚDO
               ---------------------------------------------------- #}

            <main
                id="main-content"
                class="app-content"
                data-main-content
            >

                {% block content %}
                {% endblock %}

            </main>

        </div>


        {# ========================================================
           FOOTER
           ======================================================== #}

        {% include 'partials/footer.html.twig' %}

    </div>

{% endblock %}
