{# templates/partner_registration/register.html.twig #}
{% extends 'base_guest_improved.html.twig' %}

{% block title %}Cadastro de Parceiro - wazeBR{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl w-full space-y-8 bg-white p-8 rounded-xl shadow-lg">
        <div>
            <h2 class="text-3xl font-bold text-gray-900 text-center">
                Cadastro de Parceiro
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600">
                Crie sua conta para acessar o painel de monitoramento
            </p>
        </div>

        {% for flash_error in app.flashes('error') %}
            <div class="rounded-md bg-red-50 p-4 border border-red-200">
                <div class="flex">
                    <div class="ml-3">
                        <h3 class="text-sm font-medium text-red-800">{{ flash_error }}</h3>
                    </div>
                </div>
            </div>
        {% endfor %}

        {% for flash_success in app.flashes('success') %}
            <div class="rounded-md bg-green-50 p-4 border border-green-200">
                <div class="flex">
                    <div class="ml-3">
                        <h3 class="text-sm font-medium text-green-800">{{ flash_success }}</h3>
                    </div>
                </div>
            </div>
        {% endfor %}

        {{ form_start(registrationForm, {'attr': {'class': 'mt-8 space-y-6'}}) }}

            <div class="space-y-4">
                <h3 class="text-lg font-semibold text-gray-800 border-b pb-2">
                    📋 Dados da Empresa/Parceiro
                </h3>

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div class="sm:col-span-2">
                        {{ form_label(registrationForm.partnerName) }}
                        {{ form_widget(registrationForm.partnerName, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {{ form_errors(registrationForm.partnerName) }}
                    </div>

                    <div>
                        {{ form_label(registrationForm.partnerEmail) }}
                        {{ form_widget(registrationForm.partnerEmail, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {{ form_errors(registrationForm.partnerEmail) }}
                    </div>

                    <div>
                        {{ form_label(registrationForm.partnerPhone) }}
                        {{ form_widget(registrationForm.partnerPhone, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {{ form_errors(registrationForm.partnerPhone) }}
                    </div>
                </div>
            </div>

            <div class="space-y-4 pt-4">
                <h3 class="text-lg font-semibold text-gray-800 border-b pb-2">
                    👤 Dados do Administrador
                </h3>

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div class="sm:col-span-2">
                        {{ form_label(registrationForm.userEmail) }}
                        {{ form_widget(registrationForm.userEmail, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {% if registrationForm.userEmail.vars.help %}
                            <p class="text-xs text-gray-500 mt-1">{{ registrationForm.userEmail.vars.help }}</p>
                        {% endif %}
                        {{ form_errors(registrationForm.userEmail) }}
                    </div>

                    <div>
                        {{ form_label(registrationForm.plainPassword.first) }}
                        {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {{ form_errors(registrationForm.plainPassword.first) }}
                    </div>

                    <div>
                        {{ form_label(registrationForm.plainPassword.second) }}
                        {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                    </div>

                    <div class="sm:col-span-2">
                        {{ form_label(registrationForm.userFullName) }}
                        {{ form_widget(registrationForm.userFullName, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500'}}) }}
                        {{ form_errors(registrationForm.userFullName) }}
                    </div>
                </div>
            </div>

            <div class="pt-4">
                <div class="flex items-start">
                    <div class="flex items-center h-5">
                        {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded'}}) }}
                    </div>
                    <div class="ml-3 text-sm">
                        {{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'text-gray-700'}}) }}
                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>
                </div>
            </div>

            <div class="pt-4">
                <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                    Criar conta
                </button>
            </div>

            <div class="text-center">
                <a href="{{ path('app_login') }}" class="text-sm text-indigo-600 hover:text-indigo-500">
                    Já tem conta? Faça login
                </a>
            </div>
        {{ form_end(registrationForm) }}
    </div>
</div>
{% endblock %}
