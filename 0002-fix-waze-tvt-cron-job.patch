     ],
     'waze_tvt' => [
-        'cmd'     => ['app:waze:collect-tvt'],
+        'cmd'     => ['waze:collect-tvt'],
         'timeout' => 50,
         'desc'    => 'Snapshots de rotas do feed TVT',
     ],
diff --git a/src/Command/WazeCollectRoutesCommand.php b/src/Command/WazeCollectRoutesCommand.php
