###> symfony/mailer ###
MAILER_DSN=smtp://localhost:25
MAILER_FROM_EMAIL=noreply@wazebr.com
MAILER_FROM_NAME="wazeBR"
###< symfony/mailer ###

# Exemplos de DSN para diferentes provedores:

# Gmail:
# MAILER_DSN=gmail://USERNAME:PASSWORD@smtp.gmail.com

# Gmail com app password (recomendado):
# MAILER_DSN=gmail://seu-email@gmail.com:app-password@smtp.gmail.com

# Sendgrid:
# MAILER_DSN=sendgrid://KEY@default

# Mailgun:
# MAILER_DSN=mailgun://KEY:DOMAIN@default

# Amazon SES:
# MAILER_DSN=ses://KEY:SECRET@default?region=REGION

# SMTP gen\u00e9rico:
# MAILER_DSN=smtp://user:pass@smtp.example.com:587

# Para desenvolvimento local (veja .env.dev.local):
# MAILER_DSN=null://null
