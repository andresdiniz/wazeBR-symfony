# Database configuration
# Format: mysql://username:password@host:port/database_name
# Mailer configuration
# For development (no emails sent - just logged)
MAILER_DSN=null://null

# For Gmail (production)
# MAILER_DSN=gmail://seu-email@gmail.com:app-password@smtp.gmail.com

# For SMTP
# MAILER_DSN=smtp://usuario:senha@smtp.exemplo.com:587

MAILER_FROM_EMAIL="noreply@wazebr.com"
MAILER_FROM_NAME="wazeBR"

# App configuration
APP_NAME="wazeBR"
APP_URL="http://localhost:8000"

# Symfony secret key (change this in production!)
APP_SECRET="your-secret-key-change-in-production-abc123xyz"

# Messenger configuration (optional)
# MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=disabled
