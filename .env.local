# Database configuration
# Format: mysql://username:password@host:port/database_name
DATABASE_URL="mysql://root:@localhost:3306/wazebr?serverVersion=8.0&charset=utf8mb4"

# If you're using MariaDB
# DATABASE_URL="mysql://root:@localhost:3306/wazebr?serverVersion=10.3.22-MariaDB&charset=utf8mb4"

# Mailer configuration
# For development (no emails sent)
MAILER_DSN=null://null

# For Gmail (production)
# MAILER_DSN=gmail://seu-email@gmail.com:app-password@smtp.gmail.com

# For SMTP
# MAILER_DSN=smtp://usuario:senha@smtp.exemplo.com:587

MAILER_FROM_EMAIL="noreply@wazebr.com"
MAILER_FROM_NAME="wazeBR"

# App configuration
APP_NAME="wazeBR"
APP_URL="http://localhost:8000"

# Symfony secret key (change this in production!)
APP_SECRET="your-secret-key-change-in-production-abc123xyz"

# Trusted proxies (optional)
# TRUSTED_PROXIES="127.0.0.1,127.0.0.2"

# CORS settings (optional)
# CORS_ALLOW_ORIGIN="http://localhost:3000"
