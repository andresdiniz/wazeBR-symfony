APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-this-to-a-random-32-byte-secret

# -------------------------------------------------------------------------
# BANCO DE DADOS — MySQL Hostinger
# -------------------------------------------------------------------------
DATABASE_URL="mysql://app:change-me@127.0.0.1:3306/wazebr?serverVersion=mariadb-11.0"

# -------------------------------------------------------------------------
# MESSENGER
# -------------------------------------------------------------------------
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# -------------------------------------------------------------------------
# MAILER
# -------------------------------------------------------------------------
MAILER_DSN=null://null

MAILER_FROM_EMAIL="no-reply@example.test"
MAILER_FROM_NAME="WazeBR"
APP_URL="https://example.test"

# Worker de notificações (opcional; deixe vazio para desativar)
WAZEBR_NOTIFICATIONS_WORKER_URL=
WAZEBR_NOTIFICATIONS_WEBHOOK_TOKEN=

# -------------------------------------------------------------------------
# CRON TOKEN
CRON_TOKEN=change-this-to-a-long-random-token

SCHEDULER_LOG_LEVEL=error
#SCHEDULER_LOG_LEVEL=info #Investigar erros
#SCHEDULER_LOG_LEVEL=debug #Debugar tudo

CRON_PHP_BINARY=/usr/bin/php

